# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Project specific
*.log
.env
.env.local

# Credentials & tokens
*.pem
*.key
secrets.json

# Loom (C++ kernel) build trees
loom/build*/
loom/out/

# Loom synthetic eval corpus: generator OUTPUT that must never be committed
# (loom/tools/gen_synthetic_fake_repo.py, loom/tools/scale_archive.py) --
# the corpus DATA itself (loom/tests/fixtures/eval/synthetic_dev/*.zip and
# ground_truth.json) is committed and NOT covered by this rule.
loom/tests/fixtures/eval/synthetic_dev/fake_repo/
loom/tests/fixtures/eval/synthetic_dev/*.scaled.json
loom/tests/fixtures/eval/synthetic_dev/scaled/

# Loom Android/web build outputs (never source)
loom/android/.gradle/
loom/android/local.properties
loom/android/**/build/
loom/android/**/.cxx/
loom/android/app/src/main/assets/web/**
!loom/android/app/src/main/assets/web/index.html
loom/android/verify/build*/
loom/web/node_modules/
