{"schema": "loom.extract.sentence_grammar/1", "id": "en", "language": "en",
 "label": {"pl": "Zdanie po angielsku → zadanie (przepis)", "en": "An English sentence → a task (recipe)"},
 "verbs": {"extract": "cut", "cut": "cut", "export": "cut", "make": "cut", "show": "search", "find": "search", "search": "search",
           "count": "count", "inventory": "count"},
 "stop": "(?=\\s+(?:everything|all|about|on\\s+the\\s+topic|regarding|in\\s+(?:the\\s+)?\\w+\\s+profile|as\\s|from\\s+\\d|since\\s|until\\s|to\\s+\\d|without\\s|only\\s|from\\s+(?:the\\s+)?archives?|into\\s|with\\s+redaction|for\\s+import)|$)",
 "rules": [
  {"id": "package", "regex": "\\binto\\s+(?:package\\s+|directory\\s+)?(?P<package>\"[^\"]+\"|\\S+)", "action": "package"},
  {"id": "handoff", "regex": "\\bfor\\s+(?:import|the\\s+app)\\b", "action": "handoff"},
  {"id": "sources", "regex": "\\bfrom\\s+(?:the\\s+)?(?:archives?|exports?|files?|folder|directory)\\s+(?P<list>.+?){stop}", "action": "sources"},
  {"id": "range", "regex": "\\b(?:from|since)\\s+(?P<from>\\d{4}(?:-\\d{2}){0,2})(?:\\s+(?:to|until)\\s+(?P<to>\\d{4}(?:-\\d{2}){0,2}))?", "action": "range"},
  {"id": "until", "regex": "\\b(?:until|before)\\s+(?P<to>\\d{4}(?:-\\d{2}){0,2})\\b", "action": "range"},
  {"id": "year", "regex": "\\bin\\s+(?P<year>\\d{4})\\b", "action": "range"},
  {"id": "profile", "regex": "\\b(?:in\\s+(?:the\\s+)?(?P<profile>[\\w:-]+)\\s+profile|as\\s+(?P<profile2>[\\w:-]+))", "action": "profile"},
  {"id": "no_tools", "regex": "\\bwithout\\s+tools\\b", "action": "drop_blocks", "kinds": ["tool_use", "tool_result"]},
  {"id": "no_thinking", "regex": "\\bwithout\\s+(?:reasoning|thinking)\\b", "action": "drop_blocks", "kinds": ["thinking"]},
  {"id": "redact", "regex": "\\bwith\\s+redaction\\b|\\bmask\\s+personal\\s+data\\b", "action": "redaction", "profile": "personal"},
  {"id": "only_attachments", "regex": "\\bonly\\s+with\\s+attachments\\b", "action": "expr", "expr": "has:attachments"},
  {"id": "only_agentic", "regex": "\\bonly\\s+(?:agentic|with\\s+tools)\\b", "action": "expr", "expr": "is:agentic"},
  {"id": "only_branches", "regex": "\\bonly\\s+(?:with\\s+branches|branched)\\b", "action": "expr", "expr": "has:branches"},
  {"id": "topic", "regex": "\\b(?:everything\\s+)?(?:about|on\\s+the\\s+topic(?:\\s+of)?|regarding)\\s+(?P<topic>.+?){stop}", "action": "topic"}
 ],
 "profiles": {"flat": "flat", "structure": "structure", "text": "text", "markdown": "text", "reasoning": "reasoning", "graph": "graph",
              "table": "table", "csv": "table", "timeline": "timeline", "cards": "cards", "original": "preserve", "source": "preserve",
              "preserve": "preserve", "bundle": "bundle", "zip": "bundle"},
 "list_split": "\\s*(?:,|\\s+and\\s+)\\s*",
 "filler": ["me", "please", "everything", "all", "the", "and", "a"]}
