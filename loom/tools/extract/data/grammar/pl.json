{"schema": "loom.extract.sentence_grammar/1", "id": "pl", "language": "pl",
 "label": {"pl": "Zdanie po polsku → zadanie (przepis)", "en": "A Polish sentence → a task (recipe)"},
 "verbs": {"wyciągnij": "cut", "wyciagnij": "cut", "wytnij": "cut", "zrób": "cut", "zrob": "cut", "przygotuj": "cut",
           "pokaż": "search", "pokaz": "search", "znajdź": "search", "znajdz": "search", "szukaj": "search", "wyszukaj": "search",
           "policz": "count", "zlicz": "count", "przejrzyj": "count"},
 "stop": "(?=\\s+(?:wszystko|wszystkie|na\\s+temat|dotycz\\w*|o\\s|w\\s+profil\\w*|jako\\s|w\\s+formacie|od\\s|do\\s|bez\\s|tylko\\s|z\\s+archiw\\w*|z\\s+eksport\\w*|z\\s+redakcj\\w*|z\\s+przekazaniem|do\\s+pakietu|do\\s+katalogu|do\\s+importu|do\\s+aplikacji)|$)",
 "rules": [
  {"id": "package", "regex": "\\bdo\\s+(?:pakietu|katalogu)\\s+(?P<package>\"[^\"]+\"|\\S+)", "action": "package"},
  {"id": "handoff", "regex": "\\b(?:do\\s+importu|do\\s+aplikacji|z\\s+przekazaniem)", "action": "handoff"},
  {"id": "sources", "regex": "\\bz\\s+(?:archiwum|archiwów|archiwow|pliku|plików|plikow|katalogu|eksportu|eksportów|eksportow)\\s+(?P<list>.+?){stop}", "action": "sources"},
  {"id": "range", "regex": "\\bod\\s+(?P<from>\\d{4}(?:-\\d{2}){0,2})(?:\\s+do\\s+(?P<to>\\d{4}(?:-\\d{2}){0,2}))?", "action": "range"},
  {"id": "until", "regex": "\\bdo\\s+(?P<to>\\d{4}(?:-\\d{2}){0,2})\\b", "action": "range"},
  {"id": "year", "regex": "\\bw\\s+(?P<year>\\d{4})(?:\\s+roku)?\\b", "action": "range"},
  {"id": "profile", "regex": "\\b(?:w\\s+profilu|jako|w\\s+formacie|w\\s+postaci)\\s+(?P<profile>[\\wąćęłńóśźżĄĆĘŁŃÓŚŹŻ:-]+)", "action": "profile"},
  {"id": "no_tools", "regex": "\\bbez\\s+narz[ęe]dzi\\b", "action": "drop_blocks", "kinds": ["tool_use", "tool_result"]},
  {"id": "no_thinking", "regex": "\\bbez\\s+(?:rozumowania|my[śs]lenia|thinking)\\b", "action": "drop_blocks", "kinds": ["thinking"]},
  {"id": "redact", "regex": "\\b(?:z\\s+redakcj[ąa]|bez\\s+danych\\s+osobowych|zamaskuj\\s+dane(?:\\s+osobowe)?)", "action": "redaction", "profile": "personal"},
  {"id": "only_attachments", "regex": "\\btylko\\s+z\\s+za[łl][ąa]cznikami\\b", "action": "expr", "expr": "has:attachments"},
  {"id": "only_agentic", "regex": "\\btylko\\s+(?:agentowe|z\\s+narz[ęe]dziami)\\b", "action": "expr", "expr": "is:agentic"},
  {"id": "only_branches", "regex": "\\btylko\\s+(?:z\\s+ga[łl][ęe]ziami|rozga[łl][ęe]zione)\\b", "action": "expr", "expr": "has:branches"},
  {"id": "only_thinking", "regex": "\\btylko\\s+z\\s+rozumowaniem\\b", "action": "expr", "expr": "has:thinking"},
  {"id": "topic", "regex": "\\b(?:wszystko|wszystkie\\s+rozmowy)?\\s*(?:o|na\\s+temat|dotycz[ąa]ce|dotycz[ąa]cych)\\s+(?P<topic>.+?){stop}", "action": "topic"}
 ],
 "profiles": {"płaskim": "flat", "plaskim": "flat", "płaski": "flat", "plaski": "flat", "flat": "flat",
              "strukturalnym": "structure", "struktury": "structure", "strukturze": "structure", "structure": "structure",
              "tekstowym": "text", "tekst": "text", "tekstu": "text", "markdown": "text", "text": "text",
              "rozumowania": "reasoning", "rozumowaniu": "reasoning", "reasoning": "reasoning",
              "grafu": "graph", "grafie": "graph", "graf": "graph", "graph": "graph",
              "tabeli": "table", "tabela": "table", "csv": "table", "table": "table",
              "osi": "timeline", "osi-czasu": "timeline", "timeline": "timeline",
              "kart": "cards", "karty": "cards", "kartach": "cards", "cards": "cards",
              "oryginalnym": "preserve", "oryginalny": "preserve", "źródłowym": "preserve", "zrodlowym": "preserve", "1:1": "preserve", "preserve": "preserve",
              "paczki": "bundle", "paczce": "bundle", "zip": "bundle", "bundle": "bundle"},
 "list_split": "\\s*(?:,|\\s+i\\s+|\\s+oraz\\s+)\\s*",
 "filler": ["mi", "proszę", "prosze", "wszystko", "wszystkie", "rozmowy", "z", "i", "oraz", "a", "też", "tez"]}
