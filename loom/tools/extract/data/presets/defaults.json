{
  "schema": "loom.extract.defaults/1",
  "description": "Presets, not rules: every value here is a starting point the user overrides in a task file, on the CLI or in <data dir>/extract/presets/defaults.json. 0 means 'no cut'.",
  "language": "pl",
  "workers": "auto",
  "cache": "auto",
  "sniff": {"head_bytes": 65536, "json_whole_limit_bytes": 67108864, "nested_zip_limit_bytes": 0},
  "read": {"keep_raw": false, "streaming_array_min_bytes": 5000000},
  "tokens": {"chars_per_token": {"en": 4.0, "pl": 3.2, "default": 3.6}, "note": "local estimate; the inventory shows the constants"},
  "thinking": {"full_min_chars": 200, "reasoning_share": 0.5},
  "language_detection": {"min_chars": 20, "profiles": "langdetect/profiles.json"},
  "grain": "conversation",
  "grain_blocks": ["tool_use", "tool_result", "thinking", "attachment"],
  "expand": "conversation",
  "window": {"size": 6, "step": 3},
  "cascade": "default",
  "criteria": null,
  "lexical": {"explain_top_k": 10, "saturation": 6.0, "boundary": true, "fold": true, "inflect": "rules"},
  "vectors": {"threshold": 0.35, "candidates": 0, "engine": "core.selector", "tier": null, "allow_download": false},
  "similar": {"threshold": 0.5},
  "masks": {"date_tolerance_hours": 14},
  "timeline": {"key": "created", "zone": "source", "assume_zone": "UTC", "ties": ["t", "service", "archive", "locator"],
               "bucket": "week", "gap_days": 30, "burst_ratio": 3.0,
               "continuation": {"enabled": true, "window_minutes": 240, "min_shared_terms": 2, "min_confidence": 0.3}},
  "diff": {"identity": "ext_id", "summary_only": false},
  "merge": {"newest_wins": true},
  "clusters": {"min_conversations": 2, "top_terms": 8, "max_clusters": 0, "min_term_df": 2, "min_similarity": 0.15, "feature_boost": 2.0, "max_df_share": 0.5},
  "decisions": {"learn_min_corrections": 2, "proposals": true},
  "flows": {"model": {"enabled": false, "cheap": "cheap_classify", "strong": "strong_judge",
                       "classes": {"cheap": null, "strong": null}, "route": "provider",
                       "guard": {"ratio": 10.0, "limit_per_run": 0, "limit_per_day": 0},
                       "accept": false, "accept_x10": false, "replay_only": false,
                       "provider": {"base_url": null, "api_key_env": "LOOM_EXTRACT_API_KEY", "secret": "api_key", "timeout": 120}}},
  "write": {"units_snapshot": true, "explain": true, "aggregate": false, "aggregate_content": "refuse"},
  "cut": {"profiles": ["preserve", "text"], "order": "package", "attachments": "copy_used", "redaction": "none", "extract_text": false,
          "package_default": "ekstrakt-{topic}", "package_topic_default": "archiwum"},
  "redaction": {"inflection": {"strip_final": "aeiouyąę", "optional_inner": "e", "ending_max": 5, "min_stem": 2},
                "secret_store": true},
  "state": {"dir": null},
  "handoff": {"branches": "current", "graph": false, "zip": true},
  "edits": {"preview_sample": 0},
  "report": {"language": "pl", "examples_per_unknown": 1, "max_list": 0},
  "commander": {"keymap": "fkeys", "colors": "dark", "tick_ms": 100, "bytes_per_char": 1.5,
                "autosave": {"every": 1, "resume": "ask", "file": "komander.autosave.json"}},
  "serve": {"address": "127.0.0.1", "port": 8741, "token_file": "serve.token", "answer_default": false,
            "question_timeout_s": 0, "events_keep": 0, "heartbeat_s": 15},
  "economics": {"of": "all",
                "usage": {"duplicate_lines": "max", "ignore_models": ["<synthetic>"], "stale_output": "keep"},
                "skip_session_side_files": true,
                "tool_attribution": "split",
                "day_zone": "UTC",
                "estimate": {"method": "auto", "context": "path", "calibration_min_output": 50,
                             "hidden_reasoning_models": ["o1*", "o3*", "o4*", "gpt-5*thinking*", "gpt-5-t-*", "gpt-5*-pro*", "*-thinking*", "*-reasoning*"],
                             "tiktoken": {"encodings": {"gpt-4o*": "o200k_base", "gpt-4.1*": "o200k_base", "gpt-5*": "o200k_base",
                                                        "o1*": "o200k_base", "o3*": "o200k_base", "o4*": "o200k_base",
                                                        "chatgpt-4o*": "o200k_base", "gpt-4*": "cl100k_base", "gpt-3.5*": "cl100k_base"},
                                          "other_models": "chars", "cache_dir": null}},
                "outcomes": {"edit_tools": ["Edit", "Write", "MultiEdit", "NotebookEdit"],
                             "path_keys": ["file_path", "notebook_path", "path"],
                             "commit_tools": {"Bash": ["command"]},
                             "commit_command": "(?:^|[;&|(]|\\$\\()[ \\t]*git[ \\t]+(?:-[Cc][ \\t]+\\S+[ \\t]+)*commit\\b",
                             "commit_result": "^\\[(?:[^\\]\\n]* )?([0-9a-f]{7,40})\\]",
                             "trailers_need_result": true,
                             "per_turn": false},
                "git": {"trailer": "Claude-Session", "session_id": "[A-Za-z0-9_][A-Za-z0-9_.-]*", "main_ref": ["main", "origin/main"], "numstat": true},
                "links": {"trailer_in_transcripts": true},
                "package": {"units_snapshot": false},
                "report": {"max_rows": 0, "tables": "economics/report.json"}}
}
