{
  "schema": "loom.extract.defaults/1",
  "description": "Presets, not rules: every value here is a starting point the user overrides in a task file, on the CLI or in <data dir>/extract/presets/defaults.json. 0 means 'no cut'.",
  "language": "pl",
  "workers": "auto",
  "cache": "auto",
  "sniff": {"head_bytes": 65536, "json_whole_limit_bytes": 67108864, "nested_zip_limit_bytes": 0},
  "read": {"keep_raw": false, "streaming_array_min_bytes": 5000000},
  "tokens": {"chars_per_token": {"en": 4.0, "pl": 3.2, "default": 3.6}, "note": "local estimate; the inventory shows the constants"},
  "thinking": {"full_min_chars": 200},
  "language_detection": {"min_chars": 20, "profiles": "langdetect/profiles.json"},
  "grain": "conversation",
  "expand": "conversation",
  "window": {"size": 6, "step": 3},
  "cascade": "default",
  "criteria": null,
  "lexical": {"explain_top_k": 10, "saturation": 6.0, "boundary": true, "fold": true, "inflect": "rules"},
  "vectors": {"threshold": 0.35, "candidates": 0, "engine": "core.selector", "tier": null},
  "similar": {"threshold": 0.5},
  "masks": {"date_tolerance_hours": 14},
  "timeline": {"key": "created", "zone": "source", "assume_zone": "UTC", "ties": ["t", "service", "archive", "locator"],
               "bucket": "week", "gap_days": 30, "burst_ratio": 3.0,
               "continuation": {"enabled": true, "window_minutes": 240, "min_shared_terms": 2, "min_confidence": 0.3}},
  "diff": {"identity": "ext_id", "summary_only": false},
  "merge": {"newest_wins": true},
  "clusters": {"min_conversations": 2, "top_terms": 8, "max_clusters": 0, "min_term_df": 2},
  "decisions": {"learn_min_corrections": 2, "proposals": true},
  "flows": {"model": {"enabled": false, "cheap": "cheap_classify", "strong": "strong_judge",
                       "classes": {"cheap": null, "strong": null}, "route": "provider",
                       "guard": {"ratio": 10.0, "limit_per_run": 0, "limit_per_day": 0}}},
  "write": {"units_snapshot": true, "explain": true, "aggregate": false},
  "report": {"language": "pl", "examples_per_unknown": 1, "max_list": 0}
}
