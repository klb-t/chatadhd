{
 "schema": "loom.extract.edit/1",
 "id": "set",
 "module": "edits:set",
 "group": "values",
 "label": {
  "pl": "Ustaw pole na wartość",
  "en": "Set a field to a value"
 },
 "scope": [
  "conversation",
  "message",
  "block",
  "attachment"
 ],
 "params": {
  "where": {
   "type": "expr",
   "default": "conversation"
  },
  "field": {
   "type": "field",
   "required": true
  },
  "value": {
   "type": "any"
  }
 },
 "invertible": "snapshot",
 "preview_lines": {
  "pl": "{count} × {field}: „{before}” → „{after}”",
  "en": "{count} × {field}: “{before}” → “{after}”"
 }
}
