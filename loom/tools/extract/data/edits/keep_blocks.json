{
 "schema": "loom.extract.edit/1",
 "id": "keep_blocks",
 "module": "edits:keep_blocks",
 "group": "structure",
 "label": {
  "pl": "Zostaw tylko rodzaje bloków",
  "en": "Keep only block kinds"
 },
 "scope": [
  "conversation",
  "message"
 ],
 "params": {
  "where": {
   "type": "expr",
   "default": "conversation"
  },
  "kinds": {
   "type": "list",
   "required": true
  }
 },
 "invertible": "snapshot",
 "preview_lines": {
  "pl": "usunięto {count} bloków spoza listy",
  "en": "{count} block(s) outside the list dropped"
 }
}
