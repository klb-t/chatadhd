{
 "schema": "loom.extract.edit/1",
 "id": "rename_key",
 "module": "edits:rename_key",
 "group": "keys",
 "label": {
  "pl": "Zmień nazwę klucza w polu słownikowym (meta, flags, input, extra, account)",
  "en": "Rename a key inside a dict field (meta, flags, input, extra, account)"
 },
 "scope": [
  "conversation",
  "message",
  "block"
 ],
 "params": {
  "where": {
   "type": "expr",
   "default": "message"
  },
  "in": {
   "type": "string",
   "default": "meta"
  },
  "from": {
   "type": "string",
   "required": true
  },
  "to": {
   "type": "string",
   "required": true
  }
 },
 "invertible": "inverse_rename",
 "preview_lines": {
  "pl": "{count} × klucz {from} → {to}",
  "en": "{count} × key {from} → {to}"
 }
}
