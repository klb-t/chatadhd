{"schema": "loom.extract.redaction/1", "id": "personal",
 "label": {"pl": "Dane osobowe i sekrety: e-maile, telefony, IBAN, PESEL, karty, adresy IP, klucze API, tokeny, klucze prywatne, adresy ulic", "en": "Personal data and secrets: e-mails, phones, IBAN, PESEL, cards, IP addresses, API keys, tokens, private keys, street addresses"},
 "mode": "mask",
 "mask": "[{KIND}#{n}]",
 "rules": [
  {"id": "private_key", "kind": "SECRET", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----"},
  {"id": "api_key_openai", "kind": "SECRET", "regex": "\\bsk-(?:proj-|ant-)?[A-Za-z0-9_-]{16,}"},
  {"id": "api_key_github", "kind": "SECRET", "regex": "\\b(?:ghp|gho|ghu|ghs|ghr|github_pat)_[A-Za-z0-9_]{20,}"},
  {"id": "api_key_aws", "kind": "SECRET", "regex": "\\bAKIA[0-9A-Z]{16}\\b"},
  {"id": "api_key_google", "kind": "SECRET", "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b"},
  {"id": "jwt", "kind": "SECRET", "regex": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"},
  {"id": "bearer", "kind": "SECRET", "regex": "(?i)\\bbearer\\s+([A-Za-z0-9._~+/-]{16,}=*)", "group": 1},
  {"id": "password_assignment", "kind": "SECRET", "regex": "(?i)\\b(?:password|passwd|hasło|haslo|secret|token)[\"']?\\s*[:=]\\s*[\"']?([^\\s\"',;]{6,})", "group": 1},
  {"id": "email", "kind": "EMAIL", "regex": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"},
  {"id": "iban", "kind": "IBAN", "regex": "\\b[A-Z]{2}\\d{2}(?:[ ]?[A-Z0-9]{4}){3,7}(?:[ ]?[A-Z0-9]{1,4})?\\b"},
  {"id": "card", "kind": "CARD", "regex": "\\b\\d(?:[ -]?\\d){12,18}\\b", "check": "luhn"},
  {"id": "pesel", "kind": "PESEL", "regex": "\\b\\d{11}\\b", "check": "pesel"},
  {"id": "phone", "kind": "PHONE", "regex": "(?<![\\w+])\\+\\d{1,3}[ -]?\\d{2,4}(?:[ -]?\\d{2,4}){1,3}\\b|(?<![\\w+-])\\(?\\d{2,3}\\)?[ -]\\d{3}[ -]\\d{2,3}[ -]?\\d{2,3}\\b|(?<![\\w+-])\\d{3}-\\d{3}-\\d{3,4}\\b"},
  {"id": "ipv4", "kind": "IP", "regex": "\\b(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)){3}\\b"},
  {"id": "street_pl", "kind": "ADDRESS", "regex": "\\b(?:ul\\.|ulica|al\\.|aleja|os\\.|pl\\.)\\s+[A-ZŁŚŻŹĆŃÓĘĄ][\\wąćęłńóśźżĄĆĘŁŃÓŚŹŻ.-]*(?:\\s+[A-ZŁŚŻŹĆŃÓĘĄ][\\wąćęłńóśźżĄĆĘŁŃÓŚŹŻ.-]*)*\\s+\\d+[A-Za-z]?(?:/\\d+[A-Za-z]?)?"}
 ],
 "dictionary": [],
 "dictionary_kind": "NAME",
 "fields": ["title", "text", "input", "name", "author", "file_name", "account", "meta", "extra"],
 "attachments": "copy",
 "note": {"pl": "Załączniki binarne nie są redagowane (kopiowane bez zmian, raport to mówi); ustaw attachments: omit, by je pominąć.", "en": "Binary attachments are not redacted (copied unchanged, the report says so); set attachments: omit to leave them out."}}
