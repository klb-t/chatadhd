{
  "schema": "loom.extract.format/1",
  "id": "openai.chatgpt.export",
  "vendor": "openai", "product": "chatgpt", "service": "openai",
  "label": {"pl": "Eksport danych ChatGPT", "en": "ChatGPT data export"},
  "priority": 10,
  "containers": ["zip", "json"],
  "sniff": {"any_of": [
    {"zip_member_json": {"member": "conversations.json", "array_first_keys_all": ["mapping"]}},
    {"zip_member_glob": "conversations-*.json"},
    {"json_object_keys_all": ["mapping", "title"]},
    {"json_array_first_keys_all": ["mapping"]},
    {"json_wrapper_first_keys_all": {"wrapper": "conversations", "keys": ["mapping"]}}
  ]},
  "reader": "chatgpt",
  "shards": "conversations-*.json", "wrappers": ["conversations"],
  "conversation": {"ext_id": ["conversation_id", "id"], "title": "title",
                   "created": {"path": "create_time", "type": "epoch"}, "updated": {"path": "update_time", "type": "epoch"},
                   "tree": "mapping", "current": "current_node", "model": "default_model_slug"},
  "message": {"role": "author.role", "author_name": "author.name", "recipient": "recipient",
              "created": {"path": "create_time", "type": "epoch"}, "content": "content", "model": "metadata.model_slug"},
  "roles": {"user": "user", "assistant": "assistant", "system": "system", "tool": "tool"},
  "blocks": {"text": "text", "multimodal_text": "<parts>", "thoughts": "thinking:summary",
             "reasoning_recap": "thinking:summary", "code": "tool_use", "execution_output": "tool_result",
             "tether_browsing_display": "tool_result", "tether_browsing_code": "tool_use", "tether_quote": "citation",
             "sonic_webpage": "citation", "system_error": "error", "user_editable_context": "context",
             "model_editable_context": "context", "*": "unknown"},
  "parts": {"text": "text", "image_asset_pointer": "attachment", "audio_asset_pointer": "attachment",
            "real_time_user_audio_video_asset_pointer": "attachment", "audio_transcription": "text",
            "search_result_group": "search_result", "*": "unknown"},
  "attachments": {"pointer_prefix": "file-", "pointer_fields": ["asset_pointer", "metadata.attachments[].id"],
                  "layouts": ["{id}-{name}", "{id}", "dalle-generations/{id}-{name}", "user-*/{id}-{name}", "{id}.dat"]},
  "members": {"conversations.json": "conversations", "conversations-*.json": "conversations",
              "user.json": "account", "message_feedback.json": "feedback", "shared_conversations.json": "shared_link",
              "model_comparisons.json": "member", "chat.html": "member", "textdocs/*": "artifact", "*": "unknown"},
  "preserve": {"unit": "conversation_object", "keep_members": ["user.json"], "filter_members": {"message_feedback.json": "conversation_id", "shared_conversations.json": "conversation_id", "textdocs/*": "conversation_id"}, "attachment_root": "."},
  "known_absent": {"pl": ["pełne rozumowanie — tylko streszczenia thoughts/reasoning_recap", "prompt systemowy",
                          "pełne treści przeglądanych stron"],
                   "en": ["full reasoning — only thoughts/reasoning_recap summaries", "system prompt",
                          "full contents of browsed pages"]}
}
