{
  "schema": "loom.extract.format/1",
  "id": "textlike.jsonl",
  "vendor": null, "product": null, "service": "file",
  "label": {"pl": "JSONL z wiadomościami role/content (przez engine.importer)", "en": "JSONL with role/content messages (via engine.importer)"},
  "priority": 700,
  "containers": ["jsonl"],
  "sniff": {"any_of": [{"jsonl_first_keys_any": ["role", "content", "messages"]}]},
  "reader": "textlike", "importer_method": "import_jsonl",
  "roles": {"user": "user", "assistant": "assistant"},
  "blocks": {"text": "text"},
  "members": {"*": "unknown"},
  "preserve": {"unit": "file", "keep_members": [], "attachment_root": "."},
  "known_absent": {"pl": ["identyfikatory i czasy wiadomości (chyba że w wierszu)", "gałęzie", "narzędzia", "rozumowanie"],
                   "en": ["message ids and times (unless on the line)", "branches", "tools", "reasoning"]}
}
