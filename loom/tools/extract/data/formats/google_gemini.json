{
  "schema": "loom.extract.format/1",
  "id": "google.gemini.takeout",
  "vendor": "google", "product": "gemini", "service": "google",
  "label": {"pl": "Google Takeout — Gemini Apps (Moja aktywność)", "en": "Google Takeout — Gemini Apps (My Activity)"},
  "hypothesis": true,
  "hypothesis_note": {"pl": "Kształt z dokumentacji Takeout i narzędzi zewnętrznych; poprawka to edycja tego pliku, nie kodu.",
                      "en": "Shape from Takeout documentation and third-party tools; a correction is an edit of this file, not of code."},
  "priority": 20,
  "containers": ["zip", "json", "html"],
  "sniff": {"any_of": [
    {"zip_member_glob": "Takeout/My Activity/Gemini Apps/MyActivity.*"},
    {"zip_member_glob": "Takeout/Moja aktywność/Gemini Apps/MyActivity.*"},
    {"json_array_first_keys_all": ["header", "title", "time"], "json_array_first_value": {"path": "header", "regex": "^(Gemini|Bard)"}},
    {"html_contains": "Gemini Apps"}
  ]},
  "reader": "gemini",
  "entries": {"list": "<root>", "prompt": "title", "prompt_prefix": ["Prompted ", "Zapytano: ", "Pytanie: "],
              "response_html": "safeHtmlItem[0].html", "response_text": "details", "subtitles": "subtitles",
              "time": {"path": "time", "type": "iso"}, "attachments": "attachments", "products": "products"},
  "grouping": {"by": "gap", "gap_minutes": 180,
               "note": {"pl": "Takeout nie ma identyfikatora rozmowy: wpisy grupowane w rozmowy po przerwie dłuższej niż gap_minutes",
                        "en": "Takeout has no conversation id: entries are grouped into conversations by a pause longer than gap_minutes"}},
  "roles": {"prompt": "user", "response": "assistant"},
  "blocks": {"prompt": "text", "response": "text", "*": "unknown"},
  "members": {"Takeout/My Activity/Gemini Apps/MyActivity.json": "conversations",
              "Takeout/My Activity/Gemini Apps/MyActivity.html": "conversations", "*": "unknown"},
  "preserve": {"unit": "activity_entry", "keep_members": [], "attachment_root": "Takeout/My Activity/Gemini Apps"},
  "known_absent": {"pl": ["identyfikatory rozmów (grupowanie po czasie jest wnioskiem)", "rozumowanie", "gałęzie", "wywołania narzędzi"],
                   "en": ["conversation ids (time grouping is inferred)", "reasoning", "branches", "tool calls"]}
}
