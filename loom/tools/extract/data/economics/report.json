{
 "schema": "loom.extract.economics_report/1",
 "description": "Layout of the token-economics report (Markdown, CSV): which tables, which columns, in which order. Column kinds: text, int (a measured or estimated count; null = unknown with its reason, never 0), share (0..1 shown as %), cost (amount with currency — with its basis when it is not purely measured: estimated, or mixed with both parts — or 'unknown (reason)'), bool, list. A user overlay (<data dir>/extract/economics/report.json) may reorder, drop or add columns of a table; a column the rows do not carry is shown as unknown with the reason, not left out silently. A value known only as a bound (a lower bound: stream-start output, a repository that could not be read) carries its qualifier next to it. CSV: a number column is followed by <col>_why (reason or qualifier code); a cost column is <col>_amount, <col>_currency, <col>_basis, <col>_why.",
 "columns": {
  "label": {"kind": "text", "label": {"pl": "Pozycja", "en": "Item"}},
  "id": {"kind": "text", "label": {"pl": "Id", "en": "Id"}},
  "provider": {"kind": "text", "label": {"pl": "Źródło", "en": "Source"}},
  "format": {"kind": "text", "label": {"pl": "Format", "en": "Format"}},
  "units": {"kind": "int", "label": {"pl": "Rozmowy/sesje", "en": "Conversations/sessions"}},
  "has_usage": {"kind": "bool", "label": {"pl": "Liczniki", "en": "Counters"}},
  "has_tool_traces": {"kind": "bool", "label": {"pl": "Ślady narzędzi", "en": "Tool traces"}},
  "reasoning": {"kind": "text", "label": {"pl": "Rozumowanie", "en": "Reasoning"}},
  "role": {"kind": "text", "label": {"pl": "Rola", "en": "Role"}},
  "session": {"kind": "text", "label": {"pl": "Sesja", "en": "Session"}},
  "workflow_run": {"kind": "text", "label": {"pl": "Przebieg przepływu", "en": "Workflow run"}},
  "agents": {"kind": "int", "label": {"pl": "Agenci", "en": "Agents"}},
  "transcripts": {"kind": "int", "label": {"pl": "Transkrypty", "en": "Transcripts"}},
  "model": {"kind": "text", "label": {"pl": "Model", "en": "Model"}},
  "models": {"kind": "text", "label": {"pl": "Modele (tury)", "en": "Models (turns)"}},
  "period": {"kind": "text", "label": {"pl": "Okres", "en": "Period"}},
  "day": {"kind": "text", "label": {"pl": "Dzień", "en": "Day"}},
  "tool": {"kind": "text", "label": {"pl": "Narzędzie", "en": "Tool"}},
  "calls": {"kind": "int", "label": {"pl": "Wywołania", "en": "Calls"}},
  "failed": {"kind": "int", "label": {"pl": "Błędy", "en": "Errors"}},
  "turns": {"kind": "int", "label": {"pl": "Tury", "en": "Turns"}},
  "turns_measured": {"kind": "int", "label": {"pl": "Tury zmierzone", "en": "Turns measured"}},
  "turns_estimated": {"kind": "int", "label": {"pl": "Tury oszacowane", "en": "Turns estimated"}},
  "input": {"kind": "int", "label": {"pl": "Wejście", "en": "Input"}},
  "output": {"kind": "int", "label": {"pl": "Wyjście", "en": "Output"}},
  "cache_creation": {"kind": "int", "label": {"pl": "Zapis cache", "en": "Cache write"}},
  "cache_read": {"kind": "int", "label": {"pl": "Odczyt cache", "en": "Cache read"}},
  "total": {"kind": "int", "label": {"pl": "Razem zmierzone", "en": "Measured total"}},
  "est_input": {"kind": "int", "label": {"pl": "Wejście (szac.)", "en": "Input (est.)"}},
  "est_output": {"kind": "int", "label": {"pl": "Wyjście (szac.)", "en": "Output (est.)"}},
  "est_context": {"kind": "int", "label": {"pl": "Kontekst wysłany (szac.)", "en": "Context sent (est.)"}},
  "est_total": {"kind": "int", "label": {"pl": "Razem oszacowane", "en": "Estimated total"}},
  "methods": {"kind": "text", "label": {"pl": "Metoda", "en": "Method"}},
  "cache_share": {"kind": "share", "label": {"pl": "Udział odczytu cache", "en": "Cache-read share"}},
