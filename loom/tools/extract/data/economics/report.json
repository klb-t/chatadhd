  "share": {"kind": "share", "label": {"pl": "Udział w zużyciu", "en": "Share of use"}},
  "main_share": {"kind": "share", "label": {"pl": "Pętla główna", "en": "Main loop"}},
  "cost": {"kind": "cost", "label": {"pl": "Koszt wg cen", "en": "Cost by prices"}},
  "price": {"kind": "text", "label": {"pl": "Cena (źródło)", "en": "Price (source)"}},
  "api_input": {"kind": "int", "label": {"pl": "API: wejście", "en": "API: input"}},
  "api_output": {"kind": "int", "label": {"pl": "API: wyjście", "en": "API: output"}},
  "api_cache_creation": {"kind": "int", "label": {"pl": "API: zapis cache", "en": "API: cache write"}},
  "api_cache_read": {"kind": "int", "label": {"pl": "API: odczyt cache", "en": "API: cache read"}},
  "cost_api": {"kind": "cost", "label": {"pl": "Koszt wg API sesji", "en": "Cost per session API"}},
  "coverage": {"kind": "share", "label": {"pl": "Transkrypty / API (odczyt cache)", "en": "Transcripts / API (cache read)"}},
  "coverage_output": {"kind": "share", "label": {"pl": "Transkrypty / API (wyjście)", "en": "Transcripts / API (output)"}},
  "coverage_cache_creation": {"kind": "share", "label": {"pl": "Transkrypty / API (zapis cache)", "en": "Transcripts / API (cache write)"}},
  "output_thinking": {"kind": "int", "label": {"pl": "W tym rozumowanie (wyjście)", "en": "Of which reasoning (output)"}},
  "web_search_requests": {"kind": "int", "label": {"pl": "Wyszukiwania www", "en": "Web searches"}},
  "web_fetch_requests": {"kind": "int", "label": {"pl": "Pobrania www", "en": "Web fetches"}},
  "tr_turns": {"kind": "int", "label": {"pl": "Tury w transkryptach", "en": "Transcript turns"}},
  "tr_input": {"kind": "int", "label": {"pl": "Transkr.: wejście", "en": "Transcr.: input"}},
  "tr_output": {"kind": "int", "label": {"pl": "Transkr.: wyjście", "en": "Transcr.: output"}},
  "tr_cache_creation": {"kind": "int", "label": {"pl": "Transkr.: zapis cache", "en": "Transcr.: cache write"}},
  "tr_cache_read": {"kind": "int", "label": {"pl": "Transkr.: odczyt cache", "en": "Transcr.: cache read"}},
  "tr_cost": {"kind": "cost", "label": {"pl": "Transkr.: koszt wg cen", "en": "Transcr.: cost by prices"}},
  "link": {"kind": "text", "label": {"pl": "Powiązanie", "en": "Link"}},
  "parent": {"kind": "text", "label": {"pl": "Sesja nadrzędna", "en": "Parent session"}},
  "commits": {"kind": "int", "label": {"pl": "Commity", "en": "Commits"}},
  "commits_main": {"kind": "int", "label": {"pl": "Commity na main", "en": "Commits on main"}},
  "lines_added": {"kind": "int", "label": {"pl": "Linie +", "en": "Lines +"}},
  "lines_removed": {"kind": "int", "label": {"pl": "Linie −", "en": "Lines −"}},
  "files_touched": {"kind": "int", "label": {"pl": "Pliki (Edit/Write)", "en": "Files (Edit/Write)"}},
  "edit_calls": {"kind": "int", "label": {"pl": "Edycje", "en": "Edits"}},
  "cost_per_commit": {"kind": "cost", "label": {"pl": "Koszt / commit", "en": "Cost / commit"}},
  "cost_per_commit_main": {"kind": "cost", "label": {"pl": "Koszt / commit na main", "en": "Cost / commit on main"}},
  "cost_measured": {"kind": "cost", "label": {"pl": "Koszt (tokeny zmierzone)", "en": "Cost (measured tokens)"}},
  "cost_estimated": {"kind": "cost", "label": {"pl": "Koszt (tokeny oszacowane)", "en": "Cost (estimated tokens)"}},
  "commits_all": {"kind": "int", "label": {"pl": "Commity (wszystkie, też bez stopki)", "en": "Commits (all, with or without a trailer)"}},
  "commit_commands": {"kind": "int", "label": {"pl": "Polecenia git commit", "en": "git commit commands"}},
  "output_lower_bound": {"kind": "int", "label": {"pl": "W tym wyjście z początku strumienia (dolna granica)", "en": "Of which stream-start output (lower bound)"}},
  "repos": {"kind": "text", "label": {"pl": "Repozytoria", "en": "Repositories"}},
  "repo": {"kind": "text", "label": {"pl": "Repozytorium", "en": "Repository"}},
  "sessions": {"kind": "int", "label": {"pl": "Sesje", "en": "Sessions"}},
  "agent_type": {"kind": "text", "label": {"pl": "Typ agenta", "en": "Agent type"}},
  "file_agents": {"kind": "int", "label": {"pl": "Agenci wg pliku przebiegu", "en": "Agents per the run's file"}},
  "file_total_tokens": {"kind": "int", "label": {"pl": "Tokeny wg pliku przebiegu", "en": "Tokens per the run's file"}},
  "file_tool_calls": {"kind": "int", "label": {"pl": "Wywołania narzędzi wg pliku przebiegu", "en": "Tool calls per the run's file"}},
  "reasoning_blocks": {"kind": "text", "label": {"pl": "Bloki rozumowania (zmierzone)", "en": "Reasoning blocks (measured)"}}
 },
 "tables": [
  {"id": "totals", "rows": "totals", "title": {"pl": "Razem", "en": "Totals"},
   "columns": ["label", "turns_measured", "turns_estimated", "input", "output", "output_lower_bound", "output_thinking", "cache_creation", "cache_read", "total", "cache_share", "cache_hit", "web_search_requests", "web_fetch_requests", "est_total", "cost_measured", "cost_estimated", "cost", "api_cache_read", "api_cache_creation", "api_input", "api_output", "cost_api", "commits", "commits_all", "commits_main", "cost_per_commit"]},
  {"id": "providers", "rows": "providers", "title": {"pl": "Porównanie źródeł (dostawców)", "en": "Sources (providers) compared"},
   "columns": ["provider", "format", "units", "has_usage", "has_tool_traces", "reasoning", "reasoning_blocks", "turns_measured", "turns_estimated", "total", "cache_share", "est_input", "est_output", "est_context", "methods", "cost_measured", "cost_estimated", "cost"]},
  {"id": "sessions_api", "rows": "sessions", "title": {"pl": "Sesje — liczniki API sesji i wyniki", "en": "Sessions — session API counters and outcomes"},
   "columns": ["label", "period", "model", "parent", "repos", "api_cache_read", "api_cache_creation", "api_input", "api_output", "cost_api", "commits", "commits_main", "lines_added", "lines_removed", "cost_per_commit", "cost_per_commit_main"]},
  {"id": "sessions_transcripts", "rows": "sessions", "title": {"pl": "Sesje — transkrypty (per tura)", "en": "Sessions — transcripts (per turn)"},
   "columns": ["label", "link", "transcripts", "agents", "tr_turns", "tr_cache_read", "tr_cache_creation", "tr_input", "tr_output", "main_share", "coverage", "coverage_cache_creation", "coverage_output", "files_touched", "edit_calls", "commit_commands", "tr_cost"]},
  {"id": "repos", "rows": "repos", "title": {"pl": "Repozytoria (z listy sesji) — koszt wg API sesji i commity", "en": "Repositories (from the session list) — session-API cost and commits"},
   "columns": ["repo", "sessions", "api_cache_read", "api_cache_creation", "api_input", "api_output", "cost_api", "commits", "commits_main", "cost_per_commit"]},
  {"id": "runs", "rows": "runs", "title": {"pl": "Przebiegi (transkrypt główny, podagenci, agenci przepływów)", "en": "Runs (main transcript, subagents, workflow agents)"},
   "columns": ["label", "session", "role", "agent_type", "workflow_run", "models", "turns", "cache_read", "cache_creation", "input", "output", "share", "files_touched", "edit_calls", "cost"]},
  {"id": "workflow_runs", "rows": "workflow_runs", "title": {"pl": "Przebiegi przepływów", "en": "Workflow runs"},
   "columns": ["label", "session", "agents", "file_agents", "turns", "cache_read", "cache_creation", "input", "output", "file_total_tokens", "share", "cost"]},
  {"id": "models", "rows": "models", "title": {"pl": "Modele", "en": "Models"},
   "columns": ["model", "turns_measured", "turns_estimated", "input", "output", "output_thinking", "cache_creation", "cache_read", "est_input", "est_output", "est_context", "share", "price", "cost_measured", "cost_estimated", "cost"]},
  {"id": "tools", "rows": "tools", "title": {"pl": "Narzędzia (tokeny tury dzielone po równo między jej wywołania)", "en": "Tools (a turn's tokens split equally between its calls)"},
   "columns": ["tool", "calls", "failed", "turns", "turns_measured", "turns_estimated", "input", "output", "cache_creation", "cache_read", "share", "cost_measured", "cost_estimated", "cost"]},
  {"id": "days", "rows": "days", "title": {"pl": "Dni", "en": "Days"},
   "columns": ["day", "turns_measured", "turns_estimated", "input", "output", "cache_creation", "cache_read", "est_total", "cost_measured", "cost_estimated", "cost", "commits", "commits_all"]}
 ]
}
