{"schema": "loom.extract.cascade/1", "id": "lexical_only",
 "label": {"pl": "Tylko maski i kanał leksykalny", "en": "Masks and the lexical channel only"},
 "levels": [
   {"id": "L0", "flow": "masks",   "on": "all",    "decides": ["exclude"]},
