{"schema": "loom.extract.profile/1", "id": "reasoning", "kind": "restructure",
 "label": {"pl": "Rozumowanie i narzędzia: wyłącznie bloki rozumowania i ślady narzędzi (wywołanie + wynik) z odwołaniem do wiadomości", "en": "Reasoning and tools: only reasoning blocks and tool traces (call + result) with a reference to the message"},
 "layout": "conversation>message>block",
 "branches": {"keep": "tree"},
 "fields": {"conversation": ["key", "uid", "title", "service", "created"], "message": ["conversation", "id", "parent", "role", "created", "model", "blocks"]},
 "blocks": {"thinking": "keep", "tool_use": "keep", "tool_result": "keep", "execution_output": "keep", "code": "keep", "*": "omit"},
 "drop_empty_messages": true,
 "timestamps": {"zone": "source", "format": "iso8601"},
 "outputs": [{"kind": "jsonl", "path": "reasoning/blocks.jsonl", "rows": "blocks"},
             {"kind": "markdown", "path": "reasoning/{conversation.key}.md"}],
 "sort": "package"}
