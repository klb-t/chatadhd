{
 "schema": "loom.extract.api/1",
 "description": "Calls of the one dispatcher every face uses (commander, serve, CLI 'api'): label, long (may run as a background job with progress), mutates (changes the state; caches refresh, the commander autosaves), during_job (answered while a background job runs; every other call answers 'busy'), params (documentation of the request fields). Engine operations themselves are in ops.json and reachable through 'op', 'apply' and 'select'.",
 "calls": {
  "calls": {
   "label": {
    "pl": "Rejestr wywołań API",
    "en": "API call registry"
   },
   "long": false,
   "mutates": false,
   "during_job": true,
   "params": {}
  },
  "ops": {
   "label": {
    "pl": "Rejestr operacji silnika (ops.json)",
    "en": "Engine operation registry (ops.json)"
   },
   "long": false,
   "mutates": false,
   "during_job": true,
   "params": {}
  },
  "open": {
   "label": {
    "pl": "Otwórz źródła, przepis albo pakiet",
    "en": "Open sources, a recipe or a package"
   },
   "long": true,
   "mutates": true,
   "during_job": false,
   "params": {
    "sources": "list",
    "recipe": "object|path",
    "package": "path",
    "write": "path"
   }
  },
