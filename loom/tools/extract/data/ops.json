{
  "schema": "loom.extract.ops/1",
  "description": "Registry of engine operations. Every face (CLI, commander, API) calls these and nothing else; every executed operation with records=true becomes a recipe step. Param types: string, number, bool, list, object, expr (selection language), path, id, enum (values), mode (replace|add|subtract|intersect). A param with a preset is filled in at normalisation and its origin recorded.",
  "modes": ["replace", "add", "subtract", "intersect"],
  "ops": {
    "scan":            {"label": {"pl": "Przeskanuj źródła", "en": "Scan sources"}, "params": {"nested_limit": {"type": "number", "preset": "sniff.nested_zip_limit_bytes"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "read":            {"label": {"pl": "Wczytaj jednostki", "en": "Read units"}, "params": {"keep_raw": {"type": "bool", "preset": "read.keep_raw"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "merge":           {"label": {"pl": "Scal duplikaty i wersje", "en": "Merge duplicates and versions"}, "params": {"newest_wins": {"type": "bool", "preset": "merge.newest_wins"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "inventory":       {"label": {"pl": "Inwentarz", "en": "Inventory"}, "params": {"aggregate": {"type": "bool", "preset": "write.aggregate"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "timeline":        {"label": {"pl": "Oś czasu globalna", "en": "Global timeline"},
                        "params": {"key": {"type": "string", "preset": "timeline.key"}, "zone": {"type": "string", "preset": "timeline.zone"},
                                   "bucket": {"type": "string", "preset": "timeline.bucket"}, "gap_days": {"type": "number", "preset": "timeline.gap_days"},
                                   "burst_ratio": {"type": "number", "preset": "timeline.burst_ratio"}, "from": {"type": "string"}, "to": {"type": "string"},
                                   "shift": {"type": "string"}, "anonymise": {"type": "bool", "default": false}, "granularity": {"type": "string"},
                                   "continuations": {"type": "bool", "preset": "timeline.continuation.enabled"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "diff":            {"label": {"pl": "Różnica względem poprzedniego eksportu", "en": "Diff against a previous export"},
                        "params": {"against": {"type": "list", "required": true}, "identity": {"type": "enum", "values": ["ext_id", "content_hash"], "preset": "diff.identity"},
                                   "summary_only": {"type": "bool", "preset": "diff.summary_only"}, "mode": {"type": "enum", "values": ["only_new", "changed", "removed", "all", "unchanged", "none"], "default": "none"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.criteria": {"label": {"pl": "Zaznacz kryteriami (kaskada)", "en": "Select by criteria (cascade)"},
                        "params": {"criteria": {"type": "object"}, "terms": {"type": "list"}, "regex": {"type": "list"},
                                   "cascade": {"type": "string", "preset": "cascade"}, "grain": {"type": "string", "preset": "grain"},
                                   "mode": {"type": "mode", "default": "add"}, "model": {"type": "bool", "preset": "flows.model.enabled"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.expr":     {"label": {"pl": "Zaznacz wyrażeniem", "en": "Select by expression"},
                        "params": {"expr": {"type": "expr", "required": true}, "kind": {"type": "enum", "values": ["conversation", "message", "block", "attachment"], "default": "conversation"},
                                   "mode": {"type": "mode", "default": "add"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.structural": {"label": {"pl": "Zaznacz wzorcem strukturalnym", "en": "Select by structural pattern"},
                        "params": {"pattern": {"type": "string", "required": true}, "kind": {"type": "enum", "values": ["conversation", "message"], "default": "conversation"},
                                   "mode": {"type": "mode", "default": "add"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.similar":  {"label": {"pl": "Więcej takich (podobieństwo)", "en": "More like this (similarity)"},
                        "params": {"to": {"type": "list", "required": true}, "threshold": {"type": "number", "preset": "similar.threshold"},
                                   "candidates": {"type": "number", "preset": "vectors.candidates"}, "mode": {"type": "mode", "default": "add"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.diff":     {"label": {"pl": "Zaznacz z różnicy (nowe od ostatniego eksportu)", "en": "Select from the diff (new since last export)"},
                        "params": {"mode": {"type": "enum", "values": ["only_new", "changed", "removed", "all", "unchanged"], "default": "only_new"},
                                   "combine": {"type": "mode", "default": "intersect"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.cluster":  {"label": {"pl": "Zaznacz klaster tematu", "en": "Select a topic cluster"},
                        "params": {"cluster": {"type": "string", "required": true}, "mode": {"type": "mode", "default": "add"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.manual":   {"label": {"pl": "Zastosuj decyzje ręczne", "en": "Apply manual decisions"},
                        "params": {"decisions": {"type": "path"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.clear":    {"label": {"pl": "Wyczyść zaznaczenie", "en": "Clear the selection"}, "params": {},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.invert":   {"label": {"pl": "Odwróć zaznaczenie", "en": "Invert the selection"}, "params": {},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "expand":          {"label": {"pl": "Rozszerz o sąsiedztwo", "en": "Expand to the neighbourhood"},
                        "params": {"preset": {"type": "string", "preset": "expand"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "clusters":        {"label": {"pl": "Odkryj klastry tematów", "en": "Discover topic clusters"},
                        "params": {"min_conversations": {"type": "number", "preset": "clusters.min_conversations"}, "top_terms": {"type": "number", "preset": "clusters.top_terms"},
                                   "max_clusters": {"type": "number", "preset": "clusters.max_clusters"}, "min_similarity": {"type": "number", "preset": "clusters.min_similarity"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "mark":            {"label": {"pl": "Zaznacz ręcznie (decyzja)", "en": "Mark manually (decision)"},
                        "params": {"unit": {"type": "id", "required": true}, "decision": {"type": "enum", "values": ["include", "exclude", "ambiguous", "remove"], "required": true},
                                   "reason": {"type": "string", "default": ""}, "grain": {"type": "string", "default": "conversation"}, "message": {"type": "id"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "propose":         {"label": {"pl": "Propozycje z poprawek", "en": "Proposals from corrections"},
                        "params": {"min_corrections": {"type": "number", "preset": "decisions.learn_min_corrections"}},
                        "records": false, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "explain":         {"label": {"pl": "Wyjaśnij decyzję", "en": "Explain a decision"},
                        "params": {"unit": {"type": "id", "required": true}},
                        "records": false, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "dry_run":         {"label": {"pl": "Na sucho: co weszłoby do pakietu", "en": "Dry run: what would go into the package"}, "params": {},
                        "records": false, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "write":           {"label": {"pl": "Zapisz pakiet (inwentarz, oś, różnica, zaznaczenie, manifest, raport)", "en": "Write the package (inventory, timeline, diff, selection, manifest, report)"},
                        "params": {"package": {"type": "path", "required": true}, "units_snapshot": {"type": "bool", "preset": "write.units_snapshot"},
                                   "explain": {"type": "bool", "preset": "write.explain"}, "aggregate": {"type": "bool", "preset": "write.aggregate"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "report":          {"label": {"pl": "Raport po polsku", "en": "Report"}, "params": {},
                        "records": false, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "user.call":       {"label": {"pl": "Funkcja użytkownika z nakładki", "en": "User function from the overlay"},
                        "params": {"module": {"type": "string", "required": true}, "function": {"type": "string", "required": true}, "args": {"type": "object"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"], "explicit": true}
  }
}
