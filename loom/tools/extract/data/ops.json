{
  "schema": "loom.extract.ops/1",
  "description": "Registry of engine operations. Every face (CLI, commander, API) calls these and nothing else; every executed operation with records=true becomes a recipe step. Param types: string, number, bool, list, object, expr (selection language), path (a filesystem path, resolved against the recipe directory), paths (a list of filesystem paths, each resolved the same way), field (a field name such as title or meta.x — never a filesystem path); secret=true marks a value a redacted package never carries in clear (a sha256 reference, resolved from the local store at run time), id, enum (values), mode (replace|add|subtract|intersect). A param with a preset is filled in at normalisation and its origin recorded.",
  "modes": ["replace", "add", "subtract", "intersect"],
  "ops": {
    "scan":            {"label": {"pl": "Przeskanuj źródła", "en": "Scan sources"}, "params": {"nested_limit": {"type": "number", "preset": "sniff.nested_zip_limit_bytes"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "read":            {"label": {"pl": "Wczytaj jednostki", "en": "Read units"}, "params": {"keep_raw": {"type": "bool", "preset": "read.keep_raw"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "merge":           {"label": {"pl": "Scal duplikaty i wersje", "en": "Merge duplicates and versions"}, "params": {"newest_wins": {"type": "bool", "preset": "merge.newest_wins"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "inventory":       {"label": {"pl": "Inwentarz", "en": "Inventory"}, "params": {"aggregate": {"type": "bool", "preset": "write.aggregate"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "timeline":        {"label": {"pl": "Oś czasu globalna", "en": "Global timeline"},
                        "params": {"key": {"type": "string", "preset": "timeline.key"}, "zone": {"type": "string", "preset": "timeline.zone"},
                                   "bucket": {"type": "string", "preset": "timeline.bucket"}, "gap_days": {"type": "number", "preset": "timeline.gap_days"},
                                   "burst_ratio": {"type": "number", "preset": "timeline.burst_ratio"}, "from": {"type": "string"}, "to": {"type": "string"},
                                   "shift": {"type": "string"}, "anonymise": {"type": "bool", "default": false}, "granularity": {"type": "string"},
                                   "continuations": {"type": "bool", "preset": "timeline.continuation.enabled"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "diff":            {"label": {"pl": "Różnica względem poprzedniego eksportu", "en": "Diff against a previous export"},
                        "params": {"against": {"type": "list", "required": true}, "identity": {"type": "enum", "values": ["ext_id", "content_hash"], "preset": "diff.identity"},
                                   "summary_only": {"type": "bool", "preset": "diff.summary_only"}, "mode": {"type": "enum", "values": ["only_new", "changed", "removed", "all", "unchanged", "none"], "default": "none"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.criteria": {"label": {"pl": "Zaznacz kryteriami (kaskada)", "en": "Select by criteria (cascade)"},
                        "params": {"criteria": {"type": "object"}, "terms": {"type": "list"}, "regex": {"type": "list"},
                                   "cascade": {"type": "string", "preset": "cascade"}, "grain": {"type": "string", "preset": "grain"},
                                   "mode": {"type": "mode", "default": "add"}, "model": {"type": "bool", "preset": "flows.model.enabled"}, "model_count": {"type": "bool", "default": false}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.expr":     {"label": {"pl": "Zaznacz wyrażeniem", "en": "Select by expression"},
                        "params": {"expr": {"type": "expr", "required": true}, "kind": {"type": "enum", "values": ["conversation", "message", "block", "attachment"], "default": "conversation"},
                                   "mode": {"type": "mode", "default": "add"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.encoded": {"label": {"pl": "Zaznacz rozmowy z zakodowanymi danymi", "en": "Select conversations with encoded data"},
      "params": {"kinds": {"type": "strings"}, "mode": {"type": "mode", "default": "add"}, "messages_only": {"type": "bool", "default": false},
                 "min_base64": {"type": "int"}, "min_hex": {"type": "int"}, "min_escapes": {"type": "int"}, "min_percent": {"type": "int"}},
      "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.structural": {"label": {"pl": "Zaznacz wzorcem strukturalnym", "en": "Select by structural pattern"},
                        "params": {"pattern": {"type": "string", "required": true}, "kind": {"type": "enum", "values": ["conversation", "message"], "default": "conversation"},
                                   "mode": {"type": "mode", "default": "add"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.similar":  {"label": {"pl": "Więcej takich (podobieństwo)", "en": "More like this (similarity)"},
                        "params": {"to": {"type": "list", "required": true}, "threshold": {"type": "number", "preset": "similar.threshold"},
                                   "candidates": {"type": "number", "preset": "vectors.candidates"}, "mode": {"type": "mode", "default": "add"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.diff":     {"label": {"pl": "Zaznacz z różnicy (nowe od ostatniego eksportu)", "en": "Select from the diff (new since last export)"},
                        "params": {"mode": {"type": "enum", "values": ["only_new", "changed", "removed", "all", "unchanged"], "default": "only_new"},
                                   "combine": {"type": "mode", "default": "intersect"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.cluster":  {"label": {"pl": "Zaznacz klaster tematu", "en": "Select a topic cluster"},
                        "params": {"cluster": {"type": "string", "required": true}, "mode": {"type": "mode", "default": "add"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.manual":   {"label": {"pl": "Zastosuj decyzje ręczne", "en": "Apply manual decisions"},
                        "params": {"decisions": {"type": "path"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.clear":    {"label": {"pl": "Wyczyść zaznaczenie", "en": "Clear the selection"}, "params": {},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "select.invert":   {"label": {"pl": "Odwróć zaznaczenie", "en": "Invert the selection"}, "params": {},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "expand":          {"label": {"pl": "Rozszerz o sąsiedztwo", "en": "Expand to the neighbourhood"},
                        "params": {"preset": {"type": "string", "preset": "expand"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "clusters":        {"label": {"pl": "Odkryj klastry tematów", "en": "Discover topic clusters"},
                        "params": {"min_conversations": {"type": "number", "preset": "clusters.min_conversations"}, "top_terms": {"type": "number", "preset": "clusters.top_terms"},
                                   "max_clusters": {"type": "number", "preset": "clusters.max_clusters"}, "min_similarity": {"type": "number", "preset": "clusters.min_similarity"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "mark":            {"label": {"pl": "Zaznacz ręcznie (decyzja)", "en": "Mark manually (decision)"},
                        "params": {"unit": {"type": "id", "required": true}, "decision": {"type": "enum", "values": ["include", "exclude", "ambiguous", "remove"], "required": true},
                                   "reason": {"type": "string", "default": ""}, "grain": {"type": "string", "default": "conversation"}, "message": {"type": "id"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "propose":         {"label": {"pl": "Propozycje z poprawek", "en": "Proposals from corrections"},
                        "params": {"min_corrections": {"type": "number", "preset": "decisions.learn_min_corrections"}},
                        "records": false, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "explain":         {"label": {"pl": "Wyjaśnij decyzję", "en": "Explain a decision"},
                        "params": {"unit": {"type": "id", "required": true}},
                        "records": false, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "dry_run":         {"label": {"pl": "Na sucho: co weszłoby do pakietu", "en": "Dry run: what would go into the package"}, "params": {},
                        "records": false, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "write":           {"label": {"pl": "Zapisz pakiet (inwentarz, oś, różnica, zaznaczenie, manifest, raport)", "en": "Write the package (inventory, timeline, diff, selection, manifest, report)"},
                        "params": {"package": {"type": "path", "required": true}, "units_snapshot": {"type": "bool", "preset": "write.units_snapshot"},
                                   "explain": {"type": "bool", "preset": "write.explain"}, "aggregate": {"type": "bool", "preset": "write.aggregate"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "report":          {"label": {"pl": "Raport po polsku", "en": "Report"}, "params": {},
                        "records": false, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "user.call":       {"label": {"pl": "Funkcja użytkownika z nakładki", "en": "User function from the overlay"},
                        "params": {"module": {"type": "string", "required": true}, "function": {"type": "string", "required": true}, "args": {"type": "object"}},
                        "records": true, "long": true, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"], "explicit": true},
    "package.copy":   {"label": {"pl": "Kopiuj do pakietu: zaznaczenie albo wskazane węzły (F5)", "en": "Copy into the package: the selection or given nodes (F5)"},
                        "params": {"from": {"type": "enum", "values": ["selection", "all"], "default": "selection"}, "into": {"type": "string", "default": "/"},
                                   "items": {"type": "list", "help": "node ids (uid, uid|bN branch, uid#message, uid#message/block, uid@attachment) instead of 'from'"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "package.move":   {"label": {"pl": "Przenieś w pakiecie (F6)", "en": "Move within the package (F6)"},
                        "params": {"items": {"type": "list"}, "where": {"type": "expr"}, "into": {"type": "string", "required": true}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "package.mkdir":  {"label": {"pl": "Nowa grupa/katalog w pakiecie (F7)", "en": "New group/folder in the package (F7)"},
                        "params": {"path": {"type": "string", "required": true}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "package.remove": {"label": {"pl": "Usuń z pakietu (F8)", "en": "Remove from the package (F8)"},
                        "params": {"items": {"type": "list"}, "where": {"type": "expr"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "package.rename": {"label": {"pl": "Zmień nazwę rozmowy w pakiecie", "en": "Rename a conversation in the package"},
                        "params": {"item": {"type": "string", "required": true}, "title": {"type": "string", "required": true}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "package.mark":   {"label": {"pl": "Oznacz liść gałęzi do zachowania (branches.keep: marked)", "en": "Mark the branch leaf to keep (branches.keep: marked)"},
                        "params": {"item": {"type": "string", "required": true}, "leaf": {"type": "string", "required": true}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "package.show":   {"label": {"pl": "Pokaż drzewo pakietu", "en": "Show the package tree"},
                        "params": {"order": {"type": "string", "preset": "cut.order"}},
                        "records": false, "long": false, "needs_model": false, "mutates_package": false, "faces": ["cli", "tui", "api"]},
    "edit.add_field": {"label": {"pl": "Dodaj pole ze stałą albo z wyrażeniem ({pole} …)", "en": "Add a field with a constant or an expression ({field} …)"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "field": {"type": "field", "required": true}, "value": {"type": "any"}, "expression": {"type": "string", "help": "template of the item's fields, e.g. {title} ({account.label})"}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.anonymise_time": {"label": {"pl": "Oś względna: najwcześniejszy czas = 1970-01-01, odstępy zachowane", "en": "Relative axis: the earliest time = 1970-01-01, intervals kept"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "origin": {"type": "enum", "values": ["package", "conversation"], "default": "package"}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.delete_field": {"label": {"pl": "Usuń pole", "en": "Delete a field"},
                        "params": {"where": {"type": "expr", "default": "message"}, "field": {"type": "field", "required": true}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.drop_blocks": {"label": {"pl": "Usuń rodzaje bloków (np. bez thinking)", "en": "Drop block kinds (e.g. no thinking)"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "kinds": {"type": "list", "required": true}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.flatten":   {"label": {"pl": "Spłaszcz drzewo do listy po ścieżce (current, newest, longest, marked; all_paths = osobna rozmowa na każdą ścieżkę)", "en": "Flatten the tree to a list along a path (current, newest, longest, marked; all_paths = one conversation per path)"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "path": {"type": "enum", "values": ["current", "newest", "longest", "marked", "all_paths"], "default": "current"}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.keep_blocks": {"label": {"pl": "Zostaw tylko rodzaje bloków", "en": "Keep only block kinds"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "kinds": {"type": "list", "required": true}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.map_table": {"label": {"pl": "Mapuj wartości tabelą (np. nazwy modeli, narzędzi)", "en": "Map values through a table (e.g. model or tool names)"},
                        "params": {"where": {"type": "expr", "default": "message"}, "field": {"type": "field", "required": true}, "table": {"type": "object", "required": true}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.merge_conversations": {"label": {"pl": "Scal rozmowy (np. kontynuacja ChatGPT→Claude) z zachowaniem źródła każdej wiadomości", "en": "Merge conversations (e.g. a ChatGPT→Claude continuation) keeping each message's source"},
                        "params": {"where": {"type": "expr", "required": true}, "title": {"type": "string"}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.nest":      {"label": {"pl": "Zagnieźdź listę w drzewo: po polu rodzica, co N wiadomości albo po dacie (rozmowy z rozwidleniami: odmowa, pominięcie albo świadome zastąpienie)", "en": "Nest a list into a tree: by a parent field, every N messages or by date (conversations with forks: refuse, skip or replace on purpose)"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "by": {"type": "enum", "values": ["parent", "every_n", "date"], "default": "parent"}, "field": {"type": "field", "default": "meta.parent"}, "n": {"type": "number", "default": 0}, "bucket": {"type": "enum", "values": ["day", "week", "month"], "default": "day"}, "on_forks": {"type": "enum", "values": ["refuse", "skip", "replace"], "default": "refuse"}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.redact":    {"label": {"pl": "Redakcja (maski i słownik) jako edycja — nieodwracalna, z raportem", "en": "Redaction (masks and dictionary) as an edit — irreversible, with a report"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "profile": {"type": "string", "default": "personal"}, "terms": {"type": "list", "default": [], "secret": true}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.relabel_roles": {"label": {"pl": "Mapa ról (np. tool → assistant, human → user)", "en": "Role map (e.g. tool → assistant, human → user)"},
                        "params": {"where": {"type": "expr", "default": "message"}, "map": {"type": "object", "required": true}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.rename_key": {"label": {"pl": "Zmień nazwę klucza w polu słownikowym (meta, flags, input, extra, account) albo — z in: \"\" — nazwę pola w wyjściach (np. text → content)", "en": "Rename a key inside a dict field (meta, flags, input, extra, account) or — with in: \"\" — a field's name in the outputs (e.g. text → content)"},
                        "params": {"where": {"type": "expr", "default": "message"}, "in": {"type": "string", "default": "meta", "help": "\"\" = the output name of a model field (alias applied by every renderer)"}, "from": {"type": "string", "required": true}, "to": {"type": "string", "required": true}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.replace_regex": {"label": {"pl": "Zamień regexem w polu", "en": "Regex replace in a field"},
                        "params": {"where": {"type": "expr", "default": "message"}, "field": {"type": "field", "default": "text"}, "pattern": {"type": "string", "required": true}, "replacement": {"type": "string", "default": ""}, "flags": {"type": "string", "default": ""}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.set":       {"label": {"pl": "Ustaw pole na wartość", "en": "Set a field to a value"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "field": {"type": "field", "required": true}, "value": {"type": "any"}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.shift_time": {"label": {"pl": "Przesuń czasy o stałą (np. -3d, 12h)", "en": "Shift times by a constant (e.g. -3d, 12h)"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "by": {"type": "string", "required": true}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.sort":      {"label": {"pl": "Uporządkuj po kluczu czasu (remisy stabilne)", "en": "Order by a time key (stable ties)"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "by": {"type": "enum", "values": ["created", "updated", "title", "first_message", "last_message"], "default": "created"}, "level": {"type": "enum", "values": ["conversations", "messages"], "default": "conversations"}, "reverse": {"type": "bool", "default": false}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.split_at_date": {"label": {"pl": "Podziel rozmowę datą (lub listą dat) na kilka", "en": "Split a conversation at a date (or a list of dates)"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "at": {"type": "any", "required": true}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.move_attachments": {"label": {"pl": "Przenieś załączniki do innego układu katalogów (odwołania w wyjściach idą za nimi)", "en": "Move attachments to another directory layout (references in outputs follow)"},
                        "params": {"where": {"type": "expr", "default": "conversation"}, "to": {"type": "string", "default": "{key}"}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "edit.user":     {"label": {"pl": "Edycja użytkownika (moduł z nakładki, wpis w edits/)", "en": "User edit (overlay module, entry in edits/)"},
                        "params": {"edit": {"type": "string", "required": true}, "where": {"type": "expr"}, "params": {"type": "object"}, "preview": {"type": "bool"}},
                        "records": true, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"], "explicit": true},
    "undo":           {"label": {"pl": "Cofnij ostatnią edycję (Ctrl-Z)", "en": "Undo the last edit (Ctrl-Z)"},
                        "params": {"steps": {"type": "number", "default": 1}},
                        "records": false, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "redo":           {"label": {"pl": "Ponów cofniętą edycję (Ctrl-Y)", "en": "Redo an undone edit (Ctrl-Y)"},
                        "params": {"steps": {"type": "number", "default": 1}},
                        "records": false, "long": false, "needs_model": false, "mutates_package": true, "faces": ["cli", "tui", "api"]},
    "cut":            {"label": {"pl": "Wytnij: format źródłowy 1:1 i profile przebudowy (do strefy roboczej; zapis robi write)", "en": "Cut: source format 1:1 and restructuring profiles (to the staging area; write saves them)"},
