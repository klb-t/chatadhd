<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Chat, model list, semantic LLM analysis, GitHub sync: all HTTP goes
         through LoomHttp.kt (see loom/android/README.md). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Where the data directory lives is a SETTING (see StorageActivity and
         loom/android/README.md "Data directory"). New installs use the app's
         private storage, which needs none of the permissions below. They are
         declared for the shared option (/storage/emulated/0/Documents/ChatADHD:
         survives uninstall, other apps can sync it, but every app with the same
         access can read it) that existing installs keep and users may still
         choose. That needs the legacy permissions below API 30 and All Files
         Access from API 30 on; MainActivity asks for it only when the chosen
         location needs it. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Voice input attachments (media_providers.h ASR) read local audio
         files the user picked; no microphone capture is wired into this
         shell yet (see loom/android/README.md "Gaps"). -->

    <!-- usesCleartextTraffic is true only so a LAN server can be used when the
         user explicitly allows plain HTTP in the connection screen;
         ConnectionPolicy rejects http:// otherwise (and for non-LAN hosts). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.ChatADHD"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".ConnectionActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatADHD" />

        <activity
            android:name=".StorageActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatADHD" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ChatADHD">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
