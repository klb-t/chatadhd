        ]
      }
    },
    "value_schema": {
      "type": "object",
      "required": [
        "settings",
        "privacy"
      ],
      "properties": {
        "settings": {
          "type": "object",
          "required": [
            "preference_mode"
          ],
          "properties": {
            "preference_mode": {
              "type": "string",
              "enum": [
                "ask",
                "candidate",
                "automatic"
              ],
              "x-setting": "/settings/preference_mode"
            }
          },
          "additionalProperties": true
        },
        "privacy": {
          "type": "object",
          "required": [
            "rules"
          ],
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              },
              "x-setting": "/privacy/rules"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
