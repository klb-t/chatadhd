  R"LPROFILE(ction_result_target"],"turn":["default_model","temperature","max_tokens","system_prompt","stream","graph_memory_depth","chat_flow","chat_reasoning","chat_context_order","intent_routing_method","tool_loop_policy","tool_loop_max_steps","tool_loop_result_max_chars","tool_loop_on_proposal","memory_folder_file_chars","memory_folder_max_files","memory_folder_include_hidden"],"installation":["default_model","guardian_model","chat_representation","chat_thread_filter","guardian_person_rules","chat_flow","extrapolation_preset","extrapolation_bounds","action_result_target","intent_routing_method","tool_loop_policy","tool_loop_max_steps","tool_loop_result_max_chars","tool_loop_on_proposal","worker/batch_threshold","worker/analysis_modes","graph_memory/default_depth","graph_memory/default_max_nodes","chat_context/context_order"]},"fields":[{"key":"base_url","scope":"config","group":"chat","type":"string","has_default":true,"description":"Base URL of the OpenAI-compatible chat API (OpenRouter by default).","human":{"label":{"pl":"Adres usługi modeli","en":"Model service address"},"why":{"pl":"Dokąd aplikacja wysyła rozmowy; domyślnie OpenRouter, który daje dostęp do wielu modeli jednym kluczem.","en":"Where the app sends conversations; OpenRouter by default, which reaches many models with one key."},"effect":{"pl":"Zmiana adresu kieruje wszystkie wywołania modeli (czat, analiza, osadzenia) do innej usługi zgodnej z OpenAI.","en":"Changing the address sends every model call (chat, analysis, embeddings) to another OpenAI-compatible service."},"levels":["person"],"group":"modele","subgroup":"dostawca","flows":["chat.send","semantic.analyse","semantic.batch","agent.run","use_model","embedding.embed","batch.chat","knowledge.propose_semantics","analysis.run"]}},{"key":"default_model","scope":"config","group":"chat","type":"string","has_default":true,"description":"Model used for chat when a request names none.","human":{"label":{"pl":"Model rozmowy","en":"Conversation model"},"why":{"pl":"Który model odpowiada w czacie, gdy rozmowa ani wiadomość nie wskazują innego.","en":"Which model answers in the chat when neither the conversation nor the message names another."},"effect":{"pl":"Nowe odpowiedzi przychodzą z wybranego modelu; trwające się nie zmieniają. Rozmowa lub projekt mogą mieć własny model.","en":"New replies come from the chosen model; replies in progress do not change. A conversation or project may have its own model."},"levels":["installation","person","project","conversation","turn"],"group":"rozmowa","role":"chat.default","flows":["chat.send","actions.run","agent.run","actions.preview","use_model","archive.refine","input.route_intent","summarise","translate","elaborate","parody","critique","combine","rephrase","explain_simply","depict","narrate","ports.show","roles.resolved"]}},{"key":"llm_provider","scope":"config","group":"chat","type":"string","has_default":false,"description":"Which model provider answers the chat and the other model calls: openrouter (preset), local (an OpenAI-compatible server on this device, such as llama.cpp or Ollama, at local_model_base_url), or the id of any provider manifest you added. Default: openrouter.","human":{"label":{"pl":"Dostawca modeli","en":"Model provider"},"why":{"pl":"Czy modele obsługuje OpenRouter (preset), serwer na tym urządzeniu (np. llama.cpp, Ollama), czy dostawca, którego sam dodałeś.","en":"Whether OpenRouter (preset), a server on this device (llama.cpp, Ollama) or a provider you added serves the models."},"effect":{"pl":"Wszystkie wywołania modeli idą do wskazanego dostawcy; przy dostawcy lokalnym adres bierze się z pola „Adres lokalnego serwera modeli”.","en":"Every model call goes to the named provider; with the local provider the address comes from the field “Local model server address”."},"levels":["person"],"group":"modele","subgroup":"dostawca","flows":["use_model","chat.send"],"when_unset":{"pl":"OpenRouter","en":"OpenRouter"}}},{"key":"local_model_base_url","scope":"config)LPROFILE",
  R"LPROFILE(","group":"chat","type":"string","has_default":false,"description":"Address of the model server on this device for llm_provider = local: an OpenAI-compatible API, such as http://127.0.0.1:8080/v1 for llama.cpp or http://127.0.0.1:11434/v1 for Ollama. No key is sent. Default: http://127.0.0.1:8080/v1.","human":{"label":{"pl":"Adres lokalnego serwera modeli","en":"Local model server address"},"why":{"pl":"Gdzie na tym urządzeniu działa serwer modeli, gdy dostawcą jest serwer lokalny (np. http://127.0.0.1:8080/v1).","en":"Where the model server runs on this device when the provider is the local server (e.g. http://127.0.0.1:8080/v1)."},"effect":{"pl":"Przy dostawcy lokalnym wywołania modeli trafiają pod ten adres; przy innym dostawcy pole nie ma wpływu.","en":"With the local provider model calls go to this address; with another provider the field has no effect."},"levels":["person"],"group":"modele","subgroup":"dostawca","flows":["use_model"],"when_unset":{"pl":"http://127.0.0.1:8080/v1 (llama.cpp na tym urządzeniu)","en":"http://127.0.0.1:8080/v1 (llama.cpp on this device)"}}},{"key":"semantic_model","scope":"config","group":"semantic","type":"string","has_default":true,"description":"Model for background semantic analysis; empty string disables the LLM path (regex fallback).","human":{"label":{"pl":"Model analizy w tle","en":"Background analysis model"},"why":{"pl":"Model, który czyta wiadomości w tle i wyciąga z nich tematy, encje i powiązania do grafu; od jego klasy zależy przepływ, gdy analiza czyta fragmenty (frontier — jedno wywołanie; tani, średni i nieznany — klasyczne wywołanie i wąskie pytanie o fragmenty); pusty = analiza wiadomości tylko lokalnie, bez kosztu. Z tego pola korzystają też: Sekretarz (gdy „Model Sekretarza” jest pusty), określanie celu promptu (przy wysyłaniu wiadomości), szacunek kosztu (gdy archiwum albo budowanie wiedzy może dopracować wynik modelem), dopracowanie archiwum, analiza na żądanie i pytanie „jakiego modelu używam do analizy”. Uwaga: „Dopracuj elementy archiwum” (tylko z llm auto) przy pustym polu bierze „Model rozmowy” i jest płatne.","en":"The model that reads messages in the background and pulls topics, entities and relations into the graph; its class picks the flow when the analysis reads segments (frontier — one call; cheap, mid and unknown — the classic call and a narrow question about segments); empty = message analysis stays local, no cost. The same field is also used by: the Secretary (when “Secretary model” is empty), typing the goal of a prompt (when a message is sent), the cost estimate (when an archive or a knowledge build may refine its result with a model), the refinement of archive items, the analysis on request and the question “which model do I use for analysis”. Note: “Refine archive items” (only with llm auto) takes “Conversation model” when this field is empty, and is paid."},"effect":{"pl":"Z modelem analiza jest dokładniejsza i płatna; bez niego graf buduje się z lokalnych reguł. Każdy czytelnik bierze Twoje ustawienie, a bez niego preset (puste pole); wartości wskazanej dla rozmowy lub projektu dziś nie czyta nikt — dla rozmowy działa tylko „Model Sekretarza” (guardian_model).","en":"With a model the analysis is more accurate and paid; without one the graph is built from local rules. Every reader takes your setting, else the preset (an empty field); a value named for a conversation or project is read by nobody today — per conversation only the “Secretary model” (guardian_model) applies."},"levels":["person"],"group":"modele","subgroup":"role","role":"analysis.fast","flows":["semantic.analyse","semantic.batch","guardian.observe","guardian.annotate","guardian.status","actions.preview","batch.chat","archive.refine","goal.typing","knowledge.propose_semantics","analysis.run","guardian.model_read","ports.show","roles.resolved"],"technical_only":true}},{"key":"temperature","scope":"config","group":"chat","type":"number","has_default":true,"description":"Sampling temperature)LPROFILE",
  R"LPROFILE( for chat completions.","human":{"label":{"pl":"Temperatura (swoboda odpowiedzi)","en":"Temperature (reply freedom)"},"why":{"pl":"Ile losowości ma odpowiedź: niżej = powtarzalniej i ostrożniej, wyżej = swobodniej i bardziej twórczo.","en":"How much randomness a reply has: lower = more repeatable and careful, higher = freer and more creative."},"effect":{"pl":"Działa od następnej odpowiedzi czatu i pracy agenta; analiza w tle i archiwum mają własne wartości.","en":"Applies from the next chat reply and agent run; the background analysis and the archive have their own values."},"levels":["person","turn"],"group":"rozmowa","flows":["chat.send","agent.run"]}},{"key":"max_tokens","scope":"config","group":"chat","type":"integer","has_default":true,"description":"Completion token limit sent with chat requests.","human":{"label":{"pl":"Maksymalna długość odpowiedzi","en":"Maximum reply length"},"why":{"pl":"Górna granica długości jednej odpowiedzi w tokenach (po polsku token to zwykle mniej niż pół słowa); długie odpowiedzi kosztują więcej.","en":"The upper bound of one reply's length in tokens (in English a token is roughly 3/4 of a word, in Polish usually less than half a word); long replies cost more."},"effect":{"pl":"Odpowiedź czatu lub agenta dłuższa niż limit urywa się na granicy; wyższy limit = dłuższe i droższe odpowiedzi. Analiza w tle i archiwum mają własne limity.","en":"A chat or agent reply longer than the limit stops at the bound; a higher limit = longer and dearer replies. The background analysis and the archive have their own limits."},"levels":["person","turn"],"group":"rozmowa","flows":["chat.send","agent.run","actions.preview"]}},{"key":"theme","scope":"config","group":"ui","type":"string","has_default":true,"description":"UI theme preset name (dark, amoled).","human":{"label":{"pl":"Motyw","en":"Theme"},"why":{"pl":"Wygląd aplikacji: ciemny albo AMOLED (czarny, oszczędza baterię na ekranach OLED).","en":"The app's look: dark or AMOLED (black, saves battery on OLED screens)."},"effect":{"pl":"Dziś działa tylko w starej aplikacji okienkowej; w przeglądarce i na telefonie motyw zmienia przycisk w aplikacji, a odczyt tego pola jest planowany.","en":"Today it works only in the old desktop app; in the browser and on the phone the theme is changed by a button in the app, and reading this field is planned."},"levels":["person"],"group":"interfejs","subgroup":"wyglad","flows":[]},"status":{"state":"planned","by":"M1-W0","reader":"loom/web App.tsx (also the Android WebView) keeps its own theme in localStorage loom.theme with a toggle; only the Kivy app (main.py, gui/dialogs.py) reads config theme","reason":{"pl":"Przeglądarka i telefon przełączają motyw własnym przyciskiem i pamiętają wybór na urządzeniu; to pole czyta dziś tylko stara aplikacja okienkowa.","en":"The browser and the phone switch the theme with their own button and remember the choice on the device; today only the old desktop app reads this field."},"today":{"pl":"Dziś zmiana tego pola nie zmienia wyglądu w przeglądarce ani na telefonie.","en":"Today changing this field does not change the look in the browser or on the phone."}}},{"key":"start_view","scope":"config","group":"ui","type":"array","has_default":false,"description":"What the app opens to, as an ordered list tried first to last; the first that yields a view wins (the preset is [last_saved, last_conversation, new_conversation]): last_saved = the view you left (layout and conversation, kept on this device), last_conversation = the most recently updated conversation, new_conversation = an empty chat (always possible, so the app always opens to a chat). A single string is a list of one. Unknown names are skipped. Default: the preset (R56).","human":{"label":{"pl":"Co otwiera się na starcie","en":"What opens at start"},"why":{"pl":"Kolejność prób przy starcie: ostatni widok, ostatnia rozmowa, nowa rozmowa — pierwsza możliwa wygrywa.","en":"The order tried at start: the last view, the last 