":"loom/src/guardian/actions.cpp","port":"actions","action":"guardian.status","params":[{"name":"conv_id","type":"string","required":false,"description":{"en":"The conversation (default: the current one).","pl":"Rozmowa (domyślnie bieżąca)."},"has_default":false,"edit":"free_text"},{"name":"hypothesis","type":"string","required":false,"description":{"en":"Only this hypothesis.","pl":"Tylko ta hipoteza."},"has_default":false,"edit":"free_text"},{"name":"lang","type":"string","required":false,"description":{"en":"Language of the lines (pl or en).","pl":"Język wierszy (pl lub en)."},"has_default":false,"edit":"free_text"}],"http":{"verb":"POST","path":"/api/guardian/status"},"phrases":{"en":["guardian status","what did the guardian notice","show the guardian"],"pl":["stan strażnik*","co zauważył strażnik*","pokaż strażnik*"]},"examples":{"en":["what did the guardian notice in this conversation"],"pl":["co zauważył strażnik w tej rozmowie"]},"stores_result":false,"result_text":{"en":"What the guardian noticed:","pl":"Co zauważył strażnik:"},"default_element":"current_conversation"},"guardian.promote":{"id":"guardian.promote","kind":"atomic","status":"implemented","title":"Remember it as a rule","description":"Promotes a hypothesis of the context guardian: a correction becomes a rule written to the user overlay profiles/guardian.pack, a run of clarifications becomes one compiled instruction (the existing active task specification). Either way the conversation's chat_representation is set to guardian by a rule of that conversation, so later sends use the representation. The raw messages are never touched. Undo: guardian.undo.","labels":{"pl":"Zapamiętaj jako regułę"},"inputs":["json"],"outputs":["json"],"requires":["application"],"produces":[],"content_op":"none","form_op":"none","cost":0.0,"confidence":1.0,"effects":{"reads_only":false,"writes":true,"sends_off_device":false,"costs_money":false,"irreversible":false,"touches_private_data":false},"consumer":"loom/src/guardi