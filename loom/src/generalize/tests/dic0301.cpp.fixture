// Offline DIC-0301 replay: exact historic lookup/score/typing preservation,
// actual DEV principle discovery, and absent overrides.
// No live provider, no sealed/holdout input, no CMake registration.
#include <cstdlib>
#include <fstream>
#include <iostream>
#include <sstream>

#include "../internal.h"
#include "test_generalize_fixture.h"

#ifdef DIC0301_BEFORE
namespace loom::generalize::detail {
// The old helper is supplied by exact Git-pinned common.cpp, never emulated.
Json cue_class_or_default(const kb::Pack&, std::string_view);
}
#endif


using namespace loom;
using namespace loom::generalize;

namespace {
Json read_json(const char* path) {
  std::ifstream input(path, std::ios::binary);
  if (!input) { std::cerr << "cannot read " << path << '\n'; std::exit(2); }
  std::stringstream buffer; buffer << input.rdbuf();
  auto parsed = json::parse(buffer.str());
  if (!parsed) { std::cerr << parsed.error().message << '\n'; std::exit(2); }
  return *parsed;
}

Json lookup(const kb::Pack& pack, const std::string& name) {
#ifdef DIC0301_BEFORE
  return detail::cue_class_or_default(pack, name);
#else
  return detail::cue_class(pack, name);
#endif
}

using Documents = std::map<std::string, Json>;
Documents documents(const kb::Pack& pack) {
  Documents result;
  for (const auto& file : pack.files()) result[file] = pack.file(file);
  return result;
}

std::shared_ptr<const kb::Pack> checked_pack(Documents docs) {
  auto pack = kb::Pack::from_documents(std::move(docs));
  if (!pack) { std::cerr << pack.error().message << '\n'; std::exit(2); }
  return *pack;
}

Json typed(const kb::Pack& pack, const std::string& text) {
  model::Principle p;
  p.id = "p_dic0301";
  p.statement["pl"] = text;
  Evidence empty;
  auto status = type_principle(pack, p, empty);
  if (!status) { std::cerr << status.error().message << '\n'; std::exit(2); }
  return p.to_json();
}
} // namespace

int main(int argc, char** argv) {
  if (argc != 4) {
    std::cerr << "usage: dic0301 exact-legacy-classes.json before-cues.json overlay-dir\n";
    return 2;
  }
  const Json oracle = read_json(argv[1]);
  auto builtin = kb::Pack::load_builtin();
  if (!builtin) { std::cerr << builtin.error().message << '\n'; return 2; }
  Documents docs = documents(**builtin);
  docs["lexicons/cues.json"] = read_json(argv[2]);
  const std::filesystem::path overlay_dir(argv[3]);
  std::filesystem::create_directories(overlay_dir / "lexicons");
  const auto cue_file = overlay_dir / "lexicons/cues.json";
  auto pack = checked_pack(docs);
  kb::Normalizer normalizer(*pack);
  Json output = Json::object();
  output["defaults"] = Json::array();
  output["deletion"] = Json::array();
  output["empty_pack_override"] = Json::array();
  output["replacement"] = Json::array();
  output["overlay_controls"] = Json::array();
  int exact = 0, absent = 0, empty_rejected = 0, replaced = 0, phrase_count = 0;
  int durable_deleted = 0, durable_replaced = 0, malformed_rejected = 0;
  auto write_overlay = [&](const Json& cues) {
    std::ofstream out(cue_file, std::ios::binary | std::ios::trunc);
    out << cues.dump(1);
    if (!out) { std::cerr << "cannot write overlay\n"; std::exit(2); }
  };

  for (const auto& [name, expected] : oracle.items()) {
    Json current = lookup(*pack, name);
    exact += current == expected;
    Json samples = Json::array();
    std::string all_phrases;
    for (const auto& phrase : expected["phrases"]) {
      std::string text = phrase["p"].get<std::string>();
      all_phrases += text + " . ";
      samples.push_back(Json{{"text", text}, {"score", detail::cue_score(normalizer, text, current)},
                             {"typed", typed(*pack, text)}});
      ++phrase_count;
    }
    samples.push_back(Json{{"text", "dic0301unrelatedtoken"},
                           {"score", detail::cue_score(normalizer, "dic0301unrelatedtoken", current)},
                           {"typed", typed(*pack, "dic0301unrelatedtoken")}});
    samples.push_back(Json{{"text", all_phrases},
                           {"score", detail::cue_score(normalizer, all_phrases, current)},
                           {"typed", typed(*pack, all_phrases)}});
    output["defaults"].push_back(Json{{"name", name}, {"lookup", current}, {"exact", current == expected},
                                      {"samples", samples}});

    Documents removed = docs;
    removed["lexicons/cues.json"]["classes"].erase(name);
    write_overlay(removed["lexicons/cues.json"]);
    bool durable_delete_ok = true;
    for (int restart = 0; restart < 2; ++restart) {
      auto persisted = kb::Pack::load_with_overlay(overlay_dir);
      if (!persisted) { std::cerr << persisted.error().message << '\n'; return 2; }
      Json selected = lookup(**persisted, name);
      durable_delete_ok = durable_delete_ok && selected.is_null() &&
          detail::cue_score(normalizer, all_phrases, selected) == 0.0;
    }
    durable_deleted += durable_delete_ok;
    auto deleted = checked_pack(std::move(removed));
    Json missing = lookup(*deleted, name);
    double deleted_score = detail::cue_score(normalizer, all_phrases, missing);
    absent += missing.is_null() && deleted_score == 0.0;
    output["deletion"].push_back(Json{{"name", name}, {"lookup", missing}, {"score", deleted_score},
                                      {"no_resurrection", missing.is_null() && deleted_score == 0.0},
                                      {"typed", typed(*deleted, all_phrases)}});

    Documents empty = docs;
    empty["lexicons/cues.json"]["classes"][name] = Json{{"phrases", Json::array()}};
    auto invalid = kb::Pack::from_documents(std::move(empty));
    bool rejected = !invalid;
    empty_rejected += rejected;
    // Current foundation schema forbids empty cue lists. Report rejection;
    // do not claim a successful disabled empty pack or substitute a pack.
    output["empty_pack_override"].push_back(Json{{"name", name}, {"loader_rejected", rejected},
        {"generic_empty_matcher_score", detail::cue_score(normalizer, all_phrases, Json{{"phrases", Json::array()}})}});

    Documents custom = docs;
    Json replacement{{"phrases", Json::array({Json{{"p", "dic0301customtoken"}, {"w", 3.125}}})}};
    custom["lexicons/cues.json"]["classes"][name] = replacement;
    auto changed = checked_pack(std::move(custom));
    Json selected = lookup(*changed, name);
    bool replacement_ok = selected == replacement &&
        detail::cue_score(normalizer, "dic0301customtoken", selected) == 3.125 &&
        detail::cue_score(normalizer, all_phrases, selected) == 0.0;
    replaced += replacement_ok;
    output["replacement"].push_back(Json{{"name", name}, {"replacement_only", replacement_ok}});
    Json custom_cues = docs["lexicons/cues.json"];
    custom_cues["classes"][name] = replacement;
    write_overlay(custom_cues);
    bool durable_replace_ok = true;
    for (int restart = 0; restart < 2; ++restart) {
      auto persisted = kb::Pack::load_with_overlay(overlay_dir);
      if (!persisted) { std::cerr << persisted.error().message << '\n'; return 2; }
      Json selected_again = lookup(**persisted, name);
      durable_replace_ok = durable_replace_ok && selected_again == replacement &&
          detail::cue_score(normalizer, "dic0301customtoken", selected_again) == 3.125 &&
          detail::cue_score(normalizer, all_phrases, selected_again) == 0.0;
    }
    durable_replaced += durable_replace_ok;
    {
      std::ofstream broken(cue_file, std::ios::binary | std::ios::trunc);
      broken << "{broken-json";
    }
    auto malformed = kb::Pack::load_with_overlay(overlay_dir);
    bool malformed_ok = !malformed && malformed.error().code == Errc::Parse;
    malformed_rejected += malformed_ok;
    output["overlay_controls"].push_back(Json{{"name", name},
        {"deletion_survives_reload", durable_delete_ok},
        {"replacement_survives_reload", durable_replace_ok},
        {"malformed_overlay_explicit_parse_error", malformed_ok}});

  }

  auto fixture = test::gfix::load(*pack); // Public fictional synthetic_dev only.
  auto philosophy = discover_principles(*pack, fixture.ev, model::PriorFilter{});
  if (!philosophy) { std::cerr << philosophy.error().message << '\n'; return 2; }
  output["dev_principles"] = philosophy->to_json();
  output["counts"] = Json{{"exact_classes", exact}, {"classes", oracle.size()}, {"phrases", phrase_count},
      {"deletion_no_resurrection", absent}, {"empty_pack_rejected", empty_rejected}, {"replacement_only", replaced},
      {"durable_deletion_no_resurrection", durable_deleted}, {"durable_replacement_only", durable_replaced},
      {"malformed_overlay_rejected", malformed_rejected}};
  std::cout << output.dump(1) << '\n';
  bool good = exact == 7 && phrase_count == 120 && empty_rejected == 7 && replaced == 7 && durable_replaced == 7 && malformed_rejected == 7;
#ifndef DIC0301_BEFORE
  good = good && absent == 7 && durable_deleted == 7;
#endif
  return good ? 0 : 1;
}
