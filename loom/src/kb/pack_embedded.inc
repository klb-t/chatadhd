  "exclude_contexts": ["python 3.", "api v1", "api/v1", "http/1.", "http/2", "c++20", "c++17", "sqlite 3.", "iso 8601", "utf-8", "temperature", "temp", "%", "gb", "mb", "zł", "$"],
