{
  "schema": "loom.runtime_profile_sources/1",
  "description": "Generic source projections into runtime profile definitions. paths are relative to loom/data; pointers and targets use RFC 6901. To register W12 onboarding when profiles/user.pack is present, add a recipe with output runtime/onboarding.pack, definition {}, and source profiles/user.pack, pointer /runtime_definition, target empty string. This is registration guidance only; no onboarding recipe is enabled here.",
  "recipes": [
    {
      "output": "runtime/usage_policy.pack",
      "definition": {
        "schema": "loom.runtime_profile/1",
        "domain": "usage_policy",
        "revision": 1,
        "description": "Usage admission preset from W2 PROFILE_HANDOFF.md. Every consumer must additionally run validate_usage_policy_options on complete effective values; generic schema is not admission approval. Config overrides replace whole top-level values and profile overlays retain recursive/patch semantics.",
        "defaults": null,
        "value_schema": {
          "type": "object",
          "required": [
            "schema",
            "growth_factor",
            "baseline_window",
            "ledger_busy_timeout_ms",
            "include_reservations",
            "initial_baselines",
            "baseline_min_samples",
            "baseline_floor_tokens",
            "baseline_floor_chars_per_token",
            "baseline_floor"
          ],
          "additionalProperties": true,
          "properties": {
            "schema": {
              "type": "string",
              "enum": [
                "loom.usage_policy/1"
              ]
            },
            "growth_factor": {
              "type": "number",
              "minimum": 1,
              "description": "Finite factor must also be strictly greater than one under the native W2 validator. No spending maximum.",
              "x-setting": "/growth_factor",
              "x-consumer": "UsagePolicy"
            },
            "baseline_window": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9223372036854775807,
              "description": "Positive signed int64 sample count, or null for all history; maximum is native representation, not a product ceiling.",
              "x-setting": "/baseline_window",
              "x-consumer": "UsagePolicy moving baseline"
            },
            "ledger_busy_timeout_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647,
              "x-unit": "milliseconds",
              "x-setting": "/ledger_busy_timeout_ms",
              "x-consumer": "SQLite usage ledger connection"
            },
            "include_reservations": {
              "type": "boolean",
              "x-setting": "/include_reservations",
              "x-consumer": "UsagePolicy projection"
            },
            "initial_baselines": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Finite nonnegative resource quantity or unavailable null; resource/cohort names remain data and need native validation."
                }
              },
              "x-setting": "/initial_baselines",
              "x-consumer": "UsagePolicy declared baseline"
            },
            "baseline_min_samples": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807,
              "description": "P17: until a cohort has this many measured samples its baseline is the larger of the measured mean and the floor below (a first short message must not make the second ordinary one look like a tenfold growth). From this many samples on the measured baseline is used as it is. 0 turns the floor off. A cohort with no sample at all keeps the old behaviour (a declared baseline, else none: nothing to grow from). It is a preset of what normal usage looks like, not a limit: changing it is an edit of loom_usage_policy and is confirmed like the growth factor.",
              "x-setting": "/baseline_min_samples",
              "x-consumer": "UsagePolicy moving baseline"
            },
            "baseline_floor_tokens": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "number",
                  "minimum": 0
                },
                "output": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "description": "P17: the size of an ordinary request in tokens (preset 4000 in, 1000 out), from which the floors of the baseline are derived: input_tokens and output_tokens as they are, input_bytes as input x baseline_floor_chars_per_token, cost_usd and money_usd as the tokens priced with the estimate's `price` {input, output} (USD per token) when the caller knows the model's price.",
              "x-setting": "/baseline_floor_tokens",
              "x-consumer": "UsagePolicy moving baseline"
            },
            "baseline_floor_chars_per_token": {
              "type": "number",
              "minimum": 0,
              "description": "P17: characters (bytes) per token for the floor of input_bytes when no price is known. The preset 4.0 is the `low` end of the band the cost estimate of action runs uses (runtime profile action_run, estimate.chars_per_token); a test keeps the two equal.",
              "x-setting": "/baseline_floor_chars_per_token",
              "x-consumer": "UsagePolicy moving baseline"
            },
            "baseline_floor": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "description": "P17: floors of single resources that replace the derived ones: {resource: quantity}; null = no floor for that resource.",
              "x-setting": "/baseline_floor",
              "x-consumer": "UsagePolicy moving baseline"
            }
          }
        }
      },
      "projections": [
        {
          "source": "policy/usage_policy.pack",
          "pointer": "",
          "target": "/defaults"
        }
      ]
    },
    {
      "output": "runtime/graph_entry.pack",
      "definition": {
        "schema": "loom.runtime_profile/1",
        "domain": "graph_entry",
        "revision": 1,
        "description": "Graph entry view (R45/R52/R53): axes generate the area space, calibration areas/bindings/seed/ontology are data. Overlay profiles/graph_entry.pack overrides are recursive: objects keyed by id merge (set hidden:true to hide an area or seed element; add new ids to extend), arrays replace. Providers are code mechanism ids; which areas exist, where and how they are labelled is data. All shipped content is calibration, not a closed list.",
        "defaults": {
          "axes": {},
          "areas": {},
          "bindings": {},
          "seed": {},
          "ontology": {
            "classes": {},
            "traits": {},
            "groups": {},
            "relations": {},
            "packages": {},
            "states": {},
            "default_state": ""
          },
          "parties": {
            "templates": {}
          },
          "scopes": {
            "chain": [],
            "conflict_rules": [],
            "default_rule": ""
          },
          "interfaces": {},
          "rom": {
            "mount": {},
            "items": {}
          },
          "devices": {},
          "device_platforms": {}
        },
        "value_schema": {
          "type": "object",
          "required": [
            "axes",
            "areas",
            "bindings",
            "seed",
            "ontology",
            "parties",
            "scopes"
          ],
          "additionalProperties": true
        }
      },
      "projections": [
        {
          "source": "graph/axes.pack",
          "pointer": "/axes",
          "target": "/defaults/axes"
        },
        {
          "source": "graph/entry.pack",
          "pointer": "/areas",
          "target": "/defaults/areas"
        },
        {
          "source": "graph/entry.pack",
          "pointer": "/bindings",
          "target": "/defaults/bindings"
        },
        {
          "source": "graph/entry.pack",
          "pointer": "/seed",
          "target": "/defaults/seed"
        },
        {
          "source": "graph/classes.pack",
          "pointer": "/classes",
          "target": "/defaults/ontology/classes"
        },
        {
          "source": "graph/classes.pack",
          "pointer": "/traits",
          "target": "/defaults/ontology/traits"
        },
        {
          "source": "graph/classes.pack",
          "pointer": "/groups",
          "target": "/defaults/ontology/groups"
        },
        {
          "source": "graph/classes.pack",
          "pointer": "/relations",
          "target": "/defaults/ontology/relations"
        },
        {
          "source": "graph/properties.pack",
          "pointer": "/packages",
          "target": "/defaults/ontology/packages"
        },
        {
          "source": "graph/properties.pack",
          "pointer": "/states",
          "target": "/defaults/ontology/states"
        },
        {
          "source": "graph/parties.pack",
          "pointer": "/templates",
          "target": "/defaults/parties/templates"
        },
        {
          "source": "graph/scopes.pack",
          "pointer": "/chain",
          "target": "/defaults/scopes/chain"
        },
        {
          "source": "graph/scopes.pack",
          "pointer": "/conflict_rules",
          "target": "/defaults/scopes/conflict_rules"
        },
        {
          "source": "graph/scopes.pack",
          "pointer": "/default_rule",
          "target": "/defaults/scopes/default_rule"
        },
        {
          "source": "graph/properties.pack",
          "pointer": "/default_state",
          "target": "/defaults/ontology/default_state"
        },
        {
          "source": "graph/interfaces.pack",
          "pointer": "/interfaces",
          "target": "/defaults/interfaces"
        },
        {
          "source": "graph/rom.pack",
          "pointer": "/mount",
          "target": "/defaults/rom/mount"
        },
        {
          "source": "graph/rom.pack",
          "pointer": "/items",
          "target": "/defaults/rom/items"
        },
        {
          "source": "graph/devices.pack",
          "pointer": "/devices",
          "target": "/defaults/devices"
        },
        {
          "source": "graph/devices.pack",
          "pointer": "/platforms",
          "target": "/defaults/device_platforms"
        }
      ]
    },
    {
      "output": "runtime/storage_security.pack",
      "definition": {
        "schema": "loom.runtime_profile/1",
        "domain": "storage_security",
        "revision": 1,
        "description": "Storage, encryption and security area (R51, T5a). Canonical source policy/storage_security.pack; all content is calibration/preset (default placement = today's reality, crypto preset legacy). Overlay profiles/storage_security.pack merges objects keyed by id, arrays replace. Consumers: graph_entry area storage_security (counts via profile.items); T5b providers.",
        "defaults": null,
        "value_schema": {
          "type": "object",
          "required": [
            "schema",
            "categories",
            "storages",
            "placement",
            "allowed_storages",
            "egress",
            "sync",
            "settings_conflict_rules",
            "crypto",
            "key_custody",
            "migration",
            "threat_model"
          ],
          "additionalProperties": true,
          "x-consumer": "graph_entry/storage_security",
          "properties": {
            "schema": {
              "type": "string",
              "enum": [
                "loom.storage_security/1"
              ]
            },
            "categories": {
              "type": "object",
              "x-setting": "/categories",
              "x-consumer": "graph_entry/storage_security",
              "additionalProperties": true
            },
            "storages": {
              "type": "object",
              "x-setting": "/storages",
              "x-consumer": "graph_entry/storage_security",
              "additionalProperties": true
            },
            "placement": {
              "type": "object",
              "x-setting": "/placement",
              "x-consumer": "graph_entry/storage_security",
              "additionalProperties": true
            },
            "allowed_storages": {
              "type": "object",
              "x-setting": "/allowed_storages",
              "x-consumer": "graph_entry/storage_security",
              "additionalProperties": true
            },
            "egress": {
              "type": "object",
              "x-setting": "/egress",
              "x-consumer": "graph_entry/storage_security",
              "additionalProperties": true
            },
            "sync": {
              "type": "object",
              "x-setting": "/sync",
              "x-consumer": "graph_entry/storage_security",
              "additionalProperties": true
            },
            "settings_conflict_rules": {
              "type": "object",
              "x-setting": "/settings_conflict_rules",
              "x-consumer": "graph_entry/storage_security",
              "additionalProperties": true
            },
            "crypto": {
              "type": "object",
              "required": [
                "selected_preset",
                "suite_presets",
                "algorithms"
              ],
              "additionalProperties": true,
              "x-consumer": "graph_entry/storage_security",
              "properties": {
                "selected_preset": {
                  "type": "string",
                  "x-setting": "/crypto/selected_preset",
                  "x-consumer": "graph_entry/storage_security"
                },
                "suite_presets": {
                  "type": "object",
                  "x-setting": "/crypto/suite_presets",
                  "x-consumer": "graph_entry/storage_security",
                  "additionalProperties": true
                },
                "algorithms": {
                  "type": "object",
                  "x-setting": "/crypto/algorithms",
                  "x-consumer": "graph_entry/storage_security",
                  "additionalProperties": true
                }
              }
            },
            "key_custody": {
              "type": "object",
              "x-setting": "/key_custody",
              "x-consumer": "graph_entry/storage_security",
              "additionalProperties": true
            },
            "migration": {
              "type": "object",
              "x-setting": "/migration",
              "x-consumer": "graph_entry/storage_security",
              "additionalProperties": true
            },
            "threat_model": {
              "type": "object",
              "x-setting": "/threat_model",
              "x-consumer": "graph_entry/storage_security",
              "additionalProperties": true
            }
          }
        }
      },
      "projections": [
        {
          "source": "policy/storage_security.pack",
          "pointer": "",
          "target": "/defaults"
        }
      ]
    }
  ]
}
