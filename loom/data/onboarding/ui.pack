  "defaults": {
    "mode": "conversation",
    "input": "text",
    "json_indent": 2,
    "provider_separator": "\n",
    "modes": [
      {
        "id": "conversation",
        "label": "mode.conversation"
      },
      {
        "id": "form",
        "label": "mode.form"
      }
    ],
    "boolean_options": [
      {
        "value": true,
        "label": "option.true"
      },
      {
        "value": false,
        "label": "option.false"
      }
    ],
    "preference_modes": [
      {
        "id": "ask",
        "label": "preferences.ask"
      },
      {
        "id": "candidate",
        "label": "preferences.candidate"
      },
      {
        "id": "automatic",
        "label": "preferences.automatic"
      }
    ],
    "rows": {
      "field": 3,
      "correction": 3,
      "scenario": 14,
      "privacy_rule": 6,
      "knowledge": 3,
      "default": 3
    },
    "privacy_controls": [
      {
        "key": "store",
        "renderer": "checkbox",
        "label": "privacy.store"
      },
      {
        "key": "max_detail",
        "renderer": "json",
        "label": "privacy.max_detail"
      },
      {
        "key": "max_sensitivity",
        "renderer": "json",
        "label": "privacy.max_sensitivity"
      },
      {
        "key": "providers",
        "renderer": "provider-list",
        "label": "privacy.providers"
      },
      {
        "key": "infer",
        "renderer": "checkbox",
        "label": "privacy.infer"
      },
      {
        "key": "explicit_only",
        "renderer": "checkbox",
        "label": "privacy.explicit_only"
      },
      {
        "key": "retention",
        "renderer": "json",
        "label": "privacy.retention"
      }
    ],
    "control_order": {
      "field_status": [
        "unknown",
        "declined",
        "never"
      ],
      "candidate_review": [
        "confirmed",
        "rejected"
      ],
      "section": [
        "confirmed",
        "corrected",
        "rejected",
        "skip",
        "repeat"
      ],
      "knowledge_status": [
        "delete",
        "unknown",
        "declined",
        "never"
      ],
      "default": [
        "toggle",
        "exclude",
        "clear_override",
        "accept_proposal",
        "proposal",
        "direct"
      ]
    },
    "presentation_tokens": {
      "--onboarding-gutter": "16px",
      "--onboarding-width": "960px",
      "--onboarding-h-top": "16px",
      "--onboarding-gap": "8px",
      "--onboarding-space": "10px",
      "--onboarding-section-space": "20px",
      "--onboarding-label-top": "8px",
      "--onboarding-label-bottom": "4px",
      "--onboarding-button-space": "6px",
      "--onboarding-padding": "12px",
      "--onboarding-radius": "10px",
      "--onboarding-field-space": "12px",
      "--onboarding-border-color": "#444",
      "--onboarding-legend-padding": "4px",
      "--onboarding-dim": "#888",
      "--onboarding-font-size": "12px",
      "--onboarding-json-height": "320px",
      "--onboarding-ai": "#1f2e3d",
      "--onboarding-err": "#e88",
      "--onboarding-accent": "#4d8cf2",
      "--onboarding-border-width": "1px"
    }
  }
}
