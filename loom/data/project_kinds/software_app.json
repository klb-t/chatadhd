 "constraints": [
  {
   "id": "sw.c1",
   "expr": {
    "op": "not_in",
    "args": [
     "$slot:store",
     "$rejected_values"
    ]
   },
   "on_violation": "conflict",
   "why": "a store that an active decision rejected cannot be the current store"
  },
  {
   "id": "sw.c2",
   "expr": {
    "op": "version_gte",
    "args": [
     "$temporal:current_version",
     "$git_max_version"
    ]
   },
   "on_violation": "conflict",
   "why": "the current version is never older than the newest committed version"
  }
