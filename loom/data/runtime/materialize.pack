{
  "schema": "loom.runtime_profile/1",
  "domain": "materialize",
  "revision": 1,
  "defaults": {
    "languages": {
      ".py": "python",
      ".cpp": "cpp",
      ".cc": "cpp",
      ".cxx": "cpp",
      ".h": "cpp",
      ".hpp": "cpp",
      ".c": "c",
      ".kt": "kotlin",
      ".kts": "kotlin",
      ".java": "java",
      ".ts": "typescript",
      ".tsx": "typescript",
      ".js": "typescript",
      ".jsx": "typescript"
    },
    "language": "en",
    "project_kind": "project",
    "violations_predicate": "violates",
    "detectors": {
      "max_hits_per_file": 1000000,
      "excerpt_codepoints": 160,
      "min_array_entries": 20,
      "detail_hits": 5
    },
    "outputs": {
      "self_description": "SELF.md",
      "dossier": "dossier_{{instance}}.md",
      "extrapolated_spec": "extrapolated_{{instance}}.md",
      "backlog": "BACKLOG.md"
    },
    "mime": {
      "json_suffix": ".json",
      "json": "application/json",
      "markdown": "text/markdown"
    },
    "templates": {
      "self_header": "# SELF.md\n\nGenerated by Loom's knowledge layer for run `{{run}}`.\n\n",
      "projects_header": "## Projects\n\n",
      "project_header": "### {{label}} ({{kind}})\n",
      "project_status": "- status: {{status}}, confidence {{confidence}}\n",
      "components_header": "- components:\n",
      "component": "  - {{label}} ({{kind}}): {{status}}{{oscillation}}\n",
      "decisions_header": "- decisions:\n",
      "decision": "  - {{date}}: chose {{chosen}}{{superseded}}\n",
      "superseded": " (superseded by {{id}})",
      "forks_header": "- forks:\n",
      "fork": "  - {{kind}} at {{base}} ({{count}} sides)\n",
      "area": "- area: {{statement}}{{gap}}\n",
      "gap": " [GAP: no members found]",
      "principles_header": "## Principles\n\n",
      "principle": "- [{{level}}/{{form}}] {{statement}} ({{source}}, {{validation}})\n",
      "operators_header": "\n## Operators\n\n",
      "operator": "- {{situation}} -> {{solution}} (confidence {{confidence}})\n",
      "questions_header": "\n## Open questions\n\n",
      "bullet": "- {{text}}\n",
      "oscillation": " [oscillates]",
      "unknown_status": "unknown",
      "seed": "seed",
      "discovered": "discovered",
      "missing_chosen": "?",
      "project_separator": "\n",
      "self_title": "SELF.md",
      "dossier_header": "# Dossier: {{label}} ({{paradigm}})\n\n",
      "coverage": "Coverage: {{coverage}}\n\n",
      "slots_header": "## Slots\n\n",
      "slot": "{{slot}} = {{object}}",
      "slot_line": "- {{text}}{{conflict}}\n",
      "conflict": " [CONFLICT]",
      "dossier_title": "Dossier: {{label}}",
      "backlog_header": "# Backlog\n\n",
      "contested_header": "## Contested claims\n\n",
      "contested": "- {{subject}} {{predicate}} (contested)\n",
      "violated_header": "\n## Violated expected properties\n\n",
      "violated": "- {{subject}} {{predicate}}: {{expected}} [violated]\n",
      "violations_header": "\n## Principle / preference violations\n\n",
      "violation": "- {{subject}} violates {{value}}\n",
      "absent_header": "\n## Absent required slots\n\n",
      "absent": "- {{label}} / {{slot}}: absent\n",
      "lost_header": "\n## Lost features\n\n",
      "lost": "- {{label}} (branch {{branch}}): lost as of {{date}}{{oscillation}}\n",
      "missing_branch": "main",
      "backlog_title": "Backlog",
      "extrapolated_header": "# Extrapolated spec: {{label}}\n\nProposals only \u2014 never facts (I3).\n\n## Proposals\n\n",
      "extrapolated_title": "Extrapolated spec: {{label}}",
      "no_proposals": "(none)\n",
      "detail_header": "{{count}} hit(s): ",
      "detail_hit": "{{file}}:{{line}} ",
      "detail_ellipsis": "...",
      "detail_no_hits": "no hits",
      "array_literal": "literal string array (>= {{count}} entries)"
    },
    "products": [
      {
        "renderer": "self_description",
        "enabled": true,
        "on_error": "error"
      },
      {
        "renderer": "dossier",
        "enabled": true,
        "on_error": "omit"
      },
      {
        "renderer": "extrapolated_spec",
        "enabled": true,
        "on_error": "omit"
      },
      {
        "renderer": "backlog",
        "enabled": true,
        "on_error": "error"
      }
    ]
  },
  "value_schema": {
    "type": "object",
    "properties": {
      "languages": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },
      "language": {
        "type": "string"
      },
      "project_kind": {
        "type": "string"
      },
      "violations_predicate": {
        "type": "string"
      },
      "detectors": {
        "type": "object",
        "properties": {
          "max_hits_per_file": {
            "type": "integer",
            "minimum": 0,
            "description": "0 means unlimited."
          },
          "excerpt_codepoints": {
            "type": "integer",
            "minimum": 0,
            "description": "0 means unlimited."
          },
          "min_array_entries": {
            "type": "integer",
            "minimum": 0
          },
          "detail_hits": {
            "type": "integer",
            "minimum": 0,
            "description": "0 means unlimited."
          }
        },
        "required": [
          "max_hits_per_file",
          "excerpt_codepoints",
          "min_array_entries",
          "detail_hits"
        ],
        "additionalProperties": false
      },
      "outputs": {
        "type": "object",
        "properties": {
          "self_description": {
            "type": "string"
          },
          "dossier": {
            "type": "string"
          },
          "extrapolated_spec": {
            "type": "string"
          },
          "backlog": {
            "type": "string"
          }
        },
        "required": [
          "self_description",
          "dossier",
          "extrapolated_spec",
          "backlog"
        ],
        "additionalProperties": false
      },
      "mime": {
        "type": "object",
        "properties": {
          "json_suffix": {
            "type": "string"
          },
          "json": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          }
        },
        "required": [
          "json_suffix",
          "json",
          "markdown"
        ],
        "additionalProperties": false
      },
      "templates": {
        "type": "object",
        "properties": {
          "self_header": {
            "type": "string"
          },
          "projects_header": {
            "type": "string"
          },
          "project_header": {
            "type": "string"
          },
          "project_status": {
            "type": "string"
          },
          "components_header": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "decisions_header": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "superseded": {
            "type": "string"
          },
          "forks_header": {
            "type": "string"
          },
          "fork": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "gap": {
            "type": "string"
          },
          "principles_header": {
            "type": "string"
          },
          "principle": {
            "type": "string"
          },
          "operators_header": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "questions_header": {
            "type": "string"
          },
          "bullet": {
            "type": "string"
          },
          "oscillation": {
            "type": "string"
          },
          "unknown_status": {
            "type": "string"
          },
          "seed": {
            "type": "string"
          },
          "discovered": {
            "type": "string"
          },
          "missing_chosen": {
            "type": "string"
          },
          "project_separator": {
            "type": "string"
          },
          "self_title": {
            "type": "string"
          },
          "dossier_header": {
            "type": "string"
          },
          "coverage": {
            "type": "string"
          },
          "slots_header": {
            "type": "string"
          },
          "slot": {
            "type": "string"
          },
          "slot_line": {
            "type": "string"
          },
          "conflict": {
            "type": "string"
          },
          "dossier_title": {
            "type": "string"
          },
          "backlog_header": {
            "type": "string"
          },
          "contested_header": {
            "type": "string"
          },
          "contested": {
            "type": "string"
          },
          "violated_header": {
            "type": "string"
          },
          "violated": {
            "type": "string"
          },
          "violations_header": {
            "type": "string"
          },
          "violation": {
            "type": "string"
          },
          "absent_header": {
            "type": "string"
          },
          "absent": {
            "type": "string"
          },
          "lost_header": {
            "type": "string"
