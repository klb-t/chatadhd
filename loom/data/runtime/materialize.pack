          "lost": {
            "type": "string"
          },
          "missing_branch": {
            "type": "string"
          },
          "backlog_title": {
            "type": "string"
          },
          "extrapolated_header": {
            "type": "string"
          },
          "extrapolated_title": {
            "type": "string"
          },
          "no_proposals": {
            "type": "string"
          },
          "detail_header": {
            "type": "string"
          },
          "detail_hit": {
            "type": "string"
          },
          "detail_ellipsis": {
            "type": "string"
          },
          "detail_no_hits": {
            "type": "string"
          },
          "array_literal": {
            "type": "string"
          }
        },
        "required": [
          "self_header",
          "projects_header",
          "project_header",
          "project_status",
          "components_header",
          "component",
          "decisions_header",
          "decision",
          "superseded",
          "forks_header",
          "fork",
          "area",
          "gap",
          "principles_header",
          "principle",
          "operators_header",
          "operator",
          "questions_header",
          "bullet",
          "oscillation",
          "unknown_status",
          "seed",
          "discovered",
          "missing_chosen",
          "project_separator",
          "self_title",
          "dossier_header",
          "coverage",
          "slots_header",
          "slot",
          "slot_line",
          "conflict",
          "dossier_title",
          "backlog_header",
          "contested_header",
          "contested",
          "violated_header",
          "violated",
          "violations_header",
          "violation",
          "absent_header",
          "absent",
          "lost_header",
          "lost",
          "missing_branch",
          "backlog_title",
          "extrapolated_header",
          "extrapolated_title",
          "no_proposals",
          "detail_header",
          "detail_hit",
          "detail_ellipsis",
          "detail_no_hits",
          "array_literal"
        ],
        "additionalProperties": false
      },
      "products": {
        "type": "array",
        "description": "Ordered renderer recipe. Only enabled entries execute. Consecutive enabled instance renderers form a group executed in listed order for each instance; run renderers partition groups. Names select trusted registered executable capabilities; unknown names fail before artifact writes, even if disabled.",
        "items": {
          "type": "object",
          "required": [
            "renderer",
            "enabled",
            "on_error"
          ],
          "properties": {
            "renderer": {
              "type": "string",
              "minLength": 1
            },
            "enabled": {
              "type": "boolean"
            },
            "on_error": {
              "type": "string",
              "enum": [
                "error",
                "omit"
              ]
            }
          },
          "additionalProperties": false
        },
        "x-setting": "products",
        "x-consumer": "materialize::run_stage"
      }
    },
    "required": [
      "languages",
      "language",
      "project_kind",
      "violations_predicate",
      "detectors",
      "outputs",
      "mime",
      "templates",
      "products"
    ],
    "additionalProperties": false
  }
}
