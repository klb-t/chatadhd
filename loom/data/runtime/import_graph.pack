{
  "schema": "loom.runtime_profile/1",
  "domain": "import_graph",
  "revision": 2,
  "description": "Import as graph nodes (IMPORT_JAKO_PLIKI_W_GRAFIE_2026-10-23 §3.3, package P1). Every import, in every mode (copy included), writes nodes of the existing nodes table (no new table or column, schema_version stays 4): the imported file (its container class by format), an export node with its facets (by provider), the archive entries, the conversations and the attachments, linked part_of / derived_from (relations of graph/classes.pack). Kinds are \"import_graph:<class>\" (kept apart from the recognition kinds import:*). A node's id is derived from a key built from the source's blob hash, so importing the same bytes again finds the same nodes instead of making new ones. The summary sentence is built from the templates below in the language preset (pl), with the other language kept beside it; no raw JSON is ever put in it. Everything is a preset of the person: enabled false writes no import nodes (the import itself is unchanged); classes, facets, words and templates are data and an overlay <data_dir>/profiles/import_graph.pack changes them. The lists are examples and open: an unknown format falls back to the class file, an unknown provider to the facet export, an unknown disposition to its own token.",
  "defaults": {
    "enabled": true,
    "language": "pl",
    "kind_prefix": "import_graph:",
    "metadata_key": "import_graph",
    "container_class_by_format": {
      "zip": "zip_archive",
      "json": "json_file",
      "jsonl": "jsonl_file",
      "html": "html_file",
      "mht": "html_file",
      "sqlite": "sqlite_file",
      "markdown": "text_file",
      "text": "text_file",
      "screenshot": "image_file"
    },
    "default_container_class": "file",
    "member_class_by_extension": {
      "json": "json_file",
      "jsonl": "jsonl_file",
      "html": "html_file",
      "htm": "html_file",
      "txt": "text_file",
      "md": "text_file",
      "db": "sqlite_file",
      "sqlite": "sqlite_file",
      "zip": "zip_in_zip",
      "png": "image_file",
      "jpg": "image_file",
      "jpeg": "image_file",
      "webp": "image_file",
      "gif": "image_file"
    },
    "export_facets_by_provider": {
      "openai": [
        "export.openai",
        "export.openai.chatgpt"
      ],
      "anthropic": [
        "export.anthropic",
        "export.anthropic.claude"
      ],
      "google": [
        "export.google",
        "export.google.gemini"
      ],
      "xai": [
        "export.xai",
        "export.xai.grok"
      ],
      "loom": [
        "export.loom"
      ]
    },
    "entity_class_by_kind": {
      "export:account": "account",
      "export:project": "project",
      "export:project_doc": "document",
      "export:memory": "memory_note",
      "export:artifact": "document",
      "export:feedback": "observation",
      "export:shared_link": "graph_link"
    },
    "links": {
      "contains": "part_of",
      "read_from": "derived_from"
    },
    "words": {
      "provider": {
        "openai": {
          "en": "ChatGPT (OpenAI) export",
          "pl": "Eksport ChatGPT (OpenAI)"
        },
        "anthropic": {
          "en": "Claude (Anthropic) export",
          "pl": "Eksport Claude (Anthropic)"
        },
        "google": {
          "en": "Gemini (Google) export",
          "pl": "Eksport Gemini (Google)"
        },
        "xai": {
          "en": "Grok (xAI) export",
          "pl": "Eksport Grok (xAI)"
        },
        "loom": {
          "en": "Loom export",
          "pl": "Eksport Loom"
        },
        "unknown": {
          "en": "Export of an unrecognised provider",
          "pl": "Eksport nierozpoznanego dostawcy"
        }
      },
      "plain_file": {
        "en": "Import",
        "pl": "Import"
      },
      "disposition": {
        "offline_viewer_skipped": {
          "en": "offline viewer, not read; the conversations come from the JSON files",
          "pl": "przeglądarka offline, nie wczytana; rozmowy pochodzą z plików JSON"
        },
        "unknown": {
          "en": "not recognised, kept as a node",
          "pl": "nierozpoznany, zachowany jako węzeł"
        },
        "empty": {
          "en": "empty",
          "pl": "pusty"
        }
      },
      "export_label": {
        "en": "{{what}}: {{file}}",
        "pl": "{{what}}: {{file}}"
      },
      "class": {
        "account": {
          "en": "accounts",
          "pl": "konta"
        },
        "project": {
          "en": "projects",
          "pl": "projekty"
        },
        "document": {
          "en": "documents",
          "pl": "dokumenty"
        },
        "memory_note": {
          "en": "memories",
          "pl": "wspomnienia"
        },
        "observation": {
          "en": "feedback",
          "pl": "opinie"
        },
        "graph_link": {
          "en": "shared links",
          "pl": "udostępnione łącza"
        }
      },
      "unknown_layout": {
        "pl": "nieznany układ",
        "en": "unknown layout"
      }
    },
    "read_dispositions": [
      "conversations",
      "asset",
      "record"
    ],
    "summary": {
      "parts": [
        {
          "text": {
            "en": "{{what}} from the file “{{file}}”.",
            "pl": "{{what}} z pliku „{{file}}”."
          }
        },
        {
          "text": {
            "en": "Conversations: {{conversations}}, messages: {{messages}}.",
            "pl": "Rozmowy: {{conversations}}, wiadomości: {{messages}}."
          }
        },
        {
          "when": "layout_confident",
          "text": {
            "pl": "Układ eksportu: {{layout}}.",
            "en": "Export layout: {{layout}}."
          }
        },
        {
          "when": "layout_uncertain",
          "text": {
            "pl": "Układ eksportu: prawdopodobnie {{layout}} (pewność {{layout_percent}} %).",
            "en": "Export layout: probably {{layout}} (confidence {{layout_percent}} %)."
          }
        },
        {
          "when": "layout_unknown",
          "text": {
            "pl": "Układ eksportu: nieznany — żaden opisany układ nie pasuje dość dobrze.",
            "en": "Export layout: unknown — no described layout fits well enough."
          }
        },
        {
          "when": "layout_alternatives",
          "text": {
            "pl": "Inne możliwości: {{layout_alternatives}}.",
            "en": "Other possibilities: {{layout_alternatives}}."
          }
        },
        {
          "when": "branches",
          "text": {
            "en": "Branches: {{branches}}.",
            "pl": "Gałęzie: {{branches}}."
          }
        },
        {
          "when": "attachments",
          "text": {
            "en": "Attachments: {{attachments}} (found in the archive: {{attachments_linked}}; the rest are names and descriptions only).",
            "pl": "Załączniki: {{attachments}} (odnalezione w archiwum: {{attachments_linked}}; pozostałe to tylko nazwy i opisy)."
          }
        },
        {
          "when": "entities",
          "text": {
            "en": "Also described: {{entities_text}}.",
            "pl": "Opisane także: {{entities_text}}."
          }
        },
        {
          "when": "members",
          "text": {
            "en": "Archive entries: {{members}}.",
            "pl": "Wpisy archiwum: {{members}}."
          }
        },
        {
          "when": "skipped",
          "text": {
            "en": "Not read as conversations: {{skipped_text}}.",
            "pl": "Nie wczytane jako rozmowy: {{skipped_text}}."
          }
        },
        {
          "when": "already_imported",
          "text": {
            "en": "These bytes were imported before; the same nodes were found again.",
            "pl": "Te same bajty były już importowane; odnaleziono te same węzły."
          }
        },
        {
          "text": {
            "en": "In the graph: {{nodes_created}} new nodes, {{nodes_reused}} already there — open the area “Imports”.",
            "pl": "W grafie: nowe węzły {{nodes_created}}, już istniejące {{nodes_reused}} — zobacz obszar „Importy”."
          }
        }
      ],
      "separator": " ",
      "list_separator": ", ",
      "entity_item": {
        "en": "{{label}}: {{count}}",
        "pl": "{{label}}: {{count}}"
      },
      "skipped_item": {
        "en": "{{name}} ({{why}})",
        "pl": "{{name}} ({{why}})"
      },
      "alternative_item": {
        "pl": "{{label}} ({{percent}} %)",
        "en": "{{label}} ({{percent}} %)"
      }
    },
    "archive_formats": [
      "zip"
    ],
    "layout_fingerprint": {
      "enabled": true,
      "strip_common_root": true,
      "read_prefix_bytes": 262144,
      "max_content_members": 32,
      "json_key_depth": 4,
      "unknown_evidence": 2.0,
      "confident_at": 0.8,
      "tie_within": 0.02,
      "list_min_share": 0.01,
      "max_alternatives": 3,
      "claims": {
        "claim:export-is-zip": {
          "alpha": 9,
          "beta": 1,
          "tier": "B",
          "sources": [
            "7 parsers of ChatGPT exports",
            "osteele",
            "lordjabez"
          ],
          "observed": "2026-10-23",
          "note": "provider exports arrive as one ZIP archive"
        },
        "claim:openai-single-conversations-json": {
          "alpha": 8,
          "beta": 1,
          "tier": "B",
          "sources": [
            "mohamed-chs/convoviz",
            "portable-ai-memory"
          ],
          "observed": "2026-10-23",
          "note": "one conversations.json at the top",
          "valid": {
            "from": "2023-04",
            "until": "2026-02"
          }
        },
        "claim:shards-NNN": {
          "alpha": 8,
          "beta": 1,
          "tier": "A/B",
          "sources": [
            "help.openai.com 9106926 (search summary only, page not fetched)",
            "mohamed-chs/convoviz",
            "portable-ai-memory"
          ],
          "observed": "2026-10-23",
          "note": "conversations-000.json, -001 ...; conversations.json absent",
          "valid": {
            "from": "2026-02",
            "until": null
          }
        },
        "claim:openai-mapping-tree": {
          "alpha": 9,
          "beta": 1,
          "tier": "B",
          "sources": [
            "mohamed-chs/convoviz",
            "oa-chat",
            "loom export_openai.cpp (our reader)"
          ],
          "observed": "2026-10-23",
          "note": "conversations carry a mapping tree with current_node"
        },
        "claim:chat-html-jsondata": {
          "alpha": 7,
          "beta": 1,
          "tier": "B",
          "sources": [
            "7 independent parsers"
          ],
          "observed": "2026-10-23",
          "note": "chat.html embeds var jsonData = [...] then var assetsJson = {...}"
        },
        "claim:chat-html-ships-in-sharded": {
          "alpha": 3,
          "beta": 2,
          "tier": "B",
          "sources": [
            "CRT-GroundCheck-SSE README (inferred from sizes)",
            "datamoat"
          ],
          "observed": "2026-10-23",
          "note": "a sharded export still has chat.html"
        },
        "claim:openai-user-json": {
          "alpha": 6,
          "beta": 2,
          "tier": "B",
          "sources": [
            "mohamed-chs/convoviz"
          ],
          "observed": "2026-10-23",
          "note": "user.json with the account"
        },
        "claim:openai-2025-extra-files": {
          "alpha": 2,
          "beta": 1,
          "tier": "C",
          "sources": [
            "our fixture generator (assumption, not a provider source)"
          ],
          "observed": "2026-10-23",
          "note": "shared_conversations.json and model_comparisons.json beside conversations.json; distinguishes 2025 from 2023 only weakly"
        },
        "claim:manifest-2026": {
          "alpha": 2,
          "beta": 2,
          "tier": "B-",
          "sources": [
            "Nexus",
            "ChatGPT-Wrapped",
            "datamoat"
          ],
          "observed": "2026-10-23",
          "note": "export_manifest.json; no OpenAI source, two tools generate a file of that name (mimic loop possible)"
        },
        "claim:privacy-portal-zip-in-zip": {
          "alpha": 1,
          "beta": 1,
          "tier": "D",
          "sources": [
            "temnoon/openai_export_parser"
          ],
          "observed": "2026-10-23",
          "note": "privacy portal: one ZIP inside the ZIP"
        },
        "claim:privacy-portal-dat": {
          "alpha": 1,
          "beta": 1,
          "tier": "D",
          "sources": [
            "temnoon/openai_export_parser"
          ],
          "observed": "2026-10-23",
          "note": "media as .dat without an extension"
        },
        "claim:claude-conversations-json": {
          "alpha": 8,
          "beta": 1,
          "tier": "B",
          "sources": [
            "osteele",
            "lordjabez",
            "waggle-os (first-hand check 2026-04-22)"
          ],
          "observed": "2026-10-23",
          "note": "conversations.json at the top"
        },
        "claim:claude-users-json": {
          "alpha": 7,
          "beta": 1,
          "tier": "B",
          "sources": [
            "osteele",
            "lordjabez",
            "waggle-os"
          ],
          "observed": "2026-10-23",
          "note": "users.json beside conversations.json"
        },
        "claim:claude-chat-messages": {
          "alpha": 9,
          "beta": 1,
          "tier": "B",
          "sources": [
            "osteele",
            "lordjabez",
            "loom export_anthropic.cpp (our reader)"
          ],
          "observed": "2026-10-23",
          "note": "conversations carry chat_messages"
        },
        "claim:claude-projects-json": {
          "alpha": 6,
          "beta": 2,
          "tier": "B",
          "sources": [
            "osteele",
            "waggle-os"
          ],
          "observed": "2026-10-23",
          "note": "projects.json"
        },
        "claim:claude-memories-2026": {
          "alpha": 4,
          "beta": 1,
          "tier": "B",
          "sources": [
            "waggle-os (one first-hand check 2026-04-22)"
          ],
          "observed": "2026-10-23",
          "note": "memories.json (optional) in 2026 exports",
          "valid": {
            "from": "2025",
            "until": null
          }
        },
        "claim:claude-no-memories-before-2025": {
          "alpha": 3,
          "beta": 1,
          "tier": "B",
          "sources": [
            "osteele (older exports)"
          ],
          "observed": "2026-10-23",
          "note": "older exports have no memories.json",
          "valid": {
            "from": null,
            "until": "2025"
          }
        },
        "claim:claude-design-chats-2026": {
          "alpha": 2,
          "beta": 1,
          "tier": "B",
          "sources": [
            "waggle-os"
          ],
          "observed": "2026-10-23",
          "note": "design_chats/<uuid>.json; unverified (design doc Annex B p. 5)"
        },
        "claim:gemini-myactivity-path": {
          "alpha": 4,
          "beta": 1,
          "tier": "B",
          "sources": [
            "4 parsers of Takeout My Activity"
          ],
          "observed": "2026-10-23",
          "note": "Takeout: My Activity/Gemini Apps/MyActivity.json or .html"
        },
        "claim:gemini-myactivity-keys": {
          "alpha": 3,
          "beta": 1,
          "tier": "B/A",
          "sources": [
            "4 parsers",
            "generic My Activity schema (search summary)"
          ],
          "observed": "2026-10-23",
          "note": "entries with header, title, time, products"
        }
      },
      "layouts": {
        "openai-single-2023": {
          "class": "export.openai.chatgpt",
          "class_id": "export.openai.chatgpt/single-2023",
          "source_level": "B",
          "label": {
            "pl": "ChatGPT, jeden plik rozmów (2023–2024)",
            "en": "ChatGPT, one conversations file (2023–2024)"
          },
          "observed": {
            "from": "2023-04",
            "until": "2026-02",
            "on": "2026-10-23",
            "basis": [
              "claim:openai-single-conversations-json"
            ]
          },
          "descriptors": [
            {
              "d": "container",
              "arg": "^zip$",
              "claim": "claim:export-is-zip"
            },
            {
              "d": "member_present",
              "arg": "^conversations\\.json$",
              "claim": "claim:openai-single-conversations-json"
            },
            {
              "d": "member_absent",
              "arg": "^conversations-[0-9]+\\.json$",
              "claim": "claim:openai-single-conversations-json"
            },
            {
              "d": "json_keys",
              "member": "^conversations\\.json$",
              "mode": "all",
              "keys": [
                "mapping"
              ],
              "claim": "claim:openai-mapping-tree"
            },
            {
              "d": "member_present",
              "arg": "^user\\.json$",
              "optional": true,
              "claim": "claim:openai-user-json"
            },
            {
              "d": "js_marker",
              "arg": "var jsonData = [",
              "member": "^chat\\.html$",
              "optional": true,
              "claim": "claim:chat-html-jsondata"
            }
          ],
          "unknowns": [
            "the exact release that added each side file"
          ],
          "reader": "chatgpt"
        },
        "openai-single-2025": {
          "class": "export.openai.chatgpt",
          "class_id": "export.openai.chatgpt/single-2025",
          "source_level": "B/C",
          "label": {
            "pl": "ChatGPT, jeden plik rozmów z plikami dodatkowymi (2025)",
            "en": "ChatGPT, one conversations file with side files (2025)"
          },
          "observed": {
            "from": "2025",
            "until": "2026-02",
            "on": "2026-10-23",
            "basis": [
              "claim:openai-single-conversations-json",
              "claim:openai-2025-extra-files"
            ]
          },
          "descriptors": [
            {
              "d": "container",
              "arg": "^zip$",
              "claim": "claim:export-is-zip"
            },
            {
              "d": "member_present",
              "arg": "^conversations\\.json$",
              "claim": "claim:openai-single-conversations-json"
            },
            {
              "d": "member_absent",
              "arg": "^conversations-[0-9]+\\.json$",
              "claim": "claim:openai-single-conversations-json"
            },
            {
              "d": "json_keys",
              "member": "^conversations\\.json$",
              "mode": "all",
              "keys": [
                "mapping"
              ],
              "claim": "claim:openai-mapping-tree"
            },
            {
              "d": "member_present",
              "arg": "^user\\.json$",
              "optional": true,
              "claim": "claim:openai-user-json"
            },
            {
              "d": "js_marker",
              "arg": "var jsonData = [",
              "member": "^chat\\.html$",
              "optional": true,
              "claim": "claim:chat-html-jsondata"
            },
            {
              "d": "member_present",
              "arg": "^(shared_conversations|model_comparisons)\\.json$",
              "optional": true,
              "claim": "claim:openai-2025-extra-files"
            }
          ],
          "unknowns": [
            "what really distinguishes 2025 from 2023 (no provider source)"
          ],
          "reader": "chatgpt"
        },
        "openai-sharded-2026": {
          "class": "export.openai.chatgpt",
          "class_id": "export.openai.chatgpt/sharded-2026",
          "source_level": "A/B",
          "label": {
            "pl": "ChatGPT, rozmowy podzielone na pliki (2026)",
            "en": "ChatGPT, conversations split into shards (2026)"
          },
          "observed": {
            "from": "2026-02",
            "until": null,
            "on": "2026-10-23",
            "basis": [
              "claim:shards-NNN"
            ]
          },
          "descriptors": [
            {
              "d": "container",
              "arg": "^zip$",
              "claim": "claim:export-is-zip"
            },
            {
              "d": "member_present",
              "arg": "^conversations-[0-9]+\\.json$",
              "claim": "claim:shards-NNN"
            },
            {
              "d": "member_absent",
              "arg": "^conversations\\.json$",
              "claim": "claim:shards-NNN"
            },
            {
              "d": "json_keys",
              "member": "^conversations-[0-9]+\\.json$",
              "mode": "all",
              "keys": [
                "mapping"
              ],
              "claim": "claim:openai-mapping-tree"
            },
            {
              "d": "member_present",
              "arg": "^user\\.json$",
              "optional": true,
              "claim": "claim:openai-user-json"
            },
            {
              "d": "member_present",
              "arg": "^chat\\.html$",
              "optional": true,
              "claim": "claim:chat-html-ships-in-sharded"
            },
            {
              "d": "js_marker",
              "arg": "var jsonData = [",
              "member": "^chat\\.html$",
              "optional": true,
              "claim": "claim:chat-html-jsondata"
            },
            {
              "d": "member_present",
              "arg": "^export_manifest\\.json$",
              "optional": true,
              "claim": "claim:manifest-2026"
            }
          ],
          "unknowns": [
            "split rule",
            "jsonData identity with the shards",
            "assetsJson key semantics"
          ],
          "reader": "chatgpt"
        },
        "openai-privacy-portal-2026": {
          "class": "export.openai.chatgpt",
          "class_id": "export.openai.chatgpt/privacy-portal-2026",
          "source_level": "D",
          "label": {
            "pl": "ChatGPT z portalu prywatności (ZIP w ZIP-ie, 2026)",
            "en": "ChatGPT from the privacy portal (ZIP in a ZIP, 2026)"
          },
          "observed": {
            "from": "2026",
            "until": null,
            "on": "2026-10-23",
            "basis": [
              "claim:privacy-portal-zip-in-zip"
            ]
          },
          "descriptors": [
            {
              "d": "container",
              "arg": "^zip$",
              "claim": "claim:export-is-zip"
            },
            {
              "d": "member_count",
              "arg": "\\.zip$",
              "min": 1,
              "max": 1,
              "claim": "claim:privacy-portal-zip-in-zip"
            },
            {
              "d": "member_absent",
              "arg": "^conversations(-[0-9]+)?\\.json$",
              "claim": "claim:privacy-portal-zip-in-zip"
            },
            {
              "d": "member_present",
              "arg": "\\.dat$",
              "optional": true,
              "claim": "claim:privacy-portal-dat"
            }
          ],
          "unknowns": [
            "one source only; the inner archive is not read by the fingerprint yet"
          ],
          "reader": "chatgpt"
        },
        "anthropic-2024-text": {
          "class": "export.anthropic.claude",
          "class_id": "export.anthropic.claude/2024-text",
          "source_level": "B",
          "label": {
            "pl": "Claude, rozmowy i projekty bez wspomnień (do 2025)",
            "en": "Claude, conversations and projects without memories (until 2025)"
          },
          "observed": {
            "from": "2024",
            "until": "2025",
            "on": "2026-10-23",
            "basis": [
              "claim:claude-conversations-json",
              "claim:claude-no-memories-before-2025"
            ]
          },
          "descriptors": [
            {
              "d": "container",
              "arg": "^zip$",
              "claim": "claim:export-is-zip"
            },
            {
              "d": "member_present",
              "arg": "^conversations\\.json$",
              "claim": "claim:claude-conversations-json"
            },
            {
              "d": "member_present",
              "arg": "^users\\.json$",
              "claim": "claim:claude-users-json"
            },
            {
              "d": "json_keys",
              "member": "^conversations\\.json$",
              "mode": "all",
              "keys": [
                "chat_messages"
              ],
              "claim": "claim:claude-chat-messages"
            },
            {
              "d": "member_absent",
              "arg": "^memories\\.json$",
              "claim": "claim:claude-no-memories-before-2025",
              "weight": 0,
              "note": "excluder only: memories.json is optional in 2026 too, so its absence is no evidence for this layout"
            },
            {
              "d": "member_present",
              "arg": "^projects\\.json$",
              "optional": true,
              "claim": "claim:claude-projects-json"
            }
          ],
          "unknowns": [
            "memories.json is optional in 2026 too: without it the two Claude layouts are not told apart"
          ],
          "reader": "claude"
        },
        "anthropic-2026-full": {
          "class": "export.anthropic.claude",
          "class_id": "export.anthropic.claude/2026-full",
          "source_level": "B",
          "label": {
            "pl": "Claude, pełny eksport ze wspomnieniami (2026)",
            "en": "Claude, full export with memories (2026)"
          },
          "observed": {
            "from": "2025",
            "until": null,
            "on": "2026-10-23",
            "basis": [
              "claim:claude-memories-2026"
            ]
          },
          "descriptors": [
            {
              "d": "container",
              "arg": "^zip$",
              "claim": "claim:export-is-zip"
            },
            {
              "d": "member_present",
              "arg": "^conversations\\.json$",
              "claim": "claim:claude-conversations-json"
            },
            {
              "d": "member_present",
              "arg": "^users\\.json$",
              "claim": "claim:claude-users-json"
            },
            {
              "d": "json_keys",
              "member": "^conversations\\.json$",
              "mode": "all",
              "keys": [
                "chat_messages"
              ],
              "claim": "claim:claude-chat-messages"
            },
            {
              "d": "member_present",
              "arg": "^projects\\.json$",
              "optional": true,
              "claim": "claim:claude-projects-json"
            },
            {
              "d": "member_present",
              "arg": "^memories\\.json$",
              "optional": true,
              "claim": "claim:claude-memories-2026"
            },
            {
              "d": "member_present",
              "arg": "^design_chats/[^/]+\\.json$",
              "optional": true,
              "claim": "claim:claude-design-chats-2026"
            }
          ],
          "unknowns": [
            "design_chats/ unverified",
            "attachment bytes absent (dated observation)"
          ],
          "reader": "claude"
        },
        "gemini-takeout-myactivity": {
          "class": "export.google.gemini",
          "class_id": "export.google.gemini/takeout-myactivity",
          "source_level": "B",
          "label": {
            "pl": "Gemini z Google Takeout (Moja aktywność)",
            "en": "Gemini from Google Takeout (My Activity)"
          },
          "observed": {
            "from": "2024",
            "until": null,
            "on": "2026-10-23",
            "basis": [
              "claim:gemini-myactivity-path"
            ]
          },
          "descriptors": [
            {
              "d": "container",
              "arg": "^zip$",
              "claim": "claim:export-is-zip"
            },
            {
              "d": "member_present",
              "arg": "(^|/)(My Activity|Moja aktywność)/(Gemini Apps|Aplikacje Gemini)/MyActivity\\.(json|html)$",
              "weight": 1.5,
              "claim": "claim:gemini-myactivity-path"
            },
            {
              "d": "json_keys",
              "member": "(^|/)MyActivity\\.json$",
              "mode": "all",
              "keys": [
                "header",
                "title",
                "time"
              ],
              "optional": true,
              "claim": "claim:gemini-myactivity-keys"
            }
          ],
          "unknowns": [
            "no conversation id: a flat log",
            "localised folder names other than pl/en"
          ],
          "reader": "gemini_activity"
        }
      }
    },
    "person_content": {
      "node_fields": [
        "label",
        "attrs.name",
        "attrs.file",
        "attrs.title",
        "attrs.title_original",
        "attrs.path",
        "attrs.member"
      ],
      "summary_vars": [
        "file",
        "skipped_names"
      ]
    }
  },
  "value_schema": {
    "type": "object",
    "required": [
      "enabled",
      "language",
      "kind_prefix",
      "metadata_key",
      "container_class_by_format",
      "default_container_class",
      "export_facets_by_provider",
      "links",
      "words",
      "summary"
    ],
    "additionalProperties": true,
    "properties": {
      "enabled": {
        "type": "boolean",
        "x-setting": "/enabled",
        "x-consumer": "loom::import_graph::project (src/import/import_graph.cpp)",
        "description": "false: no import nodes are written; the import itself is unchanged."
      },
      "language": {
        "type": "string",
        "minLength": 1,
        "x-setting": "/language",
        "x-consumer": "loom::import_graph::project",
        "description": "The language of the summary sentence (a preset; every language the templates carry is also returned)."
      },
      "kind_prefix": {
        "type": "string",
        "x-setting": "/kind_prefix",
        "x-consumer": "loom::import_graph::project"
      },
      "metadata_key": {
        "type": "string",
        "minLength": 1,
        "x-setting": "/metadata_key",
        "x-consumer": "loom::import_graph::project, projection reader db.imports"
      },
      "container_class_by_format": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "x-setting": "/container_class_by_format",
        "x-consumer": "loom::import_graph::project"
      },
      "default_container_class": {
        "type": "string",
        "x-setting": "/default_container_class",
        "x-consumer": "loom::import_graph::project"
      },
      "member_class_by_extension": {
        "type": "object",
        "x-setting": "/member_class_by_extension",
        "x-consumer": "loom::import_graph::project"
      },
      "export_facets_by_provider": {
        "type": "object",
        "x-setting": "/export_facets_by_provider",
        "x-consumer": "loom::import_graph::project"
      },
      "entity_class_by_kind": {
        "type": "object",
        "x-setting": "/entity_class_by_kind",
        "x-consumer": "loom::import_graph::project"
      },
      "links": {
        "type": "object",
        "x-setting": "/links",
        "x-consumer": "loom::import_graph::project"
      },
      "words": {
        "type": "object",
        "x-setting": "/words",
        "x-consumer": "loom::import_graph::project"
      },
      "read_dispositions": {
        "type": "array",
        "x-setting": "/read_dispositions",
        "x-consumer": "loom::import_graph::project",
        "description": "Member dispositions that count as read; any other one is named in the summary with its words (or its own token)."
      },
      "summary": {
        "type": "object",
        "x-setting": "/summary",
        "x-consumer": "loom::import_graph::project"
      },
      "archive_formats": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "x-setting": "/archive_formats",
        "x-consumer": "loom::import_graph::project",
        "description": "Formats whose members are written as archive_member nodes; a bare file is its own single member and gets no entry node (open list)."
      },
      "layout_fingerprint": {
        "type": "object",
        "x-setting": "/layout_fingerprint",
        "x-consumer": "loom::import_graph::fingerprint_layout (src/import/layout_fingerprint.cpp)",
        "description": "The layout fingerprint as data (design §2.3-2.4): claims with Beta reliabilities (alpha/beta are hand-set priors, dated observations with a source tier, never constraints) and layout profiles = conjunctions of descriptors of a closed dictionary. A new provider or version is a new entry here or in the overlay. Thresholds are presets."
      },
      "person_content": {
        "type": "object",
        "x-setting": "/person_content",
        "x-consumer": "loom::import_graph::project, projection reader db.imports, web audit",
        "description": "Which values are the person's own content (file names, titles, e-mail): node fields and summary variables. The web shows them as content and the words audit skips exactly them."
      }
    }
  }
}
