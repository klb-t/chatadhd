{
  "schema": "loom.runtime_profile/1",
  "domain": "actions_storage",
  "revision": 1,
  "description": "Action catalogue entries for the storage port (loom_invoke port \"storage\"), schema loom.action_catalogue/1 plus http and per-parameter descriptions. Effects are open strings (read_only|writes|sends_off_device|costs|irreversible|private_data|...). TODO(S2-R3): merge into actions.pack after P7 lands. Defaults are presets; overlay profiles/actions_storage.pack can hide or edit entries.",
  "defaults": {
    "catalogue_schema": "loom.action_catalogue/1",
    "actions": [
      {
        "id": "storage.status",
        "port": "storage",
        "action": "status",
        "kind": "atomic",
        "status": "wired",
        "description": {
          "en": "Backends, placement and state of every category",
          "pl": "Magazyny, rozmieszczenie i stan kategorii"
        },
        "inputs": [],
        "outputs": [
          {
            "name": "result",
            "type": "object",
            "description": {
              "en": "Result JSON of the storage service",
              "pl": "Wynik usługi magazynu"
            }
          }
        ],
        "required_traits": [],
        "effects": [
          "read_only"
        ],
        "http": {
          "verb": "GET",
          "path": "/api/storage/status"
        }
      },
      {
        "id": "storage.probe",
        "port": "storage",
        "action": "probe",
        "kind": "atomic",
        "status": "wired",
        "description": {
          "en": "Probe every configured backend",
          "pl": "Sprawdź każdy skonfigurowany magazyn"
        },
        "inputs": [],
        "outputs": [
          {
            "name": "result",
            "type": "object",
            "description": {
              "en": "Result JSON of the storage service",
              "pl": "Wynik usługi magazynu"
            }
          }
        ],
        "required_traits": [],
        "effects": [
          "read_only",
          "sends_off_device"
        ],
        "http": {
          "verb": "GET",
          "path": "/api/storage/probe"
        }
      },
      {
        "id": "storage.kinds",
        "port": "storage",
        "action": "kinds",
        "kind": "atomic",
        "status": "wired",
        "description": {
          "en": "Available backend kinds",
          "pl": "Dostępne rodzaje magazynów"
        },
        "inputs": [],
        "outputs": [
          {
            "name": "result",
            "type": "object",
            "description": {
              "en": "Result JSON of the storage service",
              "pl": "Wynik usługi magazynu"
            }
          }
        ],
        "required_traits": [],
        "effects": [
          "read_only"
        ],
        "http": {
          "verb": "GET",
          "path": "/api/storage/kinds"
        }
      },
      {
        "id": "storage.placement",
        "port": "storage",
        "action": "placement",
        "kind": "atomic",
        "status": "wired",
        "description": {
          "en": "Placement of one or all categories",
          "pl": "Rozmieszczenie jednej lub wszystkich kategorii"
        },
        "inputs": [
          {
            "name": "category",
            "type": "string",
            "required": false,
            "description": {
              "en": "Category id; empty = all",
              "pl": "Kategoria; puste = wszystkie"
            },
            "has_default": true,
            "edit": "choice:categories",
            "default": ""
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "object",
            "description": {
              "en": "Result JSON of the storage service",
              "pl": "Wynik usługi magazynu"
            }
          }
        ],
        "required_traits": [],
        "effects": [
          "read_only"
        ],
        "http": {
          "verb": "GET",
          "path": "/api/storage/placement",
          "query": [
            {
              "name": "category",
              "always": false
            }
          ]
        }
      },
      {
        "id": "storage.locate",
        "port": "storage",
        "action": "locate",
        "kind": "atomic",
        "status": "wired",
        "description": {
          "en": "Where the graph says an object is held",
          "pl": "Gdzie według grafu znajduje się obiekt"
        },
        "inputs": [
          {
            "name": "hash",
            "type": "string",
            "required": true,
            "description": {
              "en": "Content hash of the object",
              "pl": "Skrót treści obiektu"
            },
            "has_default": false,
            "edit": "free_text"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "object",
            "description": {
              "en": "Result JSON of the storage service",
              "pl": "Wynik usługi magazynu"
            }
          }
        ],
        "required_traits": [
          "has_hash"
        ],
        "effects": [
          "read_only"
        ],
        "http": {
          "verb": "GET",
          "path": "/api/storage/locate",
          "query": [
            {
              "name": "hash",
              "always": true
            }
          ]
        }
      },
      {
        "id": "storage.copy",
        "port": "storage",
        "action": "copy",
        "kind": "atomic",
        "status": "wired",
        "description": {
          "en": "Copy a category to another backend",
          "pl": "Skopiuj kategorię do innego magazynu"
        },
        "inputs": [
          {
            "name": "category",
            "type": "string",
            "required": true,
            "description": {
              "en": "Storage category id (see storage.status)",
              "pl": "Identyfikator kategorii danych (zob. storage.status)"
            },
            "has_default": false,
            "edit": "choice:categories"
          },
          {
            "name": "to",
            "type": "string",
            "required": true,
            "description": {
              "en": "Target backend id",
              "pl": "Identyfikator docelowego magazynu"
            },
            "has_default": false,
            "edit": "choice:backends"
          },
          {
            "name": "dry_run",
            "type": "boolean",
            "required": false,
            "description": {
              "en": "Only report what would happen",
              "pl": "Tylko pokaż, co by się stało"
            },
            "has_default": true,
            "edit": "toggle",
            "default": false
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "object",
            "description": {
              "en": "Result JSON of the storage service",
              "pl": "Wynik usługi magazynu"
            }
          }
        ],
        "required_traits": [],
        "effects": [
          "writes",
          "sends_off_device",
          "private_data"
        ],
        "http": {
          "verb": "POST",
          "path": "/api/storage/copy"
        }
      },
      {
        "id": "storage.move",
        "port": "storage",
        "action": "move",
        "kind": "atomic",
        "status": "wired",
        "description": {
          "en": "Move a category to another backend",
          "pl": "Przenieś kategorię do innego magazynu"
        },
        "inputs": [
          {
            "name": "category",
            "type": "string",
            "required": true,
            "description": {
              "en": "Storage category id (see storage.status)",
              "pl": "Identyfikator kategorii danych (zob. storage.status)"
            },
            "has_default": false,
            "edit": "choice:categories"
          },
          {
            "name": "to",
            "type": "string",
            "required": true,
            "description": {
              "en": "Target backend id",
              "pl": "Identyfikator docelowego magazynu"
            },
            "has_default": false,
            "edit": "choice:backends"
          },
          {
            "name": "delete_source",
            "type": "boolean",
            "required": false,
            "description": {
              "en": "Remove the data from the source after a verified copy",
              "pl": "Usuń dane ze źródła po zweryfikowanej kopii"
            },
            "has_default": true,
            "edit": "toggle",
            "default": false
          },
          {
            "name": "dry_run",
            "type": "boolean",
            "required": false,
            "description": {
              "en": "Only report what would happen",
              "pl": "Tylko pokaż, co by się stało"
            },
            "has_default": true,
            "edit": "toggle",
            "default": false
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "object",
            "description": {
              "en": "Result JSON of the storage service",
              "pl": "Wynik usługi magazynu"
            }
          }
        ],
        "required_traits": [],
        "effects": [
          "writes",
          "sends_off_device",
          "private_data",
          "irreversible"
        ],
        "http": {
          "verb": "POST",
          "path": "/api/storage/move"
        }
      },
      {
        "id": "storage.backup",
        "port": "storage",
        "action": "backup",
        "kind": "atomic",
        "status": "wired",
        "description": {
          "en": "Back up the database to a backend",
          "pl": "Kopia zapasowa bazy do magazynu"
        },
        "inputs": [
          {
            "name": "to",
            "type": "string",
            "required": true,
            "description": {
              "en": "Target backend id",
              "pl": "Identyfikator docelowego magazynu"
            },
            "has_default": false,
            "edit": "choice:backends"
          },
          {
            "name": "what",
            "type": "string",
            "required": false,
            "description": {
              "en": "What to back up",
              "pl": "Co skopiować"
            },
            "has_default": true,
            "edit": "choice:database",
            "default": "database"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "object",
            "description": {
              "en": "Result JSON of the storage service",
              "pl": "Wynik usługi magazynu"
            }
          }
        ],
        "required_traits": [],
        "effects": [
          "writes",
          "sends_off_device",
          "private_data"
        ],
        "http": {
          "verb": "POST",
          "path": "/api/storage/backup"
        }
      }
    ]
  },
  "value_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "catalogue_schema",
      "actions"
    ],
    "properties": {
      "catalogue_schema": {
        "type": "string"
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "port",
            "action",
            "kind",
            "status",
            "description",
            "inputs",
            "outputs",
            "required_traits",
            "effects",
            "http"
          ]
        }
      }
    }
  }
}
