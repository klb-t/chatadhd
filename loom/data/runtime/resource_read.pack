{
  "schema": "loom.runtime_profile/1",
  "domain": "resource_read",
  "revision": 1,
  "description": "Independent catalog projection persistence and content indexing. Transient reads keep derived payload in memory. Existing snapshots are retained, never silently purged. Local access does not grant model disclosure.",
  "defaults": {
    "projection_storage": "snapshot",
    "content_index": "sketch"
  },
  "value_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "projection_storage",
      "content_index"
    ],
    "properties": {
      "projection_storage": {
        "type": "string",
        "enum": [
          "snapshot",
          "transient"
        ]
      },
      "content_index": {
        "type": "string",
        "enum": [
          "sketch",
          "none"
        ]
      }
    }
  }
}
