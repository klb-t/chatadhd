{
  "schema": "loom.runtime_profile/1",
  "domain": "media",
  "revision": 1,
  "description": "Default transport/results equal legacy; confidence placeholders are compatibility priors, not measured provider confidence. Supported adapters instantiate from descriptors; new adapter semantics require code.",
  "defaults": {
    "defaults_by_adapter": {
      "groq_whisper": "groq",
      "google_speech": "google",
      "ocr_space": "ocr.space"
    },
    "asr_order": [
      "groq",
      "google"
    ],
    "ocr_order": [
      "ocr.space"
    ],
    "error_body_chars": 500,
    "providers": {
      "groq": {
        "name": "groq",
        "adapter": "groq_whisper",
        "secret_key": "groq_api_key",
        "endpoint": "https://api.groq.com/openai/v1/audio/transcriptions",
        "timeout_ms": 60000,
        "headers": {},
        "format_map": {
          "mp3": "mp3",
          "wav": "wav",
          "m4a": "mp4",
          "ogg": "ogg",
          "webm": "webm"
        },
        "default_format": "wav",
        "model": "whisper-large-v3-turbo",
        "response_format": "verbose_json",
        "max_segments": 5,
        "placeholder_confidence": 0.9
      },
      "google": {
        "name": "google",
        "adapter": "google_speech",
        "secret_key": "google_speech_api_key",
        "endpoint": "https://speech.googleapis.com/v1/speech:recognize",
        "timeout_ms": 60000,
        "headers": {
          "Content-Type": "application/json"
        },
        "encoding_map": {
          "wav": "LINEAR16",
          "mp3": "MP3",
          "ogg": "OGG_OPUS",
          "flac": "FLAC",
          "webm": "WEBM_OPUS"
        },
        "default_encoding": "LINEAR16",
        "default_language": "en-US",
        "max_alternatives": 5,
        "word_confidence": true,
        "word_time_offsets": true
      },
      "ocr.space": {
        "name": "ocr.space",
        "adapter": "ocr_space",
        "secret_key": "ocr_space_api_key",
        "endpoint": "https://api.ocr.space/parse/image",
        "timeout_ms": 60000,
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "language_map": {
          "en": "eng",
          "pl": "pol",
          "de": "ger",
          "fr": "fre",
          "es": "spa",
          "it": "ita",
          "nl": "dut",
          "pt": "por",
          "ru": "rus",
          "zh": "chs",
          "ja": "jpn",
          "ko": "kor"
        },
        "default_language": "eng",
        "engine": 2,
        "is_table": "True",
        "scale": "True",
        "overlay_placeholder_confidence": 0.9,
        "text_placeholder_confidence": 0.85
      }
    }
  },
