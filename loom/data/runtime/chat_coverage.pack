        },
        "surfaces": {
          "c_abi": [
            "loom_graph_packet_store",
            "loom_packet"
          ],
          "http": [
            "POST /api/graph/packets/store",
            "POST /api/packet"
          ]
        }
      },
      {
        "id": "ports_graph",
        "category": "internal",
        "reason": {
          "en": "Writes the adapters and the role choices into the graph as nodes for the graph view; maintenance, not a user operation.",
          "pl": "Zapisuje adaptery i wybory ról w grafie jako węzły dla widoku grafu; konserwacja, nie operacja użytkownika."
        },
        "surfaces": {
          "invoke": [
            "ports.graph"
          ]
        }
      },
      {
        "id": "artifact_content",
        "category": "display",
        "reason": {
          "en": "The bytes of an artifact are opened by the window (an image, a file), not run as an operation.",
          "pl": "Bajty artefaktu otwiera okienko (obraz, plik); to nie jest operacja."
        },
        "surfaces": {
          "c_abi": [
            "loom_get_artifact"
          ],
          "http": [
            "GET /api/artifacts/:id",
            "GET /api/artifacts/:id/raw"
          ]
        }
      },
      {
        "id": "health",
        "category": "health",
        "reason": {
          "en": "A liveness probe for the process manager, not something to ask the model.",
          "pl": "Sonda żywotności dla menedżera procesów, nie coś do pytania modelu."
        },
        "surfaces": {
          "http": [
            "GET /api/healthz"
          ]
        }
      },
      {
        "id": "pipeline_stages",
        "category": "internal",
        "reason": {
          "en": "Single stages of the knowledge pipeline (judge, extraction preview, prediction, lineage, materialisation); they are driven by a knowledge run and have no standalone user operation.",
          "pl": "Pojedyncze etapy potoku wiedzy (ocena, podgląd ekstrakcji, predykcja, rodowód, materializacja); napędza je przebieg wiedzy, nie mają samodzielnej operacji użytkownika."
        },
        "surfaces": {
          "c_abi": [
            "loom_kb_judge",
            "loom_extract_preview",
            "loom_generalize_predict",
            "loom_resolve_lineage",
            "loom_materialize"
          ]
        }
      },
      {
        "id": "session",
        "category": "session",
        "reason": {
          "en": "Signing in, out, registering and changing the own password are the session of the transport (the account of the server); a password never passes through the conversation, and the kernel does not see who is signed in.",
          "pl": "Logowanie, wylogowanie, rejestracja i zmiana własnego hasła to sesja transportu (konto serwera); hasło nie przechodzi przez rozmowę, a jądro nie widzi, kto jest zalogowany."
        },
        "surfaces": {
          "http": [
            "GET /api/auth/me",
            "POST /api/auth/login",
            "POST /api/auth/logout",
            "POST /api/auth/password",
            "POST /api/auth/register"
          ]
        }
      },
      {
        "id": "credentials",
        "category": "secret",
        "reason": {
          "en": "A key, token or passphrase typed into the conversation would be stored in the history and sent to the provider (rule deny:settings.set:secret); they are entered in Settings. The proposal says which field to open.",
          "pl": "Klucz, token albo hasło wpisane w rozmowie trafiłoby do historii i do dostawcy (reguła deny:settings.set:secret); wpisuje się je w Ustawieniach. Propozycja mówi, które pole otworzyć."
        },
        "surfaces": {
          "c_abi": [
            "loom_set_secret",
            "loom_delete_secret",
            "loom_crypto_setup",
            "loom_crypto_unlock",
            "loom_crypto_lock",
            "loom_crypto_encrypt",
            "loom_crypto_decrypt"
          ],
          "http": [
            "POST /api/secrets/:id",
            "DELETE /api/secrets/:id"
          ],
          "settings": [
            "key:api_key",
            "key:anthropic_batch_key",
            "key:github_token",
            "key:groq_api_key",
            "key:google_speech_api_key",
            "key:ocr_space_api_key",
            "group:credentials"
          ]
        }
      },
      {
        "id": "internal_setting",
        "category": "internal",
        "reason": {
          "en": "The version of the config format is kept by the auto-upgrade; the rule edit:config:_config_version refuses writes.",
          "pl": "Wersję formatu konfiguracji prowadzi automatyczna aktualizacja; reguła edit:config:_config_version odrzuca zapisy."
        },
        "surfaces": {
          "settings": [
            "key:_config_version",
            "group:internal"
          ]
        }
      },
      {
        "id": "device_plumbing",
        "category": "transport",
        "reason": {
          "en": "A client tells the kernel what its device can do and hands over the bytes of a recording; the person talks, the client plumbing is not a command.",
          "pl": "Klient mówi jądru, co potrafi jego urządzenie, i przekazuje bajty nagrania; człowiek mówi, a instalacja klienta nie jest poleceniem."
        },
        "surfaces": {
          "http": [
            "POST /api/client/capabilities",
            "POST /api/client/declare",
            "POST /api/client/blob/upload",
            "GET /api/client/blob/:hash/raw"
          ],
          "invoke": [
            "actions.client.declare",
            "actions.client.capabilities",
            "actions.client.blob_put",
            "actions.client.blob_path",
            "actions.client.blob_begin",
            "actions.client.blob_append",
            "actions.client.blob_commit",
            "actions.client.blob_read"
          ]
        }
      },
      {
