{
  "schema": "loom.runtime_profile/1",
  "domain": "chat_coverage",
  "revision": 1,
  "description": "R54 audit as data: everything the user can do must be possible from the conversation window. Every surface of the kernel (a C ABI function, an HTTP route, a loom_invoke operation, a JNI symbol, a settings group or secret) is listed exactly once, as a capability that an action reaches from the conversation (`capabilities`), as something that is not from the chat with a reason (`not_from_chat`), or as a known gap with its plan (`open`). The test tests/test_chat_coverage.cpp fails when the registry (data/graph/interfaces.pack), the settings fields or the loom_invoke dispatcher show a surface that is on none of the three lists, when a list names a surface that is gone, when an action named here is missing, planned or not runnable, and when an example sentence does not reach its action through the router. via: action (an action of the catalogue), native (the window itself), emergent (offered as a proposal by the growing catalogue). check: route (the examples are routed; the default for actions that have them), phrases (the action carries phrases). Everything here is data: an overlay may add entries; nothing is a limit.",
  "defaults": {
    "schema": "loom.chat_coverage/1",
    "sources": {
      "c_abi": "data/graph/interfaces.pack interfaces.c_abi",
      "http": "data/graph/interfaces.pack interfaces.http + interfaces.web (one namespace: \"VERB /path\", parameters as :id)",
      "jni": "data/graph/interfaces.pack interfaces.jni",
      "invoke": "port.operation of loom_invoke, found in src/capi/capi_invoke.cpp, src/actions/runner.cpp (ActionRunner::invoke), src/actions/query.cpp, src/storage/storage_command.cpp and src/capi/capi_media.cpp (github)",
      "settings": "group:<group> of every field of runtime/settings_fields.pack, key:<key> for secrets and internal keys"
    },
    "invoke_ports": {
      "actions": "actions.*",
      "storage": "storage.*",
      "github": "github.*",
      "chat": "chat.*",
      "ports": "ports.*"
    },
    "capabilities": [
      {
        "id": "chat",
        "title": {
          "en": "Talk to the model",
          "pl": "Rozmowa z modelem"
        },
        "via": "native",
        "surfaces": {
          "c_abi": [
            "loom_chat",
            "loom_chat_ex",
            "loom_chat_cancel"
          ],
          "http": [
            "POST /api/chat",
            "POST /api/chat/cancel",
            "POST /api/chat/route",
            "POST /api/chat/usage-preview",
            "POST /api/graph-reply"
          ],
          "invoke": [
            "chat.route"
          ]
        },
        "note": {
          "en": "The window itself: a message is sent, an answer streams, a command is told apart from a message by the router.",
          "pl": "Samo okienko: wiadomość jest wysyłana, odpowiedź płynie, a polecenie router odróżnia od wiadomości."
        }
      },
      {
        "id": "proposal_flow",
        "title": {
          "en": "Answer a proposal: yes, no, cancel",
          "pl": "Odpowiedź na propozycję: tak, nie, anuluj"
        },
        "via": "native",
        "surfaces": {
          "http": [
            "POST /api/actions/run",
            "POST /api/actions/confirm",
            "POST /api/actions/cancel",
            "POST /api/actions/preview",
            "POST /api/actions/client_result"
          ],
          "invoke": [
            "actions.run",
            "actions.confirm",
            "actions.cancel",
            "actions.preview",
            "actions.client_result"
          ]
        },
        "note": {
          "en": "\"yes\" / \"no\" in the conversation (and the buttons of the proposal block) are these calls; a device step is answered by the client.",
          "pl": "„tak” / „nie” w rozmowie (i przyciski bloku propozycji) to te wywołania; krok urządzenia odpowiada klient."
        }
      },
      {
        "id": "retrieval",
        "title": {
          "en": "Context the conversation uses on each message",
          "pl": "Kontekst, którego rozmowa używa przy każdej wiadomości"
        },
        "via": "native",
        "surfaces": {
          "c_abi": [
            "loom_select_context",
            "loom_select_context_ex",
            "loom_context_build"
          ],
          "http": [
            "POST /api/context/select",
            "POST /api/context/build"
          ]
        },
        "note": {
          "en": "The retrieval of every message; to look at what is connected, ask for the graph around a name.",
          "pl": "Wyszukiwanie przy każdej wiadomości; żeby zajrzeć w powiązania, poproś o graf wokół nazwy."
        }
      },
      {
        "id": "rules_set",
        "title": {
          "en": "Write a rule or a scoped value",
          "pl": "Zapisz regułę albo wartość w zakresie"
        },
        "via": "action",
        "action": "rules.set",
        "surfaces": {
          "http": [
            "POST /api/rules/set"
          ],
          "invoke": [
            "actions.rules.set"
          ]
        },
        "examples": {
          "pl": "w tej rozmowie ustaw action_result_target=conversation_message",
          "en": "for this conversation set action_result_target to conversation_message"
        }
      },
      {
        "id": "rules_disable",
        "title": {
          "en": "Switch a rule off",
          "pl": "Wyłącz regułę"
        },
        "via": "action",
        "action": "rules.disable",
        "surfaces": {
          "http": [
            "POST /api/rules/disable"
          ],
          "invoke": [
            "actions.rules.disable"
          ]
        },
        "examples": {
          "pl": "wyłącz regułę user:person:confirm:depict",
          "en": "disable the rule user:person:confirm:depict"
        }
      },
      {
        "id": "rules_list",
        "title": {
          "en": "Show the rules",
          "pl": "Pokaż reguły"
        },
        "via": "action",
        "action": "rules.list",
        "surfaces": {
          "http": [
            "POST /api/rules/list"
          ],
          "invoke": [
            "actions.rules.list"
          ]
        },
        "examples": {
          "pl": "pokaż moje reguły",
          "en": "show my rules"
        }
      },
      {
        "id": "define_action",
        "title": {
          "en": "A new action from what is said",
          "pl": "Nowa akcja z tego, co powiedziano"
        },
        "via": "emergent",
        "action": "actions.define",
        "surfaces": {
          "http": [
            "POST /api/actions/define"
          ],
          "invoke": [
            "actions.actions.define"
          ]
        },
        "note": {
          "en": "Offered as a proposal when a sentence looks like a command nothing understands (\"rozpisz tę wiadomość na kroki\"); \"yes\" writes it to the user overlay.",
          "pl": "Proponowana, gdy zdanie wygląda na polecenie, którego nic nie rozumie („rozpisz tę wiadomość na kroki”); „tak” zapisuje ją w nakładce użytkownika."
        }
      },
      {
        "id": "remove_action",
        "title": {
          "en": "Take an own action back",
          "pl": "Wycofaj własną akcję"
        },
        "via": "action",
        "action": "actions.remove",
        "surfaces": {
          "http": [
            "POST /api/actions/remove"
          ],
          "invoke": [
            "actions.actions.remove"
          ]
        },
        "examples": {
          "pl": "usuń akcję rozpisz",
          "en": "remove the action rozpisz"
        }
      },
      {
        "id": "define_group",
        "title": {
          "en": "A new group of actions or elements",
          "pl": "Nowa grupa akcji albo elementów"
        },
        "via": "emergent",
        "action": "groups.define",
        "surfaces": {
          "http": [
            "POST /api/groups/define"
          ],
          "invoke": [
            "actions.groups.define"
          ]
        },
        "note": {
          "en": "Offered when an own action is used on several classes of elements.",
          "pl": "Proponowana, gdy własna akcja jest używana na kilku klasach elementów."
        }
      },
      {
        "id": "remove_group",
        "title": {
          "en": "Take a group back",
          "pl": "Wycofaj grupę"
        },
        "via": "action",
        "action": "groups.remove",
        "surfaces": {
          "http": [
            "POST /api/groups/remove"
          ],
          "invoke": [
            "actions.groups.remove"
          ]
        },
        "examples": {
          "pl": "usuń grupę moja_grupa",
          "en": "remove the group my_group"
        }
      },
      {
        "id": "settings_set",
        "title": {
          "en": "Change a setting",
          "pl": "Zmień ustawienie"
        },
        "via": "action",
        "action": "settings.set",
        "surfaces": {
          "c_abi": [
            "loom_set_config",
            "loom_set_config_json"
          ],
          "http": [
            "PATCH /api/config",
            "PUT /api/config/:id",
            "POST /api/semantic/retry-mode"
          ],
          "settings": [
            "group:catalog",
            "group:chat",
            "group:context",
            "group:loom",
            "group:memory",
            "group:safety",
            "group:semantic",
            "group:sync",
            "group:ui",
            "group:usage"
          ]
        },
        "examples": {
          "pl": "ustaw temperature=0.3",
          "en": "set temperature to 0.3"
        },
        "note": {
          "en": "Every setting of a group, with its edit rules; credentials and the internal version are listed under not_from_chat.",
          "pl": "Każde ustawienie grupy, z jego regułami edycji; poświadczenia i wersja wewnętrzna są na liście „nie z czatu”."
        }
      },
      {
        "id": "settings_get",
        "title": {
          "en": "Read a setting (a secret only says whether it is set)",
          "pl": "Odczytaj ustawienie (sekret mówi tylko, czy jest ustawiony)"
        },
        "via": "action",
        "action": "settings.get",
        "surfaces": {
          "c_abi": [
            "loom_get_config",
            "loom_has_secret",
            "loom_list_secret_keys"
          ],
          "http": [
            "GET /api/config",
            "GET /api/secrets",
            "GET /api/secrets/:id/has"
          ]
        },
        "examples": {
          "pl": "pokaż temperature",
          "en": "show temperature"
        }
      },
      {
        "id": "media_recognition",
        "title": {
          "en": "Speech and text from a recording or an image",
          "pl": "Tekst z nagrania albo obrazu"
        },
        "via": "action",
        "action": "transcribe",
        "surfaces": {
          "c_abi": [
            "loom_transcribe",
            "loom_ocr"
          ],
          "http": [
            "POST /api/media/transcribe"
          ]
        },
        "check": "phrases",
        "also": [
          "ocr"
        ]
      }
    ],
    "not_from_chat": [
      {
        "id": "conversation_view",
        "category": "display",
        "reason": {
          "en": "What the window shows by itself: a conversation, its messages and its view are the content of the window, not an operation.",
          "pl": "To, co okienko pokazuje samo: rozmowa, jej wiadomości i widok są treścią okienka, a nie operacją."
        },
        "surfaces": {
          "c_abi": [
            "loom_get_conversation",
            "loom_get_messages",
            "loom_get_messages_ex",
            "loom_get_message",
            "loom_read_conversation_view"
