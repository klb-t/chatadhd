          "http": [
            "GET /api/conversations/:id",
            "GET /api/conversations/:id/messages",
            "GET /api/conversations/:id/view",
            "POST /api/conversations/:id/view",
            "GET /api/messages/:id"
          ]
        }
      },
      {
        "id": "graph_packets",
        "category": "internal",
        "reason": {
