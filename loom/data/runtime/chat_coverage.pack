  "value_schema": {
    "type": "object",
    "required": [
      "schema",
      "capabilities",
      "not_from_chat",
      "open"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "enum": [
          "loom.chat_coverage/1"
        ]
      },
      "sources": {
        "type": "object"
      },
      "invoke_ports": {
        "type": "object"
      },
      "capabilities": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "via"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "object"
            },
            "via": {
              "type": "string",
              "enum": [
                "action",
                "native",
                "emergent"
              ]
            },
            "action": {
              "type": "string"
            },
            "surfaces": {
              "type": "object"
            },
            "examples": {
              "type": "object"
            },
            "check": {
              "type": "string",
              "enum": [
                "route",
                "phrases"
              ]
            },
            "note": {
              "type": "object"
            },
            "also": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "not_from_chat": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "category",
            "reason",
            "surfaces"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "object"
            },
            "surfaces": {
              "type": "object"
            }
          }
        }
      },
      "open": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "reason",
            "plan",
            "surfaces"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "object"
            },
            "reason": {
              "type": "object"
            },
            "plan": {
