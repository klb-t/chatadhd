            "GET /api/methods/chat-settings",
            "POST /api/methods",
            "POST /api/analysis"
          ]
        }
      },
      {
        "id": "onboarding",
        "title": {
          "en": "Getting to know the user (guided questions)",
          "pl": "Poznawanie użytkownika (pytania prowadzące)"
        },
        "reason": {
          "en": "A guided flow of questions with its own store; asking the questions in the conversation is a design of its own.",
          "pl": "Prowadzony przebieg pytań z własnym magazynem; zadawanie pytań w rozmowie to osobny projekt."
        },
        "plan": {
          "en": "A composite action that asks one question per message and writes the answers through the onboarding store.",
          "pl": "Akcja złożona zadająca jedno pytanie na wiadomość i zapisująca odpowiedzi przez magazyn onboardingu."
        },
        "surfaces": {
          "http": [
            "POST /api/onboarding"
          ]
        }
      },
      {
        "id": "catalog_review",
        "title": {
          "en": "Review the catalogue unit by unit",
          "pl": "Przegląd katalogu jednostka po jednostce"
        },
        "reason": {
          "en": "Scoring against the self-profile, selection and the owner's include / exclude / pin overrides are decisions per unit; a spoken form needs a way to name a unit and shows the reasons of the score first.",
          "pl": "Ocena względem profilu własnego, wybór oraz nadpisania właściciela (włącz / wyklucz / przypnij) to decyzje per jednostka; mówiona postać potrzebuje sposobu wskazania jednostki i najpierw pokazuje powody oceny."
        },
        "plan": {
          "en": "catalog.score, catalog.select as read-only answers, catalog.override and catalog.import as proposals that list the units and the bytes before \"yes\".",
          "pl": "catalog.score, catalog.select jako odpowiedzi tylko do odczytu, catalog.override i catalog.import jako propozycje, które przed „tak” wypisują jednostki i bajty."
        },
        "surfaces": {
          "c_abi": [
            "loom_catalog_import",
            "loom_catalog_override",
            "loom_catalog_preview",
            "loom_catalog_score",
            "loom_catalog_select"
          ],
          "http": [
            "GET /api/catalog/units/:id",
            "POST /api/catalog/import",
            "POST /api/catalog/override",
            "POST /api/catalog/score",
            "POST /api/catalog/select"
          ]
        }
      },
      {
        "id": "knowledge_query",
        "title": {
          "en": "Ask the built knowledge",
          "pl": "Zapytaj zbudowaną wiedzę"
        },
        "reason": {
          "en": "A question to the claims, entities and models of a knowledge run is a query language of its own (what, filters); asking it in words needs a mapping from the sentence to that query, shown before it is run.",
          "pl": "Pytanie do twierdzeń, bytów i modeli przebiegu wiedzy to osobny język zapytań (co, filtry); pytanie słowami wymaga odwzorowania zdania na to zapytanie, pokazanego przed uruchomieniem."
        },
        "plan": {
          "en": "knowledge.query {what, subject} as a read-only answer that prints the query it made.",
          "pl": "knowledge.query {what, subject} jako odpowiedź tylko do odczytu, która drukuje zrobione zapytanie."
        },
        "surfaces": {
          "c_abi": [
            "loom_kb_query"
          ],
          "http": [
            "POST /api/knowledge/query"
          ]
        }
      }
    ]
  },
  "value_schema": {
    "type": "object",
    "required": [
      "schema",
      "capabilities",
      "not_from_chat",
      "open"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "enum": [
          "loom.chat_coverage/1"
        ]
      },
      "sources": {
        "type": "object"
      },
      "invoke_ports": {
        "type": "object"
      },
      "capabilities": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "via"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "object"
            },
            "via": {
              "type": "string",
              "enum": [
                "action",
                "client",
                "native",
                "emergent"
              ]
            },
            "action": {
              "type": "string"
            },
            "surfaces": {
              "type": "object"
            },
            "examples": {
              "type": "object"
            },
            "check": {
              "type": "string",
              "enum": [
                "route",
                "phrases",
                "continuation"
              ]
            },
            "chat_outcome": {
              "type": "string",
              "enum": [
                "pending",
                "executed",
                "unavailable",
                "continuation"
              ],
              "description": "What the example sentences do as chat text; pending when absent."
            },
            "chat_outcome_reason": {
              "type": "object",
              "description": "Why, in pl and en: required for unavailable and continuation."
            },
            "note": {
              "type": "object"
            },
            "also": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "not_from_chat": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "category",
            "reason",
            "surfaces"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "object"
            },
            "surfaces": {
              "type": "object"
            }
          }
        }
      },
      "open": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "reason",
            "plan",
            "surfaces"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "object"
            },
            "reason": {
              "type": "object"
            },
            "plan": {
              "type": "object"
            },
            "surfaces": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
