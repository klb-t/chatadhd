        "examples": {
          "pl": "przerwij analizę archiwum",
          "en": "stop the archive analysis"
        },
        "note": {
          "en": "Pauses at the next checkpoint; the same analysis started again resumes.",
          "pl": "Wstrzymuje w najbliższym punkcie kontrolnym; ta sama analiza uruchomiona ponownie jedzie dalej."
        }
      },
      {
