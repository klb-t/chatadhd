    "open": [
      {
        "id": "semantic_usage_confirm",
        "title": {
          "en": "Answer the x10 question of the analysis",
          "pl": "Odpowiedz na pytanie ×10 analizy"
        },
        "reason": {
          "en": "The guard's own question needs a place in the conversation (a message carrying its receipt); a chat proposal must never cover it.",
          "pl": "Pytanie samego strażnika potrzebuje miejsca w rozmowie (wiadomości z jego pokwitowaniem); propozycja z czatu nie może go zastępować."
        },
        "plan": {
          "en": "semantic.status posts the pending question as a block with the receipt, the same shape as usage_pending of a chat send.",
          "pl": "semantic.status wystawia oczekujące pytanie jako blok z pokwitowaniem, w kształcie usage_pending zwykłej wiadomości."
        },
        "surfaces": {
          "http": [
            "POST /api/semantic/usage-confirm"
          ]
        }
      },
      {
        "id": "archive",
        "title": {
          "en": "Archive Intelligence (Project Compiler)",
          "pl": "Inteligencja archiwum (Project Compiler)"
        },
        "reason": {
          "en": "A batch pipeline with a structured configuration (folders on the machine, profiles); the spoken form of that configuration is not designed yet.",
          "pl": "Potok wsadowy ze strukturalną konfiguracją (foldery na maszynie, profile); mówiona postać tej konfiguracji nie jest jeszcze zaprojektowana."
        },
        "plan": {
          "en": "archive.run {path, name}, archive.status, archive.cancel as actions with the path rules of PathPolicy; the progress as a message.",
          "pl": "archive.run {path, name}, archive.status, archive.cancel jako akcje z regułami ścieżek PathPolicy; postęp jako wiadomość."
        },
        "surfaces": {
          "c_abi": [
            "loom_archive_run",
            "loom_archive_cancel",
            "loom_archive_status"
          ],
          "http": [
            "GET /api/archive/status",
            "POST /api/archive/run",
            "POST /api/archive/cancel"
          ]
        }
      },
      {
        "id": "knowledge",
        "title": {
          "en": "Knowledge pipeline: runs, questions, policy",
          "pl": "Potok wiedzy: przebiegi, pytania, polityka"
        },
        "reason": {
          "en": "A paid, multi-stage pipeline with its own policy documents; a spoken form that shows its cost first still has to be designed.",
          "pl": "Płatny, wieloetapowy potok z własnymi dokumentami polityki; mówiona postać, która najpierw pokazuje koszt, wymaga jeszcze projektu."
        },
        "plan": {
          "en": "knowledge.status and knowledge.query first (read only), then knowledge.run with the estimate in the proposal.",
          "pl": "Najpierw knowledge.status i knowledge.query (tylko odczyt), potem knowledge.run z szacunkiem w propozycji."
        },
        "surfaces": {
