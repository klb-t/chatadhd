    },
    "kinds": {
      "course_correction": {
        "title": {
          "en": "Course correction",
          "pl": "Korekta kursu"
        },
        "strength": 1.0,
        "priority": 2,
        "annotation_category": "correction",
        "hypothesis": {
          "scope": "conversation",
          "promotes": "rule",
          "rule_kind": "preference",
          "claim": {
            "en": "The user wants this from now on: {{text}}",
            "pl": "Użytkownik chce odtąd: {{text}}"
          },
          "statement_kind": "style",
          "negative_statement_kind": "prohibition"
        },
        "detect": {
          "methods": [
            "heuristic",
            "model"
          ],
          "needs_goal": false,
          "heuristic": {
            "min_score": 0.6,
            "start_window": 5,
            "start_weight": 1.0,
            "anywhere_weight": 0.6,
            "markers": {
              "pl": [
                "nie chodzilo",
                "chodzilo mi o",
                "mialem na mysli",
                "nie tak",
                "to nie to",
                "zly kierunek",
                "zapomnij o",
                "zapomnij o tym",
                "wroc do",
                "zamiast tego",
                "zmieniam zdanie",
                "nie nie",
                "nie rob",
                "nie chce",
                "przestan",
                "jednak nie",
                "tym razem inaczej"
              ],
              "en": [
                "i meant",
                "thats not what",
                "that's not what",
                "not what i asked",
                "wrong direction",
                "forget that",
                "forget about",
                "go back to",
