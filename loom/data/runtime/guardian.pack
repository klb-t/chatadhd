                "table",
                "bullet",
                "format",
                "json",
                "markdown",
                "paragraph",
                "heading"
              ]
            }
          },
          {
            "kind": "style",
            "default": true
          }
        ],
        "materializer": {
          "id": "loom.guardian",
          "version": "1"
        },
        "task_id": "guardian",
        "product_prefix": "guardian-",
        "goal_prefix": "guardian-goal-"
      }
    },
    "levels": {
      "roles": [
        "user"
      ],
      "order": [
        "L0",
        "L1",
        "L2",
        "L3"
      ],
      "min_confidence": 0.5,
      "defs": {
        "L0": {
          "title": {
            "en": "Raw",
            "pl": "Surowy"
          },
          "drop_categories": [],
          "status": "implemented"
        },
        "L1": {
          "title": {
            "en": "Noise removed",
            "pl": "Bez szumu"
          },
          "drop_categories": [
            "filler",
            "repetition",
            "restart"
          ],
          "status": "implemented",
          "producer": "guardian_heuristic"
        },
        "L2": {
          "title": {
            "en": "Digressions and jokes removed",
            "pl": "Bez dygresji i żartów"
          },
          "inherits": "L1",
          "drop_categories": [
            "digression",
            "joke"
          ],
          "status": "implemented",
          "note": {
            "en": "Applies annotations of any producer. Heuristic producers cover only the cheap categories; digression and joke come from the semantic analyzer and stay planned until it writes them.",
            "pl": "Stosuje adnotacje dowolnego producenta. Producenci heurystyczni pokrywają tylko tanie kategorie; dygresje i żarty ma dopisywać analizator semantyczny i do tego czasu są planowane."
          }
        },
        "L3": {
          "title": {
            "en": "Condensed meaning",
            "pl": "Skondensowane znaczenie"
          },
          "kind": "compiled",
          "transform": "compile_refinements",
          "status": "implemented"
        }
      },
      "preset_categories": {
        "filler": {
          "title": {
            "en": "Filler",
            "pl": "Wypełniacz"
          }
        },
        "repetition": {
          "title": {
            "en": "Repetition",
            "pl": "Powtórzenie"
          }
        },
        "restart": {
          "title": {
            "en": "Restart or self-correction",
            "pl": "Falstart lub samopoprawka"
          }
        },
        "digression": {
          "title": {
            "en": "Digression",
            "pl": "Dygresja"
          }
        },
        "joke": {
          "title": {
            "en": "Joke",
            "pl": "Żart"
          }
        }
      },
      "noise": {
        "fillers": {
          "pl": [
            "yyy",
            "yy",
            "eee",
            "ee",
            "aaa",
            "aa",
            "hmm",
            "hmmm",
            "emm",
            "ymm",
            "yhm",
            "no wiec",
            "tak jakby",
            "w sumie takie"
          ],
          "en": [
            "um",
            "uh",
            "uhm",
            "umm",
            "uhh",
            "erm",
            "er",
            "hmm",
            "hmmm",
            "you know",
            "kind of like",
            "sort of like"
          ]
        },
        "repetition": {
          "max_ngram": 3,
          "min_token_len": 1
        },
        "restart": {
          "max_clause_words": 12,
          "markers": {
            "pl": [
              "zapomnij to co powiedzialem",
              "anuluj to zdanie",
              "nie czekaj zapomnij"
            ],
            "en": [
              "scratch that",
              "ignore that",
              "never mind that",
              "forget what i just said"
            ]
          }
        }
      }
    },
    "annotations": {
      "schema": "loom.segment_annotation/1",
      "node_kind": "annotation_category",
      "label_prefix": "annotation:",
      "producers": {
        "guardian_heuristic": {
          "status": "implemented",
          "origin": "recorded",
          "cost": "none"
        },
        "semantic_regex": {
          "status": "planned",
          "origin": "recorded",
          "reason": {
            "en": "The regex analyzer does not write segment annotations yet.",
            "pl": "Analizator regex nie zapisuje jeszcze adnotacji segmentów."
          }
        },
        "semantic_llm": {
          "status": "planned",
          "origin": "model",
          "reason": {
            "en": "The LLM analyzer does not write segment annotations yet; when it does, the guardian reads them and makes no second model call.",
            "pl": "Analizator LLM nie zapisuje jeszcze adnotacji segmentów; gdy zacznie, strażnik je odczyta i nie wykona drugiego wywołania modelu."
          }
        },
        "semantic_batch": {
          "status": "planned",
          "origin": "model",
          "reason": {
            "en": "As semantic_llm, through the batch API.",
            "pl": "Jak semantic_llm, przez API wsadowe."
          }
        }
      },
      "categories": [
        "instruction",
        "correction",
        "refinement",
        "digression",
        "joke",
        "filler",
        "repetition",
        "restart",
        "thread"
      ]
    },
    "representation": {
      "setting": "chat_representation",
      "levels_setting": "guardian_levels",
      "active": "raw",
      "unknown": "raw",
      "presets": {
        "raw": {
          "levels": {},
          "runs": "raw",
          "meaning": {
            "en": "The raw messages, as they are (preset). Request bytes are unchanged.",
            "pl": "Surowe wiadomości, jak są (preset). Bajty żądania bez zmian."
          }
        },
        "denoised": {
          "levels": {
            "user": "L1"
          },
          "runs": "raw",
          "meaning": {
            "en": "Your messages without fillers, repetitions and restarts (L1).",
            "pl": "Twoje wiadomości bez wypełniaczy, powtórzeń i falstartów (L1)."
          }
        },
        "lean": {
          "levels": {
            "user": "L2"
          },
          "runs": "raw",
          "meaning": {
            "en": "L1 plus digressions and jokes where the analyzer marked them (L2).",
            "pl": "L1 oraz dygresje i żarty, gdzie oznaczył je analizator (L2)."
          }
        },
        "guardian": {
          "levels": {
            "user": "L1"
          },
          "runs": "replace_refinement",
          "meaning": {
            "en": "L1, and a run of clarifications is replaced by one compiled instruction (L3).",
            "pl": "L1, a seria doprecyzowań jest zastąpiona jednym skompilowanym poleceniem (L3)."
          }
        },
        "mixed": {
          "levels": {},
          "runs": "append",
          "meaning": {
            "en": "The raw messages and, after them, the compiled instruction.",
            "pl": "Surowe wiadomości, a po nich skompilowane polecenie."
          }
        }
      },
      "thread_filter": {
        "status": "planned",
        "reason": {
          "en": "Skipping other topic threads belongs to the context selector and needs the analyzer to write thread annotations.",
          "pl": "Pomijanie innych wątków tematycznych należy do selektora kontekstu i wymaga adnotacji wątków od analizatora."
        }
      },
      "version_goal_task": "guardian"
    },
    "traffic": {
      "metadata_key": "guardian",
      "ignore_metadata": [
        "routed",
        "action_proposal",
        "action_run",
        "semantic_question",
        "guardian"
      ]
    },
    "nodes": {
      "occurrence": "guardian_occurrence",
      "hypothesis": "guardian_hypothesis",
      "exception": "guardian_exception",
      "level": "guardian_level",
      "representation": "guardian_representation",
      "links": {
        "evidence": "derived_from",
        "supports": "supports",
        "contradicts": "contradicts",
        "except": "except"
      }
    },
    "rules": {},
    "texts": {
      "en": {
        "propose_rule": "I noticed you have corrected the same thing {{count}} times: \"{{claim}}\". Shall I remember it as a rule for {{scope}}{{exceptions}}? It stays your rule: you can switch it off at any time.",
        "propose_compile": "You have clarified the task {{count}} times. I can keep one exact instruction instead of the whole run (your messages stay as they are):\n{{instruction}}\nUse it from now on?",
        "ask_rule": "Should I remember this for {{scope}}: \"{{claim}}\"?",
        "applied_rule": "I saved a rule for {{scope}}: \"{{claim}}\" (you corrected it {{count}} times). Switch it off with: guardian undo {{rule}}.",
        "exceptions_suffix": ", except: {{list}}",
        "answer_yes": "Done. {{what}}",
        "answer_no": "Understood, I will not remember it.",
        "promoted_rule": "Rule {{rule}} saved for {{scope}}.",
        "promoted_compile": "From now on the instruction above stands in for your {{count}} clarifications when this conversation is sent.",
        "undone": "Taken back: {{what}}. The messages and what I noticed stay.",
        "status_empty": "I have not noticed anything to remember in this conversation.",
        "status_line": "{{kind}} ({{status}}, weight {{weight}}, {{count}}x): {{claim}}"
      },
      "pl": {
        "propose_rule": "Zauważyłem, że poprawiasz to samo już {{count}} razy: \"{{claim}}\". Zapamiętać to jako regułę dla: {{scope}}{{exceptions}}? To nadal Twoja reguła: możesz ją wyłączyć w każdej chwili.",
