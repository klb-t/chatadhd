      "rule_statement": {
        "title": {
          "en": "A rule stated by the user",
          "pl": "Reguła podana przez użytkownika"
        },
        "strength": 2.0,
        "priority": 3,
        "annotation_category": "rule_statement",
        "polarity": "positive",
        "hypothesis": {
