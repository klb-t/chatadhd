        },
        "confidence": {
          "filler": {
            "sentence_start": 0.9,
            "inside": 0.5
          },
          "repetition": {
            "single_word": 0.3,
            "multi_word": 0.9
          },
          "restart": {
            "default": 0.9
          }
        }
