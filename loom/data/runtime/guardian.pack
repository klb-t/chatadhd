        }
      },
      "refinement": {
        "title": {
          "en": "Refinement or clarification",
          "pl": "Doprecyzowanie"
        },
        "strength": 0.6,
        "priority": 1,
        "annotation_category": "refinement",
        "hypothesis": {
          "scope": "conversation",
          "promotes": "transform",
          "transform": "compile_refinements",
          "claim": {
            "en": "The task was clarified {{count}} times; one instruction says it exactly.",
            "pl": "Zadanie doprecyzowano {{count}} razy; jedno polecenie mówi to dokładnie."
          }
        },
        "detect": {
          "methods": [
            "heuristic",
            "model"
          ],
          "needs_goal": true,
          "heuristic": {
            "min_score": 0.8,
            "start_window": 4,
            "start_weight": 1.0,
            "anywhere_weight": 0.4,
            "markers": {
              "pl": [
                "dodatkowo",
                "ponadto",
                "a takze",
                "jeszcze",
                "doprecyzuje",
                "doprecyzowanie",
                "dodaj",
                "uwzglednij",
                "pamietaj",
                "upewnij sie",
                "w dodatku",
                "oraz",
                "tez",
                "rowniez",
                "i jeszcze",
                "przy okazji",
                "na koniec",
                "zadbaj",
                "ma byc",
                "powinno",
                "niech"
              ],
              "en": [
                "also",
