      },
      "proposal_rejection": {
        "title": {
          "en": "Rejection of a proposal",
          "pl": "Odrzucenie propozycji"
        },
        "strength": 0.5,
        "priority": 0,
        "annotation_category": "correction",
        "hypothesis": {
          "scope": "conversation",
          "promotes": "record",
          "rule_kind": "do_not_propose",
          "statement_kind": "prohibition",
          "note": {
            "en": "Weighed, shown by guardian.status and consumed by the action router: once the weight reaches kinds.proposal_rejection.suppress_at (two refusals), the same proposal is no longer offered in that conversation; the sentence is sent as a message.",
            "pl": "Ważona, widoczna w guardian.status i używana przez router akcji: gdy waga osiągnie kinds.proposal_rejection.suppress_at (dwa odmowy), ta sama propozycja nie jest już składana w tej rozmowie; zdanie idzie jako wiadomość."
          },
          "claim": {
            "en": "Do not propose again: {{text}}",
            "pl": "Nie proponuj ponownie: {{text}}"
          }
        },
        "detect": {
          "methods": [
            "structural"
          ],
          "structural": "rejected_proposal"
        },
        "suppress_at": 1.0
      },
      "preference_statement": {
        "title": {
          "en": "Stated preference",
          "pl": "Wyrażona preferencja"
        },
        "strength": 1.0,
        "priority": 1,
        "annotation_category": "preference",
        "polarity": "positive",
        "hypothesis": {
          "scope": "conversation",
          "promotes": "rule",
          "rule_kind": "preference",
          "claim": {
            "en": "The user prefers: {{text}}",
            "pl": "Użytkownik woli: {{text}}"
          },
          "statement_kind": "style",
          "negative_statement_kind": "prohibition"
        },
        "detect": {
          "methods": [
            "heuristic",
            "model"
          ],
          "needs_goal": false,
          "heuristic": {
            "min_score": 0.6,
            "start_window": 4,
            "start_weight": 1.0,
            "anywhere_weight": 0.7,
            "markers": {
              "pl": [
                "zawsze",
                "od teraz",
                "wole",
                "preferuje",
                "na przyszlosc",
                "nigdy wiecej",
                "nigdy"
