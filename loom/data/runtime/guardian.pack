            "digression",
            "joke",
            "filler",
            "thread"
          ]
        },
        "guardian_model": {
          "status": "implemented",
          "origin": "model",
          "cost": "one guarded model call per message not read by another model producer",
          "method": "model",
          "categories_written": [
            "correction",
            "refinement",
            "preference",
            "exception",
            "rule_statement"
