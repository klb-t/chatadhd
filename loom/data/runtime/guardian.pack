      "categories": [
        "instruction",
        "correction",
        "refinement",
        "preference",
        "acceptance",
        "exception",
        "rule_statement",
        "digression",
        "joke",
        "filler",
        "repetition",
        "restart",
        "thread"
      ],
      "classes": {
        "signal": [
          "correction",
          "refinement",
          "instruction",
          "preference",
          "acceptance",
          "exception",
          "rule_statement"
        ],
        "droppable": [
          "filler",
          "repetition",
          "restart",
          "digression",
          "joke"
        ],
        "structure": [
          "thread"
        ]
      },
      "polarity": {
        "positive": [
          "acceptance",
          "preference",
          "rule_statement"
        ],
        "negative": [
          "correction",
          "restart",
          "digression"
        ]
      },
      "conflicts": {
        "order": [
          "user",
          "confidence",
          "newer"
        ],
        "shield": {
          "signal_over": "droppable",
          "min_confidence": 0.5,
          "whole_message_shields": false,
          "meaning": {
            "en": "A signal protects the segment it covers from being dropped as noise (signal beats noise). A signal that spans the whole message describes the message and shields nothing.",
            "pl": "Sygnał chroni pokryty przez siebie segment przed odrzuceniem jako szum (sygnał przed szumem). Sygnał obejmujący całą wiadomość opisuje wiadomość i niczego nie chroni."
          }
        }
      },
      "analyzer": {
        "setting": "semantic_segments",
        "active": "auto",
        "unknown": "auto",
        "presets": {
          "auto": {
            "when": {
              "guardian_method": [
                "model",
                "hybrid"
              ],
              "chat_representation": [
                "lean"
              ],
              "chat_thread_filter": [
                "current"
              ]
            },
            "meaning": {
              "en": "The analyzer's one prompt also returns the segment categories when something reads them: the Secretary using a model, the lean representation, the thread filter (preset).",
              "pl": "Jeden prompt analizatora zwraca też kategorie segmentów, gdy ktoś je czyta: Sekretarz używający modelu, reprezentacja lean, filtr wątków (preset)."
            }
          },
          "on": {
            "always": true,
            "meaning": {
              "en": "Always ask for segment categories and the thread.",
              "pl": "Zawsze proś o kategorie segmentów i wątek."
            }
          },
          "off": {
            "never": true,
            "meaning": {
              "en": "The analyzer's prompt is the classic one (entities, topics, relations); the Secretary reads messages itself.",
              "pl": "Prompt analizatora jest klasyczny (encje, tematy, relacje); Sekretarz czyta wiadomości sam."
            }
          }
        },
        "max_tokens": 1200,
        "max_segments": 12,
        "min_text_codepoints": 20,
        "thread": {
          "write": true,
          "min_confidence": 0.3,
          "category": "thread"
        },
        "categories": {
          "instruction": {
            "en": "a task or request the assistant should carry out",
            "pl": "zadanie lub prośba do wykonania"
          },
          "correction": {
            "en": "the user corrects the assistant or changes direction",
            "pl": "użytkownik poprawia asystenta albo zmienia kierunek"
          },
          "refinement": {
            "en": "the user adds a detail to the task already given",
            "pl": "użytkownik dodaje szczegół do zadania, które już podał"
          },
          "preference": {
            "en": "a standing preference of the user (how he wants things done)",
            "pl": "stała preferencja użytkownika (jak chce, żeby coś było robione)"
          },
          "exception": {
            "en": "an exception to something the user has just asked for",
            "pl": "wyjątek od tego, o co użytkownik przed chwilą poprosił"
          },
          "digression": {
            "en": "a remark that leaves the topic and could be dropped without losing the task",
            "pl": "uwaga poza tematem, którą można pominąć bez straty dla zadania"
          },
          "joke": {
            "en": "a joke or aside with no bearing on the task",
            "pl": "żart lub dygresja bez znaczenia dla zadania"
          },
          "filler": {
            "en": "words that carry no content",
            "pl": "słowa bez treści"
          }
        },
        "prompt": {
          "addendum": "\nAlso add to the same JSON object:\n  \"segments\": [{\"category\": \"{{categories}}\", \"quote\": \"the exact words copied from the message\", \"confidence\": 0.0-1.0, \"qualifier\": \"\" or \"quoted\" or \"hypothetical\"}],\n  \"thread\": \"a short label of the topic thread this message belongs to\"\n\nSegment categories:\n{{category_help}}\nSegment rules:\n- Quote the words exactly as they stand; never paraphrase. A segment is a phrase or sentence, not the whole message unless it is one.\n- qualifier is \"quoted\" when the user reports someone else's words, \"hypothetical\" when he imagines a case.\n- Use an empty segments array when nothing applies.\n"
        }
      }
    },
    "representation": {
      "setting": "chat_representation",
      "levels_setting": "guardian_levels",
      "active": "raw",
      "unknown": "raw",
      "presets": {
        "raw": {
          "levels": {},
          "runs": "raw",
          "meaning": {
            "en": "The raw messages, as they are (preset). Request bytes are unchanged.",
            "pl": "Surowe wiadomości, jak są (preset). Bajty żądania bez zmian."
          }
        },
        "denoised": {
          "levels": {
            "user": "L1"
          },
          "runs": "raw",
          "meaning": {
            "en": "Your messages without fillers, repetitions and restarts (L1).",
            "pl": "Twoje wiadomości bez wypełniaczy, powtórzeń i falstartów (L1)."
          }
        },
        "lean": {
          "levels": {
            "user": "L2"
          },
          "runs": "raw",
          "meaning": {
            "en": "L1 plus digressions and jokes where the analyzer marked them (L2).",
            "pl": "L1 oraz dygresje i żarty, gdzie oznaczył je analizator (L2)."
          }
        },
        "guardian": {
          "levels": {
            "user": "L1"
          },
          "runs": "replace_refinement",
          "meaning": {
            "en": "L1, and a run of clarifications is replaced by one compiled instruction (L3).",
            "pl": "L1, a seria doprecyzowań jest zastąpiona jednym skompilowanym poleceniem (L3)."
          }
        },
        "mixed": {
          "levels": {},
          "runs": "append",
          "meaning": {
            "en": "The raw messages and, after them, the compiled instruction.",
            "pl": "Surowe wiadomości, a po nich skompilowane polecenie."
          }
        }
      },
      "thread_filter": {
        "setting": "chat_thread_filter",
        "active": "off",
        "unknown": "off",
        "presets": {
          "off": {
            "mode": "off",
            "meaning": {
              "en": "Every thread of the conversation is sent (preset).",
              "pl": "Wysyłane są wszystkie wątki rozmowy (preset)."
            }
          },
          "current": {
            "mode": "current",
            "meaning": {
              "en": "Messages that the analyzer put in another topic thread than the one you are in now are left out of the request; they stay in the conversation.",
              "pl": "Wiadomości, które analizator przypisał do innego wątku tematycznego niż ten, w którym jesteś, nie idą w żądaniu; zostają w rozmowie."
            }
          }
        },
        "category": "thread",
        "min_confidence": 0.5,
        "keep_roles": [
          "system"
        ],
        "note": {
          "en": "The selector leaves out messages of other threads (history_skip). A message without a thread annotation is always sent.",
          "pl": "Selektor pomija wiadomości innych wątków (history_skip). Wiadomość bez adnotacji wątku jest zawsze wysyłana."
        }
      },
      "version_goal_task": "guardian"
    },
    "traffic": {
      "metadata_key": "guardian",
      "ignore_metadata": [
        "routed",
        "action_proposal",
        "action_run",
        "semantic_question",
        "guardian"
      ]
    },
    "nodes": {
      "occurrence": "guardian_occurrence",
      "hypothesis": "guardian_hypothesis",
      "exception": "guardian_exception",
      "level": "guardian_level",
      "representation": "guardian_representation",
      "links": {
        "evidence": "derived_from",
        "supports": "supports",
        "contradicts": "contradicts",
        "except": "except",
        "same_as": "same_as"
      }
    },
    "rules": {},
    "texts": {
      "en": {
        "propose_rule": "I noticed you have corrected the same thing {{count}} times: \"{{claim}}\". Shall I remember it as a rule for {{scope}}{{exceptions}}{{why}}? It stays your rule: you can switch it off at any time.",
        "propose_compile": "You have clarified the task {{count}} times. I can keep one exact instruction instead of the whole run (your messages stay as they are):\n{{instruction}}\nUse it from now on?",
        "ask_rule": "Should I remember this for {{scope}}{{why}}: \"{{claim}}\"?",
        "applied_rule": "I saved a rule for {{scope}}: \"{{claim}}\" (you corrected it {{count}} times). Switch it off with: guardian undo {{rule}}.",
        "exceptions_suffix": ", except: {{list}}",
        "answer_yes": "Done. {{what}}",
        "answer_no": "Understood, I will not remember it.",
        "promoted_rule": "Rule {{rule}} saved for {{scope}}.",
        "promoted_compile": "From now on the instruction above stands in for your {{count}} clarifications when this conversation is sent.",
        "undone": "Taken back: {{what}}. The messages and what I noticed stay.",
        "status_empty": "I have not noticed anything to remember in this conversation.",
        "status_line": "{{kind}} ({{status}}, weight {{weight}}, {{count}}x): {{claim}}",
        "propose_rule_unnamed": "I noticed you have corrected the same thing {{count}} times:\n{{quotes}}\nShall I remember it as a rule for {{scope}}{{exceptions}}{{why}}? It stays your rule: you can switch it off at any time.",
        "quote_line": "- “{{quote}}”",
        "why_conversations": "you said this in {{n}} different conversations",
        "why_task_kinds": "you said this in {{n}} different kinds of task",
        "why_requested": "you asked for it to hold always",
        "why_wrap": " ({{list}})",
        "review_rule": "The rule \"{{claim}}\" has had no confirmation for {{days}} days. Shall I switch it off? If not, it stays and I will ask again later.",
        "disable_rule": "You have just corrected against the rule \"{{claim}}\". Shall I switch it off?",
        "remembered_header": "What I remember about you:",
        "remembered_empty": "I do not remember any rule about you yet.",
        "remembered_line": "- {{claim}} ({{scope}}, since {{since}})",
        "merged": "Joined: {{what}}",
        "unmerged": "Separated: {{what}}",
        "no_model": "(No analysis model is set, so I read with word lists only: set guardian_model or the analysis model.)"
      },
      "pl": {
        "propose_rule": "Zauważyłem, że poprawiasz to samo już {{count}} razy: \"{{claim}}\". Zapamiętać to jako regułę dla: {{scope}}{{exceptions}}{{why}}? To nadal Twoja reguła: możesz ją wyłączyć w każdej chwili.",
        "propose_compile": "Doprecyzowałeś zadanie {{count}} razy. Zamiast całej serii mogę trzymać jedno dokładne polecenie (Twoje wiadomości zostają bez zmian):\n{{instruction}}\nUżywać go odtąd?",
        "ask_rule": "Czy zapamiętać dla: {{scope}}{{why}}: \"{{claim}}\"?",
        "applied_rule": "Zapisałem regułę dla: {{scope}}: \"{{claim}}\" (poprawiałeś to {{count}} razy). Wyłączysz ją poleceniem: guardian undo {{rule}}.",
        "exceptions_suffix": ", z wyjątkiem: {{list}}",
        "answer_yes": "Gotowe. {{what}}",
        "answer_no": "Rozumiem, nie będę tego pamiętać.",
        "promoted_rule": "Reguła {{rule}} zapisana dla: {{scope}}.",
        "promoted_compile": "Odtąd powyższe polecenie zastępuje Twoje {{count}} doprecyzowania przy wysyłaniu tej rozmowy.",
        "undone": "Cofnięto: {{what}}. Wiadomości i to, co zauważyłem, zostają.",
        "status_empty": "Nie zauważyłem w tej rozmowie niczego do zapamiętania.",
        "status_line": "{{kind}} ({{status}}, waga {{weight}}, {{count}}x): {{claim}}",
        "propose_rule_unnamed": "Zauważyłem, że poprawiasz to samo już {{count}} razy:\n{{quotes}}\nZapamiętać to jako regułę dla: {{scope}}{{exceptions}}{{why}}? To nadal Twoja reguła: możesz ją wyłączyć w każdej chwili.",
        "quote_line": "- „{{quote}}”",
        "why_conversations": "mówisz to w {{n}} różnych rozmowach",
        "why_task_kinds": "mówisz to w {{n}} różnych rodzajach zadań",
        "why_requested": "prosiłeś, żeby obowiązywało zawsze",
        "why_wrap": " ({{list}})",
        "review_rule": "Reguła \"{{claim}}\" nie była potwierdzona od {{days}} dni. Wyłączyć ją? Jeśli nie, zostaje i zapytam ponownie później.",
        "disable_rule": "Przed chwilą poprawiłeś coś wbrew regule \"{{claim}}\". Wyłączyć ją?",
        "remembered_header": "Co o Tobie pamiętam:",
        "remembered_empty": "Nie pamiętam jeszcze żadnej reguły o Tobie.",
        "remembered_line": "- {{claim}} ({{scope}}, od {{since}})",
        "merged": "Połączone: {{what}}",
        "unmerged": "Rozdzielone: {{what}}",
        "no_model": "(Nie ustawiono modelu analizy, więc czytam tylko listami słów: ustaw guardian_model albo model analizy.)"
      }
    },
    "scope_names": {
      "en": {
        "message": "this message",
        "conversation": "this conversation",
        "task_kind": "this kind of task",
        "person": "everything you do",
        "global": "everywhere"
      },
      "pl": {
        "message": "tej wiadomości",
