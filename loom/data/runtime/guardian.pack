{
  "schema": "loom.runtime_profile/1",
  "domain": "guardian",
  "revision": 1,
  "description": "The context guardian (P21; docs/architecture/STRAZNIK_I_SRODOWISKA_2026-10-14.md): a secretary that, beside the raw list of messages, builds the most economical and precise representation of a conversation and learns from corrections. Everything it does is data here: the kinds of signals and how each is recognised (heuristic, model, structural), the weighting and escalation curve, the thresholds, the scope ladder, how an accepted hypothesis becomes a rule, the lossy levels L0-L3 and the categories each drops, the shared segment-annotation layer, and the presets of what the context selector may pick. Settings: guardian_method, guardian_promotion, guardian_model, guardian_levels, chat_representation. The guardian never changes the raw messages and never decides what is sent: the selector reads chat_representation (preset raw: request bytes unchanged).",
  "defaults": {
    "schema": "loom.guardian/1",
    "section": "Kontekst",
    "subsection": "Strażnik",
    "method": {
      "setting": "guardian_method",
      "model_setting": "guardian_model",
      "model_fallback_setting": "default_model",
      "active": "heuristic",
      "unknown": "heuristic",
      "presets": {
        "off": {
          "heuristic": false,
          "model": false,
          "meaning": {
            "en": "The guardian observes nothing.",
            "pl": "Strażnik niczego nie obserwuje."
          }
        },
        "heuristic": {
          "heuristic": true,
          "model": false,
          "meaning": {
            "en": "Local and free: word lists and structure (preset).",
            "pl": "Lokalnie i za darmo: listy słów i struktura (preset)."
          }
        },
        "model": {
          "heuristic": false,
          "model": true,
          "meaning": {
            "en": "One guarded model call per message that no existing annotation already describes.",
            "pl": "Jedno wywołanie modelu pod strażnikami na wiadomość, której nie opisuje jeszcze żadna adnotacja."
          }
        },
        "hybrid": {
          "heuristic": true,
          "model": true,
          "ask_model_when": "no_signal",
          "meaning": {
            "en": "The local reading first; the model only for messages in which it found nothing.",
            "pl": "Najpierw odczyt lokalny; model tylko dla wiadomości, w których nic nie znalazł."
          }
        }
      },
      "model_call": {
        "kind": "guardian.annotate",
        "timeout_ms": 30000,
        "title": "Guardian: annotate a message",
        "parameters": {
          "temperature": 0,
          "max_tokens": 300
        },
        "system": "You label one user message of a chat. Answer with one JSON object only: {\"kind\": one of {{kinds}} or \"none\", \"confidence\": 0..1, \"subject\": short restatement of what the user wants or \"\", \"tone\": \"calm\" or \"sharp\", \"exceptions\": [short phrases the user excepts], \"scope\": \"message\"|\"conversation\"|\"person\" or \"\"}. Kinds: {{kind_help}}",
        "user": "Previous assistant reply (may be empty):\n{{previous}}\n\nUser message:\n{{text}}",
        "min_confidence": 0.5
      }
    },
    "promotion": {
      "setting": "guardian_promotion",
      "active": "propose",
      "unknown": "propose",
      "max_per_reply": 1,
      "presets": {
        "ask": {
          "at": "ask",
          "meaning": {
            "en": "Ask as soon as the first occurrence is seen: \"should I remember this?\"",
            "pl": "Pytaj już przy pierwszym wystąpieniu: \"czy to zapamiętać?\""
          }
        },
        "propose": {
          "at": "propose",
          "meaning": {
            "en": "Propose a rule with its evidence once the weight of the hypothesis reaches the threshold (preset).",
            "pl": "Zaproponuj regułę z dowodami, gdy waga hipotezy osiągnie próg (preset)."
          }
        },
        "apply": {
          "at": "apply",
          "meaning": {
            "en": "Write the rule at the higher threshold and say so in the conversation; always reversible.",
            "pl": "Zapisz regułę przy wyższym progu i powiedz o tym w rozmowie; zawsze odwracalne."
          }
        }
      }
    },
    "thresholds": {
      "ask": 1.0,
      "propose": 2.0,
      "apply": 3.0
    },
    "weighting": {
      "reask_factor": 2.0,
      "recency_half_life_hours": 336,
      "contradiction_factor": 0.8,
      "overlap_min": 0.5,
      "min_token_len": 3
    },
    "escalation": {
      "curve": [
        1.0,
        1.6,
        2.5,
        3.5
      ],
      "beyond_last_step": 0.5,
      "tone": {
        "factor": 1.5,
        "markers": {
          "pl": [
            "juz mowilem",
            "ile razy",
            "kolejny raz",
            "znowu",
            "cholera",
            "do cholery",
            "serio",
            "naprawde",
            "!!",
            "jak mowie",
            "przeciez"
          ],
          "en": [
            "i already said",
            "i told you",
            "how many times",
            "again",
            "seriously",
            "for the last time",
            "damn",
            "!!",
            "as i said",
            "come on"
          ]
        }
      },
      "repeat": {
        "factor": 1.8,
        "markers": {
          "pl": [
            "mowilem juz",
            "juz pisalem",
            "juz mowilem",
            "powtarzam"
          ],
          "en": [
            "i already said",
            "i told you",
            "i already told",
            "as i said",
            "i repeat"
          ]
        }
      }
    },
    "scopes": {
      "order": [
        "message",
        "conversation",
        "task_kind",
        "person",
        "global"
      ],
      "default": "conversation",
      "by_weight": [
        {
          "min": 0,
          "scope": "conversation"
        },
        {
          "min": 6,
          "scope": "person"
        }
      ],
      "markers": {
        "person": {
          "pl": [
            "zawsze",
            "od teraz",
            "na przyszlosc",
            "nigdy wiecej",
            "we wszystkich rozmowach"
          ],
          "en": [
            "always",
            "from now on",
            "in the future",
            "never again",
            "in all conversations"
          ]
        },
        "conversation": {
