    "annotations": {
      "schema": "loom.segment_annotation/2",
      "node_kind": "annotation_category",
      "label_prefix": "annotation:",
      "producers": {
        "guardian_heuristic": {
          "status": "implemented",
          "origin": "recorded",
          "cost": "none",
          "categories_written": [
            "filler",
            "repetition",
            "restart",
            "correction",
            "refinement",
            "preference",
            "acceptance",
            "exception",
            "rule_statement"
          ],
          "method": "heuristic",
          "own": true
        },
        "semantic_regex": {
          "status": "implemented",
          "origin": "recorded",
          "method": "regex",
          "cost": "none",
          "categories_written": [
            "thread"
          ],
          "note": {
            "en": "Writes the thread of a message from the dominant topic of the regex analysis.",
            "pl": "Zapisuje wątek wiadomości z dominującego tematu analizy regex."
          }
        },
        "semantic_llm": {
          "status": "implemented",
          "origin": "model",
          "method": "llm",
          "cost": "none beyond the analysis call that is made anyway (one prompt contract: entities, topics, relations and segments)",
          "categories_written": [
            "instruction",
            "correction",
            "refinement",
            "preference",
            "exception",
            "digression",
            "joke",
            "filler",
            "thread"
          ]
        },
        "semantic_batch": {
          "status": "implemented",
          "origin": "model",
