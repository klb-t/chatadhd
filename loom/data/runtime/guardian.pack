        ]
      }
    },
    "kinds": {
      "course_correction": {
        "title": {
          "en": "Course correction",
          "pl": "Korekta kursu"
        },
        "strength": 1.0,
        "priority": 2,
        "annotation_category": "correction",
        "hypothesis": {
          "scope": "conversation",
          "promotes": "rule",
          "rule_kind": "preference",
          "claim": {
            "en": "The user wants this from now on: {{text}}",
            "pl": "Użytkownik chce odtąd: {{text}}"
          },
          "statement_kind": "style",
          "negative_statement_kind": "prohibition"
        },
        "detect": {
          "methods": [
            "heuristic",
            "model"
          ],
          "needs_goal": false,
          "heuristic": {
            "min_score": 0.6,
            "start_window": 5,
            "start_weight": 1.0,
            "anywhere_weight": 0.6,
            "markers": {
              "pl": [
                "nie chodzilo",
                "chodzilo mi o",
                "mialem na mysli",
                "nie tak",
                "to nie to",
                "zly kierunek",
                "zapomnij o",
                "zapomnij o tym",
                "wroc do",
                "zamiast tego",
                "zmieniam zdanie",
                "nie nie",
                "nie rob",
                "nie chce",
                "przestan",
                "jednak nie",
                "tym razem inaczej"
              ],
              "en": [
                "i meant",
                "thats not what",
                "that's not what",
                "not what i asked",
                "wrong direction",
                "forget that",
                "forget about",
                "go back to",
                "instead",
                "actually no",
                "no no",
                "no wait",
                "dont do",
                "don't do",
                "i dont want",
                "i don't want",
                "stop doing",
                "change of plan"
              ]
            }
          }
        }
      },
      "refinement": {
        "title": {
          "en": "Refinement or clarification",
          "pl": "Doprecyzowanie"
        },
        "strength": 0.6,
        "priority": 1,
        "annotation_category": "refinement",
        "hypothesis": {
          "scope": "conversation",
          "promotes": "transform",
          "transform": "compile_refinements",
          "claim": {
            "en": "The task was clarified {{count}} times; one instruction says it exactly.",
            "pl": "Zadanie doprecyzowano {{count}} razy; jedno polecenie mówi to dokładnie."
          }
        },
        "detect": {
          "methods": [
            "heuristic",
            "model"
          ],
          "needs_goal": true,
          "heuristic": {
            "min_score": 0.8,
            "start_window": 4,
            "start_weight": 1.0,
            "anywhere_weight": 0.4,
            "markers": {
              "pl": [
                "dodatkowo",
                "ponadto",
                "a takze",
                "jeszcze",
                "doprecyzuje",
                "doprecyzowanie",
                "dodaj",
                "uwzglednij",
                "pamietaj",
                "upewnij sie",
                "w dodatku",
                "oraz",
                "tez",
                "rowniez",
                "i jeszcze",
                "przy okazji",
                "na koniec",
                "zadbaj",
                "ma byc",
                "powinno",
                "niech"
              ],
              "en": [
                "also",
                "additionally",
                "in addition",
                "one more thing",
                "make sure",
                "please also",
                "and also",
                "remember to",
                "keep in mind",
                "furthermore",
                "plus",
                "it should",
                "it must",
                "needs to",
                "add",
                "include",
                "make it"
              ]
            }
          }
        }
      },
      "proposal_rejection": {
        "title": {
          "en": "Rejection of a proposal",
          "pl": "Odrzucenie propozycji"
        },
        "strength": 0.5,
        "priority": 0,
        "annotation_category": "correction",
        "hypothesis": {
          "scope": "conversation",
          "promotes": "record",
          "rule_kind": "do_not_propose",
          "statement_kind": "prohibition",
          "note": {
            "en": "Recorded and weighed; shown by guardian.status. No consumer of a do-not-propose rule exists yet, so nothing is proposed to the user for it.",
            "pl": "Zapisywana i ważona; widoczna w guardian.status. Nie ma jeszcze odbiorcy reguły „nie proponuj”, więc użytkownikowi nic się o niej nie proponuje."
          },
          "claim": {
            "en": "Do not propose again: {{text}}",
            "pl": "Nie proponuj ponownie: {{text}}"
          }
        },
        "detect": {
          "methods": [
            "structural"
          ],
          "structural": "rejected_proposal"
        }
      }
    },
    "transforms": {
      "compile_refinements": {
        "kind": "refinement",
        "min_occurrences": 3,
        "goal_min_words": 4,
        "goal_max_chars": 4000,
        "statement_max_chars": 1200,
        "statement_kinds": [
          {
            "kind": "prohibition",
            "markers": {
