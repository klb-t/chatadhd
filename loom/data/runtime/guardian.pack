    "signal_confidence": {
      "start": 0.9,
      "anywhere": 0.65,
      "per_extra_hit": 0.05,
      "max": 0.95,
      "meaning": {
        "en": "Confidence of a heuristic signal, computed from where the marker stands (at the start of the message or anywhere) and how many markers the segment holds.",
        "pl": "Pewność sygnału heurystycznego, liczona z miejsca znacznika (początek wiadomości lub gdziekolwiek) i liczby znaczników w segmencie."
      }
    },
    "qualifiers": {
      "quoted": {
        "counts_as_evidence": false,
        "markers": {
          "pl": [
            "on mowil",
            "ona mowila",
            "mowil mi",
            "powiedzial mi",
            "powiedziala mi",
            "mowi ze",
            "ktos powiedzial",
            "cytuje",
            "napisal ze"
          ],
          "en": [
            "he said",
            "she said",
            "they said",
            "he told me",
            "she told me",
            "they told me",
            "someone said",
            "quote",
            "wrote that"
          ]
        }
      },
      "hypothetical": {
        "counts_as_evidence": false,
        "markers": {
          "pl": [
            "gdyby",
            "jesli bym",
            "co jesli",
            "na przyklad",
            "powiedzmy"
          ],
          "en": [
            "what if",
            "suppose",
            "supposing",
            "for example",
            "say i"
          ]
        }
      },
      "meaning": {
        "en": "A segment that quotes or imagines a correction is not a correction: it is annotated with a qualifier and does not count as evidence (data: counts_as_evidence).",
        "pl": "Segment, który cytuje lub wyobraża sobie korektę, nie jest korektą: dostaje kwalifikator i nie liczy się jako dowód (dane: counts_as_evidence)."
      }
    },
    "matching": {
      "setting": "guardian_match_method",
      "active": "overlap",
      "unknown": "overlap",
      "presets": {
        "overlap": {
          "methods": [
            "overlap"
          ],
          "meaning": {
            "en": "Words and concepts they share (local, free; preset). \"Shorter\", \"too long\" and \"trim it\" share the concept of brevity.",
            "pl": "Wspólne słowa i pojęcia (lokalnie, za darmo; preset). „Krócej”, „za długie” i „skróć to” mają wspólne pojęcie zwięzłości."
          }
        },
        "embedding": {
          "methods": [
            "overlap",
            "embedding"
          ],
          "meaning": {
            "en": "Overlap first, then the embedding tier of the search engine when one is available.",
            "pl": "Najpierw wspólne słowa, potem warstwa osadzeń wyszukiwarki, gdy jest dostępna."
          }
        },
        "model": {
          "methods": [
            "overlap",
            "model"
          ],
          "meaning": {
            "en": "Overlap first, then one question to the model per candidate when there are candidates (guarded model call).",
            "pl": "Najpierw wspólne słowa, potem jedno pytanie do modelu na kandydata, gdy są kandydaci (wywołanie pod strażnikami)."
          }
        },
        "user": {
          "methods": [],
          "meaning": {
            "en": "Only what you tell the guardian is the same thing (guardian merge); same words still join.",
            "pl": "Tylko to, co sam powiesz strażnikowi, że jest tym samym (guardian merge); te same słowa nadal się łączą."
          }
        }
      },
      "join_min": 0.8,
      "common_min": 1,
      "embedding_min": 0.75,
      "unmerge_on_no_below": 0.95,
      "edge": "same_as",
      "model_call": {
        "kind": "guardian.match",
        "timeout_ms": 30000,
        "title": "Guardian: are two corrections the same",
        "parameters": {
          "temperature": 0,
          "max_tokens": 60
        },
        "system": "You decide whether two corrections that a user gave a chat assistant ask for the same thing. Answer with one JSON object only: {\"same\": true or false, \"confidence\": 0..1}.",
        "user": "A: {{a}}\nB: {{b}}",
        "min_confidence": 0.7,
        "max_candidates": 2
      },
      "concepts": {
        "brevity": {
          "phrases": {
            "pl": [
              "krotk*",
              "krocej",
              "skroc*",
              "zwiezl*",
              "za dlug*",
              "zbyt dlug*"
            ],
            "en": [
              "short*",
              "concise*",
              "brief*",
              "too long",
              "trim"
            ]
          },
          "statement": {
            "pl": "Pisz krótko i zwięźle.",
            "en": "Keep answers short and concise."
          },
          "negative_statement": {
            "pl": "Nie skracaj odpowiedzi.",
            "en": "Do not shorten answers."
          }
        },
        "detail": {
          "phrases": {
            "pl": [
              "szczegol*",
              "dokladniej",
              "rozwin*"
            ],
            "en": [
              "detail*",
              "elaborate",
              "in depth",
              "thorough*"
            ]
          },
          "statement": {
            "pl": "Podawaj więcej szczegółów.",
            "en": "Give more detail."
          },
          "negative_statement": {
            "pl": "Nie wchodź w szczegóły.",
            "en": "Do not go into detail."
          }
        },
        "bullets": {
          "phrases": {
            "pl": [
              "lista",
              "liste",
              "listy",
              "punkt*",
              "wypunktowan*"
            ],
            "en": [
