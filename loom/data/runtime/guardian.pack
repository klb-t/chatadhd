        },
        "message": {
          "pl": [
            "tym razem",
            "tylko teraz"
          ],
          "en": [
            "this time",
            "just now"
          ]
        }
      },
      "by_evidence": [
        {
          "distinct_conversations": 2,
          "scope": "person",
          "why": "conversations"
        },
        {
          "distinct_task_kinds": 2,
          "scope": "person",
          "why": "task_kinds"
        }
      ],
      "widening": {
        "asks": true,
        "meaning": {
          "en": "A scope wider than the conversation is only ever proposed as a question; it grows from evidence diversity (distinct conversations, distinct kinds of task, time span), never from the count of repetitions in one place. Words like \"always\" are an occurrence that requests the scope.",
          "pl": "Zakres szerszy niż rozmowa jest zawsze tylko pytaniem; rośnie z różnorodności dowodów (różne rozmowy, różne rodzaje zadań, odstęp czasu), nigdy z liczby powtórzeń w jednym miejscu. Słowa jak „zawsze” są wystąpieniem, które prosi o zakres."
        }
      }
    },
    "exceptions": {
      "max_words": 12,
      "markers": {
        "pl": [
          "z wyjatkiem",
          "poza",
          "oprocz",
          "chyba ze",
          "ale nie"
        ],
        "en": [
          "except",
          "unless",
          "apart from",
          "other than",
          "but not"
        ]
      }
    },
    "polarity": {
