          }
        }
      },
      "rule_statement": {
        "title": {
          "en": "A rule stated by the user",
          "pl": "Reguła podana przez użytkownika"
        },
        "strength": 2.0,
        "priority": 3,
        "annotation_category": "rule_statement",
        "polarity": "positive",
        "hypothesis": {
          "scope": "conversation",
          "promotes": "rule",
          "rule_kind": "stated",
          "named": true,
          "claim": {
            "en": "{{text}}",
            "pl": "{{text}}"
          },
          "statement_kind": "style",
          "negative_statement_kind": "prohibition"
        },
        "detect": {
          "methods": [
            "heuristic"
          ],
          "needs_goal": false,
          "claim_after_marker": true,
          "heuristic": {
            "min_score": 0.9,
            "start_window": 4,
            "start_weight": 1.0,
            "anywhere_weight": 0.0,
            "markers": {
              "pl": [
                "zapamietaj ze",
                "zapamietaj",
                "przyjmij ze",
                "ustalmy ze"
              ],
              "en": [
                "remember that",
                "please remember",
                "let's agree that",
                "lets agree that"
              ]
            }
          }
        }
      }
    },
    "transforms": {
      "compile_refinements": {
        "kind": "refinement",
        "min_occurrences": 3,
        "goal_min_words": 4,
        "goal_max_chars": 4000,
