            "only here"
          ]
        },
        "message": {
          "pl": [
            "tym razem",
            "tylko teraz"
          ],
          "en": [
            "this time",
            "just now"
          ]
        }
      }
    },
    "exceptions": {
      "max_words": 12,
      "markers": {
        "pl": [
          "z wyjatkiem",
          "poza",
          "oprocz",
          "chyba ze",
          "ale nie"
        ],
        "en": [
          "except",
          "unless",
          "apart from",
          "other than",
          "but not"
        ]
      }
    },
    "polarity": {
      "negation": {
        "pl": [
          "nie",
          "bez",
          "nigdy",
          "zadnych",
          "zadnego",
          "przestan"
        ],
        "en": [
          "not",
          "dont",
          "don't",
          "never",
          "no",
          "without",
          "stop"
        ]
      }
    },
    "tokens": {
      "fold": {
        "ą": "a",
        "ć": "c",
        "ę": "e",
        "ł": "l",
        "ń": "n",
        "ó": "o",
        "ś": "s",
        "ź": "z",
        "ż": "z"
      },
      "stopwords": {
        "pl": [
          "oraz",
          "jest",
          "sie",
          "nie",
          "tak",
          "ale",
          "dla",
          "jak",
          "czy",
          "ten",
          "ta",
          "to",
          "na",
