{
  "schema": "loom.runtime_profile/1",
  "domain": "action_rules",
  "revision": 1,
  "description": "Which actions fit which element, as data (GRAF_HUB_KOD_SILNIK §5-§7). An action fits an element when the element has the traits the action requires (classes declare traits in graph/classes.pack, actions require them in runtime/actions.pack; neither lists the other). This profile holds the rest: scoped rules {scope, target, action, effect} with their effects and one shape for every kind of rule (the settings field edit rules of S2/R2 live here: target settings_field, action edit), conflict resolution by the rules of graph/scopes.pack, the axes of §6, and the extrapolation presets (max chain length, max cost, min confidence; off allowed). No rule matching = allow (R43). Everything shipped is calibration: presets, not rules.",
  "defaults": {
    "axes": {
      "content_op": [
        {
          "id": "preserve",
          "label": {
            "en": "Preserve (transcribe, translate)",
            "pl": "Zachowaj (przepisz, przetłumacz)"
          }
        },
        {
          "id": "condense",
          "label": {
            "en": "Condense (summarise)",
            "pl": "Skróć (streść)"
          }
        },
        {
          "id": "expand",
          "label": {
            "en": "Expand (elaborate)",
            "pl": "Rozwiń (dopowiedz)"
          }
        },
        {
          "id": "restyle",
          "label": {
            "en": "Change tone or style (parody)",
            "pl": "Zmień ton lub styl (sparodiuj)"
          }
        },
        {
          "id": "evaluate",
          "label": {
            "en": "Evaluate (critique)",
            "pl": "Oceń (skrytykuj)"
          }
        },
        {
          "id": "combine",
          "label": {
            "en": "Combine (put side by side)",
            "pl": "Połącz (zestaw)"
          }
        },
        {
          "id": "none",
          "label": {
            "en": "Does not act on the content",
            "pl": "Nie działa na treści"
          }
        }
      ],
      "form_op": [
        {
          "id": "read",
          "label": {
            "en": "Read a form into content (describe, transcribe)",
            "pl": "Odczytaj postać w treść (opisz, transkrybuj)"
          }
        },
        {
          "id": "express",
          "label": {
            "en": "Express content in a form (paint, sing, dance)",
            "pl": "Wyraź treść w postaci (namaluj, zaśpiewaj, zatańcz)"
          }
        },
        {
          "id": "none",
          "label": {
            "en": "Keeps the form",
            "pl": "Zachowuje postać"
          }
        }
      ]
    },
    "decisions": {
      "allow": {
        "dimension": "gate",
        "restrictiveness": 0,
        "status": "applicable",
        "label": {
          "en": "Allowed",
          "pl": "Dozwolona"
        }
      },
      "confirm": {
        "dimension": "gate",
        "restrictiveness": 1,
        "status": "needs_confirmation",
        "label": {
          "en": "Needs confirmation",
          "pl": "Wymaga potwierdzenia"
        }
      },
      "deny": {
        "dimension": "gate",
        "restrictiveness": 2,
        "status": "denied",
        "label": {
          "en": "Denied (with a stated reason)",
          "pl": "Zabroniona (z podanym powodem)"
        }
      },
      "default_action": {
        "dimension": "default",
        "status": "default",
        "label": {
          "en": "Default action of the element",
          "pl": "Domyślna akcja elementu"
        }
      },
      "value": {
        "dimension": "value",
        "status": "valued",
        "label": {
          "en": "Sets a value of a setting in its scope",
          "pl": "Ustawia wartość ustawienia w jego zakresie"
        }
      }
    },
    "effects": {
      "allow": {
        "decision": "allow",
        "meaning": "The default when no rule matches: nothing is blocked without an initiator (R43)."
      },
      "confirm": {
        "decision": "confirm",
        "meaning": "The user confirms before the action runs."
      },
      "deny": {
        "decision": "deny",
        "meaning": "Blocked by the initiator of the rule; the rule states the reason."
      },
      "default_action": {
        "decision": "default_action",
        "meaning": "The rule names (in its action) the default action for the target element."
      },
      "require_value": {
        "decision": "allow",
        "meaning": "Settings: a feature does not work until the field is set; nothing is blocked (advisory)."
      },
      "require_confirmation": {
        "decision": "confirm",
        "meaning": "Settings: a change that raises consumption needs the user's explicit confirmation."
      },
      "set_value": {
        "decision": "value",
        "meaning": "Scoped values (R47): the rule sets the value of the setting named by its target {kind: setting, key} in its scope; the most specific scope wins unless a conflict rule says otherwise. Chain thresholds (extrapolation.preset, extrapolation.max_length ...) and the place where action results go (action_results.target) resolve this way."
      }
    },
    "scope_aliases": {
      "global": "installation",
      "user": "person"
    },
    "rules": {
      "edit:config:loom_usage_policy": {
        "id": "edit:config:loom_usage_policy",
        "scope": "engine",
        "target": {
          "kind": "settings_field",
          "field_scope": "config",
          "key": "loom_usage_policy"
        },
        "action": "edit",
        "effect": "require_confirmation",
        "initiator": "engine",
        "locked": true,
        "conflict": "locked_by",
        "reason": {
          "en": "Raising expected consumption by an order of magnitude needs the user's confirmation; the usage-policy actions enforce it.",
          "pl": "Podniesienie spodziewanego zużycia o rząd wielkości wymaga potwierdzenia użytkownika; egzekwują je akcje polityki zużycia."
        }
      },
      "edit:config:_config_version": {
        "id": "edit:config:_config_version",
        "scope": "engine",
        "target": {
          "kind": "settings_field",
          "field_scope": "config",
          "key": "_config_version"
        },
        "action": "edit",
        "effect": "deny",
        "initiator": "engine",
        "reason": {
          "en": "Config format version maintained by the auto-upgrade; writes through the API are rejected.",
          "pl": "Wersja formatu konfiguracji prowadzona przez automatyczną aktualizację; zapisy przez API są odrzucane."
        }
      },
      "edit:secret:api_key": {
        "id": "edit:secret:api_key",
        "scope": "app_preset",
        "target": {
          "kind": "settings_field",
          "field_scope": "secret",
          "key": "api_key"
        },
        "action": "edit",
        "effect": "require_value",
        "initiator": "application preset"
      },
      "default:conversation": {
        "id": "default:conversation",
        "scope": "app_preset",
        "target": {
          "kind": "class",
          "id": "conversation"
        },
        "action": "chat.send",
        "effect": "default_action",
        "initiator": "application preset"
      },
      "default:audio_form": {
        "id": "default:audio_form",
        "scope": "app_preset",
        "target": {
          "kind": "class",
          "id": "audio_form"
        },
        "action": "transcribe",
        "effect": "default_action",
        "initiator": "application preset"
      },
      "default:image_form": {
        "id": "default:image_form",
        "scope": "app_preset",
        "target": {
          "kind": "class",
          "id": "image_form"
        },
        "action": "describe_image",
        "effect": "default_action",
        "initiator": "application preset"
      },
      "deny:settings.set:secret": {
        "id": "deny:settings.set:secret",
        "scope": "engine",
        "target": {
          "kind": "settings_field",
          "field_scope": "secret"
        },
        "action": "settings.set",
        "effect": "deny",
        "initiator": "engine",
        "reason": {
          "en": "A credential typed into the conversation would be stored in the conversation history and sent to the model provider; set it in Settings instead.",
          "pl": "Poświadczenie wpisane w rozmowie zostałoby zapisane w historii rozmowy i wysłane dostawcy modelu; ustaw je w Ustawieniach."
        }
      },
      "confirm:rules.set": {
        "id": "confirm:rules.set",
        "scope": "app_preset",
        "target": {
          "kind": "class",
          "id": "application"
        },
        "action": "rules.set",
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Writing a rule changes how the application behaves from now on; you confirm each one.",
          "pl": "Zapisanie reguły zmienia od teraz zachowanie aplikacji; każdą potwierdzasz sam."
        }
      },
      "confirm:rules.disable": {
        "id": "confirm:rules.disable",
        "scope": "app_preset",
        "target": {
          "kind": "class",
          "id": "application"
        },
        "action": "rules.disable",
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Switching a rule off changes how the application behaves from now on; you confirm each one.",
          "pl": "Wyłączenie reguły zmienia od teraz zachowanie aplikacji; każdą potwierdzasz sam."
        }
      },
      "confirm:guardian.promote": {
        "id": "confirm:guardian.promote",
        "scope": "app_preset",
        "target": {
          "kind": "class",
          "id": "application"
        },
        "action": "guardian.promote",
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "The guardian would save a rule or a compiled instruction for this conversation; you confirm each one.",
          "pl": "Strażnik zapisałby regułę lub skompilowane polecenie dla tej rozmowy; każde potwierdzasz sam."
        }
      },
      "confirm:guardian.undo": {
        "id": "confirm:guardian.undo",
        "scope": "app_preset",
        "target": {
          "kind": "class",
          "id": "application"
        },
        "action": "guardian.undo",
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Taking back what the guardian saved changes what is sent from now on; you confirm it.",
          "pl": "Cofnięcie tego, co zapisał strażnik, zmienia to, co jest wysyłane odtąd; potwierdzasz to sam."
        }
      },
      "confirm:actions.define": {
        "id": "confirm:actions.define",
        "scope": "app_preset",
        "target": {
          "kind": "class",
          "id": "application"
        },
        "action": "actions.define",
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Defining an action adds to what the application can do from now on; you confirm each one.",
          "pl": "Zdefiniowanie akcji powiększa od teraz to, co aplikacja potrafi; każde potwierdzasz sam."
        }
      },
      "confirm:actions.remove": {
        "id": "confirm:actions.remove",
        "scope": "app_preset",
        "target": {
          "kind": "class",
          "id": "application"
        },
        "action": "actions.remove",
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Removing an action takes away what you added; you confirm each one.",
          "pl": "Usunięcie akcji odbiera to, co dodałeś; każde potwierdzasz sam."
        }
      },
      "confirm:groups.define": {
        "id": "confirm:groups.define",
        "scope": "app_preset",
        "target": {
          "kind": "class",
          "id": "application"
        },
        "action": "groups.define",
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Defining a group adds a name that rules and actions can refer to; you confirm each one.",
          "pl": "Zdefiniowanie grupy dodaje nazwę, do której mogą się odwoływać reguły i akcje; każde potwierdzasz sam."
        }
      },
      "confirm:groups.remove": {
        "id": "confirm:groups.remove",
        "scope": "app_preset",
        "target": {
          "kind": "class",
          "id": "application"
        },
        "action": "groups.remove",
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Removing a group takes away a name your rules may refer to; you confirm each one.",
          "pl": "Usunięcie grupy odbiera nazwę, do której mogą się odwoływać Twoje reguły; każde potwierdzasz sam."
        }
      },
      "confirm:device.record_audio": {
        "id": "confirm:device.record_audio",
        "scope": "app_preset",
        "target": {
          "kind": "action",
          "id": "device.record_audio"
        },
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Recording sound with a microphone captures what is said around you; you confirm each recording.",
          "pl": "Nagrywanie mikrofonem rejestruje to, co mówi się wokół Ciebie; każde nagranie potwierdzasz sam."
        }
      },
      "confirm:device.capture_image": {
        "id": "confirm:device.capture_image",
        "scope": "app_preset",
        "target": {
          "kind": "action",
          "id": "device.capture_image"
        },
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Taking a picture with a camera captures what is in front of it; you confirm each one.",
          "pl": "Zdjęcie aparatem rejestruje to, co jest przed nim; każde potwierdzasz sam."
        }
      },
      "confirm:device.capture_video": {
        "id": "confirm:device.capture_video",
        "scope": "app_preset",
        "target": {
          "kind": "action",
          "id": "device.capture_video"
        },
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Recording video with a camera captures what is in front of it; you confirm each recording.",
          "pl": "Film z aparatu rejestruje to, co jest przed nim; każde nagranie potwierdzasz sam."
        }
      },
      "confirm:device.clipboard_read": {
        "id": "confirm:device.clipboard_read",
        "scope": "app_preset",
        "target": {
          "kind": "action",
          "id": "device.clipboard_read"
        },
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "The clipboard may hold what you copied from anywhere (passwords included); you confirm each read.",
          "pl": "Schowek może zawierać to, co skopiowano skądkolwiek (także hasła); każdy odczyt potwierdzasz sam."
        }
      },
      "confirm:conversation.delete": {
        "id": "confirm:conversation.delete",
        "scope": "app_preset",
        "target": {
          "kind": "action",
          "id": "conversation.delete"
        },
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Deleting a conversation removes it with all its messages and cannot be undone; you confirm each one.",
          "pl": "Usunięcie rozmowy usuwa ją razem ze wszystkimi wiadomościami i nie da się go cofnąć; każde potwierdzasz sam."
        }
      },
      "confirm:memory.forget": {
        "id": "confirm:memory.forget",
        "scope": "app_preset",
        "target": {
          "kind": "action",
          "id": "memory.forget"
        },
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Forgetting removes a memory entry for good; you confirm each one.",
          "pl": "Zapomnienie usuwa wpis pamięci na stałe; każde potwierdzasz sam."
        }
      },
      "confirm:usage.compact": {
        "id": "confirm:usage.compact",
        "scope": "app_preset",
        "target": {
          "kind": "action",
          "id": "usage.compact"
        },
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Compacting folds the ledger of the usage for good; you confirm each one.",
          "pl": "Kompaktowanie na stałe zwija rejestr zużycia; każde potwierdzasz sam."
        }
      },
      "confirm:storage.connect": {
        "id": "confirm:storage.connect",
        "scope": "app_preset",
        "target": {
          "kind": "action",
          "id": "storage.connect"
        },
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Connecting a storage adds a place your data can be sent to; you confirm each one.",
          "pl": "Podłączenie magazynu dodaje miejsce, dokąd mogą trafiać Twoje dane; każde potwierdzasz sam."
        }
      },
      "confirm:github.sync": {
        "id": "confirm:github.sync",
        "scope": "app_preset",
        "target": {
          "kind": "action",
          "id": "github.sync"
        },
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Syncing sends your data folder to GitHub and brings changes back; you confirm each one.",
          "pl": "Synchronizacja wysyła folder danych na GitHub i sprowadza zmiany z powrotem; każdą potwierdzasz sam."
        }
      },
      "confirm:views.write": {
        "id": "confirm:views.write",
        "scope": "app_preset",
        "target": {
          "kind": "action",
          "id": "views.write"
        },
        "effect": "confirm",
        "initiator": "application preset",
        "reason": {
          "en": "Changing a view in your overlay changes how the graph is read from now on; you confirm each change.",
          "pl": "Zmiana widoku w Twojej nakładce zmienia od teraz sposób czytania grafu; każdą zmianę potwierdzasz sam."
        }
      }
    },
    "extrapolation": {
      "active": "standard",
      "setting": "extrapolation_preset",
      "bounds_setting": "extrapolation_bounds",
      "presets": {
        "off": {
          "enabled": false,
          "label": {
            "en": "Off: no chain proposals",
            "pl": "Wyłączone: bez propozycji łańcuchów"
          }
        },
        "standard": {
          "enabled": true,
          "label": {
            "en": "Standard",
            "pl": "Standardowy"
          },
          "max_length": 3,
          "max_cost": 10,
          "min_confidence": 0.25,
          "max_results": 5
        },
        "generous": {
          "enabled": true,
          "label": {
            "en": "Generous: no bounds",
            "pl": "Hojny: bez ograniczeń"
          },
          "max_length": null,
          "max_cost": null,
          "min_confidence": null,
          "max_results": null
        }
      },
      "rank_by": [
        {
          "by": "confidence",
          "order": "desc"
        },
        {
          "by": "cost",
          "order": "asc"
        },
        {
          "by": "length",
          "order": "asc"
        }
      ]
    },
    "user_rules": {
      "id_prefix": "user",
      "default_initiator": "user",
      "default_scope": "person",
      "default_reason": {
        "en": "Set by you.",
        "pl": "Ustawione przez Ciebie."
      },
      "instance_levels": [
        "role_in_context",
        "project",
        "conversation",
        "turn"
      ],
      "overlay": "action_rules"
    },
    "scoped_values": {
      "keys": {
        "action_results.target": {
          "setting": "action_result_target",
          "label": {
            "en": "Where the results of actions go",
            "pl": "Dokąd trafiają wyniki akcji"
          }
        },
        "extrapolation.preset": {
          "setting": "extrapolation_preset",
          "label": {
            "en": "Preset of chain proposals",
            "pl": "Preset propozycji łańcuchów"
          }
        },
        "extrapolation.max_length": {
          "setting": "extrapolation_bounds",
          "field": "max_length",
          "label": {
            "en": "Longest proposed chain",
            "pl": "Najdłuższy proponowany łańcuch"
          }
        },
        "extrapolation.max_cost": {
          "setting": "extrapolation_bounds",
          "field": "max_cost",
          "label": {
            "en": "Highest cost of a proposed chain",
            "pl": "Najwyższy koszt proponowanego łańcucha"
          }
        },
        "extrapolation.min_confidence": {
          "setting": "extrapolation_bounds",
          "field": "min_confidence",
          "label": {
            "en": "Lowest confidence of a proposed chain",
            "pl": "Najniższa pewność proponowanego łańcucha"
          }
        },
        "extrapolation.max_results": {
          "setting": "extrapolation_bounds",
          "field": "max_results",
          "label": {
            "en": "How many chains are proposed",
            "pl": "Ile łańcuchów proponować"
          }
        }
      }
    }
  },
  "value_schema": {
    "type": "object",
    "required": [
      "axes",
      "decisions",
      "effects",
      "scope_aliases",
      "rules",
      "extrapolation"
    ],
    "additionalProperties": false,
    "properties": {
      "axes": {
        "type": "object",
        "description": "Vocabularies of the two action axes (GRAF_HUB_KOD_SILNIK §6); open lists, an unknown value in an action is reported, not refused.",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "decisions": {
        "type": "object",
        "description": "What a decision is: dimension gate (allow, confirm, deny; restrictiveness orders them; status is the word the engine reports), default (names the default action) or value (a scoped value of a setting: rules with effect set_value).",
        "additionalProperties": {
          "type": "object"
        }
      },
      "effects": {
        "type": "object",
        "description": "Effect id -> the decision it means. Open: other fields (settings use require_value and require_confirmation); an unknown effect id is an allow with the id passed through.",
        "additionalProperties": {
          "type": "object",
          "required": [
            "decision"
          ],
          "additionalProperties": true
        }
      },
      "scope_aliases": {
        "type": "object",
        "description": "Alias -> a level of the scopes chain (graph/scopes.pack).",
        "additionalProperties": {
          "type": "string"
        }
      },
      "rules": {
        "type": "object",
        "description": "Rule id -> rule {id, scope, scope_id?, target, action?, effect, value?, reason?, initiator?, locked?, weight?, conflict?, when?, disabled?}. One store and one shape for every kind of rule: settings field edit rules (target kind settings_field, action edit) and rules over classes, traits, trait bundles, nodes and action groups. No rule matching = allow (R43: a block needs an initiator). Overlay: profiles/action_rules.pack merges by id; disabled:true switches a rule off. Scoped values (R47): effect set_value with target {kind: setting, key} and value; the installation baseline is data, the user's setting is the person level (alias user), a rule may sit at any level (a conversation: scope + scope_id).",
        "additionalProperties": {
          "type": "object",
          "required": [
            "id",
            "scope",
            "target",
            "effect"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "description": "A level of the scopes chain (engine ... turn) or an alias."
            },
            "scope_id": {
              "type": "string",
              "description": "The instance of the level the rule belongs to (a project, a conversation...); absent = every instance."
            },
            "target": {
              "type": "object",
              "description": "Which elements: {kind:\"class\",id}, {kind:\"trait\",id}, {kind:\"bundle\",id} (member of a trait bundle), {kind:\"node\",id}, {kind:\"any\"}, or any other kind = a class id with the remaining keys matched against the element attrs (settings_field + field_scope + key)."
            },
            "action": {
              "type": [
                "string",
                "object"
              ],
              "description": "Which action: an action id, \"*\" or absent (any), {\"group\":id} or {\"flag\":effect flag}. For default_action: the default action."
            },
            "effect": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": [
                "string",
                "object"
              ],
              "description": "Why (deny needs one: R43); a string or {en, pl}."
            },
            "initiator": {
              "type": "string",
              "description": "Who stands behind the rule; default: its scope."
            },
            "locked": {
              "type": "boolean",
              "description": "Pinned: with the conflict rule locked_by a lower scope cannot override it."
            },
            "weight": {
              "type": "number",
              "description": "Vote weight for the conflict rule weighted_vote (default 1)."
            },
            "conflict": {
              "type": "string",
              "description": "The conflict rule (graph/scopes.pack) that governs rules in conflict with this one; the most general declaring rule decides, else the chain default."
            },
            "when": {
              "type": "object",
              "description": "Context predicate: {\"context\":{level:instance id}} must all hold in the query scope."
            },
            "disabled": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ],
              "description": "Dimension value only: the value the rule sets for the setting named by its target key (null is a value, e.g. \"no bound\")."
            }
          },
          "additionalProperties": true
        }
      },
      "extrapolation": {
        "type": "object",
        "required": [
          "active",
          "presets",
          "rank_by"
        ],
        "properties": {
          "active": {
            "type": "string",
            "minLength": 1
          },
          "presets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "max_length": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "max_cost": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "min_confidence": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "max_results": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "rank_by": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "by",
                "order"
              ],
              "properties": {
                "by": {
                  "type": "string",
                  "enum": [
                    "confidence",
                    "cost",
                    "length"
                  ]
                },
                "order": {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "setting": {
            "type": "string",
            "description": "Config key of the user's preset: it is the person-level value of extrapolation.preset (resolved through the scope chain like rules)."
          },
          "bounds_setting": {
            "type": "string",
            "description": "Config key (an object {max_length, max_cost, min_confidence, max_results}) of the user's thresholds: the person-level values of extrapolation.<bound>."
          }
        },
        "additionalProperties": true,
        "description": "Chain proposals (GRAF_HUB_KOD_SILNIK §5, wave 2b). Presets are not limits: null = no bound, the owner chooses; off disables proposals."
      },
      "user_rules": {
        "type": "object",
        "description": "Rules the user writes by saying so (rules.set from the conversation, the CLI or the API), kept in the overlay profiles/action_rules.pack. id_prefix starts the id of such a rule (the rest names scope, dimension and subject, so a new rule for the same subject replaces the old one); default_scope is where a rule lands when the words name none; default_reason fills a rule that gives no reason (deny needs one, R43); instance_levels are the levels that need a scope_id (a conversation, a project ...).",
        "required": [
          "id_prefix",
          "default_initiator",
          "default_scope",
          "default_reason",
          "instance_levels"
        ],
        "properties": {
          "id_prefix": {
            "type": "string",
            "minLength": 1
          },
          "default_initiator": {
            "type": "string",
            "minLength": 1
          },
          "default_scope": {
            "type": "string",
            "minLength": 1
          },
          "default_reason": {
            "type": [
              "string",
              "object"
            ]
          },
          "instance_levels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "overlay": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "scoped_values": {
        "type": "object",
        "description": "Settings the scope chain resolves (R47): the key a set_value rule targets, the user's setting that is its person-level baseline, and for a setting that holds an object which field of it. A rule on a setting the table does not list is written all the same, and the answer says that nothing reads it per scope yet.",
        "required": [
          "keys"
        ],
        "properties": {
          "keys": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "setting"
              ],
              "properties": {
                "setting": {
                  "type": "string",
                  "minLength": 1
                },
                "field": {
                  "type": "string"
                },
                "label": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
