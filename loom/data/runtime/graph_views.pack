        },
        "device": "keyboard",
        "input": {
          "key": "ArrowLeft",
          "modifiers": [
            "shift"
          ]
        },
        "action": {
          "kind": "move",
          "pair": "depth_time",
          "axis": "horizontal",
          "direction": -1,
          "step": 1
        }
      },
      "kbd.depth_time.right": {
        "label": {
          "en": "Time: forward",
          "pl": "Czas: naprzód"
        },
        "device": "keyboard",
        "input": {
          "key": "ArrowRight",
          "modifiers": [
            "shift"
          ]
        },
        "action": {
          "kind": "move",
          "pair": "depth_time",
          "axis": "horizontal",
          "direction": 1,
          "step": 1
        }
      },
      "kbd.depth_time.up": {
        "label": {
          "en": "Depth: shallower",
          "pl": "Głębia: płycej"
        },
        "device": "keyboard",
        "input": {
          "key": "ArrowUp",
          "modifiers": [
            "shift"
          ]
        },
        "action": {
          "kind": "move",
          "pair": "depth_time",
          "axis": "vertical",
          "direction": -1,
          "step": 1
        }
      },
      "kbd.depth_time.down": {
        "label": {
          "en": "Depth: deeper",
          "pl": "Głębia: głębiej"
        },
        "device": "keyboard",
        "input": {
          "key": "ArrowDown",
          "modifiers": [
            "shift"
          ]
        },
        "action": {
          "kind": "move",
          "pair": "depth_time",
          "axis": "vertical",
          "direction": 1,
          "step": 1
        }
      },
      "kbd.branches.left": {
        "label": {
          "en": "Branches: previous",
