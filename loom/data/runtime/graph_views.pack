        },
        "device": "keyboard",
        "input": {
          "key": "ArrowLeft",
          "modifiers": [
            "ctrl"
          ]
        },
        "action": {
          "kind": "move",
          "pair": "branches",
          "axis": "horizontal",
          "direction": -1,
