        }
      },
      "touch.drag.hold": {
        "label": {
          "en": "Depth and time: long press and drag",
          "pl": "Głębia i czas: długie przytrzymanie i przeciągnięcie"
        },
        "device": "touch",
        "input": {
          "gesture": "long_press_drag",
          "modifiers": []
        },
        "action": {
          "kind": "move",
          "pair": "depth_time",
          "drag": true,
          "step": 1
        },
        "status": {
          "state": "planned",
          "by": "M1-W3",
          "today": {
            "en": "Today this binding is only recorded in the data: the screen does not recognise a long press with a drag yet.",
            "pl": "Dziś to przypisanie jest tylko zapisane w danych: ekran nie rozpoznaje jeszcze długiego przytrzymania z przeciągnięciem."
          },
          "reason": {
            "en": "Recognising the gesture comes with work item M1-W3 (map gestures).",
            "pl": "Rozpoznawanie gestu dochodzi z pozycją M1-W3 (gesty mapy)."
          }
        }
      }
    },
    "interaction_rules": {
      "messages": {
        "kind": "messages",
        "texts": {
          "binding_without_device": {
            "en": "The binding names no device.",
            "pl": "Przypisanie nie wskazuje urządzenia."
          },
          "binding_without_input": {
            "en": "The binding has no input.",
            "pl": "Przypisanie nie ma wejścia."
          },
          "binding_without_action": {
            "en": "The binding has no action.",
            "pl": "Przypisanie nie ma działania."
          },
          "unsupported_device": {
            "en": "No such device '{device}'; the binding stays in the data and does nothing.",
            "pl": "Nieznane urządzenie '{device}'; przypisanie zostaje w danych i nie działa."
          },
          "unsupported_input_field": {
            "en": "Device '{device}' does not know the input field '{field}'.",
            "pl": "Urządzenie '{device}' nie zna pola wejścia '{field}'."
          },
          "unsupported_action_kind": {
            "en": "No action '{kind}'; the binding stays in the data and does nothing.",
            "pl": "Brak działania '{kind}'; przypisanie zostaje w danych i nie działa."
          },
          "device_not_implemented": {
            "en": "Device '{device}' is only recorded as data here (not handled in this version).",
            "pl": "Urządzenie '{device}' jest tu tylko zapisane jako dane (brak obsługi w tej wersji)."
          },
          "switch_view_unknown_declaration": {
            "en": "The view '{declaration}' does not exist; the binding will switch nothing.",
            "pl": "Widok '{declaration}' nie istnieje; przypisanie nic nie przełączy."
          },
          "conflict": {
            "en": "Conflicting bindings for {input}: {ids}. The last one ({winner}) wins; none is blocked.",
            "pl": "Konflikt przypisań dla {input}: {ids}. Działa ostatnie ({winner}); żadne nie jest zablokowane."
          },
          "unknown_device_requested": {
            "en": "There is no device '{device}' in the list.",
            "pl": "Nie ma urządzenia '{device}' na liście."
          },
          "input_not_implemented": {
            "en": "Input '{field}' of device '{device}' is only recorded as data here (not handled in this version).",
            "pl": "Wejście '{field}' urządzenia '{device}' jest tu tylko zapisane jako dane (brak obsługi w tej wersji)."
          }
        }
      }
    },
    "view_renderers": {
      "flat_2d": {
        "label": {
          "en": "Flat 2D (SVG)",
          "pl": "Płaski 2D (SVG)"
        },
        "meaning": {
          "en": "The view model projected onto a plane; depth shown as size, fog and desaturation. Works everywhere.",
          "pl": "Model widoku rzutowany na płaszczyznę; głębia jako rozmiar, mgła i odbarwienie. Działa wszędzie."
        },
        "engine": "svg_2d",
        "implemented": true,
        "modes": {
          "flat": {
            "kind": "screen",
            "label": {
              "en": "Flat",
              "pl": "Płasko"
            }
          }
        },
        "default_mode": "flat"
      },
      "spatial_3d": {
        "label": {
          "en": "Spatial 3D (screen, VR, AR)",
          "pl": "Przestrzenny 3D (ekran, VR, AR)"
        },
        "meaning": {
          "en": "The same view model in 3D: sector angles are real directions around the user, depth is distance, the world stands still and the user turns. On a flat screen: orbit or look-around; with WebXR: immersive VR or AR.",
          "pl": "Ten sam model widoku w 3D: kąty sektorów to prawdziwe kierunki wokół użytkownika, głębia to odległość, świat stoi, obraca się użytkownik. Na płaskim ekranie: orbita albo rozglądanie się; z WebXR: immersyjne VR albo AR."
        },
        "engine": "three",
        "implemented": true,
        "default_mode": "orbit",
        "modes": {
          "orbit": {
            "kind": "screen",
            "label": {
              "en": "Orbit (screen)",
              "pl": "Orbita (ekran)"
            },
            "meaning": {
              "en": "Drag to orbit the scene, wheel to move closer; the fallback when there is no headset.",
              "pl": "Przeciągnij, by okrążać scenę, kółko przybliża; tryb zastępczy bez gogli."
            }
          },
          "look": {
            "kind": "screen",
            "label": {
              "en": "Look around (screen)",
              "pl": "Rozglądanie się (ekran)"
            },
            "meaning": {
              "en": "Stand in the middle and turn your head by dragging, as in VR.",
              "pl": "Stań pośrodku i obracaj głowę przeciągnięciem, jak w VR."
            }
          },
          "immersive-vr": {
            "kind": "xr",
            "session": "immersive-vr",
            "label": {
              "en": "Enter VR",
              "pl": "Wejdź w VR"
            },
            "features": {
              "required": [],
              "optional": [
                "local-floor",
                "hand-tracking"
              ]
            }
          },
          "immersive-ar": {
            "kind": "xr",
            "session": "immersive-ar",
            "label": {
              "en": "Enter AR",
              "pl": "Wejdź w AR"
            },
            "features": {
              "required": [],
              "optional": [
                "local-floor",
                "hand-tracking"
              ]
            },
            "transparent_background": true
          }
        },
        "spatial": {
          "direction_offset_deg": 0,
          "mirror": false,
          "distance": {
            "near_m": 1.0,
            "far_m": 7.0,
            "curve": [
              [
                0,
                0
              ],
              [
                1,
                1
              ]
            ],
            "flat_m": 3.0,
            "rise_m_per_m": 0.12
          },
          "node": {
            "m_per_px": 0.012,
            "min_radius_m": 0.03,
            "max_radius_m": 0.4,
            "min_angle_deg": 0.7
          },
          "ground": {
            "show": true,
            "y_m": -1.2,
            "opacity": 0.07
          },
          "edges": {
            "opacity": 0.35
          },
          "fog": {
            "use_depth_system": true
          }
        },
        "blend": {
          "curve": [
            [
              0,
              1
            ],
            [
              0.5,
              0.92
            ],
            [
              1,
              0.5
            ],
            [
              1.5,
              0.2
            ],
            [
              2.5,
              0.1
            ]
          ],
          "floor_alpha": 0.15,
          "floor_scale": 0.8,
          "unit": "half_sector_width"
        },
        "labels": {
          "policy": "focus_and_gazed",
          "gazed_weight": 0.7,
          "near_m": 2.2,
          "max_chars": 42,
          "world_height_m": 0.14,
          "badges": true
        },
        "hint": {
          "distance_m": 1.25,
          "down_deg": 24,
          "width_m": 1.0,
          "opacity": 0.88,
          "max_lines": 14
        },
        "pick": {
          "tolerance_deg": 4
        },
        "xr": {
          "reference_space": "local",
          "gestures": {
            "large_swipe": {
              "min_distance_m": 0.45,
              "max_ms": 700,
              "dominance": 1.6,
              "cooldown_ms": 800
            },
            "two_hand_rotate": {
              "min_angle_deg": 25,
              "cooldown_ms": 800,
              "min_hand_move_m": 0.12,
              "max_ms": 1200
            }
          },
          "stick": {
            "threshold": 0.7,
            "repeat_ms": 350
          }
        },
        "screen": {
          "orbit": {
            "distance_m": 9.0,
            "min_m": 1.5,
            "max_m": 30,
            "yaw_deg": 25,
            "pitch_deg": 18,
            "fit": true
          },
          "look": {
            "fov_deg": 70
          },
          "fov_deg": 55
        }
      }
    },
    "node_addresses": {
      "note": {
        "en": "R101 D1 (PULPIT_R101 §4.2): address prefixes of things that can be pinned on a desktop and the node kind of their representative row in the nodes table (label = the address, metadata.address = the address). The list is open (examples): a prefix not listed here is pinned as node kind `address`, never refused. same_as: the id form the address points at, when it is a real row.",
        "pl": "R101 D1 (PULPIT_R101 §4.2): prefiksy adresów rzeczy, które można przypiąć do pulpitu, i rodzaj węzła ich reprezentanta w tabeli nodes (etykieta = adres, metadata.address = adres). Lista otwarta (przykłady): prefiks spoza listy przypina się jako węzeł rodzaju `address`, nigdy nie jest odrzucany. same_as: forma id, na którą adres wskazuje, gdy to prawdziwy wiersz."
      },
      "unknown_kind": "address",
      "default_desktop": "desktop:main",
      "prefixes": {
        "desktop:": {
          "node_kind": "desktop",
