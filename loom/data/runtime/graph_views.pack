        "source": "receipt",
        "params": {
          "msg_id": {
            "required": true,
            "description": {
              "en": "The message whose “What we sent” receipt to show.",
              "pl": "Wiadomość, której ślad „Co wysłaliśmy” pokazać."
            }
          }
        },
        "status": {
          "state": "implemented",
          "by": "M1-K1c2",
          "today": {
            "en": "Works from the stored record of a request: the message, what was put into the request (one node per element where the record names the element, otherwise one per kind of material) and what was left out and why. A record exists only for requests sent after the records were introduced, and only when saving records is on.",
            "pl": "Działa na zapisanym śladzie żądania: wiadomość, to co weszło do żądania (po jednym węźle na element, gdy ślad go nazywa, w przeciwnym razie na rodzaj materiału) oraz to co pominięto i dlaczego. Ślad istnieje tylko dla żądań wysłanych po wprowadzeniu śladów i tylko gdy zapis śladów jest włączony."
          },
          "reason": {
            "en": "Nothing is stored for this view: it is computed from the record kept with the message (contract loom.context_receipt/1).",
            "pl": "Ten widok niczego nie zapisuje: liczy się ze śladu zapisanego przy wiadomości (kontrakt loom.context_receipt/1)."
          }
        }
      },
      "evidence": {
        "label": {
