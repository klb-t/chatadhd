      "kbd.focus.selected": {
        "label": {
          "en": "F: focus on the selected element",
          "pl": "F: fokus na zaznaczonym elemencie"
        },
        "device": "keyboard",
        "input": {
          "key": "f",
          "modifiers": []
        },
        "action": {
