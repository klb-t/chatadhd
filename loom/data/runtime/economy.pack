{
  "schema": "loom.runtime_profile/1",
  "domain": "economy",
  "revision": 1,
  "description": "Resource-economy report presets (R50, GRAPH_ENTRY_PARTIES_ECONOMY section 9). Every value is a preset the owner may override; nothing here forbids a duplicate. mode: off (no analysis) | report | propose (same read-only findings, flagged as proposals) ; auto is reserved and is NOT implemented - the report never writes. Thresholds (min_*) select what is worth reporting, they never block anything. Cost coefficients feed the balance benefit = (copies-1)*size*storage_cost*horizon [+ saved tokens*price] versus cost = indirection + dedupe compute + independence loss [+ regeneration * expected reads]; a null coefficient means unknown and makes the dependent balance {known:false} rather than zero. independence_loss_usd_per_copy 0 means no price on losing independent copies. max_findings_per_class 0 lists every finding (totals always cover all).",
  "defaults": {
    "mode": "report",
    "message_statuses": [
      "active",
      "excluded"
    ],
    "min_copies": 2,
    "min_message_bytes": 64,
    "min_conversation_messages": 2,
    "json_columns": [
      {
        "table": "messages",
        "column": "metadata",
        "id": "id"
      },
      {
        "table": "nodes",
        "column": "metadata",
        "id": "id"
      },
      {
        "table": "links",
        "column": "metadata",
        "id": "id"
      },
      {
        "table": "loom_artifacts",
        "column": "metadata",
        "id": "id"
      },
      {
        "table": "loom_tasks",
        "column": "params",
        "id": "id"
      },
      {
        "table": "loom_tasks",
        "column": "result",
        "id": "id"
      }
    ],
    "min_block_bytes": 256,
    "min_block_copies": 3,
    "min_prefix_bytes": 64,
    "examples_per_finding": 3,
    "max_findings_per_class": 100,
    "storage_cost_usd_per_gb_month": 0.02,
    "horizon_months": 12,
    "indirection_cost_usd_per_reference": 1e-06,
    "dedupe_compute_usd_per_mb": 1e-05,
    "independence_loss_usd_per_copy": 0,
    "cold_compression_ratio": null,
    "chars_per_token": 4,
    "token_price_usd_per_million": null,
    "expected_prompt_inclusions": null
  },
  "value_schema": {
    "x-setting": "",
    "x-consumer": "economy",
    "type": "object",
    "required": [
      "mode",
      "message_statuses",
      "min_copies",
      "min_message_bytes",
      "min_conversation_messages",
      "json_columns",
      "min_block_bytes",
      "min_block_copies",
      "min_prefix_bytes",
      "examples_per_finding",
      "max_findings_per_class",
      "storage_cost_usd_per_gb_month",
