        },
        "contain_edge": "part_of",
        "edges": [],
        "epistemic_default": {
          "class": "declared",
          "confidence": 1.0
        },
        "description": "The 13 items of the read-only memory (graph/rom.pack); an item overridden in the user's graph_entry overlay says so (layer overlay)."
      },
      {
        "id": "group",
        "prefix": "group:",
        "class": "settings_group",
        "reader": "settings.groups",
        "label": {
          "en": "Settings groups",
          "pl": "Grupy ustawień"
        },
        "parent": {
          "area": "profiles_settings"
        },
        "contain_edge": "part_of",
        "edges": [],
        "epistemic_default": {
          "class": "declared",
          "confidence": 1.0
        },
        "description": "The groups of the settings (settings_fields.pack groups, view kind settings_groups with the view overlays)."
      },
      {
        "id": "setting",
        "prefix": "setting:",
        "class": "settings_field",
        "reader": "settings.fields",
        "label": {
          "en": "Settings",
          "pl": "Ustawienia"
        },
        "parent": {
          "of": "group"
        },
        "contain_edge": "grouped_in",
        "edges": [
          {
            "kind": "has_default",
            "to": "rom:factory_presets",
            "when": "has_default"
          }
        ],
        "epistemic_default": {
          "class": "declared",
          "confidence": 1.0
        },
        "description": "Every settings field and every profile value (settings_fields.pack fields and profile_values), its value resolved through the one scope chain (scope_resolver, opened once per render). The evidence of the value follows the level that supplied it: a preset is declared; your setting or a conversation's value is what you said (observed) — except a person value equal to the preset, which config.json may hold only because the auto-upgrade wrote the presets there: it says same_as_preset and stays declared. A secret shows only whether it is set.",
        "evidence_by_scope": {
          "installation": {
            "class": "declared",
            "confidence": 1.0
          },
          "person": {
            "class": "observed",
            "confidence": 1.0
          },
          "conversation": {
            "class": "observed",
            "confidence": 1.0
          },
          "*": {
            "class": "observed",
            "confidence": 1.0
          }
        },
        "proposals_status": {
          "state": "planned",
          "today": {
            "en": "Today no field carries a proposal of the guardian: its hypotheses are keyed by the text of a rule, not by a settings key; they are under You › Rules (guardian.remembered).",
            "pl": "Dziś żadne pole nie ma propozycji strażnika: jego hipotezy są kluczowane tekstem reguły, nie kluczem ustawienia; widać je pod Ty › Reguły (guardian.remembered)."
          },
          "reason": {
            "en": "The mapping from a hypothesis to a settings key (guardian.pack kinds.<kind>.hypothesis.setting_key) is not in the data yet.",
            "pl": "Mapowania hipotezy na klucz ustawienia (guardian.pack kinds.<kind>.hypothesis.setting_key) jeszcze nie ma w danych."
          }
        }
      },
