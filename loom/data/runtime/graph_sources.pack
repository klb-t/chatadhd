        "params": {
          "items": [
            {
              "id": "semantic_analysis",
              "label": {
                "en": "Background analysis of messages",
                "pl": "Analiza wiadomości w tle"
              },
              "why": {
                "en": "Every new message waits for the analysis (entities, topics, relations); the analysis profile chooses the mode: batch, one by one with a model, or local rules.",
                "pl": "Każda nowa wiadomość czeka na analizę (encje, tematy, relacje); profil analizy wybiera tryb: zbiorczo, pojedynczo modelem albo lokalnymi regułami."
              },
              "setting": "semantic_analysis",
              "flow": "semantic.analyse"
            },
            {
              "id": "guardian",
              "label": {
                "en": "The guardian reads every message",
                "pl": "Strażnik czyta każdą wiadomość"
              },
              "why": {
                "en": "After each message the guardian looks for corrections and clarifications and keeps its representation beside the messages; it never changes them.",
                "pl": "Po każdej wiadomości strażnik szuka poprawek i doprecyzowań i prowadzi swój obraz obok wiadomości; nigdy ich nie zmienia."
              },
              "setting": "guardian_method",
              "flow": "guardian.observe"
            },
            {
              "id": "auto_title",
              "label": {
                "en": "A title after the first message",
                "pl": "Tytuł po pierwszej wiadomości"
              },
              "why": {
                "en": "A new conversation gets a title from its first message, without a model call.",
                "pl": "Nowa rozmowa dostaje tytuł z pierwszej wiadomości, bez wywołania modelu."
              },
              "setting": "auto_title",
              "flow": "chat.send"
            },
            {
              "id": "search_index",
              "label": {
                "en": "The search index built in the background",
                "pl": "Indeks wyszukiwania budowany w tle"
              },
              "why": {
                "en": "The full-text index of the messages is filled in portions in the background, so a search never waits for it.",
                "pl": "Indeks pełnotekstowy wiadomości wypełnia się porcjami w tle, więc wyszukiwanie na niego nie czeka."
              },
              "setting": "loom_fts_background_build",
              "flow": "search.find"
            },
            {
              "id": "task_workers",
              "label": {
                "en": "Threads of the background tasks",
                "pl": "Wątki zadań w tle"
              },
              "why": {
                "en": "Long work (imports, archives, batches) runs as background tasks; this many at a time.",
                "pl": "Długie prace (importy, archiwa, partie) idą jako zadania w tle; tyle naraz."
              },
              "setting": "loom_task_workers",
              "flow": "tasks.list"
            },
            {
              "id": "cleanup",
              "label": {
                "en": "Housekeeping at start",
                "pl": "Porządki przy starcie"
              },
              "why": {
                "en": "When the app starts it removes abandoned upload parts and, if you allow it, blobs nothing names.",
                "pl": "Przy starcie aplikacja usuwa porzucone części wysyłek i, jeśli pozwolisz, bloby, których nic nie wskazuje."
              },
              "setting": "cleanup"
            },
            {
              "id": "usage_compaction",
              "label": {
                "en": "Compaction of the usage ledger",
                "pl": "Porządkowanie księgi zużycia"
              },
              "why": {
                "en": "Old completed operations of the usage ledger are folded by the compaction profile; never a spending limit.",
                "pl": "Stare zakończone operacje księgi zużycia są składane według profilu porządkowania; to nigdy nie jest limit wydatków."
              },
              "setting": "usage_ledger_compaction",
              "flow": "usage.compact"
            },
            {
              "id": "model_list",
              "label": {
                "en": "The model list fetched when a price is needed",
                "pl": "Lista modeli pobierana, gdy potrzebna cena"
              },
              "why": {
                "en": "An estimate that needs a price and finds the model list empty may fetch the provider's public list once.",
                "pl": "Wycena, która potrzebuje ceny, a lista modeli jest pusta, może raz pobrać publiczną listę dostawcy."
              },
              "setting": "model_registry_autorefresh",
              "flow": "models.refresh"
            },
            {
              "id": "environments_sync",
              "label": {
                "en": "Environments refreshed before an answer",
                "pl": "Środowiska odświeżane przed odpowiedzią"
              },
              "why": {
                "en": "Before answering a question about environments their nodes are brought up to date from their sources.",
                "pl": "Przed odpowiedzią na pytanie o środowiska ich węzły są uaktualniane ze źródeł."
              },
              "setting": "environments_auto_sync",
              "flow": "environments.sync"
            },
            {
              "id": "emergent_actions",
              "label": {
                "en": "New actions proposed from your conversations",
                "pl": "Nowe działania proponowane z rozmów"
              },
              "why": {
                "en": "A command no action understands, or a sequence you repeat, is offered as a new action — never made silently.",
                "pl": "Polecenie, którego żadne działanie nie rozumie, albo powtarzana sekwencja jest proponowana jako nowe działanie — nigdy po cichu."
              },
              "setting": "emergent_actions",
              "flow": "actions.define"
            }
          ]
        },
        "description": "The work the app does on its own (after each message, at start, in the background), each with the setting that switches it and the flow it runs; its value is that setting's value, through the scope chain. A list of examples: an overlay may add more."
