        "description": "The tool sources you added (config tool_sources: MCP servers and others), each with its trust."
      }
    ],
    "identity": {
      "description": "Address forms that name the same node: the projection address is canonical; the database id and a nodes row of kind message pointing at the message are the same node (same_as) and are counted once.",
      "db_forms": [
        {
          "db_prefix": "c_",
          "address_prefix": "conv:"
        },
        {
          "db_prefix": "m_",
          "address_prefix": "msg:"
        }
      ],
      "node_rows": [
        {
          "kind": "message",
          "points_with": [
            "metadata.message_id",
            "metadata.msg_id",
            "label"
          ],
          "db_prefix": "m_",
          "address_prefix": "msg:"
        }
      ]
    },
    "root": {
      "label": {
        "en": "Graph",
        "pl": "Graf"
      },
      "kind": "root"
    },
    "value_words": {
      "true": {
        "en": "on",
        "pl": "włączone"
      },
      "false": {
        "en": "off",
        "pl": "wyłączone"
      },
      "null": {
        "en": "not set",
        "pl": "nie ustawiono"
      },
      "empty": {
        "en": "empty",
        "pl": "puste"
      },
      "items": {
        "en": "{{n}} items",
        "pl": "{{n}} elem."
      },
      "decimal_separator": {
        "en": ".",
        "pl": ","
      },
      "secret_set": {
        "en": "set",
        "pl": "ustawiony"
      },
      "secret_unset": {
        "en": "not set",
        "pl": "nie ustawiony"
      },
      "secret_chip": {
        "en": "secret",
        "pl": "sekret"
      },
      "chip_installation": {
        "en": "Preset",
        "pl": "Preset"
      },
      "chip_person": {
        "en": "You",
        "pl": "Ty"
      },
      "problem": {
        "en": "cannot be read",
        "pl": "nie da się odczytać"
      },
      "no_model": {
        "en": "no model",
        "pl": "brak modelu"
      },
      "slot_unknown": {
        "en": "unknown",
        "pl": "nieznane"
      },
      "slot_declined": {
        "en": "declined",
        "pl": "odmówiono"
      },
      "slot_never": {
        "en": "never",
        "pl": "nigdy"
      }
    }
  },
  "value_schema": {
    "type": "object",
    "required": [
      "schema",
      "sources",
      "identity",
      "root"
    ],
    "properties": {
      "schema": {
        "type": "string"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "prefix",
            "class",
            "reader",
            "parent",
            "epistemic_default"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "prefix": {
              "type": "string",
              "minLength": 1
            },
            "class": {
              "type": "string"
            },
            "reader": {
              "type": "string",
              "minLength": 1
            },
            "parent": {
              "type": "object"
            },
            "edges": {
              "type": "array"
            },
            "epistemic_default": {
              "type": "object"
            },
            "hidden": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "identity": {
        "type": "object"
      },
      "root": {
        "type": "object"
      }
    },
    "additionalProperties": true
  }
}
