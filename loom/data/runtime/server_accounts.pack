                  },
                  "estimate_chars_per_token": {
                    "type": "number",
                    "minimum": 0
                  },
                  "parallel_streams": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "api_per_minute": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "per_address": {
                "type": "object",
                "properties": {
                  "sessions_per_hour": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "chat_per_minute": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "global": {
                "type": "object",
                "properties": {
                  "live_sessions": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pool_chat_per_day": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pool_output_tokens_per_day": {
                    "type": "integer",
                    "minimum": 0,
                    "x-unit": "tokens"
                  }
                }
              },
              "sizes": {
                "type": "object",
                "properties": {
                  "max_body_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "x-unit": "bytes"
                  },
                  "max_upload_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "x-unit": "bytes"
                  }
                }
              },
              "outbound": {
                "type": "object",
                "properties": {
                  "only_provider_hosts": {
                    "type": "boolean"
                  },
                  "extra_hosts": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "model_routes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "words": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
