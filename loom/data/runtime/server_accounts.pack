          },
          "protection": {
            "type": "object",
            "description": "Abuse and cost protection of guests (R103 B2). Every number is a preset; 0 = no limit.",
            "properties": {
              "pow": {
                "type": "object",
                "properties": {
                  "bits": {
                    "type": "integer",
                    "minimum": 0,
                    "x-unit": "bits"
                  },
                  "bits_under_load": {
                    "type": "integer",
                    "minimum": 0,
                    "x-unit": "bits"
                  },
                  "load_share": {
                    "type": "number",
                    "minimum": 0
                  },
