      "crypto": "crypto",
      "profile": "profile"
    },
    "limits": {
      "conversation_list": 50,
      "graph_node_list": 200,
      "graph_expansion_depth": 1,
      "context_depth": 0,
      "context_tokens": 4000,
      "search_results": 20,
      "task_list": 50,
      "task_resume_scan": 1000,
      "source_list": 100,
      "artifact_list": 100,
      "catalog_eval_scan": 1000000,
      "catalog_list": 100,
      "catalog_watch_seconds": 300,
      "chat_depth": 2
    },
    "presentation": {
      "widths": {
        "default": 100,
        "short": 70,
        "wide": 80,
        "brief": 60,
        "summary": 160
      },
      "timestamps": {
        "conversation": 16,
        "message": 19,
        "task": 19,
        "artifact": 19,
        "date": 10
      },
      "hash_chars": 12,
      "ellipsis": "…",
      "score_decimal_scale": 100.0
    },
    "creation": {
      "conversation_title": "New Chat",
      "memory_node_type": "text",
      "export_format": "markdown"
    },
    "evaluation": {
      "units_key": "units",
      "relevant_key": "relevant",
      "traps_key": "noise_traps",
      "generic_key": "noise_generic",
      "external_id_key": "conv_id"
    },
    "graph_stats": [
