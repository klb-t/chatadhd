{
  "schema": "loom.runtime_profile/1",
  "domain": "action_run",
  "revision": 1,
  "description": "Settings of the interpreter that runs actions (include/loom/action_run.h, action_runner.h). max_depth bounds how deep composite actions nest (a composite that contains itself is always refused); null = no bound. use_model: how a `use_model` step is filled in when the step names no model: the config key that holds the default model, the attribution title, the timeout. Everything is a preset: the user's overlay <data>/profiles/action_run.pack changes it. Steps of composite actions live in runtime/actions.pack: {id?, action, with?, when?, variants?, variant_mode?, on_failure?}; `with` may hold {\"$arg\": name, default?} (an argument of the run) and {\"$text\": step id | input} (the text of an earlier step's output, or of the element) placeholders; `with.inputs` lists {from: input | step id, variant?} parts (default: the previous step's output, the element's content for the first); `when` is a condition: {trait}, {step, is: ok|failed|skipped}, {output, kind?}, {arg, equals?}, {not}, {all: []}, {any: []}. Two more placeholders make a prompt data in every language: {\"$localized\": {en: X, pl: Y}} is the entry of the run's language (argument lang, else context.lang, else default_language) and {\"$format\": text, vars: {name: value}} fills {name} in the text; both nest, and the default of a {\"$arg\": name, default} is evaluated too.",
  "defaults": {
    "max_depth": 8,
    "default_language": "en",
    "use_model": {
      "model_setting": "default_model",
      "title": "ChatADHD",
      "timeout_ms": 180000
    },
    "media": {
      "asr": {"part": "audio", "default_format": "wav", "unit": "second"},
      "ocr": {"part": "image", "default_format": "png", "unit": "page"},
      "formats": {
        "audio/wav": "wav", "audio/x-wav": "wav", "audio/wave": "wav", "audio/mpeg": "mp3", "audio/mp3": "mp3", "audio/mp4": "m4a", "audio/x-m4a": "m4a",
        "audio/m4a": "m4a", "audio/ogg": "ogg", "audio/opus": "ogg", "audio/webm": "webm", "audio/flac": "flac", "audio/x-flac": "flac",
        "image/png": "png", "image/jpeg": "jpg", "image/jpg": "jpg", "image/gif": "gif", "image/webp": "webp", "image/bmp": "bmp", "image/tiff": "tiff"
      }
    },
    "estimate": {
      "chars_per_token": {"low": 4.0, "high": 3.0},
      "output_ratio": {
        "preserve": {"low": 0.8, "high": 1.5},
        "condense": {"low": 0.05, "high": 0.4},
        "expand": {"low": 1.0, "high": 3.0},
        "restyle": {"low": 0.8, "high": 1.5},
        "evaluate": {"low": 0.1, "high": 0.6},
        "combine": {"low": 0.5, "high": 1.5},
        "none": {"low": 0.1, "high": 1.0}
      },
      "unknown_ratio": {"low": 0.1, "high": 1.0},
      "output_floor_tokens": 32,
      "max_tokens_setting": "max_tokens",
      "pricing": {"input_key": "prompt", "output_key": "completion", "tokens_per_unit": 1, "currency": "USD"},
      "registry_refresh": {
        "setting": "model_registry_autorefresh",
        "active": "on_demand",
        "unknown": "on_demand",
        "retry_after_seconds": 300,
        "presets": {
          "on_demand": {"fetch": true, "label": {"en": "On demand: when an estimate needs a price and the model registry is empty, fetch the provider's public model list once", "pl": "Na żądanie: gdy szacunek potrzebuje ceny, a rejestr modeli jest pusty, pobierz raz publiczną listę modeli dostawcy"}},
          "off": {"fetch": false, "label": {"en": "Off: the registry is filled only by refreshing the model list yourself; an estimate without a price says so", "pl": "Wyłączone: rejestr wypełnia tylko Twoje odświeżenie listy modeli; szacunek bez ceny mówi o tym"}}
        }
      },
      "reasons": {
        "no_estimate": {"en": "no estimate", "pl": "brak szacunku"},
        "no_model_called": {"en": "no model is called", "pl": "żaden model nie jest wywoływany"},
        "condition_not_met": {"en": "its condition is not met by the arguments", "pl": "jego warunek nie jest spełniony przez argumenty"},
        "recognition_priced_by_provider": {"en": "recognition is priced by the provider by duration or by page, which the model registry does not list", "pl": "rozpoznawanie jest rozliczane przez dostawcę za czas nagrania lub za stronę, czego rejestr modeli nie podaje"},
        "media_output_not_per_token": {"en": "media output is not priced per token", "pl": "wynik medialny nie jest wyceniany za token"},
        "output_not_text": {"en": "the output is not text and its price is not listed per token", "pl": "wynik nie jest tekstem, a jego cena nie jest podana za token"},
        "no_model": {"en": "no model is named for this step", "pl": "dla tego kroku nie wskazano modelu"},
        "no_price": {"en": "the registry lists no price for the model", "pl": "rejestr nie podaje ceny tego modelu"},
        "registry_empty": {"en": "the model registry is empty, so no price is known (refresh the model list, or leave the setting model_registry_autorefresh on on_demand)", "pl": "rejestr modeli jest pusty, więc żadna cena nie jest znana (odśwież listę modeli albo zostaw ustawienie model_registry_autorefresh na on_demand)"},
        "registry_fetch_failed": {"en": "the model registry is empty and the provider's model list could not be fetched: {{why}}", "pl": "rejestr modeli jest pusty, a listy modeli dostawcy nie udało się pobrać: {{why}}"}
      }
    }
  },
  "value_schema": {
    "type": "object",
    "required": ["max_depth", "default_language", "use_model", "media", "estimate"],
    "properties": {
      "max_depth": {"type": ["integer", "null"], "description": "Deepest nesting of composite actions; null = unbounded (cycles are still refused)."},
      "default_language": {"type": "string", "minLength": 1, "description": "Language of the prompt templates ({\"$localized\": {en: ..., pl: ...}}) when neither the run's arguments (lang) nor its context (the language the asker wrote in) say one."},
      "estimate": {
        "type": "object",
        "description": "How a plan's token use and money are estimated before it runs (never a limit, never zero for what is unknown). chars_per_token: the band (low = fewer tokens, high = more). output_ratio: by the content_op of the action, the output as a share of the input; unknown_ratio for an action without one. output_floor_tokens: the smallest output assumed. max_tokens_setting: the config key of the completion limit that caps the output estimate (a step's own parameters.max_tokens wins). pricing: where the model registry keeps a price (the OpenRouter models list: USD per token, tokens_per_unit = 1); a model without a price makes the money unknown.",
        "required": ["chars_per_token", "output_ratio", "unknown_ratio", "output_floor_tokens", "max_tokens_setting", "pricing", "registry_refresh", "reasons"],
        "properties": {
          "chars_per_token": {"type": "object", "required": ["low", "high"], "properties": {"low": {"type": "number", "minimum": 0.01}, "high": {"type": "number", "minimum": 0.01}}, "additionalProperties": false},
          "output_ratio": {"type": "object", "additionalProperties": {"type": "object", "required": ["low", "high"], "properties": {"low": {"type": "number", "minimum": 0}, "high": {"type": "number", "minimum": 0}}, "additionalProperties": false}},
          "unknown_ratio": {"type": "object", "required": ["low", "high"], "properties": {"low": {"type": "number", "minimum": 0}, "high": {"type": "number", "minimum": 0}}, "additionalProperties": false},
          "output_floor_tokens": {"type": "integer", "minimum": 0},
          "max_tokens_setting": {"type": "string"},
          "pricing": {
            "type": "object",
            "required": ["input_key", "output_key", "tokens_per_unit", "currency"],
            "properties": {"input_key": {"type": "string", "minLength": 1}, "output_key": {"type": "string", "minLength": 1}, "tokens_per_unit": {"type": "number", "minimum": 1}, "currency": {"type": "string", "minLength": 1}},
            "additionalProperties": false
          },
          "registry_refresh": {
            "type": "object",
            "description": "The model registry (models.json) is empty on a fresh data directory until the model list is refreshed, so no price is known. When an estimate needs a price and the registry is empty, the provider's public model list is fetched (the existing refresh; no user data is sent). setting: the config key of the user's choice; active: the installation's preset; unknown: the preset a name that is not listed means; retry_after_seconds: after a failed fetch the next automatic attempt waits this long (null = every estimate tries again); presets: name -> {fetch, label}.",
            "required": ["setting", "active", "unknown", "retry_after_seconds", "presets"],
            "properties": {
              "setting": {"type": "string", "minLength": 1},
              "active": {"type": "string", "minLength": 1},
              "unknown": {"type": "string", "minLength": 1},
              "retry_after_seconds": {"type": ["number", "null"], "minimum": 0},
              "presets": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["fetch", "label"],
                  "properties": {"fetch": {"type": "boolean"}, "label": {"type": "object", "additionalProperties": {"type": "string"}}},
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "reasons": {
            "type": "object",
            "description": "Why money (or a price) is unknown, by code: the text in each language ({{why}} etc. are filled by the estimate). The estimate returns the code (money.reason_code) and the text in English; the chat shows the text in the language of the proposal.",
            "additionalProperties": {"type": "object", "required": ["en"], "additionalProperties": {"type": "string"}}
          }
        },
        "additionalProperties": false
      },
      "use_model": {
        "type": "object",
        "required": ["model_setting", "title", "timeout_ms"],
        "properties": {
          "model_setting": {"type": "string", "minLength": 1, "description": "Config key that holds the model used by a step that names none."},
          "title": {"type": "string", "description": "Attribution title sent with model calls of actions."},
          "timeout_ms": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      },
      "media": {
        "type": "object",
        "description": "A use_model step with `media: asr | ocr` is a recognition call: the recording or the picture goes to the media providers (profile media), which put it on the wire through the one use_model. Per kind: the part kind the step reads, the format used when the mime type is not listed (and not a subtype to use), and the unit the providers price by. `formats`: mime type -> the format name the providers know.",
        "required": ["formats"],
        "properties": {
          "formats": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": {
          "type": "object",
          "required": ["part", "default_format"],
          "properties": {"part": {"type": "string", "minLength": 1}, "default_format": {"type": "string", "minLength": 1}, "unit": {"type": "string"}},
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
