      {
        "key": "loom_event_log_types",
        "scope": "config",
        "group": "loom",
        "type": "array",
        "has_default": true,
        "description": "Event types persisted into the loom_events table.",
        "human": {
          "label": {
            "pl": "Zdarzenia zapisywane w dzienniku",
            "en": "Events written to the log"
          },
          "why": {
            "pl": "Które zdarzenia silnika (nowa rozmowa, import, zmiana grafu) trafiają do tabeli zdarzeń w bazie.",
            "en": "Which engine events (new conversation, import, graph change) go to the events table of the database."
          },
          "effect": {
            "pl": "Mniej typów = mniejsza baza i mniej historii dla narzędzi; dotyczy nowych zdarzeń.",
            "en": "Fewer types = a smaller database and less history for tools; applies to new events."
