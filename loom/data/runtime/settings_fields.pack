        }
      },
      {
        "key": "catalog_semantic_candidates",
        "scope": "config",
        "group": "catalog",
        "type": "object",
        "has_default": false,
        "description": "Options of semantic candidate generation in the catalog.",
        "human": {
          "label": {
            "pl": "Kandydaci semantyczni w katalogu",
            "en": "Semantic candidates in the catalogue"
          },
          "why": {
            "pl": "Jak skanowanie katalogu dobiera kandydatów do analizy modelem.",
            "en": "How a catalogue scan picks candidates for analysis by a model."
          },
          "effect": {
            "pl": "Dotyczy następnego skanowania.",
            "en": "Applies to the next scan."
          },
          "levels": [
