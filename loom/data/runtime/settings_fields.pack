{
  "schema": "loom.runtime_profile/1",
  "domain": "settings_fields",
  "revision": 1,
  "description": "Settings field traits (type, has_default, description) and the vocabulary of edit labels. The edit rules of the fields are general rules {scope, target, action, effect} in the one rule store, runtime/action_rules.pack (target kind settings_field, action edit); no matching rule = allow. Effects map to the API label edit (optional|required|read_only|requires_confirmation|open string). Default values are read from the real defaults, never copied here (completeness test checks both directions).",
  "defaults": {
    "element_class": "settings_field",
    "rule_action": "edit",
    "rule_scope": "installation",
    "effects": [
      {
        "id": "allow",
        "edit": "optional",
        "label_pl": "fakultatywna",
        "enforced": false,
        "meaning": "Default when no rule matches (a block needs an initiator): the field may be left empty or changed freely."
      },
      {
        "id": "require_value",
        "edit": "required",
        "label_pl": "obligatoryjna",
        "enforced": false,
        "meaning": "A feature does not work until the field is set; deleting it is not blocked."
      },
      {
        "id": "deny",
        "edit": "read_only",
        "label_pl": "tylko_odczyt",
        "enforced": true,
        "meaning": "Maintained by Loom; writes through config APIs are rejected."
      },
      {
        "id": "require_confirmation",
        "edit": "requires_confirmation",
        "label_pl": "wymaga_potwierdzenia",
        "enforced": false,
        "meaning": "A change that raises consumption needs the user's explicit confirmation; enforced by the owning action, not by the generic write."
      }
    ],
    "fields": [
      {
        "key": "base_url",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": true,
        "description": "Base URL of the OpenAI-compatible chat API (OpenRouter by default)."
      },
      {
        "key": "default_model",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": true,
        "description": "Model used for chat when a request names none."
      },
      {
        "key": "semantic_model",
        "scope": "config",
        "group": "semantic",
        "type": "string",
        "has_default": true,
        "description": "Model for background semantic analysis; empty string disables the LLM path (regex fallback)."
      },
      {
        "key": "temperature",
        "scope": "config",
        "group": "chat",
        "type": "number",
        "has_default": true,
        "description": "Sampling temperature for chat completions."
      },
      {
        "key": "max_tokens",
        "scope": "config",
        "group": "chat",
        "type": "integer",
        "has_default": true,
        "description": "Completion token limit sent with chat requests."
      },
      {
        "key": "theme",
        "scope": "config",
        "group": "ui",
        "type": "string",
        "has_default": true,
        "description": "UI theme preset name (dark, amoled)."
      },
      {
        "key": "start_view",
        "scope": "config",
        "group": "ui",
        "type": "array",
        "has_default": false,
        "description": "What the app opens to, as an ordered list tried first to last; the first that yields a view wins (the preset is [last_saved, last_conversation, new_conversation]): last_saved = the view you left (layout and conversation, kept on this device), last_conversation = the most recently updated conversation, new_conversation = an empty chat (always possible, so the app always opens to a chat). A single string is a list of one. Unknown names are skipped. Default: the preset (R56)."
      },
      {
        "key": "layout_mode",
        "scope": "config",
        "group": "ui",
        "type": "string",
        "has_default": false,
        "values": [{"value": "full_screen_chat", "preset": true}, {"value": "views_grid"}, {"value": "windows", "status": "planned", "reason": "Floating and dockable windows are the next thread after P20; until then the workbench (views_grid) opens."}],
        "description": "Layout of the application: full_screen_chat (preset: the full-screen standard chat app, profile \"Czat\"), views_grid (the workbench: application views grid, profile \"Warsztat\") or windows (floating and dockable windows; planned, not implemented yet: until it is, the workbench opens). The ⋮ menu switches between them for the session; the last choice is part of last_saved. Default: full_screen_chat (R56)."
      },
      {
        "key": "animation_styles",
        "scope": "config",
        "group": "ui",
        "section": "Interfejs i wyświetlanie",
        "subsection": "Animacje",
        "type": "object",
        "has_default": false,
        "description": "Your own animation styles, an overlay on the shipped ones (runtime/ui_animation.pack: none, fade, slide, grow, scale, grow+fade): {name: {kind: none|fade|slide|grow|scale|grow+fade, direction?: left|right|up|down, duration: {value, unit: ms|s|frames}, easing: a named easing or a cubic-bezier(...)}}. A style of the same name replaces the shipped one. Default: none (only the shipped styles)."
      },
      {
        "key": "animations",
        "scope": "config",
        "group": "ui",
        "section": "Interfejs i wyświetlanie",
        "subsection": "Animacje",
        "type": "object",
        "has_default": false,
        "description": "Which animation style each kind of UI element uses: {disclosure, drawer, menu, dialog, notice, message, proposal, view: a style name}. Only the elements you list change. Presets: disclosure grow+fade (150 ms), drawer slide, every other element fade. Chat phrases such as \"animacje wolniej\" or \"wyłącz animacje\" set it through settings.set. Default: the presets."
      },
      {
        "key": "animation_reduced_motion",
        "scope": "config",
        "group": "ui",
        "section": "Interfejs i wyświetlanie",
        "subsection": "Animacje",
        "type": "string",
        "has_default": false,
        "description": "The style used for every element when the system asks for reduced motion (prefers-reduced-motion). Preset: none. Name another style to keep some motion. Default: none."
      },
      {
        "key": "animation_refresh_hz",
        "scope": "config",
        "group": "ui",
        "section": "Interfejs i wyświetlanie",
        "subsection": "Animacje",
        "type": "number",
        "has_default": false,
        "description": "Display refresh rate in Hz, used to convert a duration given in frames into time (frames / Hz). Preset: 60. Default: 60."
      },
      {
        "key": "ui_language",
        "scope": "config",
        "group": "ui",
        "type": "string",
        "has_default": false,
        "description": "Language of the shell labels (chat screen, drawer, menus, first-run card): a language code present in the catalogs (pl, en), or empty / auto to follow the browser. Default: auto."
      },
      {
        "key": "system_prompt",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": true,
        "description": "System prompt placed first in every chat request."
      },
      {
        "key": "auto_title",
        "scope": "config",
        "group": "chat",
        "type": "boolean",
        "has_default": true,
        "description": "Generate a conversation title automatically after the first reply."
      },
      {
        "key": "stream",
        "scope": "config",
        "group": "chat",
        "type": "boolean",
        "has_default": true,
        "description": "Stream chat replies (SSE) instead of waiting for the full answer."
      },
      {
        "key": "semantic_analysis",
        "scope": "config",
        "group": "semantic",
        "type": "boolean",
        "has_default": true,
        "description": "Run semantic analysis of messages in the background."
      },
      {
        "key": "graph_memory_depth",
        "scope": "config",
        "group": "memory",
        "type": "integer",
        "has_default": true,
        "description": "Graph hops expanded when selecting graph memory for a prompt."
      },
      {
        "key": "graph_memory_max_nodes",
        "scope": "config",
        "group": "memory",
        "type": "integer",
        "has_default": true,
        "description": "Node budget of the graph memory section of a prompt."
      },
      {
        "key": "loom_event_log_types",
        "scope": "config",
        "group": "loom",
        "type": "array",
        "has_default": true,
        "description": "Event types persisted into the loom_events table."
      },
      {
        "key": "loom_task_workers",
        "scope": "config",
        "group": "loom",
        "type": "integer",
        "has_default": true,
        "description": "Worker threads of the task engine."
      },
      {
        "key": "loom_usage_policy",
        "scope": "config",
        "group": "usage",
        "type": "object",
        "has_default": true,
        "description": "Usage policy options (growth factor, baselines). Raising expected consumption by an order of magnitude needs the user's confirmation; the confirmation is enforced by the usage-policy actions, not by the config write. P17: baseline_min_samples (preset 5): until a cohort has this many measured samples its baseline is the larger of the measured mean and a floor, so one short first message does not make the next ordinary one look like a tenfold growth (0 turns the floor off; a cohort with no sample keeps the old behaviour). baseline_floor_tokens (preset {input: 4000, output: 1000}): the size of an ordinary request the floor is derived from - input_tokens and output_tokens as they are, input_bytes as input x baseline_floor_chars_per_token (preset 4.0, the low end of the band the cost estimates use), cost_usd and money_usd priced with the model's price when the caller knows it. baseline_floor: explicit floors per resource that replace the derived ones (null = none). These are presets of what normal usage is, not limits; they are edited like the growth factor, with the same confirmation."
      },
      {
        "key": "usage_spend_limits",
        "scope": "config",
        "group": "usage",
        "type": "array",
        "has_default": false,
        "description": "Your spending limits per period (the preset is none, so nothing is limited until you say so): a list of {period: day|week|month, amount, currency, on_exceed: confirm|deny|notify, rate?}. P18: every use of a model obeys them, not only action runs - a chat message, the routing model call, the background analysis, embeddings, media and an action's model call all go through the usage ledger, which adds the spend of the period (the cost the providers reported) and, when the caller knows the cost of the call, the estimate, and compares the sum with each limit. When one is passed, on_exceed decides: confirm holds the call with a receipt like the x10 hold (nothing is sent until you say yes), deny refuses it with the reason, notify lets it go and tells you. Importing a file or reading is never stopped by a limit. A plan shown in the conversation says beforehand that it would pass your limit. rate is USD per unit of the currency (an approximate preset is used when it is left out and the limit says so). Say it in the conversation: \"set a monthly limit of 20 PLN\", \"ustaw limit 20 zł na miesiąc\"; \"how much did I spend\" reads the limits back. It does not replace the x10 growth guard (loom_usage_policy). Runtime profile action_run (spend_limits). Default: none."
      },
      {
        "key": "loom_zip_max_total_bytes",
        "scope": "config",
        "group": "safety",
        "type": "integer",
        "has_default": true,
        "description": "Most bytes one imported ZIP archive may expand to; the import is refused before writing past it (zip bomb guard). 0 = no limit."
      },
      {
        "key": "loom_zip_max_ratio",
        "scope": "config",
        "group": "safety",
        "type": "number",
        "has_default": true,
        "description": "Largest uncompressed/compressed ratio of one ZIP entry; a larger one is refused while extracting. 0 = no limit."
      },
      {
        "key": "loom_git_allow_repo_config",
        "scope": "config",
        "group": "safety",
        "type": "boolean",
        "has_default": true,
        "description": "false (preset): git run on a repository from your data folder ignores its hooks, fsmonitor and other configured programs. true lets the repository's own configuration run."
      },
      {
        "key": "_config_version",
        "scope": "config",
        "group": "internal",
        "type": "integer",
        "has_default": false,
        "description": "Config format version maintained by the auto-upgrade; writes through the API are rejected."
      },
      {
        "key": "semantic_retry_mode",
        "scope": "config",
        "group": "semantic",
        "type": "string",
        "has_default": false,
        "description": "Retry policy of failed semantic work (explicit_requeue or automatic)."
      },
      {
        "key": "intent_routing_method",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "How a chat input is told to be a message or a command (R54): heuristic (local and free, preset), hybrid (the local reading first, the model asked only about what it is unsure of: a command the local reading is sure of is never turned into a message by the model; recommended once a provider key exists), model (one guarded model call per input) or off (every input is a message). Runtime profile intent_routing (heuristic.scoring.min_score and confident_score, method.presets.hybrid.ask_when)."
      },
      {
        "key": "intent_routing_run",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Whether a command from the chat waits for the user's yes (propose, preset), runs at once when its plan only reads and the rules ask for nothing (read_only), or runs at once (always). The rules and the x10 usage confirmation apply in every case."
      },
      {
        "key": "intent_routing_on_reject",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "What a no to a proposal from the chat does with the sentence the proposal came from: offer (preset: the reply offers, in the same proposal block and by the words \"send as message\", to send the sentence to the model as an ordinary message), send_as_message (it is sent at once) or drop (it is not sent). Whatever is sent has exactly the request bytes of an ordinary message. Runtime profile intent_routing."
      },
      {
        "key": "intent_routing_model",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Model used for routing when the method is model; empty = the default model."
      },
      {
        "key": "extrapolation_preset",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Preset of the chain proposals the engine makes when an element lacks what an action needs (off, standard or generous; presets are runtime/action_rules.pack). This is the user's level of a value that the scope chain resolves: a rule on a conversation or a project may set another one, and propose_chain / explain say which scope set the value. Default: the profile's active preset (standard)."
      },
      {
        "key": "extrapolation_bounds",
        "scope": "config",
        "group": "chat",
        "type": "object",
        "has_default": false,
        "description": "The user's own thresholds of chain proposals: an object with any of max_length, max_cost, min_confidence, max_results (null = no bound); each member overrides the preset at the user's level and is itself overridden by a more specific scope. Default: none (the preset's bounds)."
      },
      {
        "key": "action_result_target",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Where the result of an action run goes: graph (preset: a form node linked to its source element and to the run), run_only (the result stays in the run document) or conversation_message (the text is also posted as a message of the conversation and linked in the graph). Runtime profile action_results. This is the user's level of a value that the scope chain resolves: a rule on a conversation or a project may set another one. Text above the profile's inline_max_bytes goes to the blob store whatever the target is. Default: graph."
      },
      {
        "key": "emergent_actions",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Whether the catalogue of actions grows from your conversations (R55): propose (preset: a command no action understands, a sequence you keep repeating, or an action used on several classes is offered as a new action or group, never made silently) or off. Accepting writes only your own overlays (profiles/actions.pack, profiles/intent_routing.pack, profiles/graph_entry.pack). Runtime profile intent_routing (emergent). Default: propose."
      },
      {
        "key": "model_registry_autorefresh",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Whether an estimate may fetch the provider's public model list when it needs a price and the model registry (models.json) is empty, which it is on a fresh data directory until the list is refreshed: on_demand (preset: the list is fetched once, no user data is sent; if the fetch fails the price stays unknown with the reason, and the next automatic attempt waits the profile's retry_after_seconds) or off (the registry is filled only by refreshing the model list yourself; an estimate without a price says so). Runtime profile action_run (estimate.registry_refresh). A name that is not a preset means on_demand. Default: on_demand."
      },
      {
        "key": "image_model",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Model that paints images for the action depict (served by an openai_images provider, see image_provider). Empty = the action asks for one. Default: none."
      },
      {
        "key": "image_provider",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Id of the provider manifest (config provider_manifests, adapter openai_images) that serves image_model. Empty = the action asks for one. Default: none."
      },
      {
        "key": "speech_model",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Model that speaks for the action narrate (needs a provider whose adapter produces audio, see speech_provider). Empty = narrate returns the narration text only. Default: none."
      },
      {
        "key": "speech_provider",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Id of the provider manifest that serves speech_model. Default: none."
      },
      {
        "key": "context_execution",
        "scope": "config",
        "group": "context",
        "type": "object",
        "has_default": false,
        "description": "Execution options of context plans (stored by the context engine)."
      },
      {
        "key": "chat_reasoning",
        "scope": "config",
        "group": "chat",
        "type": "object",
        "has_default": false,
        "description": "Overrides of the reasoning request parameters per model family."
      },
      {
        "key": "analysis_prompt_overrides",
        "scope": "config",
        "group": "semantic",
        "type": "object",
        "has_default": false,
        "description": "Per-analysis prompt text overrides."
      },
      {
        "key": "analysis_prompt_dir",
        "scope": "config",
        "group": "semantic",
        "type": "string",
        "has_default": false,
        "description": "Directory with analysis prompt files overriding the built-in ones."
      },
      {
        "key": "loom_semantic_usage_policy_required",
        "scope": "config",
        "group": "usage",
        "type": "boolean",
        "has_default": false,
        "description": "Require a usage-policy admission before semantic LLM calls."
      },
      {
        "key": "github_repo",
        "scope": "config",
        "group": "sync",
        "type": "string",
        "has_default": false,
        "description": "owner/name of the repository used by GitHub sync."
      },
      {
        "key": "context_goal_cues",
        "scope": "config",
        "group": "context",
        "type": "object",
        "has_default": false,
        "description": "Overrides of the goal cue words used by context goal detection."
      },
      {
        "key": "catalog_semantic_candidates",
        "scope": "config",
        "group": "catalog",
        "type": "object",
        "has_default": false,
        "description": "Options of semantic candidate generation in the catalog."
      },
      {
        "key": "usage_baseline_key_templates",
        "scope": "config",
        "group": "usage",
        "type": "object",
        "has_default": false,
        "description": "Templates of the baseline keys used by the usage policy."
      },
      {
        "key": "usage_ledger_compaction",
        "scope": "config",
        "group": "usage",
        "type": "object",
        "has_default": false,
        "description": "Overrides of the usage ledger's compaction preset (runtime profile usage_compaction): mode off|manual|auto, older_than_days, statuses, fold_samples_beyond_window, reclaim_space, auto_interval_hours. Housekeeping of old completed operations, never a spending limit; pending, confirmed and denied operations are not folded."
      },
      {
        "key": "cleanup",
        "scope": "config",
        "group": "storage",
        "type": "object",
        "has_default": false,
        "description": "Housekeeping when the runtime starts (loom/cleanup.h); every value is a preset, none limits use. upload_part_max_age_hours (preset 24, 0 = keep forever): abandoned <data>/tmp/uploads/up_*.part files older than this are removed. orphan_blob_max_age_days (preset 0 = off): blobs older than this that no node, link, run, source, artifact or other database row and no top-level JSON file names by hash become candidates. orphan_blob_dry_run (preset true): candidates are only logged and reported; false deletes them. A blob that is named anywhere is never removed."
      },
      {
        "key": "api_key",
        "scope": "secret",
        "group": "credentials",
        "type": "string",
        "has_default": false,
        "description": "Chat API key (OpenRouter); chat cannot run without it. Value is never returned.",
        "sensitive": true
      },
      {
        "key": "anthropic_batch_key",
        "scope": "secret",
        "group": "credentials",
        "type": "string",
        "has_default": false,
        "description": "Anthropic Message Batches key for cheaper batch semantic analysis.",
        "sensitive": true
      },
      {
        "key": "github_token",
        "scope": "secret",
        "group": "credentials",
        "type": "string",
        "has_default": false,
        "description": "GitHub token for sync.",
        "sensitive": true
      },
      {
        "key": "groq_api_key",
        "scope": "secret",
        "group": "credentials",
        "type": "string",
        "has_default": false,
        "description": "Groq key for speech recognition.",
        "sensitive": true
      },
      {
        "key": "google_speech_api_key",
        "scope": "secret",
        "group": "credentials",
        "type": "string",
        "has_default": false,
        "description": "Google Speech key for speech recognition.",
        "sensitive": true
      },
      {
        "key": "ocr_space_api_key",
        "scope": "secret",
        "group": "credentials",
        "type": "string",
        "has_default": false,
        "description": "OCR.space key for screenshot OCR.",
        "sensitive": true
      }
    ]
  },
  "value_schema": {
    "type": "object",
    "required": [
      "element_class",
      "rule_action",
      "rule_scope",
      "effects",
      "fields"
    ],
    "additionalProperties": false,
    "properties": {
      "element_class": {
        "type": "string",
        "minLength": 1,
        "description": "Class of a settings field as an element of the graph (graph/classes.pack); the edit rules target it."
      },
      "rule_action": {
        "type": "string",
        "minLength": 1,
        "description": "The action the edit rules govern."
      },
      "rule_scope": {
        "type": "string",
        "minLength": 1,
        "description": "The level of the scopes chain the field metadata is read at (the API describes the installation)."
      },
      "effects": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "fields": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  }
}
