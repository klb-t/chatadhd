        "has_default": false,
        "description": "Require a usage-policy admission before semantic LLM calls.",
        "human": {
          "label": {
            "pl": "Dopuszczenie kosztów przed analizą",
            "en": "Cost admission before analysis"
          },
          "why": {
            "pl": "Czy każde wywołanie modelu analizy w tle musi najpierw przejść przez politykę zużycia.",
            "en": "Whether every background analysis model call must first pass the usage policy."
          },
          "effect": {
