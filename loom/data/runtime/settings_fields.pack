      {
        "key": "usage_baseline_key_templates",
        "scope": "config",
        "group": "usage",
        "type": "object",
        "has_default": false,
        "description": "Templates of the baseline keys used by the usage policy.",
        "human": {
          "label": {
            "pl": "Szablony kluczy odniesienia zużycia",
            "en": "Usage baseline key templates"
          },
          "why": {
            "pl": "Jak nazywane są punkty odniesienia, z którymi strażnik ×10 porównuje nowe zużycie.",
            "en": "How the baselines the ×10 guard compares new consumption with are named."
          },
          "effect": {
            "pl": "Inne szablony = inne grupowanie historii zużycia; stare punkty nie są przepisywane.",
            "en": "Other templates = another grouping of the usage history; old baselines are not rewritten."
          },
          "levels": [
