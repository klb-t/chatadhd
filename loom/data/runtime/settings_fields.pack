        "has_default": false,
        "description": "Which animation style each kind of UI element uses: {disclosure, drawer, menu, dialog, notice, message, proposal, view: a style name}. Only the elements you list change. Presets: disclosure grow+fade (150 ms), drawer slide, every other element fade. Chat phrases such as \"animacje wolniej\" or \"wyłącz animacje\" set it through settings.set. Default: the presets.",
        "human": {
          "label": {
            "pl": "Animacje elementów",
            "en": "Element animations"
          },
          "why": {
            "pl": "Jak porusza się każdy rodzaj elementu (szuflada, menu, okno dialogowe, wiadomość…); zmieniasz tylko te, które wymienisz.",
            "en": "How each kind of element moves (drawer, menu, dialog, message…); you change only the ones you list."
          },
          "effect": {
            "pl": "Działa od razu; element bez wpisu zachowuje styl wbudowany.",
            "en": "Applies at once; an element without an entry keeps the builtin style."
          },
          "levels": [
            "person"
          ],
          "group": "interfejs",
          "subgroup": "animacje",
          "flows": []
        }
      },
