          ],
          "group": "koszty",
          "subgroup": "ksiega",
          "flows": [
            "usage.spend"
          ]
        }
      },
      {
        "key": "usage_ledger_compaction",
        "scope": "config",
        "group": "usage",
        "type": "object",
        "has_default": false,
        "description": "Overrides of the usage ledger's compaction preset (runtime profile usage_compaction): mode off|manual|auto, older_than_days, statuses, fold_samples_beyond_window, reclaim_space, auto_interval_hours. Housekeeping of old completed operations, never a spending limit; pending, confirmed and denied operations are not folded.",
        "human": {
          "label": {
            "pl": "Porządkowanie księgi zużycia",
            "en": "Usage ledger compaction"
          },
          "why": {
            "pl": "Czy i kiedy stare wpisy zużycia są zwijane: wyłączone, ręcznie albo samo, po ilu dniach.",
            "en": "Whether and when old usage entries are folded: off, by hand, or by itself after so many days."
          },
          "effect": {
            "pl": "Zwinięte wpisy zostają sumami; szczegóły z okna są zachowane.",
            "en": "Folded entries remain as sums; the details within the window are kept."
          },
          "levels": [
            "person"
          ],
          "group": "koszty",
          "subgroup": "ksiega",
          "flows": [
            "usage.compact"
          ]
        }
      },
      {
        "key": "cleanup",
        "scope": "config",
        "group": "storage",
        "type": "object",
        "has_default": false,
        "description": "Housekeeping when the runtime starts (loom/cleanup.h); every value is a preset, none limits use. upload_part_max_age_hours (preset 24, 0 = keep forever): abandoned <data>/tmp/uploads/up_*.part files older than this are removed. orphan_blob_max_age_days (preset 0 = off): blobs older than this that no node, link, run, source, artifact or other database row and no top-level JSON file names by hash become candidates. orphan_blob_dry_run (preset true): candidates are only logged and reported; false deletes them. A blob that is named anywhere is never removed.",
        "human": {
          "label": {
            "pl": "Porządki przy starcie",
            "en": "Housekeeping at start"
          },
          "why": {
            "pl": "Co silnik sprząta przy uruchomieniu: porzucone części przesyłek, osierocone pliki (preset: tylko raport, nic nie kasuje).",
            "en": "What the engine tidies at launch: abandoned upload parts, orphaned files (preset: report only, nothing is deleted)."
          },
          "effect": {
            "pl": "Plik, do którego cokolwiek się odwołuje, nigdy nie jest usuwany.",
            "en": "A file that anything refers to is never removed."
          },
          "levels": [
            "person"
          ],
          "group": "prywatnosc",
          "subgroup": "porzadki",
          "flows": []
        }
      },
      {
        "key": "api_key",
        "scope": "secret",
        "group": "credentials",
        "type": "string",
        "has_default": false,
        "description": "Chat API key (OpenRouter); chat cannot run without it. Value is never returned.",
        "sensitive": true,
        "human": {
          "label": {
            "pl": "Klucz do usługi modeli",
            "en": "Model service key"
          },
          "why": {
            "pl": "Klucz OpenRouter (lub Twojego dostawcy), bez którego czat nie działa; nigdy nie jest pokazywany ani wysyłany do modelu.",
            "en": "The OpenRouter (or your provider's) key without which chat cannot run; never shown and never sent to a model."
          },
          "effect": {
            "pl": "Bez klucza każde wywołanie modelu kończy się czytelnym błędem; z kluczem rusza od razu.",
            "en": "Without the key every model call ends with a plain error; with it, calls run at once."
          },
          "levels": [
            "person"
          ],
          "group": "modele",
          "subgroup": "dostawca",
          "flows": [
            "chat.send",
            "semantic.analyse",
            "agent.run",
            "use_model",
            "embedding.embed"
          ]
        }
      },
      {
        "key": "anthropic_batch_key",
        "scope": "secret",
        "group": "credentials",
        "type": "string",
        "has_default": false,
        "description": "Anthropic Message Batches key for cheaper batch semantic analysis.",
        "sensitive": true,
        "human": {
          "label": {
            "pl": "Klucz do analizy zbiorczej Anthropic",
            "en": "Anthropic batch analysis key"
          },
          "why": {
            "pl": "Pozwala analizie w tle iść tańszym o połowę trybem zbiorczym, gdy czeka dużo wiadomości; bez klucza analiza idzie pojedynczo.",
            "en": "Lets the background analysis use the half-price batch mode when many messages wait; without it the analysis runs one by one."
          },
          "effect": {
            "pl": "Z kluczem powyżej progu trybu zbiorczego wiadomości idą partiami (wolniej, taniej).",
            "en": "With the key, above the batch threshold messages go in batches (slower, cheaper)."
          },
          "levels": [
            "person"
          ],
          "group": "modele",
          "subgroup": "klucze",
          "role": "analysis.fast",
          "flows": [
            "semantic.batch"
          ],
          "technical_only": true
        }
      },
