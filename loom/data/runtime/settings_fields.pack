  },
  "value_schema": {
    "type": "object",
    "required": [
      "element_class",
      "rule_action",
      "rule_scope",
      "effects",
      "groups",
      "level_evidence",
      "fields",
      "profile_values"
    ],
    "additionalProperties": false,
    "properties": {
      "element_class": {
        "type": "string",
        "minLength": 1,
        "description": "Class of a settings field as an element of the graph (graph/classes.pack); the edit rules target it."
      },
      "rule_action": {
        "type": "string",
        "minLength": 1,
        "description": "The action the edit rules govern."
      },
      "rule_scope": {
        "type": "string",
        "minLength": 1,
        "description": "The level of the scopes chain the field metadata is read at (the API describes the installation)."
      },
      "effects": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "level_evidence": {
        "type": "object",
        "additionalProperties": false,
        "description": "Evidence for human.levels: `chain` = keys whose reader resolves the value through the scope chain (scopes::Binding / resolve_value), the only keys that may declare project or conversation; `turn` = keys with a per-request wire option (ChatOptions::from_json), the only keys that may declare turn; `installation` = keys and profile values (<profile><pointer>) whose installation layer has a writer: the runtime-profile preset (profiles/<domain>.pack, the only writer of a profile value) or a user rule at the installation scope (chain keys). `person` is config.json / secrets.json (settings.set), never a profile value. A field declaring a level without evidence is a problem (settings_fields_problems). M1-D1 replaces these lists with `reads`/`implemented_in` per field.",
        "properties": {
          "chain": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "turn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "installation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "fields": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "key",
            "scope",
            "group",
            "type",
            "has_default",
            "description"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "enum": [
                "config",
                "secret"
              ]
            },
            "group": {
              "type": "string",
              "minLength": 1,
              "description": "Technical group of the key (historical; the human group is human.group)."
            },
            "type": {
              "type": "string",
              "enum": [
                "string",
                "integer",
                "number",
                "boolean",
                "array",
                "object"
              ]
            },
            "has_default": {
              "type": "boolean"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "human": {
              "type": "object",
              "description": "The field as a person reads it on a phone. label: plain name; why: what it is for; effect: what changes when it changes; levels: the levels of the scopes chain (graph/scopes.pack) where a reader honours the value (a preset; the full chain is always available under 'more levels'; project/conversation only with `level_evidence.chain`, turn only with `level_evidence.turn`); group/subgroup: ids from `groups`; role: the model role of ports.pack the field is the value of; flows: ids of the actions (runtime/actions.pack) that read the key, empty when the reader is the shell or the runtime itself; technical_only: shown only under its technical name (the role card, the all-fields table), never in the human group list - the field is never dropped.",
              "required": [
                "label",
                "why",
                "effect",
                "levels",
                "group"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "object",
                  "required": [
                    "pl",
                    "en"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "pl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "why": {
                  "type": "object",
                  "required": [
                    "pl",
                    "en"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "pl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "effect": {
                  "type": "object",
                  "required": [
                    "pl",
                    "en"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "pl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "levels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "group": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Id of a group of `groups` (checked at runtime against the live groups, so an overlay may add a group of its own)."
                },
                "subgroup": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "role_status": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Status of `role` when ports.pack does not know the role yet (e.g. planned): the chip stays honest; a role neither known nor given a status is a problem."
                },
                "flows": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "technical_only": {
                  "type": "boolean"
                }
              }
            },
            "values": {
              "type": "array",
              "description": "The values the field's reader understands, as the phone list editor shows them. Each entry: value; meaning {pl,en}; preset (the default value of a field without a kernel default); status (e.g. planned: the reader does not handle it yet) with reason {pl,en}; on_set: what a write of a value with a status does on every write path (settings.set, PATCH /api/config, loom_set_config, `loom config set`) - refuse (its reader rejects it: the write is refused with the reason) or warn (its reader degrades: stored, the write reports the status and reason); absent = warn.",
              "items": {
                "type": "object",
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "integer",
                      "boolean",
                      "null",
                      "object",
                      "array"
                    ]
                  },
                  "meaning": {
                    "type": "object",
                    "required": [
                      "pl",
                      "en"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "preset": {
                    "type": "boolean"
                  },
                  "status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": [
                      "object",
                      "string"
                    ],
                    "required": [
                      "pl",
                      "en"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "minLength": 1
                  },
                  "on_set": {
                    "type": "string",
                    "enum": [
                      "refuse",
                      "warn"
                    ]
                  }
                }
              }
            },
            "values_from": {
              "type": "object",
              "required": [
                "profile",
                "pointer"
              ],
              "additionalProperties": false,
              "description": "The values are the reader's data, not a copy: settings_fields() reads the runtime profile `profile` (with the user's profile overlay, as the reader does) at `pointer` - the object's keys when keys:true, else the array's items. The field's own `values` entries stay as annotations (meaning, preset, status) and come first; every value of the profile is marked from_profile, one without an annotation is appended, and an annotation `planned` whose value the profile now has becomes status_superseded (its reader knows it). A profile that cannot be read leaves the annotations and values_from_problem.",
              "properties": {
                "profile": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer": {
                  "type": "string"
                },
                "keys": {
                  "type": "boolean"
                }
              }
            },
            "values_open": {
              "type": "boolean",
              "description": "The `values` list is examples, not the whole set: every write path accepts other values without a warning. Without it the list is closed and `on_unlisted` says what a write of another value does."
            },
            "status": {
              "type": "object",
              "required": [
                "state",
                "reason"
              ],
              "additionalProperties": false,
              "description": "Field-level status when the key has a preset but no reader yet (M1 §3.5 \"nothing pretends to be ready\"): state (planned), by (the position that adds the reader), reason {pl,en} shown as the chip \"planned (reason)\". Removed by the position that implements the reader.",
              "properties": {
                "state": {
                  "type": "string",
                  "minLength": 1
                },
                "by": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "object",
                  "required": [
                    "pl",
                    "en"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "pl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "sensitive": {
              "type": "boolean"
            },
            "section": {
              "type": "string"
            },
            "subsection": {
              "type": "string"
            },
            "on_unlisted": {
              "type": "string",
              "enum": [
                "refuse",
                "warn"
              ],
              "description": "What a write of a value outside a closed `values` list does on every write path (settings.set, PATCH /api/config, loom_set_config, `loom config set`): refuse (the reader rejects unknown values, or the list is the field's contract) or warn (the reader falls back: stored, the write names the list). Absent = warn. Clearing the key (null) is always accepted. Ignored with values_open."
            }
          }
        }
      },
      "groups": {
        "type": "object",
        "description": "Human groups of the settings, id -> group. An overlay (profiles/settings_fields.pack, view kind settings_groups) may regroup, rename or hide; nothing about grouping is in code.",
        "additionalProperties": {
          "type": "object",
          "required": [
            "label",
            "why",
            "order",
            "subgroups"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "object",
              "required": [
                "pl",
                "en"
              ],
              "additionalProperties": false,
              "properties": {
                "pl": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "why": {
              "type": "object",
              "required": [
                "pl",
                "en"
              ],
              "additionalProperties": false,
              "properties": {
                "pl": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "order": {
              "type": "integer",
              "minimum": 0
            },
            "hidden": {
              "type": "boolean"
            },
            "subgroups": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "object",
                    "required": [
                      "pl",
                      "en"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "why": {
                    "type": "object",
                    "required": [
                      "pl",
                      "en"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "hidden": {
                    "type": "boolean"
                  }
                }
              }
            },
            "empty_reason": {
              "type": "object",
              "required": [
                "pl",
                "en"
              ],
              "additionalProperties": false,
              "properties": {
                "pl": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Why the group holds no field (an overlay may hide fields or a later milestone adds them); a group that holds nothing without this is a problem (settings_fields_problems)."
            }
          }
        }
      },
      "profile_values": {
        "type": "array",
        "description": "Values of runtime profiles shown as settings fields with the chip 'runtime profile: <profile>'; the value lives in the profile (overlay profiles/<profile>.pack), never copied into config.",
        "items": {
          "type": "object",
          "required": [
            "profile",
            "pointer"
          ],
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "minLength": 1,
              "description": "RFC 6901 pointer into the profile's values."
            },
            "human": {
              "type": "object",
              "description": "The field as a person reads it on a phone. label: plain name; why: what it is for; effect: what changes when it changes; levels: the levels of the scopes chain (graph/scopes.pack) where a reader honours the value (a preset; the full chain is always available under 'more levels'; project/conversation only with `level_evidence.chain`, turn only with `level_evidence.turn`); group/subgroup: ids from `groups`; role: the model role of ports.pack the field is the value of; flows: ids of the actions (runtime/actions.pack) that read the key, empty when the reader is the shell or the runtime itself; technical_only: shown only under its technical name (the role card, the all-fields table), never in the human group list - the field is never dropped.",
              "required": [
                "label",
                "why",
                "effect",
                "levels",
                "group"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "object",
                  "required": [
                    "pl",
                    "en"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "pl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "why": {
                  "type": "object",
                  "required": [
                    "pl",
                    "en"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "pl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "effect": {
                  "type": "object",
                  "required": [
                    "pl",
                    "en"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "pl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "levels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "group": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Id of a group of `groups` (checked at runtime against the live groups, so an overlay may add a group of its own)."
                },
                "subgroup": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "role_status": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Status of `role` when ports.pack does not know the role yet (e.g. planned): the chip stays honest; a role neither known nor given a status is a problem."
                },
                "flows": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "technical_only": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "placement": {
        "type": "object",
        "description": "Group membership a user overlay patches per key (profiles/settings_fields.pack overrides.placement): field key, or <profile><pointer> of a profile value -> {group, subgroup?}. It moves the entry on top of human.group/subgroup (the preset stays visible as human.placed_from) without copying the fields array. Empty in the shipped pack: the preset membership is human.group. An entry without a group, or naming no field, is an issue (groups_issues), never dropped silently.",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "group": {
              "type": "string"
            },
            "subgroup": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
