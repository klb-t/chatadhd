          ],
          "group": "rozmowa",
          "flows": [
            "chat.send",
            "conversation.rename"
          ]
        }
      },
      {
        "key": "stream",
        "scope": "config",
        "group": "chat",
        "type": "boolean",
        "has_default": true,
        "description": "Stream chat replies (SSE) instead of waiting for the full answer.",
        "human": {
          "label": {
            "pl": "Odpowiedź na żywo",
            "en": "Live reply"
          },
          "why": {
            "pl": "Czy odpowiedź pojawia się słowo po słowie, czy dopiero cała na raz.",
            "en": "Whether a reply appears word by word or only whole at the end."
          },
          "effect": {
            "pl": "Działa od następnej wiadomości; nie zmienia treści odpowiedzi ani kosztu.",
            "en": "Applies from the next message; changes neither the reply's content nor its cost."
          },
          "levels": [
            "person",
            "turn"
          ],
          "group": "rozmowa",
          "flows": [
            "chat.send",
            "agent.run",
            "graph_native.reply"
          ]
        }
      },
      {
        "key": "semantic_analysis",
        "scope": "config",
        "group": "semantic",
        "type": "boolean",
        "has_default": true,
        "description": "Run semantic analysis of messages in the background.",
        "human": {
          "label": {
            "pl": "Analiza wiadomości w tle",
            "en": "Background analysis of messages"
          },
          "why": {
            "pl": "Czy aplikacja czyta wiadomości w tle i buduje z nich graf wiedzy (tematy, encje, powiązania), z którego potem wybiera kontekst.",
            "en": "Whether the app reads messages in the background and builds the knowledge graph (topics, entities, relations) it later picks context from."
          },
          "effect": {
            "pl": "Wyłączone: nowe wiadomości nie trafiają do grafu, dopóki nie włączysz; dotychczasowe wyniki zostają.",
            "en": "Off: new messages do not enter the graph until you switch it on; earlier results stay."
          },
          "levels": [
            "person"
          ],
          "group": "kontekst",
          "subgroup": "analiza",
          "flows": [
            "semantic.analyse",
            "semantic.batch"
          ]
        }
      },
      {
        "key": "graph_memory_depth",
        "scope": "config",
        "group": "memory",
        "type": "integer",
        "has_default": true,
        "description": "Graph hops expanded when selecting graph memory for a prompt.",
        "human": {
          "label": {
            "pl": "Głębokość pamięci z grafu",
            "en": "Graph memory depth"
          },
          "why": {
            "pl": "Ile kroków po powiązaniach od tematów Twojej wiadomości aplikacja idzie, szukając kontekstu z dawnych rozmów.",
            "en": "How many hops along relations from your message's topics the app walks when looking for context from past conversations."
          },
          "effect": {
            "pl": "Głębiej = więcej dalszych skojarzeń w żądaniu (i więcej tokenów); 0 = ani jednego kroku po powiązaniach, więc z dawnych rozmów zwykle nic nie dochodzi.",
            "en": "Deeper = more distant associations in the request (and more tokens); 0 = not a single hop along relations, so usually nothing comes from past conversations."
          },
          "levels": [
            "person",
            "turn"
          ],
          "group": "kontekst",
          "subgroup": "wybor",
          "flows": [
            "chat.send"
          ]
        }
      },
      {
        "key": "graph_memory_max_nodes",
        "scope": "config",
        "group": "memory",
        "type": "integer",
        "has_default": true,
        "description": "Node budget of the graph memory section of a prompt.",
        "human": {
          "label": {
            "pl": "Budżet węzłów pamięci z grafu",
            "en": "Graph memory node budget"
          },
          "why": {
            "pl": "Ile najwyżej wiadomości z dawnych rozmów, znalezionych przez graf, dokłada się do jednego żądania.",
            "en": "At most how many messages from past conversations, found through the graph, are added to one request."
          },
          "effect": {
            "pl": "Więcej = pełniejszy kontekst, dłuższe i droższe żądanie; 0 = bez limitu: każda znaleziona wiadomość trafia do żądania (najdłuższe i najdroższe).",
            "en": "More = fuller context, a longer and dearer request; 0 = no limit: every message found goes into the request (the longest and dearest)."
          },
          "levels": [
            "person"
          ],
          "group": "kontekst",
          "subgroup": "wybor",
          "flows": [
            "chat.send"
          ]
        }
      },
      {
        "key": "memory_folder_file_chars",
