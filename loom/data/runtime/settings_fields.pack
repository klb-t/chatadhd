      {
        "key": "auto_title",
        "scope": "config",
        "group": "chat",
        "type": "boolean",
        "has_default": true,
        "description": "Generate a conversation title automatically after the first reply.",
        "human": {
          "label": {
            "pl": "Tytuł rozmowy automatycznie",
            "en": "Automatic conversation title"
          },
          "why": {
            "pl": "Po pierwszej odpowiedzi aplikacja sama nadaje rozmowie tytuł (jedno krótkie wywołanie modelu).",
            "en": "After the first reply the app names the conversation itself (one short model call)."
          },
          "effect": {
            "pl": "Wyłączone: nowe rozmowy zostają bez tytułu, dopóki ich nie nazwiesz.",
            "en": "Off: new conversations stay untitled until you name them."
          },
          "levels": [
