        }
      },
      {
        "key": "context_goal_cues",
        "scope": "config",
        "group": "context",
        "type": "object",
        "has_default": false,
        "description": "Overrides of the goal cue words used by context goal detection.",
        "human": {
          "label": {
            "pl": "Słowa-wskazówki celu",
            "en": "Goal cue words"
          },
          "why": {
            "pl": "Twoje słowa, po których aplikacja poznaje cel wiadomości (np. „napraw”, „wyjaśnij”) i dobiera do niego kontekst.",
            "en": "Your words by which the app recognises a message's goal (e.g. “fix”, “explain”) and picks context for it."
          },
          "effect": {
            "pl": "Działa od następnego żądania; słowa wbudowane zostają.",
            "en": "Applies from the next request; the builtin words stay."
          },
          "levels": [
