          "levels": [
            "person"
          ],
          "group": "silnik",
          "subgroup": "indeks",
          "flows": []
        }
      },
      {
        "key": "loom_fts_chunk_rows",
        "scope": "config",
        "group": "loom",
        "type": "integer",
        "has_default": true,
        "description": "Rows indexed per transaction while the full-text index is built or rebuilt; the database lock is released between chunks so other users are not blocked. Preset 10000. 0 = one transaction (the old behaviour).",
        "human": {
          "label": {
            "pl": "Wiersze na porcję indeksu wyszukiwania",
            "en": "Rows per search index chunk"
          },
          "why": {
            "pl": "Po ile wierszy na raz buduje się indeks pełnotekstowy; między porcjami baza jest wolna dla innych.",
            "en": "How many rows at a time the full-text index is built in; between chunks the database is free for others."
          },
          "effect": {
            "pl": "Większa porcja = szybsza budowa i dłuższe blokady; 0 = jedna transakcja.",
            "en": "A larger chunk = a faster build and longer locks; 0 = one transaction."
          },
          "levels": [
            "person"
          ],
          "group": "silnik",
          "subgroup": "indeks",
          "flows": [
            "search.find"
          ]
        }
      },
      {
        "key": "loom_fts_background_build",
        "scope": "config",
        "group": "loom",
        "type": "boolean",
        "has_default": true,
        "description": "Build and sync the full-text index on a background thread at startup so the first search does not pay for the build. Preset true. A search issued before the build ends finishes it itself and then answers from the complete index.",
        "human": {
          "label": {
            "pl": "Indeks wyszukiwania w tle",
            "en": "Search index in the background"
          },
          "why": {
            "pl": "Czy indeks pełnotekstowy buduje się przy starcie w tle, żeby pierwsze szukanie nie czekało.",
            "en": "Whether the full-text index is built in the background at start so the first search does not wait."
          },
          "effect": {
            "pl": "Wyłączone: pierwsze szukanie po starcie buduje indeks samo i trwa dłużej.",
            "en": "Off: the first search after start builds the index itself and takes longer."
          },
          "levels": [
            "person"
          ],
          "group": "silnik",
          "subgroup": "indeks",
          "flows": [
            "search.find"
          ]
        }
      },
      {
        "key": "loom_graph_data_limit",
        "scope": "config",
        "group": "loom",
        "type": "integer",
        "has_default": true,
        "description": "Message nodes per page of GET /api/graph/data?conv_id= when the request gives no limit param. Preset 5000 = the newest 5000 messages per page; the response then carries truncated, next_before and total_messages, and older pages are fetched with before=next_before (nothing is cut for good). 0 = no limit (the whole conversation in one answer). A request's own limit param always wins.",
        "human": {
          "label": {
            "pl": "Węzły na stronę danych grafu",
            "en": "Graph data nodes per page"
          },
          "why": {
            "pl": "Ile najnowszych wiadomości na stronę dostaje widok grafu z API, gdy nie poda własnego limitu; starsze dociąga dalej.",
            "en": "How many newest messages per page the graph view gets from the API when it names no limit; older ones are fetched further on."
          },
          "effect": {
            "pl": "Więcej = cięższe strony; 0 = bez cięcia. Nic nie jest tracone.",
            "en": "More = heavier pages; 0 = no cut. Nothing is lost."
          },
          "levels": [
            "person"
          ],
          "group": "silnik",
          "subgroup": "indeks",
          "flows": [
            "graph.overview"
          ]
        }
      },
      {
        "key": "loom_web_graph_page",
        "scope": "config",
        "group": "loom",
        "type": "integer",
        "has_default": true,
        "description": "Message nodes the web graph view asks for per page of a conversation graph. Preset 2000 = the newest 2000 first, older ones on request (nothing is cut for good). 0 = no cut (the whole conversation in one answer).",
        "human": {
          "label": {
            "pl": "Węzły na stronę widoku grafu",
            "en": "Graph view nodes per page"
          },
          "why": {
            "pl": "Ile najnowszych wiadomości widok grafu pobiera na raz; starsze na żądanie.",
            "en": "How many newest messages the graph view fetches at once; older ones on request."
          },
          "effect": {
            "pl": "Więcej = wolniejszy pierwszy rysunek; 0 = wszystko od razu. Nic nie jest tracone.",
            "en": "More = a slower first drawing; 0 = everything at once. Nothing is lost."
          },
          "levels": [
            "person"
          ],
          "group": "interfejs",
          "subgroup": "strony",
          "flows": []
        }
      },
      {
        "key": "loom_web_message_window",
        "scope": "config",
        "group": "loom",
        "type": "integer",
        "has_default": true,
        "description": "Messages the web chat view loads per page. Preset 500 = the newest 500 first, older ones page by page on scroll up or with the button (nothing is cut for good). 0 = no cut (the whole conversation).",
        "human": {
          "label": {
            "pl": "Wiadomości na stronę czatu",
            "en": "Chat messages per page"
          },
          "why": {
            "pl": "Ile najnowszych wiadomości ładuje czat na raz; starsze dociąga przy przewijaniu w górę.",
            "en": "How many newest messages the chat loads at once; older ones are fetched when you scroll up."
          },
          "effect": {
            "pl": "Więcej = dłuższe pierwsze ładowanie długich rozmów; 0 = cała rozmowa od razu. Nic nie jest tracone.",
            "en": "More = a longer first load of long conversations; 0 = the whole conversation at once. Nothing is lost."
          },
          "levels": [
            "person"
          ],
          "group": "interfejs",
          "subgroup": "strony",
          "flows": []
        }
      },
      {
        "key": "loom_task_workers",
        "scope": "config",
        "group": "loom",
        "type": "integer",
        "has_default": true,
        "description": "Worker threads of the task engine.",
        "human": {
          "label": {
            "pl": "Wątki zadań w tle",
            "en": "Background task threads"
          },
          "why": {
            "pl": "Ile zadań w tle (import, analiza, indeks) może iść równolegle.",
            "en": "How many background jobs (import, analysis, index) may run in parallel."
          },
          "effect": {
            "pl": "Działa po ponownym uruchomieniu; więcej = szybciej, ale większe obciążenie urządzenia.",
            "en": "Applies after a restart; more = faster, but a heavier load on the device."
          },
          "levels": [
            "person"
          ],
          "group": "silnik",
          "subgroup": "zadania",
          "flows": [
            "tasks.list"
          ]
        }
      },
      {
        "key": "loom_usage_policy",
        "scope": "config",
        "group": "usage",
        "type": "object",
        "has_default": true,
        "description": "Usage policy options (growth factor, baselines). Raising expected consumption by an order of magnitude needs the user's confirmation; the confirmation is enforced by the usage-policy actions, not by the config write. P17: baseline_min_samples (preset 5): until a cohort has this many measured samples its baseline is the larger of the measured mean and a floor, so one short first message does not make the next ordinary one look like a tenfold growth (0 turns the floor off; a cohort with no sample keeps the old behaviour). baseline_floor_tokens (preset {input: 4000, output: 1000}): the size of an ordinary request the floor is derived from - input_tokens and output_tokens as they are, input_bytes as input x baseline_floor_chars_per_token (preset 4.0, the low end of the band the cost estimates use), cost_usd and money_usd priced with the model's price when the caller knows it. baseline_floor: explicit floors per resource that replace the derived ones (null = none). These are presets of what normal usage is, not limits; they are edited like the growth factor, with the same confirmation.",
        "human": {
          "label": {
            "pl": "Strażnik wzrostu zużycia (×10)",
            "en": "Consumption growth guard (×10)"
          },
          "why": {
            "pl": "Jedyna reguła właściciela: skok spodziewanego zużycia o rząd wielkości wymaga Twojego potwierdzenia; tu są współczynnik i punkty odniesienia.",
            "en": "The owner's one rule: a jump of expected consumption by an order of magnitude needs your confirmation; the factor and the baselines live here."
          },
          "effect": {
            "pl": "Zmiana tych wartości sama wymaga potwierdzenia; działania porównują szacunek z punktem odniesienia i pytają, gdy przekroczy współczynnik.",
            "en": "Changing these values itself needs confirmation; actions compare an estimate with the baseline and ask when it exceeds the factor."
          },
          "levels": [
            "person"
          ],
          "group": "koszty",
          "subgroup": "limity",
          "flows": [
            "actions.run",
            "usage.spend",
            "chat.send"
          ]
        }
      },
      {
        "key": "usage_spend_limits",
        "scope": "config",
        "group": "usage",
        "type": "array",
        "has_default": false,
        "description": "Your spending limits per period (the preset is none, so nothing is limited until you say so): a list of {period: day|week|month, amount, currency, on_exceed: confirm|deny|notify, rate?}. P18: every use of a model obeys them, not only action runs - a chat message, the routing model call, the background analysis, embeddings, media and an action's model call all go through the usage ledger, which adds the spend of the period (the cost the providers reported) and, when the caller knows the cost of the call, the estimate, and compares the sum with each limit. When one is passed, on_exceed decides: confirm holds the call with a receipt like the x10 hold (nothing is sent until you say yes), deny refuses it with the reason, notify lets it go and tells you. Importing a file or reading is never stopped by a limit. A plan shown in the conversation says beforehand that it would pass your limit. rate is USD per unit of the currency (an approximate preset is used when it is left out and the limit says so). Say it in the conversation: \"set a monthly limit of 20 PLN\", \"ustaw limit 20 zł na miesiąc\"; \"how much did I spend\" reads the limits back. It does not replace the x10 growth guard (loom_usage_policy). Runtime profile action_run (spend_limits). Default: none.",
        "human": {
          "label": {
            "pl": "Limity wydatków",
            "en": "Spending limits"
          },
          "why": {
            "pl": "Twoje własne progi na dzień, tydzień lub miesiąc; preset: brak, więc nic nie ogranicza, dopóki nie powiesz.",
            "en": "Your own thresholds per day, week or month; preset: none, so nothing is limited until you say so."
          },
          "effect": {
            "pl": "Po przekroczeniu progu: pytanie, odmowa albo tylko powiadomienie — jak ustawisz; dotyczy każdego użycia modelu.",
            "en": "Past a threshold: a question, a refusal or only a notice — as you set it; covers every use of a model."
          },
          "levels": [
            "person"
          ],
          "group": "koszty",
          "subgroup": "limity",
          "flows": [
            "usage.set_limit",
            "usage.spend",
            "chat.send"
          ]
        }
      },
      {
        "key": "loom_zip_max_total_bytes",
        "scope": "config",
        "group": "safety",
        "type": "integer",
        "has_default": true,
        "description": "Most bytes one imported ZIP archive may expand to; the import is refused before writing past it (zip bomb guard). 0 = no limit.",
        "human": {
          "label": {
            "pl": "Największy rozmiar po rozpakowaniu ZIP",
            "en": "Largest unpacked ZIP size"
          },
          "why": {
            "pl": "Ochrona przed archiwum, które rozpakowuje się do gigantycznego rozmiaru (bomba zip); 0 = bez limitu.",
            "en": "Protection from an archive that unpacks to a gigantic size (a zip bomb); 0 = no limit."
          },
          "effect": {
            "pl": "Import większego archiwum zostaje odrzucony przed zapisem, z powodem.",
            "en": "An import of a larger archive is refused before anything is written, with the reason."
          },
          "levels": [
            "person"
          ],
          "group": "prywatnosc",
          "subgroup": "bezpieczenstwo",
          "flows": [
            "import.file"
          ]
        }
      },
      {
        "key": "loom_zip_max_ratio",
        "scope": "config",
        "group": "safety",
        "type": "number",
        "has_default": true,
        "description": "Largest uncompressed/compressed ratio of one ZIP entry; a larger one is refused while extracting. 0 = no limit.",
        "human": {
          "label": {
            "pl": "Największy stopień kompresji wpisu ZIP",
            "en": "Largest ZIP entry compression ratio"
          },
          "why": {
            "pl": "Wpis archiwum, który rozpakowuje się więcej niż tyle razy, jest podejrzany; 0 = bez limitu.",
            "en": "An archive entry that unpacks more than this many times is suspect; 0 = no limit."
          },
          "effect": {
            "pl": "Taki wpis jest odrzucany przy rozpakowaniu, z powodem.",
            "en": "Such an entry is refused while unpacking, with the reason."
          },
          "levels": [
            "person"
          ],
          "group": "prywatnosc",
          "subgroup": "bezpieczenstwo",
          "flows": [
            "import.file"
          ]
        }
      },
      {
        "key": "loom_git_allow_repo_config",
        "scope": "config",
        "group": "safety",
        "type": "boolean",
        "has_default": true,
        "description": "false (preset): git run on a repository from your data folder ignores its hooks, fsmonitor and other configured programs. true lets the repository's own configuration run.",
        "human": {
          "label": {
            "pl": "Programy z konfiguracji repozytorium",
            "en": "Programs from a repository's configuration"
          },
          "why": {
            "pl": "Czy git uruchamiany na repozytorium z Twojego folderu może wykonywać jego własne haki i programy; preset: nie.",
            "en": "Whether git run on a repository from your folder may execute its own hooks and programs; preset: no."
          },
          "effect": {
            "pl": "Włączone: repozytorium, które zsynchronizujesz, może uruchomić własny kod na Twoim urządzeniu.",
            "en": "On: a repository you sync may run its own code on your device."
          },
          "levels": [
            "person"
          ],
          "group": "prywatnosc",
          "subgroup": "bezpieczenstwo",
          "flows": [
            "github.sync"
          ]
        }
      },
      {
        "key": "_config_version",
        "scope": "config",
        "group": "internal",
        "type": "integer",
        "has_default": false,
        "description": "Config format version maintained by the auto-upgrade; writes through the API are rejected.",
        "human": {
          "label": {
            "pl": "Wersja formatu konfiguracji",
            "en": "Config format version"
          },
          "why": {
            "pl": "Numer, po którym aplikacja wie, jak unowocześnić plik ustawień; prowadzi go sama.",
            "en": "The number by which the app knows how to upgrade the settings file; it maintains it itself."
          },
          "effect": {
            "pl": "Tylko do odczytu: zmiana przez API jest odrzucana, z powodem.",
            "en": "Read only: a change through the API is rejected, with the reason."
          },
          "levels": [],
          "group": "silnik",
          "subgroup": "wszystkie",
          "flows": [],
          "technical_only": true
        }
      },
      {
        "key": "semantic_retry_mode",
        "scope": "config",
        "group": "semantic",
        "type": "string",
        "has_default": false,
        "description": "Retry policy of failed semantic work (explicit_requeue or automatic).",
        "human": {
          "label": {
            "pl": "Ponawianie nieudanej analizy",
            "en": "Retrying failed analysis"
          },
          "why": {
            "pl": "Czy nieudana analiza wiadomości czeka na Twoje polecenie, czy ponawia się sama.",
            "en": "Whether a failed message analysis waits for your command or retries by itself."
          },
          "effect": {
            "pl": "Gdy ponawia się sama, nieudane wiadomości wracają do kolejki bez pytania, co może kosztować kolejne wywołania.",
            "en": "When it retries by itself, failed messages return to the queue without asking, which may cost further calls."
          },
          "levels": [
            "person"
          ],
          "group": "kontekst",
          "subgroup": "analiza",
          "flows": [
            "semantic.requeue",
            "semantic.analyse"
          ]
        },
        "values": [
          {
            "value": "explicit_requeue",
            "meaning": {
              "pl": "Czeka na Twoje polecenie: nieudana analiza wraca do kolejki dopiero, gdy o to poprosisz.",
              "en": "Waits for your command: a failed analysis returns to the queue only when you ask."
            }
          },
          {
            "value": "automatic",
            "meaning": {
              "pl": "Sama: nieudana analiza wraca do kolejki bez pytania (może kosztować kolejne wywołania).",
              "en": "By itself: a failed analysis returns to the queue without asking (may cost further calls)."
            }
          }
        ],
        "on_unlisted": "refuse"
      },
      {
        "key": "intent_routing_method",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "How a chat input is told to be a message or a command (R54): heuristic (local and free, preset), hybrid (the local reading first, the model asked only about what it is unsure of: a command the local reading is sure of is never turned into a message by the model; recommended once a provider key exists), model (one guarded model call per input) or off (every input is a message). Runtime profile intent_routing (heuristic.scoring.min_score and confident_score, method.presets.hybrid.ask_when).",
        "human": {
          "label": {
            "pl": "Rozpoznawanie poleceń",
            "en": "Command recognition"
          },
          "why": {
            "pl": "Jak aplikacja poznaje, że to, co piszesz, jest poleceniem, a nie wiadomością: lokalnie i za darmo (preset), modelem tam, gdzie nie jest pewna, zawsze modelem albo wcale.",
            "en": "How the app tells that what you type is a command, not a message: locally and free (preset), with a model where it is unsure, always with a model, or not at all."
          },
          "effect": {
            "pl": "Model w rozpoznawaniu = lepsze trafienia i dodatkowe wywołanie przy wiadomości.",
            "en": "A model in recognition = better hits and an extra call per message."
          },
          "levels": [
            "person"
          ],
          "group": "rozmowa",
          "subgroup": "polecenia",
          "flows": [
            "input.route_intent",
            "chat.send"
          ]
        }
      },
      {
        "key": "intent_routing_run",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Whether a command from the chat waits for the user's yes (propose, preset), runs at once when its plan only reads and the rules ask for nothing (read_only), or runs at once (always). The rules and the x10 usage confirmation apply in every case.",
        "human": {
          "label": {
            "pl": "Wykonanie polecenia z rozmowy",
            "en": "Running a command from the chat"
          },
          "why": {
            "pl": "Czy polecenie czeka na Twoje „tak” (preset), rusza od razu, gdy tylko czyta, czy rusza zawsze.",
            "en": "Whether a command waits for your yes (preset), runs at once when it only reads, or always runs at once."
          },
          "effect": {
            "pl": "Reguły i strażnik ×10 pytają niezależnie od tego pola.",
            "en": "The rules and the ×10 guard ask regardless of this field."
          },
          "levels": [
            "person"
          ],
          "group": "rozmowa",
          "subgroup": "polecenia",
          "flows": [
            "input.route_intent"
          ]
        }
      },
      {
        "key": "intent_routing_on_reject",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "What a no to a proposal from the chat does with the sentence the proposal came from: offer (preset: the reply offers, in the same proposal block and by the words \"send as message\", to send the sentence to the model as an ordinary message), send_as_message (it is sent at once) or drop (it is not sent). Whatever is sent has exactly the request bytes of an ordinary message. Runtime profile intent_routing.",
        "human": {
          "label": {
            "pl": "Po odrzuceniu propozycji",
            "en": "After a rejected proposal"
          },
          "why": {
            "pl": "Co dzieje się ze zdaniem, z którego powstała odrzucona propozycja: oferta wysłania jako wiadomość (preset), wysłanie od razu albo porzucenie.",
            "en": "What happens to the sentence a rejected proposal came from: an offer to send it as a message (preset), sending at once, or dropping it."
          },
          "effect": {
            "pl": "Wysłane zdanie idzie do modelu dokładnie jak zwykła wiadomość.",
            "en": "A sent sentence goes to the model exactly like an ordinary message."
          },
          "levels": [
            "person"
          ],
          "group": "rozmowa",
          "subgroup": "polecenia",
          "flows": [
            "input.route_intent"
          ]
        }
      },
      {
        "key": "intent_routing_model",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Model used for routing when the method is model; empty = the default model.",
        "human": {
          "label": {
            "pl": "Model rozpoznawania poleceń",
            "en": "Command recognition model"
          },
          "why": {
            "pl": "Który model ocenia, czy wpis jest poleceniem, gdy metoda rozpoznawania używa modelu; pusty = model rozmowy.",
            "en": "Which model judges whether an entry is a command when the recognition method uses a model; empty = the conversation model."
          },
          "effect": {
            "pl": "Tańszy model = tańsze rozpoznawanie; działa tylko przy metodach „model” i „hybrid”.",
            "en": "A cheaper model = cheaper recognition; applies only with the “model” and “hybrid” methods."
          },
          "levels": [
            "person"
          ],
          "group": "modele",
          "subgroup": "role",
          "role": "intent.routing",
          "role_status": "planned",
          "flows": [
            "input.route_intent"
          ],
          "technical_only": true
        }
      },
      {
        "key": "extrapolation_preset",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Preset of the chain proposals the engine makes when an element lacks what an action needs (off, standard or generous; presets are runtime/action_rules.pack). This is the user's level of a value that the scope chain resolves: a rule on a conversation or a project may set another one, and propose_chain / explain say which scope set the value. Default: the profile's active preset (standard).",
        "human": {
          "label": {
            "pl": "Podpowiedzi łańcuchów działań",
            "en": "Action chain suggestions"
          },
          "why": {
            "pl": "Jak śmiało aplikacja proponuje łańcuch kroków, gdy elementowi brakuje czegoś do działania: wcale, standardowo (preset) albo hojnie.",
            "en": "How boldly the app proposes a chain of steps when an element lacks what an action needs: not at all, standard (preset) or generous."
          },
          "effect": {
            "pl": "Hojniej = więcej i dłuższych propozycji (z szacunkiem kosztu); rozmowa lub projekt mogą mieć własny poziom.",
            "en": "More generous = more and longer proposals (with a cost estimate); a conversation or project may have its own level."
          },
          "levels": [
            "installation",
            "person",
            "project",
            "conversation"
          ],
          "group": "rozmowa",
          "subgroup": "polecenia",
          "flows": [
            "actions.propose_chain"
          ]
        }
      },
      {
        "key": "extrapolation_bounds",
        "scope": "config",
        "group": "chat",
        "type": "object",
        "has_default": false,
        "description": "The user's own thresholds of chain proposals: an object with any of max_length, max_cost, min_confidence, max_results (null = no bound); each member overrides the preset at the user's level and is itself overridden by a more specific scope. Default: none (the preset's bounds).",
        "human": {
          "label": {
            "pl": "Własne granice podpowiedzi",
            "en": "Your own suggestion bounds"
          },
          "why": {
            "pl": "Twoje progi dla łańcuchów: najdłuższy łańcuch, najwyższy koszt, najniższa pewność, liczba wyników; brak = bez granicy.",
            "en": "Your thresholds for chains: longest chain, highest cost, lowest confidence, number of results; absent = no bound."
          },
          "effect": {
            "pl": "Każdy podany próg zastępuje ten z presetu; pozostałe zostają.",
            "en": "Each threshold you give replaces the preset's; the others stay."
          },
          "levels": [
            "installation",
            "person",
            "project",
            "conversation"
          ],
          "group": "rozmowa",
          "subgroup": "polecenia",
          "flows": [
            "actions.propose_chain"
          ]
        }
      },
      {
        "key": "action_result_target",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Where the result of an action run goes: graph (preset: a form node linked to its source element and to the run), run_only (the result stays in the run document) or conversation_message (the text is also posted as a message of the conversation and linked in the graph). Runtime profile action_results. This is the user's level of a value that the scope chain resolves: a rule on a conversation or a project may set another one. Text above the profile's inline_max_bytes goes to the blob store whatever the target is. Default: graph.",
        "human": {
          "label": {
            "pl": "Gdzie trafia wynik działania",
            "en": "Where an action's result goes"
          },
          "why": {
            "pl": "Wynik działania: węzeł w grafie (preset), tylko w dokumencie przebiegu albo dodatkowo jako wiadomość rozmowy.",
            "en": "The result of an action: a node in the graph (preset), the run document only, or additionally a message of the conversation."
          },
          "effect": {
            "pl": "Zmienia tylko, gdzie wynik widać; przebieg zawsze go ma.",
            "en": "Changes only where the result is seen; the run always keeps it."
          },
          "levels": [
            "installation",
            "person",
            "project",
            "conversation"
          ],
          "group": "rozmowa",
          "subgroup": "polecenia",
          "flows": [
            "actions.run"
          ]
        }
      },
      {
        "key": "emergent_actions",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Whether the catalogue of actions grows from your conversations (R55): propose (preset: a command no action understands, a sequence you keep repeating, or an action used on several classes is offered as a new action or group, never made silently) or off. Accepting writes only your own overlays (profiles/actions.pack, profiles/intent_routing.pack, profiles/graph_entry.pack). Runtime profile intent_routing (emergent). Default: propose.",
        "human": {
          "label": {
            "pl": "Nowe działania z rozmów",
            "en": "New actions from conversations"
          },
          "why": {
            "pl": "Czy aplikacja proponuje nowe działania, gdy powtarzasz sekwencję albo wydajesz polecenie, którego żadne działanie nie rozumie (preset: proponuje, nigdy po cichu).",
            "en": "Whether the app proposes new actions when you repeat a sequence or give a command no action understands (preset: it proposes, never silently)."
          },
          "effect": {
            "pl": "Wyłączone: katalog działań rośnie tylko, gdy sam je zdefiniujesz.",
            "en": "Off: the catalogue of actions grows only when you define them yourself."
          },
          "levels": [
            "person"
          ],
          "group": "rozmowa",
          "subgroup": "polecenia",
          "flows": [
            "input.route_intent",
            "actions.define"
          ]
        }
      },
      {
        "key": "tool_loop_policy",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "What the agent (the tool loop of use_model) may do on its own: a preset of the runtime profile tool_loop - local_reversible (preset: local, reversible actions run, everything else is proposed and waits for you), read_only, confirm_all (every call is a proposal) or apply_all (every call runs; the rules of the interpreter, the x10 guard and the spending limits still apply) - or a policy of your own as an object {id?, rules: [{when?: {effects, actions, prefixes}, mode: run|propose|deny}]}. Default: local_reversible.",
        "human": {
          "label": {
            "pl": "Co agent może sam",
            "en": "What the agent may do alone"
          },
          "why": {
            "pl": "Które wywołania narzędzi agent wykonuje bez pytania: lokalne i odwracalne (preset), tylko odczyt, każde pyta, każde wykonuje — albo Twoja własna polityka.",
            "en": "Which tool calls the agent runs without asking: local and reversible (preset), read only, every one asks, every one runs — or your own policy."
          },
          "effect": {
            "pl": "„Wykonuj wszystko” nadal podlega regułom, strażnikowi ×10 i limitom wydatków.",
            "en": "“Run everything” still obeys the rules, the ×10 guard and the spending limits."
          },
          "levels": [
            "person"
          ],
          "group": "rozmowa",
          "subgroup": "agent",
          "flows": [
            "agent.run"
          ]
        }
      },
      {
        "key": "tool_loop_max_steps",
        "scope": "config",
        "group": "chat",
        "type": "integer",
        "has_default": false,
        "description": "How many model turns one agent loop may take; 0 = no limit. Runtime profile tool_loop (max_steps). Default: 8.",
        "human": {
          "label": {
            "pl": "Kroki jednej pracy agenta",
            "en": "Steps of one agent job"
          },
          "why": {
            "pl": "Ile tur modelu ma jedna praca agenta; 0 = bez limitu.",
            "en": "How many model turns one agent job may take; 0 = no limit."
          },
          "effect": {
            "pl": "Więcej kroków = dłuższa i droższa praca; po limicie agent zatrzymuje się i pokazuje, co zrobił.",
            "en": "More steps = a longer and dearer job; at the limit the agent stops and shows what it did."
          },
          "levels": [
            "person"
          ],
          "group": "rozmowa",
          "subgroup": "agent",
          "flows": [
            "agent.run"
          ]
        }
      },
      {
        "key": "tool_loop_on_proposal",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "What the agent does when a call it made became a proposal that waits for you: stop (preset: the loop ends and shows the proposals) or continue (the model is told the call was not executed and goes on). Default: stop.",
        "human": {
          "label": {
            "pl": "Agent przy propozycji",
            "en": "Agent at a proposal"
          },
          "why": {
            "pl": "Gdy wywołanie agenta czeka na Twoje „tak”: praca kończy się i pokazuje propozycje (preset) albo idzie dalej z informacją dla modelu.",
            "en": "When an agent call waits for your yes: the job ends and shows the proposals (preset) or goes on with a note to the model."
          },
          "effect": {
            "pl": "„Dalej” = model pracuje, nie czekając na Twoją decyzję o tym kroku.",
            "en": "“Go on” = the model keeps working without waiting for your decision on that step."
          },
          "levels": [
            "person"
          ],
          "group": "rozmowa",
          "subgroup": "agent",
          "flows": [
            "agent.run"
          ]
        }
      },
      {
        "key": "tool_loop_result_max_chars",
        "scope": "config",
        "group": "chat",
        "type": "integer",
        "has_default": false,
        "description": "A tool result longer than this many characters is cut when it is handed back to the model (the run keeps all of it); 0 = no cut. Runtime profile tool_loop (result_max_chars). Default: 20000.",
        "human": {
          "label": {
            "pl": "Ucięcie wyniku narzędzia dla modelu",
            "en": "Tool result cut for the model"
          },
          "why": {
            "pl": "Dłuższy wynik narzędzia jest ucinany, zanim model go dostanie (przebieg ma całość); 0 = bez cięcia.",
            "en": "A longer tool result is cut before the model gets it (the run keeps all of it); 0 = no cut."
          },
          "effect": {
            "pl": "Mniejsza wartość = tańsze kroki, ale model widzi mniej.",
            "en": "A smaller value = cheaper steps, but the model sees less."
          },
          "levels": [
            "person"
          ],
          "group": "rozmowa",
          "subgroup": "agent",
          "flows": [
            "agent.run"
          ]
        }
      },
      {
        "key": "chat_history_command_traffic",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "How the exchange of a chat command (what you typed as a command, the proposal, your answer to it) enters the history the chat model reads: skip_exchange (preset: left out, an action's result stays as context), skip_all (results left out too) or include (everything is sent). Default: skip_exchange.",
        "human": {
          "label": {
            "pl": "Polecenia w historii dla modelu",
            "en": "Commands in the history for the model"
          },
          "why": {
            "pl": "Czy wymiana wokół polecenia (Twoje polecenie, propozycja, Twoja odpowiedź) trafia do historii, którą czyta model: pomijana (preset), pomijana razem z wynikami albo w całości.",
            "en": "Whether the exchange around a command (your command, the proposal, your answer) enters the history the model reads: skipped (preset), skipped with the results, or all of it."
          },
          "effect": {
            "pl": "Pominięcie = krótsze żądania; model nie widzi, co ustalaliście przy poleceniach.",
            "en": "Skipping = shorter requests; the model does not see what you settled around commands."
          },
          "levels": [
            "person"
          ],
          "group": "rozmowa",
          "subgroup": "polecenia",
          "flows": [
            "chat.send"
          ]
        }
      },
      {
        "key": "model_registry_autorefresh",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Whether an estimate may fetch the provider's public model list when it needs a price and the model registry (models.json) is empty, which it is on a fresh data directory until the list is refreshed: on_demand (preset: the list is fetched once, no user data is sent; if the fetch fails the price stays unknown with the reason, and the next automatic attempt waits the profile's retry_after_seconds) or off (the registry is filled only by refreshing the model list yourself; an estimate without a price says so). Runtime profile action_run (estimate.registry_refresh). A name that is not a preset means on_demand. Default: on_demand.",
        "human": {
          "label": {
            "pl": "Lista modeli pobierana sama",
            "en": "Model list fetched by itself"
          },
          "why": {
            "pl": "Czy szacunek kosztu może raz pobrać publiczną listę modeli dostawcy, gdy rejestr jest pusty; żadne Twoje dane nie są wysyłane.",
            "en": "Whether a cost estimate may fetch the provider's public model list once when the registry is empty; none of your data is sent."
          },
          "effect": {
            "pl": "Wyłączone: ceny są znane dopiero po ręcznym odświeżeniu listy, a szacunek bez ceny mówi to wprost.",
            "en": "Off: prices are known only after you refresh the list yourself, and an estimate without a price says so."
          },
          "levels": [
            "person"
          ],
          "group": "modele",
          "subgroup": "dostawca",
          "flows": [
            "actions.preview",
            "models.refresh"
          ]
        }
      },
      {
        "key": "image_model",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Model that paints images for the action depict (served by an openai_images provider, see image_provider). Empty = the action asks for one. Default: none.",
        "human": {
          "label": {
            "pl": "Model obrazów",
            "en": "Image model"
          },
          "why": {
            "pl": "Który model maluje obrazy dla działania „depict”; pusty = działanie pyta o model.",
            "en": "Which model paints images for the action “depict”; empty = the action asks for one."
          },
          "effect": {
            "pl": "Działa przy następnym obrazie; potrzebuje dostawcy z pola Dostawca obrazów.",
            "en": "Applies to the next image; needs the provider from the Image provider field."
          },
          "levels": [
            "person"
          ],
          "group": "modele",
          "subgroup": "role",
          "role": "image.generate",
          "role_status": "planned",
          "flows": [
            "depict",
            "media.generate_image"
          ],
          "technical_only": true
        }
      },
      {
        "key": "image_provider",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Id of the provider manifest (config provider_manifests, adapter openai_images) that serves image_model. Empty = the action asks for one. Default: none.",
        "human": {
          "label": {
            "pl": "Dostawca obrazów",
            "en": "Image provider"
          },
          "why": {
            "pl": "Który z Twoich dodanych dostawców obsługuje model obrazów.",
            "en": "Which of your added providers serves the image model."
          },
          "effect": {
            "pl": "Bez niego działanie „depict” pyta, dokąd wysłać.",
            "en": "Without it the action “depict” asks where to send."
          },
          "levels": [
            "person"
          ],
          "group": "modele",
          "subgroup": "role",
          "role": "image.generate",
          "role_status": "planned",
          "flows": [
            "depict"
          ],
          "technical_only": true
        }
      },
      {
        "key": "speech_model",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Model that speaks for the action narrate (needs a provider whose adapter produces audio, see speech_provider). Empty = narrate returns the narration text only. Default: none.",
        "human": {
          "label": {
            "pl": "Model mowy",
            "en": "Speech model"
          },
          "why": {
            "pl": "Który model czyta na głos dla działania „narrate”; pusty = tylko tekst narracji.",
            "en": "Which model speaks for the action “narrate”; empty = the narration text only."
          },
          "effect": {
            "pl": "Działa przy następnej narracji; potrzebuje dostawcy z pola Dostawca mowy.",
            "en": "Applies to the next narration; needs the provider from the Speech provider field."
          },
          "levels": [
            "person"
          ],
          "group": "modele",
          "subgroup": "role",
          "role": "speech.synthesize",
          "role_status": "planned",
          "flows": [
            "narrate"
          ],
          "technical_only": true
        }
      },
      {
        "key": "speech_provider",
        "scope": "config",
        "group": "chat",
        "type": "string",
        "has_default": false,
        "description": "Id of the provider manifest that serves speech_model. Default: none.",
        "human": {
          "label": {
            "pl": "Dostawca mowy",
            "en": "Speech provider"
          },
          "why": {
            "pl": "Który z Twoich dodanych dostawców obsługuje model mowy.",
            "en": "Which of your added providers serves the speech model."
          },
          "effect": {
            "pl": "Bez niego działanie „narrate” zwraca tylko tekst.",
            "en": "Without it the action “narrate” returns text only."
          },
          "levels": [
            "person"
          ],
          "group": "modele",
          "subgroup": "role",
          "role": "speech.synthesize",
          "role_status": "planned",
          "flows": [
            "narrate"
          ],
          "technical_only": true
        }
      },
      {
        "key": "guardian_method",
        "scope": "config",
        "group": "context",
        "type": "string",
        "has_default": false,
        "description": "How the context guardian recognises signals in your messages (corrections, clarifications): heuristic (preset: word lists and structure, local and free), model (one guarded model call per message that no existing annotation already describes), hybrid (the local reading first, the model only where it found nothing) or off. The guardian is a secretary: it builds a representation of the conversation beside the raw messages and never changes them. Runtime profile guardian (method). Default: heuristic.",
        "human": {
          "label": {
            "pl": "Jak strażnik czyta sygnały",
            "en": "How the guardian reads signals"
          },
          "why": {
            "pl": "Jak sekretarz rozmowy rozpoznaje poprawki i doprecyzowania: lokalnie (preset), modelem, najpierw lokalnie i modelem tam, gdzie nic nie znalazł, albo wcale.",
            "en": "How the conversation's secretary recognises corrections and clarifications: locally (preset), with a model, locally first and the model where it found nothing, or not at all."
          },
          "effect": {
            "pl": "Model = dokładniej i płatnie (jedno chronione wywołanie na wiadomość bez adnotacji); strażnik nigdy nie zmienia Twoich wiadomości.",
            "en": "A model = more accurate and paid (one guarded call per message without annotations); the guardian never changes your messages."
          },
          "levels": [
            "person"
          ],
          "group": "kontekst",
          "subgroup": "straznik",
          "flows": [
            "guardian.observe",
            "guardian.annotate"
          ]
        }
      },
      {
        "key": "guardian_promotion",
        "scope": "config",
        "group": "context",
        "type": "string",
        "has_default": false,
        "description": "What the guardian does when a hypothesis about you gathers enough weight: ask (ask at the first occurrence), propose (preset: propose a rule with its evidence at the threshold) or apply (write the rule at the higher threshold and say so; always reversible). The thresholds, the escalation curve and the weights are data in the runtime profile guardian. Default: propose.",
        "human": {
          "label": {
            "pl": "Gdy strażnik jest pewny",
            "en": "When the guardian is sure"
          },
          "why": {
            "pl": "Co strażnik robi, gdy hipoteza o Tobie zbierze dość wagi: pyta od razu, proponuje regułę z dowodami (preset) albo zapisuje ją sam i mówi o tym.",
            "en": "What the guardian does when a hypothesis about you gathers enough weight: asks at once, proposes a rule with its evidence (preset), or writes it itself and says so."
          },
          "effect": {
            "pl": "„Zapisuje sam” = reguły powstają bez pytania; zawsze odwracalne (Ty › Reguły).",
            "en": "“Writes itself” = rules appear without asking; always reversible (You › Rules)."
          },
          "levels": [
            "person"
          ],
          "group": "kontekst",
          "subgroup": "straznik",
          "flows": [
            "guardian.promote"
          ]
        }
      },
      {
        "key": "guardian_model",
        "scope": "config",
        "group": "context",
        "type": "string",
        "has_default": false,
        "description": "Model used by the guardian when its method asks one (reading, naming, matching). The model of the conversation is never inherited (owner decision 2026-10-15): it is used only if you set this by hand. Resolution is a policy in the runtime profile guardian (models.policies.guardian, overlay-able): this setting; else the ports role guardian (preset: the same choice as analysis.fast, i.e. semantic_model); else analysis.fast; else NO model - the guardian then reads with word lists only and says so (status, proposals). A policy step relative_to (one tier cheaper than another model, tiers from models.tiers) is available but never preset. The call goes through use_model and the usage guards (x10, spending limits). Default: none.",
        "human": {
          "label": {
            "pl": "Model strażnika",
            "en": "Guardian model"
          },
          "why": {
            "pl": "Który model pomaga strażnikowi rozmowy czytać, nazywać i łączyć sygnały, gdy jego metoda tego wymaga; model rozmowy nigdy nie jest dziedziczony.",
            "en": "Which model helps the conversation guardian read, name and join signals when its method asks for one; the conversation model is never inherited."
          },
          "effect": {
            "pl": "Pusty: strażnik używa modelu analizy w tle. Rozmowa lub projekt mogą wskazać inny.",
            "en": "Empty: the guardian uses the background analysis model. A conversation or project may name another."
          },
          "levels": [
            "installation",
            "person",
            "project",
            "conversation"
          ],
          "group": "modele",
          "subgroup": "role",
          "role": "guardian",
          "flows": [
            "guardian.observe",
            "guardian.compile",
            "guardian.merge"
          ],
          "technical_only": true
        }
      },
      {
        "key": "guardian_levels",
        "scope": "config",
        "group": "context",
        "type": "object",
        "has_default": false,
        "description": "Your own definition of the lossy levels of the guardian's representation, merged over the profile guardian (levels.defs): {L1: {drop_categories: [filler, repetition, restart]}, L2: {drop_categories: [digression, joke]}, ...}; a level you name that the profile does not know is added. Categories and thresholds are yours to choose; the original text is never touched and every drop records its category and span. Default: the profile.",
        "human": {
          "label": {
            "pl": "Poziomy odchudzania rozmowy",
            "en": "Conversation slimming levels"
          },
          "why": {
            "pl": "Twoja definicja, co znika na poziomie L1 (wypełniacze, powtórzenia…) i L2 w reprezentacji rozmowy wysyłanej modelowi.",
            "en": "Your definition of what drops at level L1 (fillers, repetitions…) and L2 in the representation of the conversation sent to the model."
          },
          "effect": {
            "pl": "Działa od następnego żądania w trybach „denoised”, „lean” i „guardian”.",
            "en": "Applies from the next request in the “denoised”, “lean” and “guardian” modes."
          },
          "levels": [
            "person"
          ],
          "group": "kontekst",
          "subgroup": "straznik",
          "flows": [
            "chat.send",
            "guardian.compile"
          ]
        }
      },
      {
        "key": "semantic_segments",
        "scope": "config",
        "group": "context",
        "type": "string",
        "has_default": false,
        "description": "Whether the semantic analyzer's one prompt also returns the segment categories of a message (correction, preference, exception, digression, joke, instruction ...) and its topic thread, written to the shared annotation layer: auto (preset: when something reads them - a guardian that uses a model, the lean representation, the thread filter), on or off (the classic prompt: entities, topics, relations). One call per message either way. Runtime profile guardian (annotations.analyzer). Default: auto. The flow follows the class of the analysis model (models.flows, calibration): a frontier-class model gets one call for everything, a cheap one the classic call and one narrow question for the segments.",
        "human": {
          "label": {
            "pl": "Kategorie fragmentów w analizie",
            "en": "Segment categories in the analysis"
          },
          "why": {
            "pl": "Czy analiza w tle zapisuje też rodzaj każdego fragmentu wiadomości (poprawka, preferencja, żart, polecenie…) i wątek tematu: gdy coś z tego korzysta (preset), zawsze albo nigdy.",
            "en": "Whether the background analysis also records the kind of each message segment (correction, preference, joke, instruction…) and its topic thread: when something uses them (preset), always, or never."
          },
          "effect": {
            "pl": "Jedno wywołanie na wiadomość tak czy inaczej; bez kategorii filtr wątków i tryby odchudzone nie mają na czym pracować.",
            "en": "One call per message either way; without categories the thread filter and the slimmed modes have nothing to work on."
          },
          "levels": [
            "person"
          ],
          "group": "kontekst",
          "subgroup": "analiza",
          "flows": [
            "semantic.analyse"
          ]
        }
      },
      {
        "key": "chat_thread_filter",
        "scope": "config",
        "group": "context",
        "type": "string",
        "has_default": false,
        "description": "Whether the context selector leaves out of a request the messages the analyzer put in another topic thread than the one you are in: off (preset: every thread is sent) or current. The messages stay in the conversation; only the request is lighter. Runtime profile guardian (representation.thread_filter). Default: off.",
        "human": {
          "label": {
            "pl": "Filtr wątków w żądaniu",
            "en": "Thread filter in the request"
          },
          "why": {
            "pl": "Czy do modelu idą wiadomości z innych wątków tematu niż ten, w którym jesteś: wszystkie (preset) albo tylko bieżący.",
            "en": "Whether messages from other topic threads than the one you are in go to the model: all (preset) or the current one only."
          },
          "effect": {
            "pl": "Tylko bieżący = lżejsze żądanie; wiadomości zostają w rozmowie.",
            "en": "Current only = a lighter request; the messages stay in the conversation."
          },
          "levels": [
            "installation",
            "person",
            "project",
            "conversation"
          ],
          "group": "rozmowa",
          "flows": [
            "chat.send"
          ]
        }
      },
      {
        "key": "guardian_match_method",
        "scope": "config",
        "group": "context",
        "type": "string",
        "has_default": false,
        "description": "How the guardian recognises that several corrections are the same thing: overlap (preset: shared words and concepts, local and free), embedding (then the embedding tier of the search engine when available), model (then one guarded model question per candidate) or user (only what you declare, guardian merge). A wrong join is separated again with guardian unmerge, or by answering no to its proposal. Runtime profile guardian (matching). Default: overlap.",
        "human": {
          "label": {
            "pl": "Jak strażnik łączy poprawki",
            "en": "How the guardian joins corrections"
          },
          "why": {
            "pl": "Jak strażnik poznaje, że kilka poprawek to to samo: wspólne słowa (preset), osadzenia, pytanie do modelu albo tylko to, co sam wskażesz.",
            "en": "How the guardian tells that several corrections are the same thing: shared words (preset), embeddings, a question to a model, or only what you point out."
          },
          "effect": {
            "pl": "Błędne połączenie rozdzielasz poleceniem „unmerge” albo odpowiedzią „nie” na propozycję.",
            "en": "A wrong join is separated with “unmerge” or by answering no to its proposal."
          },
          "levels": [
            "person"
          ],
          "group": "kontekst",
          "subgroup": "straznik",
          "flows": [
            "guardian.merge",
            "guardian.observe"
          ]
        }
      },
      {
        "key": "guardian_person_rules",
        "scope": "config",
        "group": "context",
        "type": "string",
        "has_default": false,
        "description": "Whether the rules the guardian keeps about you (scope person or wider) go with a request: send (preset) or off. Resolved in the scope chain (R47): a rule of one conversation can set it to off there. Only the normalized text of a rule is sent, never the quotes it was heard in. Runtime profile guardian (privacy.visibility). Default: send.",
        "human": {
          "label": {
            "pl": "Reguły o Tobie w żądaniu",
            "en": "Rules about you in a request"
          },
          "why": {
            "pl": "Czy reguły, które strażnik pamięta o Tobie, idą z każdym żądaniem (preset) czy nie; jedna rozmowa może to wyłączyć u siebie.",
            "en": "Whether the rules the guardian keeps about you go with every request (preset) or not; one conversation may switch it off for itself."
          },
          "effect": {
            "pl": "Wysyłany jest tylko tekst reguły, nigdy cytaty, z których powstała.",
            "en": "Only the rule's text is sent, never the quotes it was heard in."
          },
          "levels": [
            "installation",
            "person",
            "project",
            "conversation"
          ],
          "group": "ty",
          "subgroup": "reguly",
          "flows": [
            "chat.send"
          ]
        }
      },
      {
        "key": "chat_representation",
        "scope": "config",
        "group": "context",
        "type": "string",
        "has_default": false,
        "description": "What the context selector sends of a conversation: raw (preset: the messages as they are, request bytes unchanged), denoised (your messages at level L1, without fillers, repetitions and restarts), lean (level L2), guardian (L1 and a run of clarifications replaced by one compiled instruction) or mixed (the raw messages followed by the compiled instruction); or a preset of your own in the profile guardian (representation.presets). A value that the scope chain resolves: accepting a proposal of the guardian sets guardian for that conversation as a rule you can switch off. The compatibility mode (system prompt and raw conversation only) is unaffected. Default: raw.",
        "human": {
          "label": {
            "pl": "Co model dostaje z rozmowy",
            "en": "What the model gets of the conversation"
          },
          "why": {
            "pl": "Wiadomości jak są (preset), bez wypełniaczy (L1), odchudzone (L2), z instrukcją skompilowaną przez strażnika albo jedno i drugie.",
            "en": "The messages as they are (preset), without fillers (L1), slimmed (L2), with the instruction the guardian compiled, or both."
          },
          "effect": {
            "pl": "Odchudzone = tańsze żądanie, mniej dosłownie; przyjęcie propozycji strażnika ustawia „guardian” dla tej rozmowy jako regułę, którą możesz wyłączyć.",
            "en": "Slimmed = a cheaper request, less literal; accepting a guardian proposal sets “guardian” for that conversation as a rule you can switch off."
          },
          "levels": [
            "installation",
            "person",
            "project",
            "conversation"
          ],
          "group": "rozmowa",
          "flows": [
            "chat.send",
            "guardian.compile"
          ]
        }
      },
      {
        "key": "chat_flow",
        "scope": "config",
        "group": "context",
        "section": "Kontekst",
        "subsection": "Przepływ wejścia i wyjścia",
        "type": "string",
        "has_default": false,
        "description": "Which flow the request goes through: how the context the selector chose (from the graph, by task, settings, representation) is rendered for the model and in which form the answer is asked for and taken back. A flow is data in the profile guardian (context_io.flows: renderer + output); shipped: plain (preset: ordinary chat turns in, plain text out, request bytes unchanged), graph_out (chat turns in, a graph reply out: loom.graph_reply/2 forced through a structured response format, prompt-only and validated for a model that cannot), graph_in (the selection as a graph packet in), graph_io (both). Empty: the flow of the model's class (context_io.class_flows), never the model of the conversation as such. A value that the scope chain resolves: \"w tej rozmowie ustaw chat_flow na graph_io\". A graph reply is rendered to the same text for you and its nodes and links are embedded in the graph with provenance to the message; an invalid reply is shown as raw text with a note. Graph replies are not streamed. Default: the flow of the class (all plain).",
        "human": {
          "label": {
            "pl": "Przepływ żądania",
            "en": "Request flow"
          },
          "why": {
            "pl": "W jakiej formie kontekst idzie do modelu i w jakiej wraca odpowiedź: zwykły czat (preset), graf w odpowiedzi, graf na wejściu albo oba.",
            "en": "In which form the context goes to the model and the reply comes back: plain chat (preset), a graph in the reply, a graph on the way in, or both."
          },
          "effect": {
            "pl": "Z grafem w odpowiedzi model odpowiada w ustalonej strukturze, sprawdzanej przed pokazaniem; model, który nie umie, dostaje tylko prompt.",
            "en": "With a graph in the reply the model answers in a fixed structure, checked before it is shown; a model that cannot gets a prompt only."
          },
          "levels": [
            "installation",
            "person",
            "project",
            "conversation",
            "turn"
          ],
          "group": "rozmowa",
          "flows": [
            "chat.send",
            "graph_native.reply"
          ]
        }
      },
      {
        "key": "environments_auto_sync",
        "scope": "config",
        "group": "loom",
        "type": "boolean",
        "has_default": false,
        "description": "Before answering a question about environments (what can I do on my phone, in this directory), bring the environment, capability and access nodes of the graph up to date from their sources. Off: answer from the nodes as they are (environments.sync does it on request). Runtime profile graph_entry (environments.settings). Default: true.",
        "human": {
          "label": {
            "pl": "Odświeżanie środowisk przed odpowiedzią",
            "en": "Environment refresh before an answer"
          },
          "why": {
            "pl": "Zanim aplikacja odpowie, co może na tym urządzeniu lub w folderze, odświeża w grafie węzły środowisk i uprawnień (preset: tak).",
            "en": "Before the app answers what it can do on this device or in a folder, it refreshes the environment and access nodes of the graph (preset: yes)."
          },
          "effect": {
            "pl": "Wyłączone: odpowiada z tego, co graf już ma; odświeżasz poleceniem „environments.sync”.",
            "en": "Off: it answers from what the graph already holds; you refresh with “environments.sync”."
          },
          "levels": [
            "person"
          ],
          "group": "prywatnosc",
          "subgroup": "dane",
          "flows": [
            "environments.can_do",
            "environments.sync"
          ]
        }
      },
      {
        "key": "environments_probe_paths",
        "scope": "config",
        "group": "loom",
        "type": "boolean",
        "has_default": false,
        "description": "A question about a directory asks the operating system about it (exists, readable, writable); nothing in it is read. Off: only what the graph already holds. Runtime profile graph_entry (environments.settings). Default: true.",
        "human": {
          "label": {
            "pl": "Pytanie systemu o folder",
            "en": "Asking the system about a folder"
          },
          "why": {
            "pl": "Pytanie o folder sprawdza w systemie, czy istnieje i czy wolno go czytać lub pisać; nic w środku nie jest czytane.",
            "en": "A question about a folder asks the system whether it exists and may be read or written; nothing inside is read."
          },
          "effect": {
            "pl": "Wyłączone: tylko to, co graf już wie.",
            "en": "Off: only what the graph already knows."
          },
          "levels": [
            "person"
          ],
          "group": "prywatnosc",
          "subgroup": "dane",
          "flows": [
            "environments.can_do"
          ]
        }
      },
      {
        "key": "tool_sources",
        "scope": "config",
        "group": "loom",
        "type": "object",
        "has_default": false,
        "description": "Your tool sources: external servers whose tools become actions of the catalogue, id -> {kind (mcp), transport (stdio | http), command + args (stdio) or url (http), access: {secret: <key name in the secrets vault>, header?, scheme?} (a reference, never the key itself), env: {NAME: {secret: <key name>}}, label?, enabled?, effects?: {flag: value} for every tool of the source, tools?: {<tool>: {effects?: {...}, hidden?: bool}}}. Nothing is contacted or sent until you add a source and ask for it to be listed (tool_source.sync); the tools are written to your overlay profiles/actions.pack, each marked with unknown effects so that the rules ask before every run (relax with tool_source.trust). Runtime profile tool_sources. Default: none.",
        "human": {
          "label": {
            "pl": "Źródła narzędzi",
            "en": "Tool sources"
          },
          "why": {
            "pl": "Zewnętrzne serwery (MCP), których narzędzia stają się działaniami katalogu; każde z zaufaniem i dostępem, które ustalasz.",
            "en": "External servers (MCP) whose tools become actions of the catalogue; each with the trust and access you set."
          },
          "effect": {
            "pl": "Dodane źródło pojawia się w katalogu po synchronizacji; usunięte znika razem ze swoimi działaniami.",
            "en": "An added source appears in the catalogue after a sync; a removed one disappears with its actions."
          },
          "levels": [
            "person"
          ],
          "group": "prywatnosc",
          "subgroup": "dane",
          "flows": [
            "tool_source.add",
            "tool_source.sync",
            "tool_source.trust"
          ]
        }
      },
      {
        "key": "context_execution",
        "scope": "config",
        "group": "context",
        "type": "object",
        "has_default": false,
        "description": "Execution options of context plans (stored by the context engine).",
        "human": {
          "label": {
            "pl": "Opcje wykonania planu kontekstu",
            "en": "Context plan execution options"
          },
          "why": {
            "pl": "Opcje zapisane przez silnik kontekstu: jak wykonuje plan wyboru tego, co idzie do modelu.",
            "en": "Options stored by the context engine: how it executes the plan of choosing what goes to the model."
          },
          "effect": {
            "pl": "Zmiana dotyczy następnych żądań; pusty obiekt = presety silnika.",
            "en": "A change applies to the next requests; an empty object = the engine's presets."
          },
          "levels": [
            "person"
          ],
          "group": "kontekst",
          "subgroup": "wybor",
          "flows": [
            "chat.send"
          ]
        }
      },
      {
        "key": "chat_reasoning",
        "scope": "config",
        "group": "chat",
        "type": "object",
        "has_default": false,
        "description": "Overrides of the reasoning request parameters per model family.",
        "human": {
          "label": {
            "pl": "Rozumowanie modelu",
            "en": "Model reasoning"
          },
          "why": {
            "pl": "Ile „myślenia” prosisz od modelu i jak zgłaszać to poszczególnym rodzinom modeli.",
            "en": "How much “thinking” you ask of the model and how to request it from each model family."
          },
          "effect": {
            "pl": "Więcej rozumowania = wolniej i drożej, często dokładniej; rodzina bez wpisu dostaje preset. Jedno żądanie może zmienić tylko poziom rozumowania (opcja reasoning_effort), nie sposób zgłaszania.",
            "en": "More reasoning = slower and dearer, often more accurate; a family without an entry gets the preset. A single request can change only the effort level (option reasoning_effort), not how it is reported."
          },
          "levels": [
            "person",
            "turn"
          ],
          "group": "rozmowa",
          "flows": [
            "chat.send"
          ]
        }
      },
      {
        "key": "analysis_prompt_overrides",
