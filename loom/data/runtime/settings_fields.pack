      },
      {
        "key": "onboarding_card",
        "scope": "config",
        "group": "ui",
        "type": "string",
        "has_default": true,
        "description": "Whether the profile interview card is shown in the conversation window: show (preset), later (hidden until the next launch) or never. Never does not delete the profile; the interview can always be started with a command (profile.interview). Default: show.",
        "values": [
          {
            "value": "show",
            "meaning": {
              "pl": "Pokazuj.",
              "en": "Show."
            }
          },
          {
            "value": "later",
            "meaning": {
              "pl": "Później (do następnego uruchomienia).",
              "en": "Later (until the next launch)."
            }
          },
          {
            "value": "never",
            "meaning": {
              "pl": "Nigdy.",
              "en": "Never."
            }
          }
        ],
        "status": {
          "state": "planned",
          "by": "M1-W2",
          "reason": {
            "pl": "Czytelnik tego pola — karta „Poznajmy się” w pustym czacie — powstaje w M1-W2; do tego czasu wartość jest zapisywana, ale nic jej nie czyta.",
            "en": "The reader of this field — the “Let us meet” card of the empty chat — comes with M1-W2; until then the value is stored but nothing reads it."
          }
        },
        "human": {
          "label": {
            "pl": "Karta pierwszych kroków",
            "en": "First-steps card"
          },
          "why": {
            "pl": "Czy w okienku rozmowy pokazuje się karta wywiadu o Tobie: tak (preset), później albo nigdy.",
            "en": "Whether the card of the interview about you shows in the conversation window: yes (preset), later, or never."
          },
          "effect": {
            "pl": "„Nigdy” nie kasuje profilu; wywiad zawsze można zacząć poleceniem.",
            "en": "“Never” does not delete the profile; the interview can always be started with a command."
          },
          "levels": [
            "person"
          ],
          "group": "interfejs",
          "subgroup": "wyglad",
          "flows": []
        },
        "on_unlisted": "refuse"
      },
      {
        "key": "android_back_exit_confirm",
        "scope": "config",
        "group": "ui",
        "type": "string",
        "has_default": true,
        "description": "What the system back button does on the first screen of the Android shell: ask (preset: a confirmation before leaving), never (back never leaves the app) or always (leaves without asking). No effect in a browser. Default: ask.",
        "values": [
          {
            "value": "ask",
            "meaning": {
              "pl": "Pyta przed wyjściem.",
              "en": "Asks before leaving."
            }
          },
          {
            "value": "never",
            "meaning": {
              "pl": "Nigdy nie wychodzi.",
              "en": "Never leaves."
            }
          },
          {
            "value": "always",
            "meaning": {
              "pl": "Wychodzi bez pytania.",
              "en": "Leaves without asking."
            }
          }
        ],
        "status": {
          "state": "planned",
          "by": "M1-A0",
          "reason": {
            "pl": "Czytelnik tego pola — przycisk wstecz Androida (OnBackPressedDispatcher) — powstaje w M1-A0; do tego czasu wartość jest zapisywana, ale nic jej nie czyta.",
            "en": "The reader of this field — the Android back button (OnBackPressedDispatcher) — comes with M1-A0; until then the value is stored but nothing reads it."
          }
        },
        "human": {
          "label": {
            "pl": "Wstecz na Androidzie wychodzi z aplikacji",
            "en": "Android back leaves the app"
          },
          "why": {
            "pl": "Co robi systemowe „wstecz” na pierwszym ekranie: pyta (preset), wychodzi bez pytania albo nigdy nie wychodzi.",
            "en": "What the system back does on the first screen: asks (preset), leaves without asking, or never leaves."
          },
          "effect": {
            "pl": "Dotyczy tylko powłoki Androida; w przeglądarce nie ma wpływu.",
            "en": "Applies to the Android shell only; no effect in a browser."
          },
          "levels": [
            "person"
          ],
          "group": "interfejs",
          "subgroup": "czat",
          "flows": []
        },
        "on_unlisted": "refuse"
      },
      {
        "key": "secrets_in_chat",
        "scope": "config",
        "group": "safety",
        "type": "string",
        "has_default": true,
        "description": "What happens to a credential (API key, token, password) typed into the conversation: never (preset: it is neither stored in the history nor sent to the model provider, the reply points to Settings; the model does not need your keys), ask (a confirmation each time) or allow (the sentence goes through as typed, with exactly the request bytes of an ordinary message). A setting, not a rule: you may change it. Default: never.",
        "values": [
          {
            "value": "never",
            "meaning": {
              "pl": "Nigdy nie zapisuj ani nie wysyłaj; model nie potrzebuje Twoich kluczy.",
              "en": "Never store or send; the model does not need your keys."
            }
          },
          {
            "value": "ask",
            "meaning": {
              "pl": "Pytaj za każdym razem.",
              "en": "Ask every time."
            }
          },
          {
            "value": "allow",
            "meaning": {
              "pl": "Przepuszczaj jak każdą wiadomość.",
              "en": "Let through like any message."
            }
          }
        ],
        "status": {
          "state": "planned",
          "by": "M1-K1",
          "reason": {
            "pl": "Czytelnik tego pola — filtr kluczy i haseł w chat.send i input.route_intent — powstaje w M1-K1; do tego czasu wartość jest zapisywana, ale nic jej nie czyta.",
            "en": "The reader of this field — the key-and-password filter in chat.send and input.route_intent — comes with M1-K1; until then the value is stored but nothing reads it."
          }
        },
        "human": {
          "label": {
            "pl": "Klucze i hasła w rozmowie",
            "en": "Keys and passwords in the chat"
          },
          "why": {
            "pl": "Co robić z kluczem lub hasłem wpisanym w rozmowie: nigdy nie zapisywać ani nie wysyłać (preset — model nie potrzebuje Twoich kluczy; ustawiasz je w Ustawieniach), pytać za każdym razem albo przepuszczać.",
            "en": "What to do with a key or password typed into the chat: never store or send it (preset — the model does not need your keys; you set them in Settings), ask every time, or let it through."
          },
          "effect": {
            "pl": "„Przepuszczaj” zapisuje wpis w historii i wysyła go dostawcy modelu jak każdą wiadomość.",
            "en": "“Let through” stores the entry in the history and sends it to the model provider like any message."
          },
          "levels": [
            "person"
          ],
          "group": "prywatnosc",
          "subgroup": "dane",
          "flows": [
            "chat.send",
            "input.route_intent"
          ]
        },
        "on_unlisted": "refuse"
      },
      {
        "key": "profile_detail_level",
        "scope": "config",
        "group": "context",
        "type": "string",
        "has_default": true,
        "description": "Detail level of your profile, the ids planned for onboarding/scenario.pack detail_levels (M1-K2): minimal, normal (preset) or detailed. It decides which interview fields are asked (detail <= level), what is stored and how much of the profile the profile prefix of a request carries; the privacy decisions of the profile (onboarding.privacy: max_detail, max_sensitivity) decide what may be stored or sent at all. The first question of the profile interview will write it (person; M1-K2); a remark such as 'shorter' lowers it by one. Default: normal.",
        "values": [
          {
            "value": "minimal",
            "meaning": {
              "pl": "Minimalnie: tylko styl i język.",
              "en": "Minimal: style and language only."
            }
          },
          {
            "value": "normal",
            "meaning": {
              "pl": "Zwykle: styl, język, potrzeby uwagi.",
              "en": "Normal: style, language, attention needs."
            }
          },
          {
            "value": "detailed",
            "meaning": {
              "pl": "Szczegółowo: wszystko, na co pozwoliłeś.",
              "en": "Detailed: everything you allowed."
            }
          }
        ],
        "status": {
          "state": "planned",
          "by": "M1-K2",
          "reason": {
            "pl": "Czytelnik tego pola — wywiad profilu (profile.interview) — powstaje w M1-K2; do tego czasu wartość jest zapisywana, ale nic jej nie czyta.",
            "en": "The reader of this field — the profile interview (profile.interview) — comes with M1-K2; until then the value is stored but nothing reads it."
          }
        },
        "human": {
          "label": {
            "pl": "Jak dokładnie aplikacja ma Cię znać",
            "en": "How closely the app should know you"
          },
          "why": {
            "pl": "Poziom szczegółowości profilu: minimalnie, zwykle (preset) albo szczegółowo. Od niego zależy, o co pyta wywiad „Poznaj mnie”, co zapisuje i ile o Tobie widzi model.",
            "en": "The detail level of your profile: minimal, normal (preset) or detailed. It decides what the “Get to know me” interview asks, what it stores and how much about you the model sees."
          },
          "effect": {
            "pl": "Wyżej = więcej pytań i pełniejszy opis Ciebie w żądaniu; zasady prywatności profilu i tak decydują, co wolno zapisać i wysłać. Pierwsze pytanie wywiadu ustawi to pole (gdy wywiad powstanie, M1-K2).",
            "en": "Higher = more questions and a fuller description of you in a request; the profile's privacy rules still decide what may be stored and sent. The interview's first question will set this field (when the interview comes, M1-K2)."
          },
          "levels": [
            "person"
          ],
          "group": "ty",
          "subgroup": "profil",
          "flows": []
        },
        "on_unlisted": "refuse"
      },
      {
        "key": "context_receipt_store",
        "scope": "config",
        "group": "context",
        "type": "string",
        "has_default": true,
        "description": "Whether the context receipt of a message (what exactly the selector sent to the model: elements, bytes, profile, modifiers) is stored with the message: auto (preset: stored whole when it fits context_receipt_max_bytes, otherwise a summary with the reason), always (stored whole, no cap) or never (the \"What we sent\" link says there is no receipt and why). This is the user's level of a value that the scope chain resolves. Default: auto.",
        "values": [
          {
            "value": "auto",
            "meaning": {
              "pl": "W całości, gdy mieści się w limicie; inaczej skrót z powodem.",
              "en": "Whole when it fits the limit; otherwise a summary with the reason."
            }
          },
          {
            "value": "always",
            "meaning": {
              "pl": "Zawsze w całości.",
              "en": "Always whole."
            }
          },
          {
            "value": "never",
            "meaning": {
              "pl": "Nigdy.",
              "en": "Never."
            }
          }
        ],
        "status": {
          "state": "planned",
          "by": "M1-K1",
          "reason": {
            "pl": "Czytelnik tego pola — ślad „Co wysłaliśmy” zapisywany przez build_messages — powstaje w M1-K1; do tego czasu wartość jest zapisywana, ale nic jej nie czyta.",
            "en": "The reader of this field — the “What we sent” receipt stored by build_messages — comes with M1-K1; until then the value is stored but nothing reads it."
          }
        },
        "human": {
          "label": {
            "pl": "Zapis śladu „Co wysłaliśmy”",
            "en": "Storing the “What we sent” trail"
          },
          "why": {
            "pl": "Czy przy każdej wiadomości zapisuje się, co dokładnie poszło do modelu: gdy mieści się w limicie, inaczej skrót z powodem (preset), zawsze w całości albo nigdy.",
            "en": "Whether what exactly went to the model is stored with each message: when it fits the limit, otherwise a summary with the reason (preset), always whole, or never."
          },
          "effect": {
            "pl": "Bez zapisu odnośnik „Co wysłaliśmy” pokazuje tylko, że śladu nie ma, i dlaczego.",
            "en": "Without a record the “What we sent” link shows only that there is no trail, and why."
          },
          "levels": [
            "person"
          ],
          "group": "kontekst",
          "subgroup": "slad",
          "flows": [
            "chat.send"
          ]
        },
        "on_unlisted": "refuse"
      },
      {
        "key": "context_receipt_max_bytes",
        "scope": "config",
        "group": "context",
        "type": "integer",
        "has_default": true,
        "description": "Most bytes of a context receipt stored whole in the auto mode of context_receipt_store; a larger receipt is stored as a summary with the reason. 0 = no cap. Default: 65536.",
        "status": {
          "state": "planned",
          "by": "M1-K1",
          "reason": {
            "pl": "Czytelnik tego pola — ślad „Co wysłaliśmy” zapisywany przez build_messages — powstaje w M1-K1; do tego czasu wartość jest zapisywana, ale nic jej nie czyta.",
            "en": "The reader of this field — the “What we sent” receipt stored by build_messages — comes with M1-K1; until then the value is stored but nothing reads it."
          }
        },
        "human": {
          "label": {
            "pl": "Limit śladu „Co wysłaliśmy”",
            "en": "“What we sent” trail limit"
          },
          "why": {
            "pl": "Ile bajtów śladu zapisuje się w trybie „auto”; większy ślad dostaje skrót z powodem. 0 = bez limitu.",
            "en": "How many bytes of the trail are stored in the “auto” mode; a larger trail gets a summary with the reason. 0 = no limit."
          },
          "effect": {
            "pl": "Większy limit = pełniejsze ślady i większa baza.",
            "en": "A larger limit = fuller trails and a larger database."
          },
          "levels": [
            "person"
          ],
          "group": "kontekst",
          "subgroup": "slad",
          "flows": [
            "chat.send"
          ]
        }
      }
    ],
    "profile_values": [
      {
        "profile": "worker",
        "pointer": "/batch_threshold",
        "human": {
          "label": {
            "pl": "Próg trybu zbiorczego analizy",
            "en": "Batch-mode threshold of the analysis"
          },
          "why": {
            "pl": "Od ilu oczekujących wiadomości analiza w tle przechodzi na tańszy o połowę, wolniejszy tryb zbiorczy (potrzebny klucz do analizy zbiorczej Anthropic).",
            "en": "From how many waiting messages the background analysis switches to the half-price, slower batch mode (needs the Anthropic batch analysis key)."
          },
          "effect": {
            "pl": "Niżej = częściej partiami (taniej, wolniej); wyżej = częściej pojedynczo (szybciej, drożej).",
            "en": "Lower = batches more often (cheaper, slower); higher = one by one more often (faster, dearer)."
          },
          "levels": [
            "installation"
          ],
          "group": "kontekst",
          "subgroup": "analiza",
          "flows": [
            "semantic.batch",
            "semantic.analyse"
          ]
        }
      },
      {
        "profile": "worker",
        "pointer": "/analysis_modes",
        "human": {
          "label": {
            "pl": "Tryby analizy w tle",
            "en": "Background analysis modes"
          },
          "why": {
            "pl": "Którymi trybami i w jakiej kolejności analiza w tle może pracować: zbiorczo, pojedynczo modelem, lokalnymi regułami.",
            "en": "Which modes, and in which order, the background analysis may work in: batch, one by one with a model, local rules."
          },
          "effect": {
            "pl": "Tryb usunięty z listy nie jest używany; bez modelu zostają lokalne reguły.",
            "en": "A mode removed from the list is not used; without a model the local rules remain."
          },
          "levels": [
            "installation"
          ],
          "group": "kontekst",
          "subgroup": "analiza",
          "flows": [
            "semantic.analyse",
            "semantic.batch"
          ]
        }
      },
      {
        "profile": "graph_memory",
        "pointer": "/default_depth",
        "human": {
          "label": {
            "pl": "Głębokość pamięci z grafu (preset profilu)",
            "en": "Graph memory depth (profile preset)"
          },
          "why": {
            "pl": "Zapasowa głębokość pamięci z grafu na wypadek, gdyby w ustawieniach nie było żadnej wartości pola „Głębokość pamięci z grafu”.",
            "en": "The fallback graph memory depth in case the settings hold no value at all for the field “Graph memory depth”."
          },
          "effect": {
            "pl": "Dziś nie działa: pole „Głębokość pamięci z grafu” ma zawsze wartość (preset 2), a 0 w tym polu znaczy „bez kroków”, nie „weź tę liczbę”.",
            "en": "Not in effect today: the field “Graph memory depth” always has a value (preset 2), and 0 in that field means “no hops”, not “take this number”."
          },
          "levels": [
            "installation"
          ],
          "group": "kontekst",
          "subgroup": "wybor",
          "flows": [
            "chat.send"
          ]
        }
      },
      {
        "profile": "graph_memory",
        "pointer": "/default_max_nodes",
        "human": {
          "label": {
            "pl": "Budżet węzłów pamięci z grafu (preset profilu)",
            "en": "Graph memory node budget (profile preset)"
          },
          "why": {
            "pl": "Zapasowy budżet pamięci z grafu na wypadek, gdyby w ustawieniach nie było żadnej wartości pola „Budżet węzłów pamięci z grafu”.",
            "en": "The fallback graph memory budget in case the settings hold no value at all for the field “Graph memory node budget”."
          },
          "effect": {
            "pl": "Dziś nie działa: pole „Budżet węzłów pamięci z grafu” ma zawsze wartość (preset 20), a 0 w tym polu znaczy „bez limitu”, nie „weź tę liczbę”.",
            "en": "Not in effect today: the field “Graph memory node budget” always has a value (preset 20), and 0 in that field means “no limit”, not “take this number”."
          },
          "levels": [
            "installation"
          ],
          "group": "kontekst",
          "subgroup": "wybor",
          "flows": [
            "chat.send"
          ]
        }
      },
      {
        "profile": "chat_context",
        "pointer": "/context_order",
        "human": {
          "label": {
            "pl": "Kolejność części żądania (preset profilu)",
            "en": "Order of the request parts (profile preset)"
          },
          "why": {
            "pl": "Kolejność używana, gdy pole Kolejność części żądania jest puste.",
            "en": "The order used when the Order of the request parts field is empty."
          },
          "effect": {
            "pl": "Działa tylko wtedy, gdy pole „Kolejność części żądania” jest puste.",
            "en": "Takes effect only when the field “Order of the request parts” is empty."
          },
          "levels": [
