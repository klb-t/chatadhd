          },
          "why": {
            "pl": "Które repozytorium (właściciel/nazwa) synchronizuje Twoje dane w obie strony.",
            "en": "Which repository (owner/name) syncs your data both ways."
          },
          "effect": {
            "pl": "Synchronizacja wysyła dane do tego repozytorium; bez tokena nic nie wychodzi.",
            "en": "Sync sends data to this repository; without a token nothing leaves."
          },
          "levels": [
