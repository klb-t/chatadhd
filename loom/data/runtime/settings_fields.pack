        "human": {
          "label": {
            "pl": "Instrukcja systemowa",
            "en": "System instruction"
          },
          "why": {
            "pl": "Tekst, który model dostaje na początku każdego żądania: kim ma być i jak odpowiadać.",
            "en": "The text the model gets at the start of every request: who to be and how to answer."
          },
          "effect": {
            "pl": "Działa od następnej wiadomości; jedno żądanie może podać własną instrukcję (opcja system_prompt).",
            "en": "Applies from the next message; a single request may give its own instruction (option system_prompt)."
          },
          "levels": [
            "person",
            "turn"
          ],
          "group": "rozmowa",
          "flows": [
            "chat.send"
          ]
        }
