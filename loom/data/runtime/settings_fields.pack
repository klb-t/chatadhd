      {
        "key": "navigator_children_limit",
        "scope": "config",
        "group": "ui",
        "type": "integer",
        "has_default": true,
        "description": "How many children of one node graph.navigate returns per level when the request names no limit; the rest is collapsed and the navigator says how many (\"K nodes collapsed - change the budget\"). 0 = no limit. Default: 50.",
        "status": {
          "state": "planned",
          "by": "M1-K0",
          "reason": {
