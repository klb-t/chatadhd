{
  "schema": "loom.runtime_profile/1",
  "domain": "chat_secrets",
  "revision": 1,
  "description": "What counts as a secret in an outgoing chat message and what happens on a hit (R67). Patterns (regular expressions with flags, labels in pl and en), the scan of the values in the secrets store, the scan of attached text files, the action per value of the setting secrets_in_chat (refuse | hold | pass) and the words are data; native code only runs the scan and the action. A hit is reported by rule and place, never by value.",
  "defaults": {
    "patterns": [
      {
        "id": "anthropic_key",
        "regex": "sk-ant-[A-Za-z0-9_-]{20,}",
        "flags": "",
        "label": {
          "pl": "klucz API (sk-ant-…)",
          "en": "API key (sk-ant-…)"
        }
      },
      {
        "id": "openrouter_key",
        "regex": "sk-or-v1-[A-Za-z0-9]{20,}",
        "flags": "",
        "label": {
          "pl": "klucz OpenRouter (sk-or-…)",
          "en": "OpenRouter key (sk-or-…)"
        }
      },
      {
        "id": "openai_key",
        "regex": "sk-[A-Za-z0-9_-]{20,}",
        "flags": "",
        "label": {
          "pl": "klucz API (sk-…)",
          "en": "API key (sk-…)"
        }
      },
      {
        "id": "github_token",
        "regex": "gh[pousr]_[A-Za-z0-9]{30,}",
        "flags": "",
        "label": {
          "pl": "token GitHub",
          "en": "GitHub token"
        }
      },
      {
        "id": "github_pat",
        "regex": "github_pat_[A-Za-z0-9_]{40,}",
        "flags": "",
        "label": {
          "pl": "token GitHub (github_pat_…)",
          "en": "GitHub token (github_pat_…)"
        }
      },
      {
        "id": "aws_access_key",
        "regex": "AKIA[0-9A-Z]{16}",
        "flags": "",
        "label": {
          "pl": "klucz dostępu AWS",
          "en": "AWS access key"
        }
      },
      {
        "id": "google_api_key",
        "regex": "AIza[0-9A-Za-z_-]{35}",
        "flags": "",
        "label": {
          "pl": "klucz API Google",
          "en": "Google API key"
        }
      },
      {
        "id": "slack_token",
        "regex": "xox[baprs]-[A-Za-z0-9-]{10,}",
        "flags": "",
        "label": {
          "pl": "token Slack",
          "en": "Slack token"
        }
      },
      {
        "id": "private_key_block",
        "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
        "flags": "",
        "label": {
          "pl": "klucz prywatny (blok PEM)",
          "en": "private key (PEM block)"
        }
      },
      {
        "id": "jwt",
        "regex": "eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
        "flags": "",
        "label": {
          "pl": "token JWT",
          "en": "JWT token"
        }
      },
      {
        "id": "password_assignment",
        "regex": "(hasło|haslo|password|passwd|pwd)\\s*[:=]\\s*[^\\s]{4,}",
        "flags": "i",
        "label": {
          "pl": "hasło wpisane w treści",
          "en": "a password written in the text"
        }
      }
    ],
    "store": {
      "scan": true,
      "min_length": 8,
      "skip_keys": []
    },
    "attachments": {
      "scan_text_files": true
    },
    "modes": {
      "never": {
        "action": "refuse"
      },
      "ask": {
        "action": "hold"
      },
      "allow": {
        "action": "pass"
      }
    },
    "texts": {
      "ask": {
        "pl": "W wiadomości jest sekret — wysłać mimo to?",
        "en": "The message contains a secret — send it anyway?"
      },
      "refused": {
        "pl": "W wiadomości jest sekret, więc nic nie wysłałem ani nie zapisałem. Model nie potrzebuje Twoich kluczy; jeśli chcesz to zmienić, ustawienie jest w Ustawieniach (Bezpieczeństwo).",
        "en": "The message contains a secret, so nothing was sent or stored. The model does not need your keys; you can change this in Settings (Safety)."
      },
      "send_anyway": {
        "pl": "Wyślij mimo to",
        "en": "Send anyway"
      },
      "dont_send": {
        "pl": "Nie wysyłaj",
        "en": "Do not send"
      },
      "where_text": {
        "pl": "w treści wiadomości",
        "en": "in the text of the message"
      },
      "where_file": {
        "pl": "w załączonym pliku",
        "en": "in an attached file"
      },
      "where_store": {
        "pl": "to samo, co zapisany klucz lub hasło z Twoich sekretów",
        "en": "the same as a key or password saved in your secrets"
      }
    }
  },
  "value_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "patterns",
      "store",
      "attachments",
      "modes",
      "texts"
    ],
    "properties": {
      "patterns": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "regex",
            "flags",
            "label"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "regex": {
              "type": "string"
            },
            "flags": {
              "type": "string"
            },
            "label": {
              "type": "object"
            }
          }
        }
      },
      "store": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scan",
          "min_length",
          "skip_keys"
        ],
        "properties": {
          "scan": {
            "type": "boolean"
          },
          "min_length": {
            "type": "integer",
            "minimum": 1
          },
          "skip_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "attachments": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scan_text_files"
        ],
        "properties": {
          "scan_text_files": {
            "type": "boolean"
          }
        }
      },
      "modes": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string"
            }
          }
        }
      },
      "texts": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      }
    }
  }
}
