      "submit_error_body_chars",
      "failure_recovery",
      "retry_mode",
      "retry_spacing_ms",
      "executing_lease_ms",
      "analysis_modes"
    ],
    "properties": {
      "drain_batch": {
        "x-setting": "/drain_batch",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "idle_poll_ms": {
        "x-setting": "/idle_poll_ms",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807,
        "x-unit": "milliseconds"
      },
      "llm_rate_limit": {
        "x-setting": "/llm_rate_limit",
        "x-consumer": "worker/media/github",
        "type": "number",
        "minimum": 0
      },
      "startup_delay_ms": {
        "x-setting": "/startup_delay_ms",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807,
        "x-unit": "milliseconds"
      },
      "batch_threshold": {
        "x-setting": "/batch_threshold",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807,
        "x-unit": "messages"
      },
      "batch_max_messages": {
        "x-setting": "/batch_max_messages",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "batch_endpoint": {
        "x-setting": "/batch_endpoint",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "pause_poll_ms": {
        "x-setting": "/pause_poll_ms",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807,
        "x-unit": "milliseconds"
      },
      "error_backoff_ms": {
        "x-setting": "/error_backoff_ms",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807,
        "x-unit": "milliseconds"
      },
      "rate_elapsed_floor": {
        "x-setting": "/rate_elapsed_floor",
        "x-consumer": "worker/media/github",
        "type": "number",
        "minimum": 0
      },
      "batch_output_tokens": {
        "x-setting": "/batch_output_tokens",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "batch_input_chars": {
        "x-setting": "/batch_input_chars",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0
      },
      "submit_timeout_ms": {
        "x-setting": "/submit_timeout_ms",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "poll_timeout_ms": {
        "x-setting": "/poll_timeout_ms",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "results_timeout_ms": {
        "x-setting": "/results_timeout_ms",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "batch_secret_key": {
        "x-setting": "/batch_secret_key",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "headers": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "strip_model_provider": {
        "x-setting": "/strip_model_provider",
        "x-consumer": "worker/media/github",
        "type": "boolean"
      },
      "batch_estimate_per_message": {
        "x-setting": "/batch_estimate_per_message",
        "x-consumer": "worker/media/github",
        "type": "number",
        "minimum": 0
      },
      "terminal_statuses": {
        "x-setting": "/terminal_statuses",
        "x-consumer": "worker/media/github",
        "type": "array",
        "items": {
          "x-setting": "/terminal_statuses/<index>",
          "x-consumer": "worker/media/github",
          "type": "string"
        }
      },
      "submit_error_body_chars": {
        "type": "integer",
        "minimum": 0,
        "x-setting": "/submit_error_body_chars",
        "x-consumer": "worker",
        "x-unit": "Unicode codepoints"
      },
      "failure_recovery": {
        "type": "string",
        "enum": [
          "explicit_requeue"
        ],
        "x-setting": "/failure_recovery",
        "x-consumer": "semantic_worker",
        "description": "Implemented recovery policy for per-message failed/interrupted claims. Resume only unpauses the worker; update_msg semantic_status=pending explicitly requeues."
      },
      "retry_mode": {
        "type": "string",
        "enum": [
          "explicit_requeue",
          "automatic"
        ],
        "x-setting": "/retry_mode",
        "x-consumer": "semantic_worker",
        "description": "explicit_requeue: failed/stalled items wait for an explicit requeue (update_msg pending or bulk requeue). automatic: they are requeued by the worker with no attempt ceiling; each resend passes the usage guard."
      },
      "retry_spacing_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807,
        "x-setting": "/retry_spacing_ms",
        "x-consumer": "semantic_worker",
        "x-unit": "milliseconds",
        "description": "Preset spacing between attempts on one item under automatic retry. Not a limit on how many attempts there are."
      },
      "executing_lease_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807,
        "x-setting": "/executing_lease_ms",
        "x-consumer": "semantic_worker",
        "x-unit": "milliseconds",
        "description": "A durable executing claim older than this is reported as stalled even if its owner cannot be probed. Reporting only; nothing is retried by it in explicit_requeue mode."
      },
      "analysis_modes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "x-setting": "/analysis_modes",
        "x-consumer": "semantic_worker",
        "description": "Preference order of registered analysis modes (built in: batch, llm, regex; embedders can register more). Each drain uses the first available bulk mode for the whole queue, otherwise every message goes to the first available per-message mode that accepts it, so modes can be mixed in one run. Availability still follows config (semantic_model, semantic_analysis, the batch key). Drop a name to disable that mode; keep regex last as the catch-all."
      }
    },
    "additionalProperties": false
  }
}
