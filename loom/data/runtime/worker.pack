{
  "schema": "loom.runtime_profile/1",
  "domain": "worker",
  "revision": 3,
  "description": "Worker timing, batching and transport recipe. Input/output generation uses existing semantic prompt, owned by thread1. Cost/message is an estimate placeholder, not actual charge. Per-message failures and interrupted claims require explicit requeue; batch polling remains process-local. Retry is a mode, not a ceiling: retry_mode explicit_requeue (default preset) never resends on its own; automatic requeues failed and stalled items without any attempt limit, spaced by retry_spacing_ms, and every automatic resend passes the shared usage guard. A claim whose owner is gone, or older than executing_lease_ms, is reported as stalled.",
  "defaults": {
    "drain_batch": 50,
    "idle_poll_ms": 30000,
    "llm_rate_limit": 2.0,
    "startup_delay_ms": 3000,
    "batch_threshold": 500,
    "batch_max_messages": 10000,
    "batch_endpoint": "https://api.anthropic.com/v1/messages/batches",
    "pause_poll_ms": 5000,
    "error_backoff_ms": 5000,
    "rate_elapsed_floor": 0.01,
    "batch_output_tokens": 800,
    "batch_input_chars": 3000,
    "submit_timeout_ms": 120000,
    "poll_timeout_ms": 30000,
    "results_timeout_ms": 300000,
    "batch_secret_key": "anthropic_batch_key",
    "headers": {
      "anthropic-version": "2023-06-01"
    },
    "strip_model_provider": true,
    "batch_estimate_per_message": 6.5e-05,
    "terminal_statuses": [
      "failed",
      "canceled",
      "expired"
    ],
    "submit_error_body_chars": 200,
    "failure_recovery": "explicit_requeue",
    "retry_mode": "explicit_requeue",
    "retry_spacing_ms": 60000,
    "executing_lease_ms": 900000,
    "analysis_modes": [
      "batch",
      "llm",
      "regex"
    ]
  },
  "value_schema": {
    "x-setting": "",
    "x-consumer": "worker/media/github",
    "type": "object",
    "required": [
      "drain_batch",
      "idle_poll_ms",
      "llm_rate_limit",
      "startup_delay_ms",
      "batch_threshold",
      "batch_max_messages",
      "batch_endpoint",
      "pause_poll_ms",
      "error_backoff_ms",
      "rate_elapsed_floor",
      "batch_output_tokens",
      "batch_input_chars",
      "submit_timeout_ms",
      "poll_timeout_ms",
      "results_timeout_ms",
      "batch_secret_key",
      "headers",
