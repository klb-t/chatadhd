{
  "schema": "loom.runtime_profile/1",
  "domain": "github",
  "revision": 1,
  "description": "Defaults match SyncConfig/GitHubSync. Credential values are external; only credential reference names and inert templates are data.",
  "defaults": {
    "branch": "main",
    "sync_direction": "bidirectional",
    "auto_sync": false,
    "include_patterns": [
      "*.py",
      "*.md",
      "*.json",
      "*.txt"
    ],
    "exclude_patterns": [
      "__pycache__/*",
      ".git/*",
      "*.pyc",
      "secrets.json",
      "*/secrets.json"
    ],
    "base_url": "https://api.github.com",
    "headers": {
      "Accept": "application/vnd.github.v3+json",
      "User-Agent": "ChatADHD-Sync"
    },
    "authorization_template": "token {{token}}",
    "connection_timeout_ms": 10000,
    "request_timeout_ms": 30000,
    "commit_message_template": "Update {{path}} via ChatADHD",
    "secret_key": "github_token"
  },
  "value_schema": {
    "x-setting": "",
    "x-consumer": "worker/media/github",
    "type": "object",
    "required": [
      "branch",
      "sync_direction",
      "auto_sync",
      "include_patterns",
      "exclude_patterns",
      "base_url",
      "headers",
      "authorization_template",
      "connection_timeout_ms",
      "request_timeout_ms",
      "commit_message_template",
      "secret_key"
    ],
    "properties": {
      "branch": {
        "x-setting": "branch",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "sync_direction": {
        "x-setting": "sync_direction",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "auto_sync": {
        "x-setting": "auto_sync",
        "x-consumer": "worker/media/github",
        "type": "boolean"
      },
      "include_patterns": {
        "x-setting": "include_patterns",
        "x-consumer": "worker/media/github",
        "type": "array",
        "items": {
          "x-setting": "include_patterns[]",
          "x-consumer": "worker/media/github",
          "type": "string"
        }
      },
      "exclude_patterns": {
        "x-setting": "exclude_patterns",
        "x-consumer": "worker/media/github",
        "type": "array",
        "items": {
          "x-setting": "exclude_patterns[]",
          "x-consumer": "worker/media/github",
          "type": "string"
        }
      },
      "base_url": {
        "x-setting": "base_url",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "headers": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "authorization_template": {
        "x-setting": "authorization_template",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "connection_timeout_ms": {
        "x-setting": "connection_timeout_ms",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "request_timeout_ms": {
        "x-setting": "request_timeout_ms",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "commit_message_template": {
        "x-setting": "commit_message_template",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "secret_key": {
        "x-setting": "secret_key",
        "x-consumer": "worker/media/github",
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
