          "label": {
            "en": "Executable",
            "pl": "Wykonywalny"
          },
          "description": "A method, flow or routine that can be applied."
        },
        "expresses_content": {
          "label": {
            "en": "Expresses a content",
            "pl": "Wyraża treść"
          },
          "description": "A form: a concrete expression of a content in some modality."
        },
        "expressible": {
          "label": {
            "en": "Expressible",
            "pl": "Wyrażalna"
          },
          "description": "A content that can be expressed in any form."
        },
        "self_model": {
          "label": {
            "en": "Self-model",
            "pl": "Samomodel"
          },
          "description": "The application describing itself."
        },
        "summary": {
          "label": {
            "en": "Summary",
            "pl": "Streszczenie"
          },
          "description": "Produced: a condensed rendering of a content."
        },
        "semantic_analysis": {
          "label": {
            "en": "Semantic analysis",
            "pl": "Analiza semantyczna"
          },
          "description": "Produced: entities, topics and relations."
        },
        "classification": {
          "label": {
            "en": "Classification",
            "pl": "Klasyfikacja"
          },
          "description": "Produced: a class, type or intent assigned to an element."
        },
        "critique": {
