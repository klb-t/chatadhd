            "self_model"
          ],
          "element_match": "any"
        },
        "off_device": {
          "label": {
            "en": "Everything that leaves the device",
            "pl": "Wszystko, co wysyła poza urządzenie"
          },
          "effect_flags": [
            "sends_off_device"
          ]
        },
        "irreversible": {
          "label": {
