              "as": "scope_chain",
              "pointer": "/scopes/chain"
            },
            {
              "as": "conflict_rules",
              "pointer": "/scopes/conflict_rules"
            }
          ]
        },
        "party": {
          "order": 5,
          "kind": "party",
          "label": {
            "en": "You (party with unknown slots)",
