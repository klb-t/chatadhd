          },
          "effect_flags": [
            "costs_money"
          ]
        },
        "private_data": {
          "label": {
            "en": "Actions touching private data",
            "pl": "Akcje dotykające danych prywatnych"
          },
          "effect_flags": [
            "touches_private_data"
          ]
        },
        "condensing": {
          "label": {
            "en": "Condense content",
            "pl": "Skracanie treści"
          },
          "content_ops": [
            "condense"
          ]
        },
        "restyling": {
          "label": {
            "en": "Change tone or style",
            "pl": "Zmiana tonu lub stylu"
          },
          "content_ops": [
            "restyle"
          ]
        },
        "reading_forms": {
          "label": {
            "en": "Read a form into content",
            "pl": "Odczytanie postaci w treść"
          },
          "form_ops": [
            "read"
          ]
        },
        "expressing_forms": {
          "label": {
            "en": "Express content in a form",
            "pl": "Wyrażenie treści w postaci"
          },
          "form_ops": [
            "express"
          ]
        },
        "devices": {
          "label": {
            "en": "Input/output devices and endpoints",
            "pl": "Urządzenia wejścia/wyjścia i punkty końcowe"
          },
          "traits": [
            "device"
          ],
          "element_match": "any"
        },
        "ports": {
          "label": {
            "en": "Ports, adapters and their runs",
            "pl": "Porty, adaptery i ich przebiegi"
          },
          "traits": [
            "port_artifact"
          ],
          "element_match": "any"
        },
        "environments": {
          "label": {
            "en": "Environments, capabilities and accesses",
            "pl": "Środowiska, zdolności i dostępy"
          },
          "traits": [
            "environment_artifact"
          ],
          "element_match": "any"
        }
      },
      "relations": {
        "supports": {
          "label": {
            "en": "Supports",
            "pl": "Wspiera"
          },
          "from": "guardian_occurrence",
          "to": "guardian_hypothesis",
          "description": "An occurrence (or a hypothesis) supports a hypothesis; the weight is the escalation factor it was counted with."
        },
        "contradicts": {
          "label": {
            "en": "Contradicts",
            "pl": "Przeczy"
          },
          "from": "guardian_hypothesis",
          "to": "guardian_hypothesis",
          "description": "Two hypotheses of the guardian claim opposite things in an overlapping scope."
        },
        "except": {
          "label": {
            "en": "Exception to",
            "pl": "Wyjątek od"
          },
          "from": "guardian_exception",
          "to": "guardian_hypothesis",
          "description": "The exception limits the hypothesis; stated by the user or inferred (metadata.explicit)."
        },
        "expresses": {
          "label": {
            "en": "Expresses",
            "pl": "Wyraża"
          },
          "from": "form",
          "to": "content",
          "description": "A form expresses a content (FRBR/LRM work-expression, a calibration point). Two forms of one content are linked through it, so a search for the content finds it in every form.",
          "weight": {
            "name": "fidelity",
            "range": [
              0,
              1
            ],
            "meaning": {
              "en": "How faithfully the form carries the content: 1 = nothing lost, 0 = nothing preserved. What was kept, lost or added (e.g. style) goes into the link metadata keys kept, lost, added.",
              "pl": "Jak wiernie postać niesie treść: 1 = nic nie zgubiono, 0 = nic nie zachowano. Co zachowano, zgubiono lub dodano (np. styl) trafia do kluczy metadanych krawędzi kept, lost, added."
            }
          }
        },
        "derived_from": {
          "label": {
            "en": "Derived from",
            "pl": "Pochodzi z"
          },
          "from": "form",
          "to": "any",
          "description": "A result was made from this source element (a message, a conversation, a node, a stored file). Written for every result of an action run that has a source element."
        },
        "produced_by": {
          "label": {
            "en": "Produced by",
            "pl": "Wytworzone przez"
          },
          "from": "form",
          "to": "action_run",
          "description": "The action run that made a result; the run node carries the action id, run id, step, model / adapter and usage receipts (references only, never secrets or bytes)."
        },
        "implements": {
          "label": {
            "en": "Implements",
            "pl": "Implementuje"
          },
          "from": "adapter",
          "to": "port",
          "description": "The adapter is one registered implementation of the port."
        },
        "chose": {
          "label": {
            "en": "Chose",
            "pl": "Wybrał"
          },
          "from": "role_choice",
          "to": "adapter",
          "description": "The role resolved to this adapter (a composition links every member)."
        },
        "part_of": {
          "label": {
            "en": "Part of",
            "pl": "Część"
          },
          "from": "port_run",
          "to": "action_run",
          "description": "A port run that happened inside an action run (the run id is in the execution context)."
        },
        "has_capability": {
          "label": {
            "en": "Has capability",
            "pl": "Ma zdolność"
          },
          "from": "environment",
          "to": "capability",
          "description": {
            "en": "The environment can do this; the capability points at the class of the thing that does it.",
            "pl": "Środowisko to potrafi; zdolność wskazuje klasę tego, co to wykonuje."
          }
        },
        "accessed_via": {
          "label": {
            "en": "Accessed via",
            "pl": "Dostęp przez"
          },
          "from": "environment",
          "to": "access",
          "description": {
            "en": "One gets into the environment this way.",
            "pl": "Do środowiska wchodzi się tym sposobem."
          }
        },
        "requires_access": {
          "label": {
            "en": "Requires access",
            "pl": "Wymaga dostępu"
          },
          "from": "capability",
          "to": "access",
          "description": {
            "en": "The capability is usable only with this access (for example an operating-system permission).",
            "pl": "Zdolność działa tylko z tym dostępem (na przykład zgodą systemu)."
          }
        },
        "stored_in": {
          "label": {
            "en": "Stored in",
            "pl": "Przechowywane w"
          },
          "from": "access",
          "to": "secret_vault",
          "description": {
            "en": "The secret an access refers to lives in the vault; the node holds the key name only.",
            "pl": "Sekret, do którego odnosi się dostęp, leży w sejfie; węzeł trzyma samą nazwę klucza."
          }
        },
        "hosted_on": {
          "label": {
            "en": "Hosted on",
            "pl": "Działa na"
          },
          "from": "environment",
          "to": "environment",
          "description": {
            "en": "The environment lives on, or is reached through, another one (a storage on a runtime or in a directory).",
            "pl": "Środowisko działa na innym albo jest osiągane przez inne (magazyn na środowisku uruchomieniowym lub w katalogu)."
          }
        },
        "provided_by": {
          "label": {
            "en": "Provided by",
            "pl": "Dostarczane przez"
          },
          "from": "capability",
          "to": "port",
          "description": {
            "en": "The capability is carried out by this port (its adapters are the means).",
            "pl": "Zdolność wykonuje ten port (jego adaptery są środkami)."
          }
        }
      },
