      },
      "db.provenance": {
        "provider": "db.provenance"
      },
      "kb.entities": {
        "provider": "kb.entities"
      },
      "kb.claims": {
        "provider": "kb.claims"
      },
      "kb.runs": {
        "provider": "kb.runs",
