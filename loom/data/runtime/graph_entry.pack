            },
            {
              "path": "loom/src/crypto/envelope.cpp"
            },
            {
              "path": "loom/src/crypto/hash_portable.cpp"
            },
            {
              "path": "loom/src/crypto/kem_xwing.cpp"
            },
            {
              "path": "loom/src/crypto/sealed.cpp"
            },
            {
              "path": "loom/src/crypto/sig_hybrid.cpp"
            },
            {
              "path": "loom/src/util/sha256.cpp"
            }
          ],
          "gaps": [
            "Algorithms only: there is no embedded update/signature verification key and no update verifier."
          ]
        },
        "id_time": {
          "number": 11,
          "label": {
            "en": "Identity and time generators",
            "pl": "Generatory tożsamości i czasu"
          },
          "why": "Identifier format, clock and versioning, so addresses stay consistent across the ecosystem.",
          "address": "rom:id_time",
          "status": "present",
          "files": [
            {
              "path": "loom/include/loom/util/ids.h"
            },
            {
              "path": "loom/include/loom/util/time.h"
            },
            {
              "path": "loom/src/util/random_ids_time.cpp"
            }
          ],
          "gaps": []
        },
        "ui_texts": {
          "number": 12,
          "label": {
            "en": "Base UI texts",
            "pl": "Podstawowe teksty interfejsu"
          },
          "why": "Texts (pl, en) the application needs before any memory is loaded.",
          "address": "rom:ui_texts",
          "status": "partial",
          "files": [
            {
              "path": "loom/data/onboarding/ui.pack"
            },
            {
              "path": "loom/data/runtime/cli.pack"
            },
            {
              "path": "loom/data/runtime/settings_fields.pack"
            }
          ],
          "gaps": [
            "Web UI strings are compiled into the web bundle (loom/web/src), not a shared data pack."
          ]
        },
        "catalogue": {
          "number": 13,
          "label": {
            "en": "ROM catalogue",
            "pl": "Katalog ROM"
          },
          "why": "The list of all items above with graph addresses; makes the ROM visible in the graph like any memory.",
          "address": "rom:catalogue",
          "status": "partial",
          "files": [
            {
              "path": "loom/include/loom/rom.h"
            },
            {
              "path": "loom/src/graph/rom.cpp"
            },
            {
              "path": "loom/tests/test_rom.cpp"
            },
            {
              "path": "loom/tools/gen_rom_catalogue.py"
            }
          ],
          "gaps": [
            "The catalogue pack is pinned in data_domains.pack."
          ]
        }
      }
