      "traits": {
        "has_text": {
          "label": {
            "en": "Has text",
            "pl": "Ma tekst"
          },
          "description": "Carries text (its own, or a canonical description)."
        },
        "has_image": {
          "label": {
            "en": "Has image",
            "pl": "Ma obraz"
          },
          "description": "Carries a still image."
        },
        "has_audio": {
          "label": {
            "en": "Has audio",
            "pl": "Ma dźwięk"
          },
          "description": "Carries a sound recording."
        },
        "has_video": {
          "label": {
            "en": "Has video",
            "pl": "Ma wideo"
          },
          "description": "Carries moving images."
        },
        "has_code": {
          "label": {
            "en": "Has code",
            "pl": "Ma kod"
          },
          "description": "Carries source code."
        },
        "has_table": {
          "label": {
            "en": "Has table",
            "pl": "Ma tabelę"
          },
          "description": "Carries tabular data."
        },
        "has_motion": {
          "label": {
            "en": "Has motion",
            "pl": "Ma ruch"
          },
          "description": "Carries movement (dance, motion capture)."
        },
        "musical": {
          "label": {
            "en": "Musical",
            "pl": "Muzyczny"
          },
          "description": "Has musical structure."
        },
        "has_file": {
          "label": {
            "en": "Has file",
            "pl": "Ma plik"
          },
          "description": "Backed by a stored file."
        },
        "has_hash": {
          "label": {
            "en": "Has content hash",
            "pl": "Ma skrót zawartości"
          },
          "description": "Content-addressed: the stored bytes have a hash."
        },
        "in_conversation": {
          "label": {
            "en": "In a conversation",
            "pl": "W konwersacji"
          },
          "description": "Belongs to a conversation."
        },
        "editable": {
          "label": {
            "en": "Editable",
            "pl": "Edytowalny"
          },
          "description": "May be edited."
        },
        "versioned": {
          "label": {
            "en": "Has versions",
            "pl": "Ma wersje"
          },
          "description": "Edits keep earlier versions as branches."
        },
        "executable": {
          "label": {
            "en": "Executable",
            "pl": "Wykonywalny"
          },
          "description": "A method, flow or routine that can be applied."
        },
        "expresses_content": {
          "label": {
            "en": "Expresses a content",
            "pl": "Wyraża treść"
          },
          "description": "A form: a concrete expression of a content in some modality."
        },
        "expressible": {
          "label": {
            "en": "Expressible",
            "pl": "Wyrażalna"
          },
          "description": "A content that can be expressed in any form."
        },
        "self_model": {
          "label": {
            "en": "Self-model",
            "pl": "Samomodel"
          },
          "description": "The application describing itself."
        },
        "summary": {
          "label": {
            "en": "Summary",
            "pl": "Streszczenie"
          },
          "description": "Produced: a condensed rendering of a content."
        },
        "semantic_analysis": {
          "label": {
            "en": "Semantic analysis",
            "pl": "Analiza semantyczna"
          },
          "description": "Produced: entities, topics and relations."
        },
        "classification": {
          "label": {
            "en": "Classification",
            "pl": "Klasyfikacja"
          },
          "description": "Produced: a class, type or intent assigned to an element."
        },
        "critique": {
          "label": {
            "en": "Critique",
            "pl": "Ocena"
          },
          "description": "Produced: an evaluation of a content."
        },
        "has_embedding": {
          "label": {
            "en": "Has embedding",
            "pl": "Ma wektor"
          },
          "description": "Produced: a vector representation."
        },
        "analysis_result": {
          "label": {
            "en": "Analysis result",
            "pl": "Wynik analizy"
          },
          "description": "Produced: the result of an analysis contract."
        },
        "knowledge_proposal": {
          "label": {
            "en": "Knowledge proposal",
            "pl": "Propozycja wiedzy"
          },
          "description": "Produced: proposed semantic knowledge, not yet accepted."
        },
        "device": {
          "label": {
            "en": "Device",
            "pl": "Urządzenie"
          },
          "description": "An input/output device or endpoint of the application (microphone, screen, storage, network endpoint...). A description plus platform availability; no hardware access is implied."
        },
        "input_device": {
          "label": {
            "en": "Input device",
            "pl": "Urządzenie wejścia"
          },
          "description": "Brings data into the application."
        },
        "output_device": {
          "label": {
            "en": "Output device",
            "pl": "Urządzenie wyjścia"
          },
          "description": "Takes data out of the application."
        },
        "captures_audio": {
          "label": {
            "en": "Captures audio",
            "pl": "Rejestruje dźwięk"
          },
          "description": "Can record sound (not the recording itself: that is has_audio)."
        },
        "captures_image": {
          "label": {
            "en": "Captures images",
            "pl": "Rejestruje obraz"
          },
          "description": "Can capture still images."
        },
        "captures_video": {
          "label": {
            "en": "Captures video",
            "pl": "Rejestruje wideo"
          },
          "description": "Can capture moving images."
        },
        "plays_audio": {
          "label": {
            "en": "Plays audio",
            "pl": "Odtwarza dźwięk"
          },
          "description": "Can play sound."
        },
        "displays_visual": {
          "label": {
            "en": "Displays visuals",
            "pl": "Wyświetla obraz"
          },
          "description": "Can show text, images or video to the user."
        },
        "holds_clipboard": {
          "label": {
            "en": "Holds clipboard",
            "pl": "Ma schowek"
          },
          "description": "Reads or writes the system clipboard."
        },
        "notifies": {
          "label": {
            "en": "Notifies",
            "pl": "Powiadamia"
          },
          "description": "Can raise a notification for the user."
        },
        "needs_permission": {
          "label": {
            "en": "Needs permission",
            "pl": "Wymaga zgody"
          },
          "description": "Use is gated by an operating-system or browser permission granted by the user."
        },
        "remote": {
          "label": {
            "en": "Remote",
            "pl": "Zdalne"
          },
          "description": "Reached over the network; data sent to it leaves the device."
        },
        "port": {
          "label": {
            "en": "Port",
            "pl": "Port"
          },
          "description": "An abstract interface that adapters implement (asr, ocr, storage, llm ...)."
        },
        "adapter": {
          "label": {
            "en": "Adapter",
            "pl": "Adapter"
          },
          "description": "One registered implementation of a port; carries a secret key name at most, never a secret."
        },
        "role_choice": {
          "label": {
            "en": "Role choice",
            "pl": "Wybór roli"
          },
          "description": "The adapter (or composition) a role of the ports profile resolved to, with the scope and source of the choice."
        },
        "port_run": {
          "label": {
            "en": "Port run",
            "pl": "Przebieg portu"
          },
          "description": "One real run through a port; result of a model call, storage operation or ensemble."
        },
        "port_artifact": {
          "label": {
            "en": "Port artifact",
            "pl": "Element portów"
          },
          "description": "A node that describes the port layer (port, adapter, role choice, port run); references only, never secrets or bytes."
        },
        "environment": {
          "label": {
            "en": "Environment",
            "pl": "Środowisko"
          },
          "description": {
            "en": "Something one can act on: a runtime (phone, server, command line, browser), a directory, a storage, a service account. What it can do is its capabilities; how one gets in is its accesses.",
            "pl": "To, na czym można działać: środowisko uruchomieniowe (telefon, serwer, wiersz poleceń, przeglądarka), katalog, magazyn, konto w serwisie. Co potrafi, to jego zdolności; jak się tam dostać, to jego dostępy."
          }
        },
        "capability": {
          "label": {
            "en": "Capability",
            "pl": "Zdolność"
          },
          "description": {
            "en": "What an environment can do (record sound, keep files, run a port ...). It points at the class of the thing that does it, so actions fit it by that class's traits.",
            "pl": "Co środowisko potrafi (nagrywać dźwięk, trzymać pliki, uruchamiać port ...). Wskazuje klasę tego, co to robi, więc akcje dopasowują się po cechach tej klasy."
          }
        },
        "access": {
          "label": {
            "en": "Access",
            "pl": "Dostęp"
          },
          "description": {
            "en": "How one may act in an environment: a key, a token, a login, a permission, physical possession. Holds a reference to the secrets vault (a key name), never the secret itself.",
            "pl": "Jak można działać w środowisku: klucz, token, logowanie, zgoda, fizyczne posiadanie. Trzyma odniesienie do sejfu (nazwę klucza), nigdy sam sekret."
          }
        },
        "credential_reference": {
          "label": {
            "en": "Credential reference",
            "pl": "Odniesienie do poświadczenia"
          },
          "description": {
            "en": "A name of a secret in the vault and whether it is set; the value never enters the graph.",
            "pl": "Nazwa sekretu w sejfie i informacja, czy jest ustawiony; wartość nigdy nie trafia do grafu."
          }
        },
        "environment_artifact": {
          "label": {
            "en": "Environment artifact",
            "pl": "Element środowisk"
          },
          "description": {
            "en": "A node of the environment layer (environment, capability, access, vault); references only, never secrets or bytes.",
            "pl": "Węzeł warstwy środowisk (środowisko, zdolność, dostęp, sejf); tylko odniesienia, nigdy sekrety ani bajty."
          }
        }
      },
      "groups": {
        "rich_content": {
          "label": {
            "en": "Rich representations of multidimensional content",
            "pl": "Bogate reprezentacje wielowymiarowych treści"
          },
          "traits": [
            "has_text",
            "has_image",
            "has_audio",
            "has_video",
            "has_code",
            "has_table",
            "has_motion",
            "expresses_content"
          ],
          "element_match": "any"
        },
        "flows": {
          "label": {
            "en": "Flows, routines, pipelines, methods",
            "pl": "Flow, rutyny, pipeliny, metody"
          },
          "traits": [
            "executable"
          ],
          "element_match": "any"
        },
        "memories": {
          "label": {
            "en": "Memories and stores",
            "pl": "Pamięci i magazyny"
          },
          "traits": [
            "storage",
            "has_hash"
          ],
          "element_match": "any"
        },
        "settings": {
          "label": {
            "en": "Settings and rules",
            "pl": "Ustawienia i zasady"
          },
          "traits": [
            "settings_field"
          ],
          "element_match": "any"
        },
        "conversation_structure": {
          "label": {
