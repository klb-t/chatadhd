    "bindings": {
      "pack.principles": {
        "provider": "pack.file",
        "as": "principles",
        "params": {
          "path": "philosophy/principles.json"
        }
      },
      "pack.operators": {
        "provider": "pack.file",
        "as": "operators",
        "params": {
          "path": "philosophy/operators.json"
        }
      },
      "pack.rules": {
        "provider": "pack.file",
        "as": "rules",
        "params": {
          "path": "rules/inference_rules.json"
        }
      },
      "profile.domains": {
        "provider": "profile.domains",
        "as": "profile_domains"
      },
      "profile.import_formats": {
        "provider": "profile.items",
