{
  "schema": "loom.runtime_profile/1",
  "domain": "import_formats",
  "revision": 1,
  "description": "UNWIRED: exact format, MIME, role and text-parser recipes captured from W5 4e8c3de. RuntimeProfile inspection/overrides only; native import dispatch/parser remains unchanged until W5 wires it. Lists/dictionaries are open registries; codecs and lossless provenance operations remain native.",
  "defaults": {
    "detection": {
      "extension_rules": [
        {
          "extensions": [
            ".zip"
          ],
          "format": "zip"
        },
        {
          "extensions": [
            ".db"
          ],
          "format": "sqlite"
        },
        {
          "extensions": [
            ".json"
          ],
          "format": "json"
        },
        {
          "extensions": [
            ".jsonl",
            ".ndjson"
          ],
          "format": "jsonl"
        },
        {
          "extensions": [
            ".html",
            ".htm"
          ],
          "format": "html"
        },
        {
          "extensions": [
            ".mht",
            ".mhtml"
          ],
          "format": "mht"
        },
        {
          "extensions": [
            ".png",
            ".jpg",
            ".jpeg",
            ".webp"
          ],
          "format": "screenshot"
        },
        {
          "extensions": [
            ".md"
          ],
          "format": "markdown"
        },
        {
          "extensions": [
            ".txt",
            ".log"
          ],
          "format": "text"
        }
      ],
      "sniff_bytes": 200,
      "zip_prefix": "PK\u0003\u0004",
      "sqlite_contains": "SQLite format",
      "json_first_non_whitespace": [
        "{",
        "["
      ],
      "html_contains_case_insensitive": [
        "<html",
        "<!doctype"
      ],
      "fallback_format": "unknown"
    },
    "mime_by_format": {
      "zip": "application/zip",
      "sqlite": "application/vnd.sqlite3",
      "json": "application/json",
      "jsonl": "application/x-ndjson",
      "html": "text/html",
      "mht": "message/rfc822",
      "markdown": "text/markdown",
      "text": "text/plain",
      "screenshot": "image/*"
    },
    "fallback_mime": "application/octet-stream",
    "export_mode_names": [
      "auto",
      "off",
      "on"
    ],
    "legacy_json_roles": {
      "field_priority": [
        "role",
        "sender"
      ],
      "absent_role": "user",
      "user_inputs": [
        "user",
        "human"
      ],
      "excluded_roles": [
        "system"
      ],
      "other_role": "assistant"
    },
    "legacy_sqlite_roles": {
      "user_inputs": [
        "user",
        "human"
      ],
      "other_role": "assistant"
    },
    "provider_exports": {
      "openai": {
        "source": "import:openai",
        "conversation_field": "mapping",
        "absent_role": "unknown"
      },
      "anthropic": {
        "source": "import:anthropic",
        "conversation_field": "chat_messages",
        "role_map": {
          "human": "user"
        },
        "absent_role": "assistant"
      },
      "generic_message_wrappers": [
        "messages",
        "chat_messages",
        "items",
        "data"
      ],
      "streamed_conversations_wrapper": "conversations"
    },
    "text_formats": {
      "markdown": {
        "user_prefixes": [
          "## human",
          "## user",
          "**human**",
          "**user**"
        ],
        "assistant_prefixes": [
          "## assistant",
          "## claude",
          "**assistant**",
          "**claude**"
        ],
        "separators": [
          "---",
          "***"
        ],
        "fallback_role": "assistant"
      },
      "plain_text": {
        "user_labels": [
          "Human",
          "User",
          "You"
        ],
        "assistant_labels": [
          "Assistant",
          "AI",
          "Claude"
        ],
        "label_order": [
          "Human",
          "User",
          "You",
          "Assistant",
          "AI",
          "Claude"
        ],
        "fallback_role": "assistant"
      },
      "screenshot": {
        "user_words": [
          "You",
          "Human",
          "User",
          "Ja",
          "Ty"
        ],
        "assistant_words": [
          "Claude",
          "Assistant",
          "AI",
          "ChatGPT",
          "GPT",
          "Gemini",
          "Bot"
        ],
        "user_arrows": [
          "►",
          "▶",
          "→",
          ">"
        ],
        "assistant_arrows": [
          "◄",
          "◀",
          "←",
          "<"
        ],
        "user_sidebar_labels": [
          "h",
          "human"
        ],
        "assistant_sidebar_labels": [
          "a",
          "assistant"
        ],
        "block_length_exclusive_minimum": 3,
        "unlabelled_user_length_exclusive_maximum": 50,
        "unlabelled_user_question_suffix": "?",
        "ocr_text_minimum_codepoints": 10,
        "fallback_role": "assistant",
        "title_prefix": "Screenshot ",
        "title_time_format": "%Y-%m-%d %H:%M"
      }
    }
  },
