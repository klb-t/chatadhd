{
  "schema": "loom.runtime_profile/1",
  "domain": "intent_routing",
  "revision": 1,
  "description": "Everything from the conversation window (R54, GRAF_HUB_KOD_SILNIK §8): every chat input goes through input.route_intent, which decides message or command and, for a command, resolves it against the action catalogue and the rules and answers IN the conversation with a proposal. This profile is the data of that decision. method: heuristic (local and free: explicit command syntax, patterns, and the phrases that actions carry in the catalogue; no model call), model (one use_model call with the configured model, guarded like every other), off (every input is a message). The method is a setting: config key `intent_routing_method`, then the preset below; the call may override it. execution: whether a proposal waits for the user's yes (propose, the preset), runs at once when the whole plan only reads and the rules ask for nothing (read_only), or runs at once whatever it does (always); the rules and the x10 usage confirmation apply in every case. Confirmation is a reply that is exactly one of the yes / no words below. A phrase on an action is space-separated words, all of which must occur within `window_tokens` of the start with at least one within `lead_tokens`; a word ending in * matches any continuation; text is lower-cased and the letters in `fold` are replaced before matching. A chat input is a command only when it names an action AND an element (an id, or a word that refers to the conversation or a message); otherwise it is a message and continues on the chat path unchanged. All numbers here are calibration, not limits: the user's overlay <data>/profiles/intent_routing.pack changes any of them.",
  "defaults": {
    "method": {
      "setting": "intent_routing_method",
      "active": "heuristic",
      "presets": {
        "off": {"label": {"en": "Off: every input is a message", "pl": "Wyłączone: każde wejście jest wiadomością"}},
        "heuristic": {"label": {"en": "Local: explicit syntax and phrases, no model call", "pl": "Lokalnie: jawna składnia i frazy, bez wywołania modelu"}},
        "model": {"label": {"en": "Model: one model call per input (guarded like every other)", "pl": "Model: jedno wywołanie modelu na wejście (pod tym samym zabezpieczeniem)"}}
      },
      "model_setting": "intent_routing_model",
      "model_fallback_setting": "default_model"
    },
    "execution": {
      "setting": "intent_routing_run",
      "active": "propose",
      "presets": {
        "propose": {"label": {"en": "Propose first, run after the user's yes", "pl": "Najpierw propozycja, wykonanie po „tak”"}},
        "read_only": {"label": {"en": "Run at once when the plan only reads and the rules ask for nothing", "pl": "Od razu, gdy plan tylko czyta, a zasady o nic nie pytają"}},
        "always": {"label": {"en": "Run at once (rules and the x10 confirmation still apply)", "pl": "Od razu (zasady i potwierdzenie ×10 nadal obowiązują)"}}
      }
    },
    "emergent": {
      "setting": "emergent_actions",
      "active": "propose",
      "presets": {
        "off": {"label": {"en": "Off: the catalogue never grows from conversations", "pl": "Wyłączone: katalog nie rośnie z rozmów"}},
        "propose": {"label": {"en": "Propose: new actions, sequences and groups are offered, never made silently", "pl": "Propozycje: nowe akcje, sekwencje i grupy są proponowane, nigdy po cichu"}}
      },
      "command_shape": {
        "max_tokens": 16,
        "min_lead_chars": 4,
        "lead_skip": ["prosze", "teraz", "moglbys", "mozesz", "moze", "please", "now", "could", "can", "would", "you", "just", "hey", "ok", "okay"],
        "not_leads": ["jak", "jaki", "jaka", "jakie", "co", "czemu", "dlaczego", "czy", "kto", "kiedy", "gdzie", "ile", "ktory", "ktora", "chce", "chcialbym", "chcialabym", "mam", "musze", "powiedz", "what", "why", "how", "who", "when", "where", "which", "does", "should", "will", "this", "that", "there", "here", "what's", "i'm", "i'd", "i'll", "let's", "tell", "want", "need", "think", "wonder", "maybe"],
        "forbid_question_mark": true
      },
      "naming": {"prefix": "", "max_chars": 24},
      "requires_from": ["has_text", "has_image", "has_audio", "has_video", "has_code", "has_table"],
      "definition": {
        "system": {
          "en": "You carry out an instruction about the text that follows it. Do what the instruction says, faithfully and completely; add nothing it does not ask for. Answer in the language of the instruction unless it asks for another.",
          "pl": "Wykonujesz polecenie dotyczące poniższego tekstu. Zrób dokładnie to, co polecenie mówi, wiernie i w całości; nie dodawaj niczego, o co nie prosi. Odpowiadaj w języku polecenia, chyba że prosi o inny."
        },
        "parameters": {"temperature": 0.5},
        "cost": 1.0,
        "confidence": 0.6
      },
      "sequences": {"repeat": 3, "max_length": 3, "gap_seconds": 900, "window_runs": 200, "joiner": "_then_"},
      "groups": {"min_classes": 2, "suffix": "_targets"},
      "node": {"kind": "proposal", "link": "derived_from"}
    },
    "default_language": "en",
    "message_request_fields": ["attachments", "usage_confirmation", "active_task_spec", "knowledge_context", "web_search", "deep_research"],
    "heuristic": {
      "language_hints": {
        "pl": ["ustaw", "zmien", "przelacz", "pokaz", "sprawdz", "jaka", "jakie", "streszcz", "podsumuj", "narysuj", "zrob", "tak", "nie", "prosze", "dziekuje", "rozmowe", "rozmowy", "wiadomosc"]
      },
      "fold": {"ą": "a", "ć": "c", "ę": "e", "ł": "l", "ń": "n", "ó": "o", "ś": "s", "ź": "z", "ż": "z"},
      "window_tokens": 12,
      "lead_tokens": 4,
      "scoring": {"base": 0.6, "per_word": 0.1, "lead_penalty": 0.05, "min_score": 0.5},
      "explicit": {
        "prefixes": ["/"],
        "run_verbs": ["run", "uruchom"],
        "aliases": {"set": "settings.set", "ustaw": "settings.set", "get": "settings.get", "show": "settings.get", "pokaz": "settings.get", "pokaż": "settings.get"},
        "arg_pattern": "^([A-Za-z_][A-Za-z0-9_.]*)=(.*)$",
        "element_markers": ["on", "na", "for", "dla"],
        "default_element": "current_conversation"
      },
      "patterns": [
        {
          "id": "set_equals",
          "action": "settings.set",
          "regex": "^(?:(?:set|change|ustaw|zmień|zmien)\\s+)?([A-Za-z][A-Za-z0-9_]*)\\s*=\\s*(.+?)\\s*$",
          "args": ["key", "value"],
          "element_arg": "key",
          "requires_element": true
        },
        {
          "id": "set_to",
          "action": "settings.set",
          "regex": "^(?:set|change|switch|ustaw|zmień|zmien|przełącz|przelacz)\\s+(?:the\\s+)?(?:setting\\s+)?([A-Za-z][A-Za-z0-9_]*)\\s+(?:to|na|=)\\s+(.+?)\\s*$",
          "args": ["key", "value"],
          "element_arg": "key",
          "requires_element": true
        },
        {
          "id": "show_setting",
          "action": "settings.get",
          "regex": "^(?:show|get|display|what is|what's|pokaż|pokaz|sprawdź|sprawdz|jaka jest|jakie jest)\\s+(?:the\\s+)?(?:setting\\s+|value of\\s+|ustawienie\\s+|wartość\\s+|wartosc\\s+)?([A-Za-z][A-Za-z0-9_]*)\\s*\\??$",
          "args": ["key"],
          "element_arg": "key",
          "requires_element": true
        }
      ],
      "references": [
        {"id": "conversation", "words": ["rozmow*", "konwersacj*", "czat*", "chat", "conversation", "thread", "dyskusj*", "wątek", "watek", "wątku", "watku"], "resolve": "current_conversation"},
        {"id": "message", "words": ["wiadomo*", "message", "odpowied*", "reply", "answer"], "resolve": "last_message"}
      ],
      "phrases": {
        "rephrase": {
          "en": ["rephrase", "reword", "rewrite", "paraphrase", "say it differently", "put it differently"],
          "pl": ["przeredaguj*", "przeformułuj*", "przeformuluj*", "sparafrazuj*", "napisz inaczej", "powiedz inaczej", "ujmij inaczej"]
        },
        "explain_simply": {
          "en": ["explain simply", "explain it simply", "explain this simply", "simplify", "eli5", "explain like", "make it simpler"],
          "pl": ["wytłumacz prościej", "wyjaśnij prościej", "wytlumacz prosciej", "wyjasnij prosciej", "uprość*", "uprosc*", "wytłumacz jak"]
        }
      },
      "rules": {
        "scopes": [
          {"scope": "conversation", "phrases": {
            "pl": ["w tej rozmowie", "w tym czacie", "w tym wątku", "dla tej rozmowy", "dla tego czatu", "dla tego wątku", "tylko tutaj", "tylko w tej rozmowie"],
            "en": ["in this conversation", "for this conversation", "in this chat", "for this chat", "in this thread", "for this thread", "only here", "only in this conversation"]}},
          {"scope": "person", "phrases": {
            "pl": ["dla mnie", "u mnie", "na stałe dla mnie", "osobiście"],
            "en": ["for me", "for myself", "personally", "on my account"]}},
          {"scope": "installation", "phrases": {
            "pl": ["w całej instalacji", "w tej instalacji", "dla wszystkich", "dla wszystkich rozmów", "wszędzie", "globalnie"],
            "en": ["in this installation", "in the whole installation", "for everyone", "for all conversations", "everywhere", "globally"]}}
        ],
        "commands": [
          {"id": "set_value.pl", "action": "rules.set", "effect": "set_value", "needs_scope": true, "lang": "pl",
           "regex": "^[\\s,]*(?:ustaw|zmien|przelacz)\\s+([a-z][a-z0-9_.]*)\\s*(?:=|na)\\s*(.+?)\\s*[.!]*\\s*$", "args": ["key", "value"], "original": ["value"]},
          {"id": "set_value.en", "action": "rules.set", "effect": "set_value", "needs_scope": true, "lang": "en",
           "regex": "^[\\s,]*(?:set|change|switch)\\s+(?:the\\s+)?(?:setting\\s+)?([a-z][a-z0-9_.]*)\\s*(?:=|to)\\s*(.+?)\\s*[.!]*\\s*$", "args": ["key", "value"], "original": ["value"]},
          {"id": "confirm.ask_before.pl", "action": "rules.set", "effect": "confirm", "lang": "pl",
           "regex": "^[\\s,]*(?:zawsze\\s+)?(?:pytaj|zapytaj)\\s+(?:mnie\\s+)?(?:przed|o)\\s+(?:uruchomieniem\\s+|wykonaniem\\s+)?([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$", "args": ["action"], "resolve": ["action"]},
          {"id": "confirm.never_without_asking.pl", "action": "rules.set", "effect": "confirm", "lang": "pl",
           "regex": "^[\\s,]*nigdy\\s+nie\\s+(?:uruchamiaj|wykonuj|odpalaj)\\s+([a-z][a-z0-9_.]*)\\s+bez\\s+pytania\\s*[.!]*\\s*$", "args": ["action"], "resolve": ["action"]},
          {"id": "confirm.never_without_asking.en", "action": "rules.set", "effect": "confirm", "lang": "en",
           "regex": "^[\\s,]*never\\s+(?:run|execute|start)\\s+([a-z][a-z0-9_.]*)\\s+without\\s+(?:asking|confirmation|confirming)\\s*[.!]*\\s*$", "args": ["action"], "resolve": ["action"]},
          {"id": "confirm.ask_before.en", "action": "rules.set", "effect": "confirm", "lang": "en",
           "regex": "^[\\s,]*(?:always\\s+)?ask\\s+(?:me\\s+)?before\\s+(?:running\\s+|executing\\s+)?([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$", "args": ["action"], "resolve": ["action"]},
          {"id": "deny.never.pl", "action": "rules.set", "effect": "deny", "lang": "pl",
           "regex": "^[\\s,]*(?:nigdy\\s+nie\\s+(?:uruchamiaj|wykonuj|odpalaj)|zabron\\w*|zablokuj)\\s+([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$", "args": ["action"], "resolve": ["action"]},
          {"id": "deny.never.en", "action": "rules.set", "effect": "deny", "lang": "en",
           "regex": "^[\\s,]*(?:never\\s+(?:run|execute|start)|forbid|ban|block)\\s+([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$", "args": ["action"], "resolve": ["action"]},
          {"id": "allow.pl", "action": "rules.set", "effect": "allow", "lang": "pl",
           "regex": "^[\\s,]*(?:(?:zawsze\\s+)?(?:pozwalaj|zezwalaj)\\s+na|nie\\s+pytaj\\s+(?:mnie\\s+)?(?:o|przed))\\s+([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$", "args": ["action"], "resolve": ["action"]},
          {"id": "allow.en", "action": "rules.set", "effect": "allow", "lang": "en",
           "regex": "^[\\s,]*(?:(?:always\\s+)?allow|(?:stop\\s+asking|don't\\s+ask|do\\s+not\\s+ask)\\s+(?:me\\s+)?(?:about|before))\\s+([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$", "args": ["action"], "resolve": ["action"]},
          {"id": "disable.pl", "action": "rules.disable", "lang": "pl",
           "regex": "^[\\s,]*(?:wylacz|usun|zdejmij)\\s+regule\\s+(\\S+?)\\s*[.!]*\\s*$", "args": ["id"], "original": ["id"]},
          {"id": "disable.en", "action": "rules.disable", "lang": "en",
           "regex": "^[\\s,]*(?:disable|remove|switch\\s+off|turn\\s+off)\\s+(?:the\\s+)?rule\\s+(\\S+?)\\s*[.!]*\\s*$", "args": ["id"], "original": ["id"]},
          {"id": "remove_action.pl", "action": "actions.remove", "lang": "pl",
           "regex": "^[\\s,]*(?:usun|wycofaj|cofnij)\\s+akcje\\s+([a-z0-9][a-z0-9_.-]*)\\s*[.!]*\\s*$", "args": ["id"]},
          {"id": "remove_action.en", "action": "actions.remove", "lang": "en",
           "regex": "^[\\s,]*(?:remove|delete|undo|take\\s+back)\\s+(?:the\\s+)?action\\s+([a-z0-9][a-z0-9_.-]*)\\s*[.!]*\\s*$", "args": ["id"]},
          {"id": "remove_group.pl", "action": "groups.remove", "lang": "pl",
           "regex": "^[\\s,]*(?:usun|wycofaj|cofnij)\\s+grupe\\s+([a-z0-9][a-z0-9_.-]*)\\s*[.!]*\\s*$", "args": ["id"]},
          {"id": "remove_group.en", "action": "groups.remove", "lang": "en",
           "regex": "^[\\s,]*(?:remove|delete|undo|take\\s+back)\\s+(?:the\\s+)?group\\s+([a-z0-9][a-z0-9_.-]*)\\s*[.!]*\\s*$", "args": ["id"]},
          {"id": "list.pl", "action": "rules.list", "lang": "pl",
           "regex": "^[\\s,]*(?:pokaz|wylistuj|wypisz)\\s+(?:moje\\s+|wszystkie\\s+)?(?:zasady|reguly)\\s*[.!?]*\\s*$", "args": []},
          {"id": "list.en", "action": "rules.list", "lang": "en",
           "regex": "^[\\s,]*(?:show|list)\\s+(?:me\\s+)?(?:my\\s+|all\\s+|the\\s+)?rules\\s*[.!?]*\\s*$", "args": []}
        ]
      },
      "languages": [
        {"code": "en", "label": {"en": "English", "pl": "angielski"}, "names": ["english", "angielsk*"]},
        {"code": "pl", "label": {"en": "Polish", "pl": "polski"}, "names": ["polish", "polsk*"]},
        {"code": "de", "label": {"en": "German", "pl": "niemiecki"}, "names": ["german", "deutsch", "niemieck*"]},
        {"code": "fr", "label": {"en": "French", "pl": "francuski"}, "names": ["french", "francais", "francusk*"]},
        {"code": "es", "label": {"en": "Spanish", "pl": "hiszpański"}, "names": ["spanish", "espanol", "hiszpansk*"]},
        {"code": "it", "label": {"en": "Italian", "pl": "włoski"}, "names": ["italian", "italiano", "wlosk*"]},
        {"code": "pt", "label": {"en": "Portuguese", "pl": "portugalski"}, "names": ["portuguese", "portugues", "portugalsk*"]},
        {"code": "ru", "label": {"en": "Russian", "pl": "rosyjski"}, "names": ["russian", "rosyjsk*"]},
        {"code": "uk", "label": {"en": "Ukrainian", "pl": "ukraiński"}, "names": ["ukrainian", "ukrainsk*"]},
        {"code": "cs", "label": {"en": "Czech", "pl": "czeski"}, "names": ["czech", "czesk*"]},
        {"code": "sk", "label": {"en": "Slovak", "pl": "słowacki"}, "names": ["slovak", "slowack*"]},
        {"code": "sl", "label": {"en": "Slovenian", "pl": "słoweński"}, "names": ["slovenian", "slowensk*"]},
        {"code": "hr", "label": {"en": "Croatian", "pl": "chorwacki"}, "names": ["croatian", "chorwack*"]},
        {"code": "bg", "label": {"en": "Bulgarian", "pl": "bułgarski"}, "names": ["bulgarian", "bulgarsk*"]},
        {"code": "nl", "label": {"en": "Dutch", "pl": "niderlandzki"}, "names": ["dutch", "nederlands", "niderlandzk*", "holendersk*"]},
        {"code": "sv", "label": {"en": "Swedish", "pl": "szwedzki"}, "names": ["swedish", "svenska", "szwedzk*"]},
        {"code": "no", "label": {"en": "Norwegian", "pl": "norweski"}, "names": ["norwegian", "norsk", "norwesk*"]},
        {"code": "da", "label": {"en": "Danish", "pl": "duński"}, "names": ["danish", "dansk", "dunsk*"]},
        {"code": "fi", "label": {"en": "Finnish", "pl": "fiński"}, "names": ["finnish", "suomi", "finsk*"]},
        {"code": "hu", "label": {"en": "Hungarian", "pl": "węgierski"}, "names": ["hungarian", "wegiersk*"]},
        {"code": "ro", "label": {"en": "Romanian", "pl": "rumuński"}, "names": ["romanian", "rumunsk*"]},
        {"code": "el", "label": {"en": "Greek", "pl": "grecki"}, "names": ["greek", "greck*"]},
        {"code": "lt", "label": {"en": "Lithuanian", "pl": "litewski"}, "names": ["lithuanian", "litewsk*"]},
        {"code": "lv", "label": {"en": "Latvian", "pl": "łotewski"}, "names": ["latvian", "lotewsk*"]},
        {"code": "et", "label": {"en": "Estonian", "pl": "estoński"}, "names": ["estonian", "estonsk*"]},
        {"code": "tr", "label": {"en": "Turkish", "pl": "turecki"}, "names": ["turkish", "turecki", "turecku", "turk*"]},
        {"code": "ja", "label": {"en": "Japanese", "pl": "japoński"}, "names": ["japanese", "japonsk*"]},
        {"code": "zh", "label": {"en": "Chinese", "pl": "chiński"}, "names": ["chinese", "chinsk*"]},
        {"code": "ko", "label": {"en": "Korean", "pl": "koreański"}, "names": ["korean", "koreansk*"]},
        {"code": "ar", "label": {"en": "Arabic", "pl": "arabski"}, "names": ["arabic", "arabsk*"]},
        {"code": "he", "label": {"en": "Hebrew", "pl": "hebrajski"}, "names": ["hebrew", "hebrajsk*"]},
        {"code": "hi", "label": {"en": "Hindi", "pl": "hindi"}, "names": ["hindi"]},
        {"code": "la", "label": {"en": "Latin", "pl": "łaciński"}, "names": ["latin", "lacin*"]}
      ],
      "arguments": [
        {"id": "target_language.pl", "param": "target_language", "lang": "pl", "kind": "language", "regex": "\\b(?:na|po|do)\\s+(?:jezyk\\w*\\s+)?(\\w+)"},
        {"id": "target_language.en", "param": "target_language", "lang": "en", "kind": "language", "regex": "\\b(?:into|to|in)\\s+(?:the\\s+)?(?:language\\s+)?(\\w+)"},
        {"id": "style.pl", "param": "style", "lang": "pl", "kind": "text", "regex": "\\bw\\s+stylu\\s+(.+?)\\s*[.!?]*\\s*$"},
        {"id": "style.pl.manner", "param": "style", "lang": "pl", "kind": "text", "regex": "\\bw\\s+manierze\\s+(.+?)\\s*[.!?]*\\s*$"},
        {"id": "style.en", "param": "style", "lang": "en", "kind": "text", "regex": "\\bin\\s+the\\s+style\\s+of\\s+(.+?)\\s*[.!?]*\\s*$"},
        {"id": "style.en.adjective", "param": "style", "lang": "en", "kind": "text", "regex": "\\bin\\s+(?:an?\\s+)?(\\w+)\\s+style\\b"},
        {"id": "tone.pl.adjective", "param": "tone", "lang": "pl", "kind": "text", "regex": "\\bw\\s+(\\w+)\\s+tonie\\b"},
        {"id": "tone.pl", "param": "tone", "lang": "pl", "kind": "text", "regex": "\\bw\\s+tonie\\s+(.+?)\\s*[.!?]*\\s*$"},
        {"id": "tone.en", "param": "tone", "lang": "en", "kind": "text", "regex": "\\bin\\s+(?:an?\\s+|the\\s+)?(\\w+)\\s+tone\\b"},
        {"id": "level.pl", "param": "level", "lang": "pl", "kind": "text", "regex": "\\bna\\s+poziomie\\s+(.+?)\\s*[.!?]*\\s*$"},
        {"id": "level.en", "param": "level", "lang": "en", "kind": "text", "regex": "\\bat\\s+(?:an?\\s+|the\\s+)?(\\w+(?:\\s+\\w+)?)\\s+level\\b"},
        {"id": "audience.pl", "param": "audience", "lang": "pl", "kind": "text", "regex": "\\b(?:jak\\s+)?dla\\s+(.+?)\\s*[.!?]*\\s*$"},
        {"id": "audience.en.like", "param": "audience", "lang": "en", "kind": "text", "regex": "\\b(like\\s+i(?:'|\u2019)?m\\s+\\w+)\\s*[.!?]*\\s*$"},
        {"id": "audience.en", "param": "audience", "lang": "en", "kind": "text", "regex": "\\bfor\\s+(?:an?\\s+|the\\s+)?(.+?)\\s*[.!?]*\\s*$"},
        {"id": "size.pl.by", "param": "size", "lang": "pl", "kind": "text", "template": "{1}x{2}", "regex": "\\b(?:w\\s+rozmiarze|rozmiar(?:u|em)?)\\s+(\\d{2,5})\\s*[x\u00d7]\\s*(\\d{2,5})"},
        {"id": "size.pl", "param": "size", "lang": "pl", "kind": "text", "template": "{1}x{1}", "regex": "\\b(?:w\\s+rozmiarze|rozmiar(?:u|em)?)\\s+(\\d{2,5})\\b"},
        {"id": "size.en.by", "param": "size", "lang": "en", "kind": "text", "template": "{1}x{2}", "regex": "\\b(?:size|sized|at)\\s+(\\d{2,5})\\s*[x\u00d7]\\s*(\\d{2,5})"},
        {"id": "size.en", "param": "size", "lang": "en", "kind": "text", "template": "{1}x{1}", "regex": "\\b(?:size|sized|at)\\s+(\\d{2,5})\\b"}
      ]
    },
    "confirmation": {
      "yes": {
        "en": ["yes", "y", "yep", "yeah", "ok", "okay", "sure", "confirm", "confirmed", "go ahead", "do it", "proceed", "run it"],
        "pl": ["tak", "t", "ok", "okej", "dobrze", "jasne", "potwierdzam", "potwierdź", "potwierdz", "zrób to", "zrob to", "działaj", "dzialaj", "dalej", "wykonaj"]
      },
      "no": {
        "en": ["no", "n", "nope", "cancel", "stop", "never mind", "nevermind", "drop it", "don't", "do not"],
        "pl": ["nie", "anuluj", "odrzuć", "odrzuc", "odrzucam", "zostaw", "zostaw to", "nie rób tego", "nie rob tego", "stop"]
      }
    },
    "model": {
      "system": "You decide whether a user's input to a chat application is an ordinary message for the language model, or a command to the application itself (run one of its actions on something). Answer with one JSON object only: {\"kind\": \"message\" | \"command\", \"action\": <action id or null>, \"reference\": <\"conversation\" | \"message\" | an id such as m_... c_... | a settings key | null>, \"args\": {<argument name>: <value>}, \"confidence\": <0..1>}. A command names something the application can do to an existing element (for example summarise this conversation, set a setting). Questions, requests for the model to write or explain, and anything unclear are messages. Use only action ids from the list.",
      "catalogue_line": "- {{id}}: {{title}} (needs: {{requires}})",
      "user": "Actions:\n{{actions}}\n\nInput:\n{{text}}",
      "parameters": {"temperature": 0, "max_tokens": 300},
      "title": "ChatADHD-Route",
      "timeout_ms": 30000,
      "min_confidence": 0.5
    },
    "texts": {
      "en": {
        "proposal_title": "I read this as a command: {{title}}.",
        "proposal_element": "On: {{element}}.",
        "proposal_plan": "It will run: {{plan}}.",
        "proposal_cost": "Estimate: {{cost}} (relative cost, 1 = one ordinary model call), {{calls}} model call(s), about {{bytes}} bytes sent to the model.",
        "proposal_money_known": "Money: about {{low}} to {{high}} {{currency}}, from the size of the input and the model's listed price (an estimate, not a limit).",
        "proposal_money_unknown": "Money: unknown ({{why}}); do not read it as free.",
        "missing_args_settings": " (or set: {{settings}})",
        "proposal_effects": "It {{effects}}.",
        "proposal_confirm": "The rules ask you to confirm: {{what}}.",
        "proposal_ask": "Reply \"yes\" to run it or \"no\" to drop it.",
        "proposal_not_runnable": "I cannot run this yet: {{why}}.",
        "proposal_denied": "The rules do not allow this: {{reason}}{{initiator}}.",
        "proposal_unfit": "This does not fit that element: it needs {{missing}}.",
        "proposal_missing_args": "I still need: {{args}}. Say it as /{{action}} with {{args}} filled in, or ask in other words.",
        "proposal_args": "Arguments I read from your words: {{args}}.",
        "proposal_args_open": "Not given (the defaults apply): {{params}}.",
        "proposal_refused": "This is refused: {{reason}}{{initiator}}.",
        "proposal_note": "Note: {{note}}.",
        "rule_note_consumer": "nothing reads this value per scope yet, so it will not change anything until a part of the application does",
        "rule_replaces": "It replaces the rule you set before for the same thing.",
        "define_title": "I do not know the command \"{{verb}}\". Shall I define it as a new action?",
        "define_what": "Name: {{id}}. It sends the text of the element to the model with your own instruction: \"{{instruction}}\". It works on elements that have: {{requires}}.",
        "define_then": "Then it runs on {{element}}.",
        "define_where": "It is written to your own overlay ({{overlay}}), not to the shipped data; \"remove action {{id}}\" takes it back.",
        "define_ask": "Reply \"yes\" to define it, or \"no\" to drop it.",
        "sequence_title": "You have run {{sequence}} on {{class}} {{count}} times in a row. Shall I save it as one action \"{{id}}\"?",
        "sequence_what": "It runs {{steps}} one after another, the result of each feeding the next.",
        "group_title": "\"{{action}}\" has been used on {{classes}}, which share: {{traits}}. Shall I define a group \"{{id}}\" for what they have in common?",
        "group_what": "A group is a named bundle of traits that rules and actions can refer to. It is written to your own overlay ({{overlay}}); \"remove group {{id}}\" takes it back.",
        "defined_group_label": "What \"{{action}}\" works on",
        "defined_done": "Defined the action \"{{id}}\" in your own overlay ({{overlay}}). Take it back with: remove action {{id}}.",
        "defined_group_done": "Defined the group \"{{id}}\" in your own overlay ({{overlay}}). Take it back with: remove group {{id}}.",
        "removed_done": "Removed \"{{id}}\" from your own overlay.",
        "proposal_error": "I could not plan this: {{message}}",
        "proposal_chain": "It would need a chain: {{chain}}.",
        "proposal_alternatives": "Other readings: {{alternatives}}.",
        "initiator_by": " (set by {{who}})",
        "effect_reads": "only reads",
        "effect_writes": "changes data",
        "effect_sends": "sends data off this device",
        "effect_money": "costs money",
        "effect_irreversible": "cannot be undone",
        "effect_private": "touches private data",
        "effect_none": "has no side effects",
        "no_element": "this conversation",
        "group_label": "{{count}} elements",
        "result_completed": "Done: {{title}}.",
        "result_failed": "It failed at {{step}}: {{message}}",
        "result_denied": "The rules do not allow it: {{message}}",
        "result_rejected": "Dropped. Nothing was executed.",
        "result_cancelled": "Cancelled.",
        "result_waiting": "It is waiting for your answer: {{kind}}.",
        "result_usage": "The model call is held by the usage guard: its expected usage is far above your recent baseline. Nothing was sent. Confirm it here or in the usage prompt.",
        "result_no_text": "It produced no text.",
        "ack_no": "Dropped. Nothing was executed.",
        "route_failed": "Routing with the model failed ({{message}}); the local method decided instead."
      },
      "pl": {
        "proposal_title": "Rozumiem to jako polecenie: {{title}}.",
        "proposal_element": "Na: {{element}}.",
        "proposal_plan": "Wykonam: {{plan}}.",
        "proposal_cost": "Szacunek: {{cost}} (koszt względny, 1 = jedno zwykłe wywołanie modelu), wywołań modelu: {{calls}}, do modelu pójdzie ok. {{bytes}} bajtów.",
        "proposal_money_known": "Pieniądze: ok. {{low}} do {{high}} {{currency}}, z rozmiaru wejścia i ceny modelu z cennika (szacunek, nie limit).",
        "proposal_money_unknown": "Pieniądze: nieznane ({{why}}); nie czytaj tego jako za darmo.",
        "missing_args_settings": " (albo ustaw: {{settings}})",
        "proposal_effects": "To {{effects}}.",
        "proposal_confirm": "Zasady każą Cię zapytać o potwierdzenie: {{what}}.",
        "proposal_ask": "Odpowiedz „tak”, żeby wykonać, albo „nie”, żeby odrzucić.",
        "proposal_not_runnable": "Nie mogę tego jeszcze wykonać: {{why}}.",
        "proposal_denied": "Zasady na to nie pozwalają: {{reason}}{{initiator}}.",
        "proposal_unfit": "To nie pasuje do tego elementu: potrzebuje {{missing}}.",
        "proposal_missing_args": "Brakuje jeszcze: {{args}}. Podaj to jako /{{action}} z uzupełnionymi wartościami albo powiedz inaczej.",
        "proposal_args": "Argumenty odczytane z Twoich słów: {{args}}.",
        "proposal_args_open": "Niepodane (obowiązują wartości domyślne): {{params}}.",
        "proposal_refused": "To jest odrzucone: {{reason}}{{initiator}}.",
        "proposal_note": "Uwaga: {{note}}.",
        "rule_note_consumer": "żadna część aplikacji nie czyta jeszcze tej wartości per zakres, więc nic się nie zmieni, dopóki któraś jej nie zacznie czytać",
        "rule_replaces": "Zastępuje regułę, którą ustawiłeś wcześniej w tej samej sprawie.",
        "define_title": "Nie znam polecenia „{{verb}}”. Zdefiniować je jako nową akcję?",
        "define_what": "Nazwa: {{id}}. Wysyła tekst elementu do modelu z Twoim własnym poleceniem: „{{instruction}}”. Działa na elementach, które mają: {{requires}}.",
        "define_then": "Potem wykonuje się na: {{element}}.",
        "define_where": "Zapisuje się w Twojej własnej nakładce ({{overlay}}), nie w danych dostarczonych z aplikacją; „usuń akcję {{id}}” to cofa.",
        "define_ask": "Odpowiedz „tak”, żeby zdefiniować, albo „nie”, żeby odrzucić.",
        "sequence_title": "Wykonałeś {{sequence}} na: {{class}} {{count}} razy z rzędu. Zapisać to jako jedną akcję „{{id}}”?",
        "sequence_what": "Wykonuje {{steps}} jedno po drugim, wynik każdego idzie do następnego.",
        "group_title": "„{{action}}” użyto na: {{classes}}, a te mają wspólne: {{traits}}. Zdefiniować grupę „{{id}}” dla tego, co mają wspólnego?",
        "group_what": "Grupa to nazwany zestaw cech, do którego mogą się odwoływać reguły i akcje. Zapisuje się w Twojej własnej nakładce ({{overlay}}); „usuń grupę {{id}}” to cofa.",
        "defined_group_label": "Na czym działa „{{action}}”",
        "defined_done": "Zdefiniowano akcję „{{id}}” w Twojej własnej nakładce ({{overlay}}). Cofniesz to poleceniem: usuń akcję {{id}}.",
        "defined_group_done": "Zdefiniowano grupę „{{id}}” w Twojej własnej nakładce ({{overlay}}). Cofniesz to poleceniem: usuń grupę {{id}}.",
        "removed_done": "Usunięto „{{id}}” z Twojej własnej nakładki.",
        "proposal_error": "Nie udało się tego zaplanować: {{message}}",
        "proposal_chain": "Potrzebny byłby łańcuch: {{chain}}.",
        "proposal_alternatives": "Inne odczytania: {{alternatives}}.",
        "initiator_by": " (ustawił: {{who}})",
        "effect_reads": "tylko czyta",
        "effect_writes": "zmienia dane",
        "effect_sends": "wysyła dane poza to urządzenie",
        "effect_money": "kosztuje pieniądze",
        "effect_irreversible": "jest nieodwracalne",
        "effect_private": "dotyka danych prywatnych",
        "effect_none": "nie ma skutków ubocznych",
        "no_element": "tej rozmowie",
        "group_label": "elementy: {{count}}",
        "result_completed": "Gotowe: {{title}}.",
        "result_failed": "Nie udało się w kroku {{step}}: {{message}}",
        "result_denied": "Zasady na to nie pozwalają: {{message}}",
        "result_rejected": "Odrzucone. Nic nie wykonano.",
        "result_cancelled": "Anulowano.",
        "result_waiting": "Czeka na Twoją odpowiedź: {{kind}}.",
        "result_usage": "Wywołanie modelu wstrzymał strażnik zużycia: przewidywane zużycie jest dużo wyższe niż ostatnia wartość bazowa. Nic nie wysłano. Potwierdź tutaj albo w oknie zużycia.",
        "result_no_text": "Nie powstał żaden tekst.",
        "ack_no": "Odrzucone. Nic nie wykonano.",
        "route_failed": "Rozpoznanie przez model się nie udało ({{message}}); zdecydowała metoda lokalna."
      }
    }
  },
  "value_schema": {
    "type": "object",
    "required": ["method", "execution", "emergent", "default_language", "message_request_fields", "heuristic", "confirmation", "model", "texts"],
    "properties": {
      "method": {
        "type": "object",
        "required": ["setting", "active", "presets"],
        "properties": {
          "setting": {"type": "string", "minLength": 1},
          "active": {"type": "string", "minLength": 1},
          "presets": {"type": "object", "additionalProperties": {"type": "object"}},
          "model_setting": {"type": "string"},
          "model_fallback_setting": {"type": "string"}
        },
        "additionalProperties": false
      },
      "execution": {
        "type": "object",
        "required": ["setting", "active", "presets"],
        "properties": {
          "setting": {"type": "string", "minLength": 1},
          "active": {"type": "string", "minLength": 1},
          "presets": {"type": "object", "additionalProperties": {"type": "object"}}
        },
        "additionalProperties": false
      },
      "emergent": {
        "type": "object",
        "description": "The catalogue grows from conversations (R55), always as proposals and never silently. `setting`/`active`/`presets`: off | propose. command_shape: an input that matches no action but has the shape of a command (a verb-like lead word, an element, no question) is offered as the definition of a new action (a composite with one use_model step whose prompt is the user's own instruction; requires inferred from the element's traits among requires_from; the phrase joins the lexicon). sequences: the same chain of actions, each run on the result of the one before, on elements of one class `repeat` times in a row (consecutive within gap_seconds, at most max_length long, read from the last window_runs runs) is offered as one composite. groups: a user-defined action used on min_classes classes that share traits is offered a group (named trait bundle) of what they share. Accepting writes only user overlays; every proposal leaves a node of `node.kind` with links `node.link` to the messages it emerged from.",
        "required": ["setting", "active", "presets", "command_shape", "naming", "requires_from", "definition", "sequences", "groups", "node"],
        "properties": {
          "setting": {"type": "string", "minLength": 1},
          "active": {"type": "string", "minLength": 1},
          "presets": {"type": "object", "additionalProperties": {"type": "object"}},
          "command_shape": {"type": "object", "required": ["max_tokens", "min_lead_chars", "lead_skip", "not_leads", "forbid_question_mark"], "properties": {
            "max_tokens": {"type": "integer", "minimum": 1}, "min_lead_chars": {"type": "integer", "minimum": 1},
            "lead_skip": {"type": "array", "items": {"type": "string"}}, "not_leads": {"type": "array", "items": {"type": "string"}},
            "forbid_question_mark": {"type": "boolean"}}, "additionalProperties": false},
          "naming": {"type": "object", "required": ["prefix", "max_chars"], "properties": {"prefix": {"type": "string"}, "max_chars": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
          "requires_from": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "definition": {"type": "object", "required": ["system", "parameters", "cost", "confidence"], "properties": {
            "system": {"type": "object", "additionalProperties": {"type": "string"}}, "parameters": {"type": "object"},
            "cost": {"type": "number", "minimum": 0}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false},
          "sequences": {"type": "object", "required": ["repeat", "max_length", "gap_seconds", "window_runs", "joiner"], "properties": {
            "repeat": {"type": "integer", "minimum": 1}, "max_length": {"type": "integer", "minimum": 2}, "gap_seconds": {"type": "integer", "minimum": 0},
            "window_runs": {"type": "integer", "minimum": 1}, "joiner": {"type": "string", "minLength": 1}}, "additionalProperties": false},
          "groups": {"type": "object", "required": ["min_classes", "suffix"], "properties": {"min_classes": {"type": "integer", "minimum": 2}, "suffix": {"type": "string"}}, "additionalProperties": false},
          "node": {"type": "object", "required": ["kind", "link"], "properties": {"kind": {"type": "string", "minLength": 1}, "link": {"type": "string", "minLength": 1}}, "additionalProperties": false}
        },
        "additionalProperties": false
      },
      "default_language": {"type": "string", "minLength": 1},
      "message_request_fields": {"type": "array", "items": {"type": "string"}, "description": "A chat request that carries one of these (non-empty) is an explicit chat feature: it is a message and never routed."},
      "heuristic": {
        "type": "object",
        "required": ["fold", "language_hints", "window_tokens", "lead_tokens", "scoring", "explicit", "patterns", "references"],
        "properties": {
          "fold": {"type": "object", "additionalProperties": {"type": "string"}},
          "language_hints": {"type": "object", "description": "Words (folded) that tell the language of an input that has no distinguishing letters; the language of a matched phrase wins over them.", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
          "window_tokens": {"type": "integer", "minimum": 1},
          "lead_tokens": {"type": "integer", "minimum": 1},
          "scoring": {
            "type": "object",
            "required": ["base", "per_word", "lead_penalty", "min_score"],
            "properties": {
              "base": {"type": "number"}, "per_word": {"type": "number"}, "lead_penalty": {"type": "number"}, "min_score": {"type": "number"}
            },
            "additionalProperties": false
          },
          "explicit": {
            "type": "object",
            "required": ["prefixes", "run_verbs", "aliases", "arg_pattern", "element_markers", "default_element"],
            "properties": {
              "prefixes": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "run_verbs": {"type": "array", "items": {"type": "string"}},
              "aliases": {"type": "object", "additionalProperties": {"type": "string"}},
              "arg_pattern": {"type": "string", "minLength": 1},
              "element_markers": {"type": "array", "items": {"type": "string"}},
              "default_element": {"type": "string", "enum": ["current_conversation", "last_message", ""]}
            },
            "additionalProperties": false
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "action", "regex", "args"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "action": {"type": "string", "minLength": 1},
                "regex": {"type": "string", "minLength": 1},
                "args": {"type": "array", "items": {"type": "string"}},
                "element_arg": {"type": "string"},
                "requires_element": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "words", "resolve"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "words": {"type": "array", "items": {"type": "string"}},
                "resolve": {"type": "string", "enum": ["current_conversation", "last_message"]}
              },
              "additionalProperties": false
            }
          },
          "rules": {
            "type": "object",
            "description": "Scoped settings and rules from what is said (R54): \"w tej rozmowie ustaw X=Y\", \"dla mnie zawsze pytaj przed depict\", \"for this conversation never run depict without asking\". `scopes`: the phrases that name a level of the scope chain (cut out of the text before the commands are read; none named = the default scope of the action_rules profile). `commands`: regexes matched against the folded text with the scope phrase blanked out; group order = `args`; `original` args are read from the text as typed, `resolve` args are action words turned into catalogue ids (an unknown word makes the input a message, nothing is guessed); `needs_scope`: only when a scope phrase was said (without it the plain settings patterns apply). The result is a proposal to run rules.set / rules.disable / rules.list.",
            "required": ["scopes", "commands"],
            "properties": {
              "scopes": {"type": "array", "items": {"type": "object", "required": ["scope", "phrases"], "properties": {"scope": {"type": "string", "minLength": 1}, "phrases": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}}}, "additionalProperties": false}},
              "commands": {"type": "array", "items": {"type": "object", "required": ["id", "action", "regex", "args"], "properties": {
                "id": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}, "effect": {"type": "string"}, "lang": {"type": "string"},
                "needs_scope": {"type": "boolean"}, "regex": {"type": "string", "minLength": 1},
                "args": {"type": "array", "items": {"type": "string"}}, "original": {"type": "array", "items": {"type": "string"}}, "resolve": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}
            },
            "additionalProperties": false
          },
          "phrases": {
            "type": "object",
            "description": "The lexicon of commands next to the `phrases` of the catalogue's own actions: action id -> language -> phrases (a word ending in * is a prefix). Phrases the user's own conversations add live here (overlay profiles/intent_routing.pack); an action's own `phrases` stay where they are.",
            "additionalProperties": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}}
          },
          "languages": {
            "type": "array",
            "description": "Names of languages as people say them (folded, lower case; a trailing * is a prefix): what a phrase such as \"na niemiecki\" or \"into German\" may name. The value given to an action is label.en. An unknown name is never guessed.",
            "items": {
              "type": "object",
              "required": ["code", "label", "names"],
              "properties": {
                "code": {"type": "string", "minLength": 1},
                "label": {"type": "object", "additionalProperties": {"type": "string"}},
                "names": {"type": "array", "items": {"type": "string", "minLength": 1}}
              },
              "additionalProperties": false
            }
          },
          "arguments": {
            "type": "array",
            "description": "Arguments from loose phrases. Each pattern fills the declared parameter `param` of the chosen action (an action that does not declare it is not touched; an argument already given is never overwritten). `regex` is matched against the folded, lower-cased text (Polish letters without diacritics); group 1 (and 2 ...) is read from the original text, so the user's own words are kept. kind text: the captured words, or `template` ({1}, {2} = groups); kind language: the captured word must be one of `languages`, else nothing is extracted. First match per parameter wins; patterns of the language of the input come first.",
            "items": {
              "type": "object",
              "required": ["id", "param", "kind", "regex"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "param": {"type": "string", "minLength": 1},
                "lang": {"type": "string"},
                "kind": {"type": "string", "enum": ["text", "language"]},
                "regex": {"type": "string", "minLength": 1},
                "template": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "confirmation": {
        "type": "object",
        "required": ["yes", "no"],
        "properties": {
          "yes": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
          "no": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
        },
        "additionalProperties": false
      },
      "model": {
        "type": "object",
        "required": ["system", "catalogue_line", "user", "parameters", "title", "timeout_ms", "min_confidence"],
        "properties": {
          "system": {"type": "string"},
          "catalogue_line": {"type": "string"},
          "user": {"type": "string"},
          "parameters": {"type": "object"},
          "title": {"type": "string"},
          "timeout_ms": {"type": "integer", "minimum": 1},
          "min_confidence": {"type": "number"}
        },
        "additionalProperties": false
      },
      "texts": {"type": "object", "description": "Per language: the sentences of proposals and results ({{name}} placeholders).", "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}}
    },
    "additionalProperties": false
  }
}
