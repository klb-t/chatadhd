          },
          {
            "id": "deeper",
            "key": "context.depth_delta",
            "step": "deeper",
            "phrases": {
              "pl": [
                "głębiej",
                "głębiej o jeden",
                "weź głębszy kontekst",
                "sięgnij głębiej",
                "głębszy kontekst"
              ],
              "en": [
                "deeper",
