              "id"
            ]
          },
          {
            "id": "remove_group.en",
            "action": "groups.remove",
            "lang": "en",
            "regex": "^[\\s,]*(?:remove|delete|undo|take\\s+back)\\s+(?:the\\s+)?group\\s+([a-z0-9][a-z0-9_.-]*)\\s*[.!]*\\s*$",
            "args": [
              "id"
            ]
          },
          {
            "id": "list.pl",
            "action": "rules.list",
            "lang": "pl",
            "regex": "^[\\s,]*(?:pokaz|wylistuj|wypisz)\\s+(?:moje\\s+|wszystkie\\s+)?(?:zasady|reguly)\\s*[.!?]*\\s*$",
            "args": []
