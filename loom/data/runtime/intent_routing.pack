    },
    "model": {
      "system": "You route one input of a chat application; the input may be in any language (often Polish). Decide: an ordinary message for the language model, or a command to the application itself (run one of its actions on something that already exists). Answer with one JSON object only: {\"kind\": \"message\" | \"command\" | \"define\", \"action\": <action id or null>, \"reference\": <\"conversation\" | \"message\" | an id such as m_... c_... | a settings key | null>, \"args\": {<argument name>: <value>}, \"confidence\": <0..1>}. A command asks the application to act on the conversation, a message or a setting (summarise, translate, explain simply, rephrase, set, show, ...); when you name an action, kind is \"command\". Questions, requests to write or explain something new, and anything unclear are messages with action null. Use only action ids from the list, and only an action that really does what is asked. When the input is a command to the application but NO action in the list fits it, do not pick the nearest one: answer {\"kind\": \"define\", \"action\": null, \"confidence\": <0..1>} (the application then offers the user a new action).\nExamples (input -> kind, action, reference):\n{{examples}}",
      "trace_raw_chars": 4000,
      "local_recheck": true,
      "skip_when_rule_command": true,
      "catalogue_line": "- {{id}}: {{title}} (needs: {{requires}})",
      "catalogue_line_free": "- {{id}}: {{title}}",
      "named_action_min_confidence": 0.8,
      "define_answer": "define",
      "verb_guard": {
        "enabled": true
      },
      "catalogue_retrieval": {
        "top_k": 20,
        "stem_chars": 5,
        "chars_per_token": 3.9,
        "always": [
          "summarise",
          "translate",
          "explain_simply",
          "rephrase"
        ],
        "text_fields": [
          "id",
          "title",
          "description",
          "phrases"
        ]
      },
      "examples": {
        "enabled": true,
        "max": 8,
        "line": "\"{{text}}\" -> {{answer}}",
        "command_answer": "command",
        "message_answer": "message",
        "phrase_reference": "message",
        "phrase_actions": [
          "explain_simply",
          "rephrase"
        ],
        "fixed": {
          "pl": [
            {
              "text": "Streść tę rozmowę",
              "action": "summarise",
              "reference": "conversation"
            },
            {
              "text": "Przetłumacz tę wiadomość na angielski",
              "action": "translate",
              "reference": "message"
            },
            {
              "text": "Rozpisz to na kroki",
              "answer": "define"
            },
            {
              "text": "Napisz wiersz o kocie"
            },
            {
              "text": "Co to jest DNS?"
            }
          ],
          "en": [
            {
              "text": "Summarise this conversation",
              "action": "summarise",
              "reference": "conversation"
            },
            {
              "text": "Translate this message into German",
              "action": "translate",
              "reference": "message"
            },
            {
              "text": "Break this into steps",
              "answer": "define"
            },
            {
              "text": "Write a poem about a cat"
            },
            {
              "text": "What is DNS?"
            }
          ]
        }
      },
      "user": "Actions:\n{{actions}}\n\nInput:\n{{text}}",
      "parameters": {
        "temperature": 0,
        "max_tokens": 300
      },
      "title": "ChatADHD-Route",
      "timeout_ms": 30000,
      "min_confidence": 0.5
    },
    "texts": {
      "en": {
        "proposal_title": "I read this as a command: {{title}}.",
        "proposal_element": "On: {{element}}.",
        "proposal_plan": "It will run: {{plan}}.",
        "proposal_cost": "Estimate: {{cost}} (relative cost, 1 = one ordinary model call), {{calls}} model call(s), about {{bytes}} bytes sent to the model.",
        "proposal_money_known": "Money: about {{low}} to {{high}} {{currency}}, from the size of the input and the model's listed price (an estimate, not a limit).",
        "proposal_money_unknown": "Money: unknown ({{why}}); do not read it as free.",
        "proposal_routing_spent": "Already spent reading your sentence (routing call, {{model}}, {{tokens}} tokens): {{usd}} USD; it is not in the estimate above.",
        "proposal_routing_unknown": "Already spent reading your sentence (routing call, {{model}}, {{tokens}} tokens): the cost is not known; it is not in the estimate above.",
