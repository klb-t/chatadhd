      "naming": {
        "prefix": "",
        "max_chars": 24
      },
      "requires_from": [
        "has_text",
        "has_image",
        "has_audio",
        "has_video",
        "has_code",
        "has_table"
      ],
      "definition": {
        "system": {
          "en": "You carry out an instruction about the text that follows it. Do what the instruction says, faithfully and completely; add nothing it does not ask for. Answer in the language of the instruction unless it asks for another.",
          "pl": "Wykonujesz polecenie dotyczące poniższego tekstu. Zrób dokładnie to, co polecenie mówi, wiernie i w całości; nie dodawaj niczego, o co nie prosi. Odpowiadaj w języku polecenia, chyba że prosi o inny."
        },
        "parameters": {
          "temperature": 0.5
        },
        "cost": 1.0,
        "confidence": 0.6
      },
      "sequences": {
        "repeat": 3,
        "max_length": 3,
        "gap_seconds": 900,
        "window_runs": 200,
        "joiner": "_then_",
        "index": {
          "convs": 64,
          "snapshot_every": 100,
          "sources": 16
        }
      },
      "groups": {
        "min_classes": 2,
        "suffix": "_targets"
      },
      "node": {
        "kind": "proposal",
        "link": "derived_from"
      }
    },
    "default_language": "en",
    "message_request_fields": [
      "attachments",
      "usage_confirmation",
      "active_task_spec",
      "knowledge_context",
      "web_search",
      "deep_research"
