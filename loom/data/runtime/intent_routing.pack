      "context_modifiers": {
        "status": {
          "state": "implemented",
          "by": "M1-K1b",
          "today": {
            "pl": "Router czyta tę tabelę: całe zdanie „szerzej”, „węziej”, „głębiej”, „płycej” albo „profil selektora …” zmienia tylko następną wiadomość (akcja context.modify, bez zapisu reguły); „co wysłaliśmy” pokazuje ślad ostatniego żądania (akcja context.receipt). Zdanie z „na stałe” albo z zakresem („w tej rozmowie”) zapisuje regułę (rules.set).",
            "en": "The router reads this table: the whole sentence “wider”, “narrower”, “deeper”, “shallower” or “selector profile …” changes the next message only (the action context.modify, no rule is written); “what we sent” shows the record of the last request (the action context.receipt). A sentence with “permanently” or a scope (“in this conversation”) writes a rule (rules.set)."
          }
        },
        "note": {
          "pl": "Frazy to całe zdania (krótkie polecenia), nie słowa w środku wiadomości: „opisz to szerzej” zostaje wiadomością. Zmiana dotyczy następnej tury, chyba że powiesz „na stałe w tej rozmowie”. Kroki (×2, ÷2, +1, −1) są w action_rules.pack, scoped_values.",
          "en": "The phrases are whole sentences (short commands), not words inside a message: “describe it wider” stays a message. The change applies to the next turn unless you say “permanently in this conversation”. The steps (×2, ÷2, +1, −1) are in action_rules.pack, scoped_values."
        },
        "permanent": {
          "default_scope": "conversation",
          "words": {
            "pl": [
              "na stałe",
              "na zawsze"
            ],
            "en": [
              "permanently",
              "for good",
              "from now on"
            ]
          }
        },
        "modifiers": [
          {
            "id": "wider",
            "key": "context.breadth_delta",
            "step": "wider",
            "phrases": {
              "pl": [
                "szerzej",
                "weź szerszy kontekst",
                "szerszy kontekst",
                "więcej kontekstu",
                "poszerz kontekst",
                "weź więcej kontekstu"
              ],
              "en": [
