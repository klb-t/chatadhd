          ]
        }
      },
      "rules": {
        "scopes": [
          {
            "scope": "conversation",
            "phrases": {
              "pl": [
                "w tej rozmowie",
                "w tym czacie",
                "w tym wątku",
                "dla tej rozmowy",
                "dla tego czatu",
                "dla tego wątku",
                "tylko tutaj",
                "tylko w tej rozmowie"
              ],
              "en": [
                "in this conversation",
                "for this conversation",
                "in this chat",
                "for this chat",
                "in this thread",
                "for this thread",
                "only here",
                "only in this conversation"
              ]
            }
          },
          {
            "scope": "person",
            "phrases": {
              "pl": [
                "dla mnie",
                "u mnie",
                "na stałe dla mnie",
                "osobiście"
              ],
              "en": [
                "for me",
                "for myself",
                "personally",
                "on my account"
              ]
            }
          },
          {
            "scope": "installation",
            "phrases": {
              "pl": [
                "w całej instalacji",
                "w tej instalacji",
                "dla wszystkich",
                "dla wszystkich rozmów",
                "wszędzie",
                "globalnie"
              ],
              "en": [
                "in this installation",
                "in the whole installation",
                "for everyone",
                "for all conversations",
                "everywhere",
                "globally"
              ]
            }
          }
        ],
        "commands": [
          {
            "id": "set_value.pl",
            "action": "rules.set",
            "effect": "set_value",
            "needs_scope": true,
            "lang": "pl",
            "regex": "^[\\s,]*(?:ustaw|zmien|przelacz)\\s+([a-z][a-z0-9_.]*)\\s*(?:=|na)\\s*(.+?)\\s*[.!]*\\s*$",
            "args": [
              "key",
              "value"
            ],
            "original": [
              "value"
            ]
          },
          {
            "id": "set_value.en",
            "action": "rules.set",
            "effect": "set_value",
            "needs_scope": true,
            "lang": "en",
            "regex": "^[\\s,]*(?:set|change|switch)\\s+(?:the\\s+)?(?:setting\\s+)?([a-z][a-z0-9_.]*)\\s*(?:=|to)\\s*(.+?)\\s*[.!]*\\s*$",
            "args": [
              "key",
              "value"
            ],
            "original": [
              "value"
            ]
          },
          {
            "id": "confirm.ask_before.pl",
            "action": "rules.set",
            "effect": "confirm",
            "lang": "pl",
            "regex": "^[\\s,]*(?:zawsze\\s+)?(?:pytaj|zapytaj)\\s+(?:mnie\\s+)?(?:przed|o)\\s+(?:uruchomieniem\\s+|wykonaniem\\s+)?([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$",
            "args": [
              "action"
            ],
            "resolve": [
              "action"
            ]
          },
          {
            "id": "confirm.never_without_asking.pl",
            "action": "rules.set",
            "effect": "confirm",
            "lang": "pl",
            "regex": "^[\\s,]*nigdy\\s+nie\\s+(?:uruchamiaj|wykonuj|odpalaj)\\s+([a-z][a-z0-9_.]*)\\s+bez\\s+pytania\\s*[.!]*\\s*$",
            "args": [
              "action"
            ],
            "resolve": [
              "action"
            ]
          },
          {
            "id": "confirm.never_without_asking.en",
            "action": "rules.set",
            "effect": "confirm",
            "lang": "en",
            "regex": "^[\\s,]*never\\s+(?:run|execute|start)\\s+([a-z][a-z0-9_.]*)\\s+without\\s+(?:asking|confirmation|confirming)\\s*[.!]*\\s*$",
            "args": [
              "action"
            ],
            "resolve": [
              "action"
            ]
          },
          {
            "id": "confirm.ask_before.en",
            "action": "rules.set",
            "effect": "confirm",
            "lang": "en",
            "regex": "^[\\s,]*(?:always\\s+)?ask\\s+(?:me\\s+)?before\\s+(?:running\\s+|executing\\s+)?([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$",
            "args": [
              "action"
            ],
            "resolve": [
              "action"
            ]
          },
          {
            "id": "deny.never.pl",
            "action": "rules.set",
            "effect": "deny",
            "lang": "pl",
            "regex": "^[\\s,]*(?:nigdy\\s+nie\\s+(?:uruchamiaj|wykonuj|odpalaj)|zabron\\w*|zablokuj)\\s+([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$",
            "args": [
              "action"
            ],
            "resolve": [
              "action"
            ]
          },
          {
            "id": "deny.never.en",
            "action": "rules.set",
            "effect": "deny",
            "lang": "en",
            "regex": "^[\\s,]*(?:never\\s+(?:run|execute|start)|forbid|ban|block)\\s+([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$",
            "args": [
              "action"
            ],
            "resolve": [
              "action"
            ]
          },
          {
            "id": "allow.pl",
            "action": "rules.set",
            "effect": "allow",
            "lang": "pl",
            "regex": "^[\\s,]*(?:(?:zawsze\\s+)?(?:pozwalaj|zezwalaj)\\s+na|nie\\s+pytaj\\s+(?:mnie\\s+)?(?:o|przed))\\s+([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$",
            "args": [
              "action"
            ],
            "resolve": [
              "action"
            ]
          },
          {
            "id": "allow.en",
            "action": "rules.set",
            "effect": "allow",
            "lang": "en",
            "regex": "^[\\s,]*(?:(?:always\\s+)?allow|(?:stop\\s+asking|don't\\s+ask|do\\s+not\\s+ask)\\s+(?:me\\s+)?(?:about|before))\\s+([a-z][a-z0-9_.]*)\\s*[.!]*\\s*$",
            "args": [
              "action"
            ],
            "resolve": [
              "action"
            ]
          },
          {
            "id": "disable.pl",
            "action": "rules.disable",
            "lang": "pl",
            "regex": "^[\\s,]*(?:wylacz|usun|zdejmij)\\s+regule\\s+(\\S+?)\\s*[.!]*\\s*$",
            "args": [
              "id"
            ],
            "original": [
              "id"
            ]
          },
          {
            "id": "disable.en",
            "action": "rules.disable",
            "lang": "en",
            "regex": "^[\\s,]*(?:disable|remove|switch\\s+off|turn\\s+off)\\s+(?:the\\s+)?rule\\s+(\\S+?)\\s*[.!]*\\s*$",
            "args": [
              "id"
            ],
            "original": [
              "id"
            ]
          },
          {
            "id": "remove_action.pl",
            "action": "actions.remove",
            "lang": "pl",
            "regex": "^[\\s,]*(?:usun|wycofaj|cofnij)\\s+akcje\\s+([a-z0-9][a-z0-9_.-]*)\\s*[.!]*\\s*$",
            "args": [
              "id"
            ]
          },
          {
            "id": "remove_action.en",
            "action": "actions.remove",
            "lang": "en",
            "regex": "^[\\s,]*(?:remove|delete|undo|take\\s+back)\\s+(?:the\\s+)?action\\s+([a-z0-9][a-z0-9_.-]*)\\s*[.!]*\\s*$",
            "args": [
              "id"
            ]
          },
          {
            "id": "remove_group.pl",
            "action": "groups.remove",
            "lang": "pl",
            "regex": "^[\\s,]*(?:usun|wycofaj|cofnij)\\s+grupe\\s+([a-z0-9][a-z0-9_.-]*)\\s*[.!]*\\s*$",
