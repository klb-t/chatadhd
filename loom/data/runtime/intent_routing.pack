        "group_label": "elementy: {{count}}",
        "result_completed": "Gotowe: {{title}}.",
        "result_failed": "Nie udało się w kroku {{step}}: {{message}}",
        "result_denied": "Zasady na to nie pozwalają: {{message}}",
        "result_rejected": "Odrzucone. Nic nie wykonano.",
        "result_cancelled": "Anulowano.",
        "result_waiting": "Czeka na Twoją odpowiedź: {{kind}}.",
        "result_client": "Czekam na Twoje urządzenie: {{prompt}}",
        "proposal_client": "Na Twoim urządzeniu: {{steps}}. Przeglądarka albo aplikacja wykonuje te kroki sama i zapyta Cię, gdy się zaczną.",
        "result_usage": "Wywołanie modelu wstrzymał strażnik zużycia: przewidywane zużycie jest dużo wyższe niż ostatnia wartość bazowa. Nic nie wysłano. Potwierdź tutaj albo w oknie zużycia.",
        "result_no_text": "Nie powstał żaden tekst.",
        "agent_proposals": "Agent chce to zrobić i czeka na Twoją odpowiedź (zaakceptuj albo odrzuć):",
        "agent_failed": "Agent zatrzymał się z błędem: {{message}}",
        "agent_step_limit": "Agent wykorzystał limit tur modelu ({{turns}}) i nie skończył.",
        "agent_held": "Agenta wstrzymał strażnik zużycia: nic więcej nie wysłano. Potwierdź w oknie zużycia.",
        "agent_cancelled": "Agent został anulowany.",
        "agent_status_other": "Agent zakończył ze statusem: {{status}}.",
        "ack_no": "Odrzucone. Nic nie wykonano.",
        "interview_waiting": "Czekam na Twoje „tak” albo „nie” przy propozycji powyżej. Niczego nie zapisałem.",
        "ack_no_offer": "Odrzucone. Nic nie wykonano, a Twoje zdanie nie poszło do modelu. Odpowiedz „wyślij jako wiadomość” (albo „tak”), żeby wysłać je jako zwykłą wiadomość, albo użyj przycisku.",
        "ack_no_send": "Odrzucone. Nic nie wykonano. Wysyłam Twoje zdanie do modelu jako zwykłą wiadomość.",
        "offer_declined": "Rozumiem: Twoje zdanie zostaje niewysłane.",
        "offer_gone": "Tego zdania nie ma już do wysłania: {{why}}.",
        "route_failed": "Rozpoznanie przez model się nie udało ({{message}}); zdecydowała metoda lokalna.",
        "why_planned": "jeszcze niedostępne",
        "why_no_executor": "nic w tej instalacji tego nie wykonuje",
        "semantic_question_batch": "Analiza w tle chce zużyć ok. {{ratio}} razy więcej niż zwykle ({{count}} wiadomości) - kontynuować?",
        "semantic_question_batch_unknown": "Analiza w tle chce zużyć wielokrotnie więcej niż zwykle ({{count}} wiadomości) - kontynuować?",
        "semantic_question_retry": "Ponowne wysłanie nieudanych analiz chce zużyć ok. {{ratio}} razy więcej niż zwykle ({{count}} wiadomości) - kontynuować?",
        "semantic_question_retry_unknown": "Ponowne wysłanie nieudanych analiz chce zużyć wielokrotnie więcej niż zwykle ({{count}} wiadomości) - kontynuować?",
        "semantic_question_limit_batch": "Analiza w tle ({{count}} wiadomości) została wstrzymana przez Twój limit wydatków: {{reason}} - kontynuować mimo to?",
        "semantic_question_limit_retry": "Ponowne wysłanie nieudanych analiz ({{count}} wiadomości) zostało wstrzymane przez Twój limit wydatków: {{reason}} - kontynuować mimo to?",
        "semantic_refused": "Analiza w tle ({{count}} wiadomości) jest wstrzymana przez Twój limit wydatków: {{reason}} Spróbuje ponownie później; podnieś limit, by kontynuować teraz.",
        "semantic_answer_yes": "Dobrze - analiza w tle jedzie dalej.",
        "semantic_answer_no": "Dobrze - analiza w tle jest wstrzymana. Wznowisz ją poleceniem „wznów analizę semantyczną”.",
        "semantic_answer_no_retry": "Dobrze - tych analiz nie wysyłam ponownie.",
        "semantic_answer_gone": "To pytanie nie jest już aktualne ({{why}})."
      }
    }
  },
  "value_schema": {
    "type": "object",
    "required": [
      "method",
      "execution",
      "on_reject",
      "emergent",
      "default_language",
      "message_request_fields",
      "heuristic",
      "confirmation",
      "model",
      "texts"
    ],
    "properties": {
      "method": {
        "type": "object",
        "required": [
          "setting",
          "active",
          "presets"
        ],
        "properties": {
          "setting": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "type": "string",
            "minLength": 1
          },
          "presets": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "model_setting": {
            "type": "string"
          },
          "model_fallback_setting": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "execution": {
        "type": "object",
        "required": [
          "setting",
          "active",
          "presets"
        ],
        "properties": {
          "setting": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "type": "string",
            "minLength": 1
          },
          "presets": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "direct": {
            "type": "array",
            "description": "Actions that run at once whatever the setting says, because they only describe or change nothing that stays: answers about the application (what can be done here, how to do something), the change of the context for the NEXT message only (context.modify: nothing is written, one word drops it) and the record of what was sent (context.receipt). Rules and the x10 question of the usage guard still apply. The overlay replaces the list; an empty list makes them wait for the yes like the rest.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      },
      "on_reject": {
        "type": "object",
        "description": "What the answer \"no\" to a proposal does with the sentence the proposal came from. `setting`/`active`/`presets`: offer (preset: the reply offers to send the sentence to the model as an ordinary message, in the same proposal block and by the words in confirmation.send) | send_as_message (the sentence is sent at once) | drop (it is not sent). `unknown`: the preset used when the setting names none of the presets.",
        "required": [
          "setting",
          "active",
          "presets"
        ],
        "properties": {
          "setting": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "type": "string",
            "minLength": 1
          },
          "unknown": {
            "type": "string",
            "minLength": 1
          },
          "presets": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "emergent": {
        "type": "object",
        "description": "The catalogue grows from conversations (R55), always as proposals and never silently. `setting`/`active`/`presets`: off | propose. command_shape: an input that matches no action but has the shape of a command (a verb-like lead word, an element, no question) is offered as the definition of a new action (a composite with one use_model step whose prompt is the user's own instruction; requires inferred from the element's traits among requires_from; the phrase joins the lexicon). sequences: the same chain of actions, each run on the result of the one before, on elements of one class `repeat` times in a row (consecutive within gap_seconds, at most max_length long; the last window_runs occurrences of a chain are counted for each class, kept in an incremental index) is offered as one composite. groups: a user-defined action used on min_classes classes that share traits is offered a group (named trait bundle) of what they share. Accepting writes only user overlays; every proposal leaves a node of `node.kind` with links `node.link` to the messages it emerged from.",
        "required": [
          "setting",
          "active",
          "presets",
          "command_shape",
          "naming",
          "requires_from",
          "definition",
          "sequences",
          "groups",
          "node"
        ],
        "properties": {
          "setting": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "type": "string",
            "minLength": 1
          },
          "presets": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "command_shape": {
            "type": "object",
            "required": [
              "max_tokens",
              "min_lead_chars",
              "element_within",
              "lead_skip",
              "not_leads",
              "forbid_question_mark",
              "verbs",
              "statement"
            ],
            "properties": {
              "max_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "existing_prefix_chars": {
                "type": "integer",
                "minimum": 0,
                "description": "P30: a lead verb that equals, matches by wildcard or shares this many leading characters (folded) with a phrase of an existing action names that action, so it is never offered as a new one. 0 turns the near match off (equal and wildcard matches stay)."
              },
              "min_lead_chars": {
                "type": "integer",
                "minimum": 1
              },
              "element_within": {
                "type": "integer",
                "minimum": 1
              },
              "lead_skip": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "not_leads": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "forbid_question_mark": {
                "type": "boolean"
              },
              "verbs": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": "P17: the lead of a command must be a verb from the list of the sentence's language (folded: lower case, no diacritics; PL imperative and infinitive, EN imperative). A language without a list accepts any list. A sentence that begins with anything else (\"First message of run 1\") is a statement, never a command, so it is not offered as a new action."
              },
              "verbs_extra": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": "Verbs added to `verbs` without replacing the list (an overlay replaces arrays, so the shipped list stays and these are united with it)."
              },
              "statement": {
                "type": "object",
                "properties": {
                  "after_lead": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Words that, directly after the lead, make the sentence a noun phrase or a statement (\"outline of this conversation\", \"list is long\")."
                  },
                  "subjects": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Subject words that, among the skipped lead words, make the sentence a statement (\"you outline ...\") unless a modal stands right before them (\"can you outline ...\")."
                  },
                  "modals": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label_chars": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "A lead directly followed by one of these characters is a label (\"Note: this message ...\"), not an order."
                  },
                  "reason": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "naming": {
            "type": "object",
            "required": [
              "prefix",
              "max_chars"
            ],
            "properties": {
              "prefix": {
                "type": "string"
              },
              "max_chars": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "requires_from": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "definition": {
            "type": "object",
            "required": [
              "system",
              "parameters",
              "cost",
              "confidence"
            ],
            "properties": {
              "system": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "parameters": {
                "type": "object"
              },
              "cost": {
                "type": "number",
                "minimum": 0
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "sequences": {
            "type": "object",
            "required": [
              "repeat",
              "max_length",
              "gap_seconds",
              "window_runs",
              "joiner"
            ],
            "properties": {
              "repeat": {
                "type": "integer",
                "minimum": 1
              },
              "max_length": {
                "type": "integer",
                "minimum": 2
              },
              "gap_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "window_runs": {
                "type": "integer",
                "minimum": 1
              },
              "joiner": {
                "type": "string",
                "minLength": 1
              },
              "index": {
                "type": "object",
                "description": "The incremental index of completed runs behind the detection (action_index.h): the tail of this many conversations is kept (convs), a snapshot is written to the run log every snapshot_every folded runs (a restart folds only what came after it), and this many messages are remembered per action (sources: what a group offer is derived from).",
                "properties": {
                  "convs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "snapshot_every": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sources": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "groups": {
            "type": "object",
            "required": [
              "min_classes",
              "suffix"
            ],
            "properties": {
              "min_classes": {
                "type": "integer",
                "minimum": 2
              },
              "suffix": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "node": {
            "type": "object",
            "required": [
              "kind",
              "link"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "link": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "default_language": {
        "type": "string",
        "minLength": 1
      },
      "message_request_fields": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "A chat request that carries one of these (non-empty) is an explicit chat feature: it is a message and never routed."
      },
      "heuristic": {
        "type": "object",
        "required": [
          "fold",
          "language_hints",
          "window_tokens",
          "lead_tokens",
          "scoring",
          "explicit",
          "patterns",
          "references"
        ],
        "properties": {
          "fold": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "language_hints": {
            "type": "object",
            "description": "Words (folded) that tell the language of an input that has no distinguishing letters; the language of a matched phrase wins over them.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "window_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "lead_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "sequence": {
            "type": "object",
            "description": "Two actions in one sentence (\"nagraj notatkę głosową i ją streść\"): the second acts on what the first brings. connectors: words (folded) that join them; bonus: added to the score of the first so the pair beats it alone.",
            "properties": {
              "connectors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "bonus": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "scoring": {
            "type": "object",
            "required": [
              "base",
              "per_word",
              "lead_penalty",
              "min_score"
            ],
            "properties": {
              "base": {
                "type": "number"
              },
              "per_word": {
                "type": "number"
              },
              "lead_penalty": {
                "type": "number"
              },
              "min_score": {
                "type": "number"
              },
              "confident_score": {
                "type": "number",
                "description": "Method hybrid: a candidate scoring at or above this is a command the local reading is sure of and the model is not asked; between min_score and this the reading is unsure and the model decides."
              }
            },
            "additionalProperties": false
          },
          "explicit": {
            "type": "object",
            "required": [
              "prefixes",
              "run_verbs",
              "aliases",
              "arg_pattern",
              "element_markers",
              "default_element"
            ],
            "properties": {
              "prefixes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "run_verbs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "aliases": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "arg_pattern": {
                "type": "string",
                "minLength": 1
              },
              "element_markers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default_element": {
                "type": "string",
                "enum": [
                  "current_conversation",
                  "last_message",
                  ""
                ]
              }
            },
            "additionalProperties": false
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "action",
                "regex",
                "args"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "regex": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "element_arg": {
                  "type": "string"
                },
                "requires_element": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "words",
                "resolve"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "resolve": {
                  "type": "string",
                  "enum": [
                    "current_conversation",
                    "last_message",
                    "element"
                  ]
                },
                "element": {
                  "type": "string",
                  "description": "resolve element: the id of the element the words stand for (device:microphone ...; ids of the data in element_resolution.pack)."
                }
              },
              "additionalProperties": false
            }
          },
          "rules": {
            "type": "object",
            "description": "Scoped settings and rules from what is said (R54): \"w tej rozmowie ustaw X=Y\", \"dla mnie zawsze pytaj przed depict\", \"for this conversation never run depict without asking\". `scopes`: the phrases that name a level of the scope chain (cut out of the text before the commands are read; none named = the default scope of the action_rules profile). `commands`: regexes matched against the folded text with the scope phrase blanked out; group order = `args`; `original` args are read from the text as typed, `resolve` args are action words turned into catalogue ids (an unknown word makes the input a message, nothing is guessed); `needs_scope`: only when a scope phrase was said (without it the plain settings patterns apply). The result is a proposal to run rules.set / rules.disable / rules.list.",
            "required": [
              "scopes",
              "commands"
            ],
            "properties": {
              "scopes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "scope",
                    "phrases"
                  ],
                  "properties": {
                    "scope": {
                      "type": "string",
                      "minLength": 1
                    },
                    "phrases": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "commands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "action",
                    "regex",
                    "args"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "action": {
                      "type": "string",
                      "minLength": 1
                    },
                    "effect": {
                      "type": "string"
                    },
                    "lang": {
                      "type": "string"
                    },
                    "needs_scope": {
                      "type": "boolean"
                    },
                    "regex": {
                      "type": "string",
                      "minLength": 1
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "original": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "resolve": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "action_words": {
                "type": "object",
                "description": "Words (folded; a trailing * matches any continuation) that stand for exactly one action in a rule or a scoped statement (\"pytaj przed obrazem\": obraz* is depict, not a media action that is only planned). Tried before the phrases of the catalogue.",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "phrases": {
            "type": "object",
            "description": "The lexicon of commands next to the `phrases` of the catalogue's own actions: action id -> language -> phrases (a word ending in * is a prefix). Phrases the user's own conversations add live here (overlay profiles/intent_routing.pack); an action's own `phrases` stay where they are.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "languages": {
            "type": "array",
            "description": "Names of languages as people say them (folded, lower case; a trailing * is a prefix): what a phrase such as \"na niemiecki\" or \"into German\" may name. The value given to an action is label.en. An unknown name is never guessed.",
            "items": {
              "type": "object",
              "required": [
                "code",
                "label",
                "names"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "names": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "arguments": {
            "type": "array",
            "description": "Arguments from loose phrases. Each pattern fills the declared parameter `param` of the chosen action (an action that does not declare it is not touched; an argument already given is never overwritten). `regex` is matched against the folded, lower-cased text (Polish letters without diacritics); group 1 (and 2 ...) is read from the original text, so the user's own words are kept. kind text: the captured words, or `template` ({1}, {2} = groups); kind language: the captured word must be one of `languages`, else nothing is extracted. First match per parameter wins; patterns of the language of the input come first. A pattern with `action` is read for that action only (profile.set: the field and its value from \"work.projects=chess club\").",
            "items": {
              "type": "object",
              "required": [
                "id",
                "param",
                "kind",
                "regex"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "param": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "description": "Only for this action (its id): a parameter name that several actions declare (slot, value) is read from the sentence for this action alone."
                },
                "lang": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "text",
                    "language"
                  ]
                },
                "regex": {
                  "type": "string",
                  "minLength": 1
                },
                "template": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "commands": {
            "type": "array",
            "description": "Commands of everything the conversation can do besides the rules (P15, R54): a regex matched against the folded text; group order = `args`; `original` args are read from the text as typed; `set` fixes arguments; `element` is the element the command acts on ({id} | {resolve: current_conversation | last_message}; none = the application), `element_from_arg` leaves it to the action (settings); `takes_scope` lets the scope phrases of the rules cut out of the text and fill `scope`; `check_arg` keeps the command only when the text of that argument is itself a command (how do I ...). First match per list wins ties, the order is the order of the list.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "action",
                "regex",
                "args"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "lang": {
                  "type": "string"
                },
                "regex": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "original": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "resolve": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "set": {
                  "type": "object"
                },
                "element": {
                  "type": "object"
                },
                "element_from_arg": {
                  "type": "boolean"
                },
                "takes_scope": {
                  "type": "boolean"
                },
                "check_arg": {
                  "type": "string"
                },
                "graph_arg": {
                  "type": "string",
                  "description": "M1-K0: the command is kept only when the text of this argument names a node of the graph projection (find_address); else the sentence stays a message („przejdź do rzeczy”)."
                },
                "graph_match": {
                  "type": "string",
                  "enum": [
                    "exact",
                    "words"
                  ],
                  "description": "How graph_arg is matched: exact (the whole name, an alias or the id, word by word with stems) or words (a name that has every word)."
                }
              },
              "additionalProperties": false
            }
          },
          "payload": {
            "type": "object",
            "description": "Default element (actions.pack default_element: last_message, current_conversation): a sentence that names no element but brings its own text to work on is an ordinary message and the model does the job inline (\"przetłumacz na niemiecki: dzień dobry\"). payload_patterns: regexes matched against the text as typed (a colon followed by text, a second line, a quoted text). max_words: the content words allowed after the command (the words an argument pattern reads, such as \"na niemiecki\", and the filler words are not content); more is a payload. All numbers are calibration, not limits.",
            "properties": {
              "payload_patterns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "max_words": {
                "type": "integer",
                "minimum": 0
              },
              "filler_words": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "conversation_language": {
            "type": "object",
            "description": "When the words of an input show no language (\"undo\", \"ok\"), the answer is in the language of the conversation: that of its latest proposal, else of its latest message of the person that shows one. messages: how many of the latest messages are looked at; enabled false: the default language.",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "messages": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "context_modifiers": {
            "type": "object",
            "description": "Short sentences that widen, narrow, deepen or flatten the context of the next turn, name a selector profile, or ask what was sent to the model (M1-D2 data; the router reads it since M1-K1b). status says so.",
            "properties": {
              "status": {
                "type": "object"
              },
              "note": {
                "type": "object"
              },
              "permanent": {
                "type": "object",
                "description": "Words that make a modifier a rule instead of a change for the next turn (\"na stałe\", \"permanently\"); default_scope: the level the rule is written at when the sentence names none."
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "key",
                    "step",
                    "phrases"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "step": {
                      "type": "string",
                      "minLength": 1
                    },
                    "phrases": {
                      "type": "object"
                    }
                  }
                }
              },
              "profile": {
                "type": "object"
              },
              "receipt": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "statement_guard": {
            "type": "object",
            "description": "P18: a sentence that says something ABOUT a result (\"Ocena tej wiadomości jest niska\", \"The critique of this message is harsh\") is not the command a word in it also names. nouns: languages -> the words of the lexicon's stems that are nouns as well as verbs (ocena, krytyka, podsumowanie ...); statement_words: languages -> the words that make a sentence a statement (jest, była, wynosi, is, was ...). A phrase that hit on one of the nouns, in a sentence that has a statement word, is not a command; a hit on a verb never is dropped, nor a noun that asks for the act (\"Zrób ocenę tej wiadomości\"). Both lists are calibration and are replaced by an overlay; empty lists turn the guard off.",
            "properties": {
              "nouns": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "statement_words": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "confirmation": {
        "type": "object",
        "required": [
          "yes",
          "no"
        ],
        "properties": {
          "yes": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "no": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "send": {
            "type": "object",
            "description": "Words that take an open offer to send the rejected sentence as a message (the yes words do too); the no words close the offer.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      },
      "model": {
        "type": "object",
        "required": [
          "system",
          "catalogue_line",
          "user",
          "parameters",
          "title",
          "timeout_ms",
          "min_confidence"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "catalogue_line": {
            "type": "string"
          },
          "catalogue_line_free": {
            "type": "string",
            "description": "P31: the catalogue line of an action that needs no element (shorter: no needs part)."
          },
          "named_action_min_confidence": {
            "type": "number",
            "description": "P31: a model answer that names an existing action is taken as that command even when it says kind=message, from this confidence up (a preset; a value above 1 switches it off). The route trace says why."
          },
          "examples": {
            "type": "object",
            "description": "P31: the examples in the routing prompt ({{examples}} of system), in the language of the input: fixed ones, and the first phrase of each phrase_actions action from heuristic.phrases. line: {{text}}, {{answer}}. max: the most lines (-1: all). enabled false leaves them out.",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "max": {
                "type": "integer",
                "minimum": -1
              },
              "line": {
                "type": "string"
              },
              "command_answer": {
                "type": "string"
              },
              "message_answer": {
                "type": "string"
              },
              "phrase_reference": {
                "type": "string"
              },
              "phrase_actions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fixed": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            "additionalProperties": false
          },
          "define_answer": {
            "type": "string",
            "description": "P32: the kind the routing model answers when no action of the list fits the command (the prompt teaches it); the definition offer decides."
          },
          "verb_guard": {
            "type": "object",
            "description": "P32: before a model-named action is accepted, a sentence of command shape whose lead verb is neither one of that action's phrases nor the verb of any existing action goes to the definition offer (the model's action stands when nothing can be defined). enabled false switches it off.",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "catalogue_retrieval": {
            "type": "object",
            "description": "P32: the routing prompt lists only the top_k actions closest to the message by the local search (selector tiers: embeddings, TF-IDF, keyword) over text_fields (id, title, description, phrases), plus the always list and every action the local reading scored; top_k 0 = the whole catalogue. stem_chars: words are folded and cut to this many letters for the TF-IDF and keyword tiers (0 = whole words). chars_per_token: the divisor of the token ESTIMATE in the trace.",
            "properties": {
              "top_k": {
                "type": "integer",
                "minimum": 0
              },
              "stem_chars": {
                "type": "integer",
                "minimum": 0
              },
              "chars_per_token": {
                "type": "number"
              },
              "always": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "text_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "user": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "title": {
            "type": "string"
          },
          "skip_when_rule_command": {
            "type": "boolean",
            "description": "P34: a rule or scoped-value command is read locally either way; when one is found the routing model is not asked (no routing call is paid). Off: the model is asked as before."
          },
          "local_recheck": {
            "type": "boolean",
            "description": "P30: when the routing model finds no command, the local reading is made before the sentence is offered as a new action."
          },
          "trace_raw_chars": {
            "type": "integer",
            "minimum": -1,
            "description": "P30: how many characters of the routing model's raw answer the route trace keeps; -1 keeps it whole, 0 keeps none. A preset, not a limit of the kernel."
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "min_confidence": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "texts": {
        "type": "object",
        "description": "Per language: the sentences of proposals and results ({{name}} placeholders).",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "additionalProperties": false
  }
}