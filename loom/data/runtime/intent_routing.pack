      },
      "window_tokens": 12,
      "lead_tokens": 4,
      "scoring": {
        "base": 0.6,
        "per_word": 0.1,
        "lead_penalty": 0.05,
        "min_score": 0.5,
        "confident_score": 0.7
      },
      "sequence": {
        "connectors": [
          "i",
          "oraz",
          "potem",
          "nastepnie",
          "and",
          "then"
        ],
        "bonus": 0.05
      },
      "explicit": {
        "prefixes": [
          "/"
        ],
        "run_verbs": [
          "run",
          "uruchom"
        ],
        "aliases": {
          "set": "settings.set",
          "ustaw": "settings.set",
          "get": "settings.get",
          "show": "settings.get",
          "pokaz": "settings.get",
          "pokaż": "settings.get",
          "help": "help.can_do",
          "pomoc": "help.can_do",
          "search": "search.find",
          "szukaj": "search.find",
          "znajdz": "search.find",
          "remember": "memory.remember",
          "zapamietaj": "memory.remember",
          "forget": "memory.forget",
          "zapomnij": "memory.forget",
          "models": "models.list",
          "modele": "models.list",
          "spend": "usage.spend",
          "wydatki": "usage.spend",
          "sync": "github.sync",
          "export": "export.conversation",
          "eksportuj": "export.conversation",
          "import": "import.file",
          "importuj": "import.file"
        },
        "arg_pattern": "^([A-Za-z_][A-Za-z0-9_.]*)=(.*)$",
        "element_markers": [
          "on",
          "na",
          "for",
          "dla"
        ],
        "default_element": "current_conversation"
      },
      "patterns": [
        {
          "id": "set_equals",
          "action": "settings.set",
          "regex": "^(?:(?:set|change|ustaw|zmień|zmien)\\s+)?([A-Za-z][A-Za-z0-9_]*)\\s*=\\s*(.+?)\\s*$",
          "args": [
            "key",
            "value"
          ],
          "element_arg": "key",
          "requires_element": true
        },
        {
          "id": "set_to",
          "action": "settings.set",
          "regex": "^(?:set|change|switch|ustaw|zmień|zmien|przełącz|przelacz)\\s+(?:the\\s+)?(?:setting\\s+)?([A-Za-z][A-Za-z0-9_]*)\\s+(?:to|na|=)\\s+(.+?)\\s*$",
          "args": [
            "key",
            "value"
          ],
          "element_arg": "key",
          "requires_element": true
        },
        {
          "id": "show_setting",
          "action": "settings.get",
          "regex": "^(?:show|get|display|what is|what's|pokaż|pokaz|sprawdź|sprawdz|jaka jest|jakie jest)\\s+(?:the\\s+)?(?:setting\\s+|value of\\s+|ustawienie\\s+|wartość\\s+|wartosc\\s+)?([A-Za-z][A-Za-z0-9_]*)\\s*\\??$",
          "args": [
            "key"
          ],
          "element_arg": "key",
          "requires_element": true
        }
      ],
      "references": [
        {
          "id": "conversation",
          "words": [
            "rozmow*",
            "konwersacj*",
            "czat*",
            "chat",
            "conversation",
