        "explain_simply": {
          "en": [
            "explain simply",
            "explain it simply",
            "explain this simply",
            "simplify",
            "eli5",
            "explain like",
            "make it simpler"
          ],
          "pl": [
            "wytłumacz prościej",
            "wyjaśnij prościej",
            "wytlumacz prosciej",
            "wyjasnij prosciej",
            "uprość*",
