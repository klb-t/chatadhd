    "kinds": {
      "resource": "external:resource",
      "conversation": "export:conversation",
      "message": "export:message",
      "profile": "runtime:profile",
      "profile_field": "runtime:profile_field",
      "json": "external:json",
      "json_field": "external:json_field"
    },
    "predicates": {
      "contains": "contains",
      "parent": "parent",
      "projects": "projects"
    }
  },
  "value_schema": {
