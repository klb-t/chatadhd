{
  "schema": "loom.runtime_profile/1",
  "domain": "element_resolution",
  "revision": 1,
  "description": "How a bare id becomes an element (GRAF_HUB_KOD_SILNIK §5, §8): the id forms of the graph/DB (prefix or hash length -> where the engine reads it and which class it gets), how a stored blob's MIME type maps to a class and traits, how a node kind maps to a class, and what text a conversation or message contributes as content. The engine only knows the SOURCES (message, conversation, version_group, node, link, blob, setting, device, projection: an address of the graph projection, runtime/graph_sources.pack — conv:<id> and msg:<id> are read as the conversation c_<id> and the message m_<id>, every other projection address is an element of its class without a store read); which prefix means which source, and which class follows, is calibration here and editable in the overlay <data>/profiles/element_resolution.pack. A bare string that is a class id stays a class id; a string that matches no form falls through unchanged (the matching engine then reports the class as unknown).",
  "defaults": {
    "id_forms": [
      {"id": "message", "prefix": "m_", "source": "message", "class": "message"},
      {"id": "conversation", "prefix": "c_", "source": "conversation", "class": "conversation"},
      {"id": "version_group", "prefix": "vg_", "source": "version_group", "class": "message"},
      {"id": "node", "prefix": "n_", "source": "node"},
      {"id": "link", "prefix": "l_", "source": "link", "class": "edge"},
      {"id": "blob_node", "prefix": "blob:", "source": "blob"},
      {"id": "blob", "hex_length": 64, "source": "blob"},
      {"id": "device", "prefix": "device:", "source": "device"},
      {"id": "projection_area", "prefix": "area:", "source": "projection", "class": "graph_area"},
      {"id": "projection_rom", "prefix": "rom:", "source": "projection", "class": "rom_item"},
      {"id": "projection_group", "prefix": "group:", "source": "projection", "class": "settings_group"},
      {"id": "projection_setting", "prefix": "setting:", "source": "projection", "class": "settings_field"},
      {"id": "projection_scope", "prefix": "scope:", "source": "projection", "class": "scope_level"},
      {"id": "projection_role", "prefix": "role:", "source": "projection", "class": "model_role"},
      {"id": "projection_model", "prefix": "model:", "source": "projection", "class": "model"},
      {"id": "projection_connector", "prefix": "connector:", "source": "projection", "class": "connector"},
      {"id": "projection_party", "prefix": "party:", "source": "projection", "class": "person"},
      {"id": "projection_preference", "prefix": "preference:", "source": "projection", "class": "preference"},
      {"id": "projection_policy", "prefix": "policy:", "source": "projection", "class": "privacy_rule"},
      {"id": "projection_interest", "prefix": "interest:", "source": "projection", "class": "interest"},
      {"id": "projection_learned", "prefix": "learned:", "source": "projection", "class": "learned"},
      {"id": "projection_memory", "prefix": "memory:", "source": "projection", "class": "memory_note"},
      {"id": "projection_conv", "prefix": "conv:", "source": "projection", "class": "conversation", "same_as_prefix": "c_"},
      {"id": "projection_msg", "prefix": "msg:", "source": "projection", "class": "message", "same_as_prefix": "m_"},
      {"id": "projection_unit", "prefix": "unit:", "source": "projection", "class": "unit"}, {"id": "projection_subgraph", "prefix": "subgraph:", "source": "projection", "class": "person_subgraph"},
      {"id": "projection_selector_profile", "prefix": "selector_profile:", "source": "projection", "class": "selector_profile"},
      {"id": "projection_flow", "prefix": "flow:", "source": "projection", "class": "flow"},
      {"id": "projection_step", "prefix": "step:", "source": "projection", "class": "flow_step"},
      {"id": "projection_perspective", "prefix": "perspective:", "source": "projection", "class": "perspective"},
      {"id": "projection_edge_kind", "prefix": "edge_kind:", "source": "projection", "class": "edge_kind"},
      {"id": "projection_view", "prefix": "view:", "source": "projection", "class": "view"},
      {"id": "projection_binding", "prefix": "binding:", "source": "projection", "class": "gesture_binding"},
      {"id": "projection_env", "prefix": "env:", "source": "projection", "class": "environment"},
      {"id": "projection_tool_source", "prefix": "tool_source:", "source": "projection", "class": "tool_source"},
      {"id": "projection_levels", "prefix": "levels:", "source": "projection", "class": "settings_group"},
      {"id": "projection_tool_kind", "prefix": "tool_kind:", "source": "projection", "class": "tool_source_kind"},
      {"id": "projection_tools_also", "prefix": "also:", "source": "projection", "class": "graph_link"},
      {"id": "projection_automation", "prefix": "automation:", "source": "projection", "class": "automation"},
      {"id": "projection_task", "prefix": "task:", "source": "projection", "class": "background_task"},
      {"id": "projection_calibration", "prefix": "calibration:", "source": "projection", "class": "calibration_item"}
    ],
    "setting": {"class": "settings_field", "source": "setting"},
    "node_kind_classes": {"blob": "file", "message": "message", "text_form": "text_form", "image_form": "image_form", "audio_form": "audio_form", "video_form": "video_form", "content": "content", "action_run": "action_run", "proposal": "emergent_proposal"},
    "mime_rules": [
      {"prefix": "image/", "class": "image_form", "traits": ["has_file", "has_hash"], "part": "image"},
      {"prefix": "audio/", "class": "audio_form", "traits": ["has_file", "has_hash"], "part": "audio"},
      {"prefix": "video/", "class": "video_form", "traits": ["has_file", "has_hash"], "part": "video"},
      {"prefix": "text/", "class": "text_form", "traits": ["has_file", "has_hash"], "part": "text"},
      {"exact": "application/json", "class": "text_form", "traits": ["has_file", "has_hash"], "part": "text"},
      {"prefix": "", "class": "file", "traits": [], "part": "file_ref"}
    ],
    "content": {
      "conversation_roles": {"user": "User", "assistant": "Assistant", "system": "System"},
      "conversation_line": "{{role}}: {{text}}",
      "conversation_separator": "\n\n",
      "exclude_metadata_keys": ["routed", "action_proposal", "action_run"]
    }
  },
  "value_schema": {
    "type": "object",
    "required": ["id_forms", "setting", "node_kind_classes", "mime_rules", "content"],
    "properties": {
      "id_forms": {
        "type": "array",
        "description": "Ordered id forms: the first that matches wins. prefix: the id starts with it; hex_length: the id is that many lowercase hex digits.",
        "items": {
          "type": "object",
          "required": ["id", "source"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "prefix": {"type": "string"},
            "hex_length": {"type": "integer", "minimum": 1},
            "source": {"type": "string", "enum": ["message", "conversation", "version_group", "node", "link", "blob", "device", "projection"]},
            "class": {"type": "string"},
            "same_as_prefix": {"type": "string", "minLength": 1, "description": "A projection address that is the same node as a database id: the rest of the address after this prefix is that id (conv:<id> = c_<id>), resolved by the id form of that prefix."}
          },
          "additionalProperties": false
        }
      },
      "setting": {
        "type": "object",
        "description": "A bare string that names a settings field (data/runtime/settings_fields.pack) is that field: element class and source.",
        "required": ["class", "source"],
        "properties": {"class": {"type": "string"}, "source": {"type": "string"}},
        "additionalProperties": false
      },
      "node_kind_classes": {
        "type": "object",
        "description": "Node kind -> class; a kind that is itself a known class is used as it is, any other kind leaves the class empty (own traits only).",
        "additionalProperties": {"type": "string"}
      },
      "mime_rules": {
        "type": "array",
        "description": "First rule whose prefix (or exact type) matches the stored MIME type: class, extra traits and the kind of typed part the bytes make.",
        "items": {
          "type": "object",
          "required": ["class", "part"],
          "properties": {
            "prefix": {"type": "string"},
            "exact": {"type": "string"},
            "class": {"type": "string"},
            "traits": {"type": "array", "items": {"type": "string"}},
            "part": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "content": {
        "type": "object",
        "description": "How the text of a conversation is laid out when it is the input of an action.",
        "required": ["conversation_roles", "conversation_line", "conversation_separator", "exclude_metadata_keys"],
        "properties": {
          "exclude_metadata_keys": {"type": "array", "items": {"type": "string"}, "description": "A message whose metadata has one of these keys is chat-window command traffic (the command, its proposal, the yes) and is not part of the content of the conversation."},
          "conversation_roles": {"type": "object", "additionalProperties": {"type": "string"}},
          "conversation_line": {"type": "string", "minLength": 1},
          "conversation_separator": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
