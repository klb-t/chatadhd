{
  "schema": "loom.runtime_profile/1",
  "domain": "model_workflows",
  "revision": 1,
  "description": "Catalogue of named use-cases that call the use-model action. A call may name its workflow; an unknown or planned name is rejected before any send. A new use-case is a new entry here (profiles/model_workflows.pack overlay), not new code.",
  "defaults": {
    "workflows": {
      "chat.send": {
        "status": "implemented",
        "title": "Send a chat message",
        "description": "A user message in a conversation, answered by the selected model (buffered or streamed); history, memory and graph context are the input.",
        "accepts": [
          "text",
          "json"
        ],
        "produces": [
          "text"
        ],
        "consumer": "loom/src/chat/chat_engine.cpp"
      },
      "semantic.analyse": {
        "status": "implemented",
        "title": "Semantic analysis of one message",
        "description": "Entities, topics and relations of one message from the semantic model; regex analysis stays the fallback.",
        "accepts": [
          "text"
        ],
        "produces": [
          "text"
        ],
        "consumer": "loom/src/semantic/semantic_llm.cpp"
      },
      "semantic.batch": {
        "status": "implemented",
        "title": "Semantic analysis through Message Batches",
        "description": "The worker submits queued messages to the provider's Message Batches, polls the batch and ingests the results.",
        "accepts": [
          "text"
        ],
        "produces": [
          "text"
        ],
        "consumer": "loom/src/worker/semantic_worker.cpp"
      },
      "batch.chat": {
        "status": "implemented",
        "title": "Batch analysis of chosen messages",
        "description": "Chosen messages analysed as concurrent chat requests, or as native Message Batches when the address names a batch provider.",
        "accepts": [
          "text"
        ],
        "produces": [
          "text"
        ],
        "consumer": "loom/src/chat/batch_api.cpp"
      },
      "archive.refine": {
        "status": "implemented",
        "title": "Refine archive items",
        "description": "Reclassifies low-confidence archive items (idea, decision, rejected option, ...).",
        "accepts": [
          "text"
        ],
        "produces": [
          "text"
        ],
        "consumer": "loom/src/archive/pipeline.cpp"
      },
      "goal.typing": {
        "status": "implemented",
        "title": "Type the goal of a prompt",
        "description": "Classifies a prompt into a goal type when the cue classifier is unsure; explicitly budgeted.",
        "accepts": [
          "text"
        ],
        "produces": [
          "text"
        ],
        "consumer": "loom/src/context/context_engine.cpp"
      },
      "graph_native.reply": {
        "status": "planned",
        "title": "Graph-native reply",
        "description": "A graph-native message in a conversation: the reply is a graph packet compiled by a method.",
        "accepts": [
          "text",
          "json"
        ],
        "produces": [
          "text",
          "json"
        ],
        "consumer": "loom/src/chat/graph_reply.cpp"
      },
      "jev.edge_classify": {
        "status": "planned",
        "title": "Classify and weigh edges (Jev)",
        "description": "Classification and weighting of graph edges by the Jev analysis.",
        "accepts": [
          "text",
          "json"
        ],
        "produces": [
          "json"
        ],
        "consumer": ""
      },
      "input.route_intent": {
        "status": "planned",
        "title": "Route user input",
        "description": "Decides whether user input is a message or an interface command; for a command, analyses feasibility and cost.",
        "accepts": [
          "text",
          "json"
        ],
        "produces": [
          "json"
        ],
        "consumer": ""
      },
      "script.call": {
        "status": "planned",
        "title": "Model call from a script",
        "description": "A model call made by an internal script running in the app.",
        "accepts": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "produces": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "consumer": ""
      },
      "agent.call": {
        "status": "planned",
        "title": "Model call from an agent",
        "description": "A model call made by an agent; the agent's steps are workflows of their own.",
        "accepts": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "produces": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "consumer": ""
      },
      "media.generate_image": {
        "status": "planned",
        "title": "Generate an image",
        "description": "Image generation; adapter openai_images exists, no caller is wired yet.",
        "accepts": [
          "text",
          "image"
        ],
        "produces": [
          "image"
        ],
        "consumer": ""
      },
      "media.generate_video": {
        "status": "planned",
        "title": "Generate a video",
        "description": "Video generation from a text or image prompt.",
        "accepts": [
          "text",
          "image"
        ],
        "produces": [
          "video"
        ],
        "consumer": ""
      },
      "media.generate_music": {
        "status": "planned",
        "title": "Generate music",
        "description": "Music generation from a text or audio prompt.",
        "accepts": [
          "text",
          "audio"
        ],
        "produces": [
          "audio"
        ],
        "consumer": ""
      }
    }
  },
  "value_schema": {
    "type": "object",
    "required": [
      "workflows"
    ],
    "properties": {
      "workflows": {
        "type": "object",
        "description": "Workflow name -> declaration.",
        "x-setting": "/workflows",
        "x-consumer": "loom::llm::use_model",
        "additionalProperties": {
          "type": "object",
          "required": [
            "status",
            "accepts",
            "produces"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "implemented",
                "planned"
              ],
              "description": "planned: declared, not callable yet."
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "accepts": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "text",
                  "json",
                  "image",
                  "audio",
                  "video",
                  "embedding",
                  "file_ref"
                ]
              },
              "description": "Input part kinds the workflow takes."
            },
            "produces": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "text",
                  "json",
                  "image",
                  "audio",
                  "video",
                  "embedding",
                  "file_ref"
                ]
              },
              "description": "Output part kinds the workflow returns."
            },
            "consumer": {
              "type": "string",
              "description": "Where the workflow is called from today."
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": false
  }
}
