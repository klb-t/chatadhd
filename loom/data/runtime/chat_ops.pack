    "role_consumers": {
      "action": {
        "en": "Read today by the actions that call a model: that job uses it from now on.",
        "pl": "Czytane dziś przez akcje wywołujące model: ta praca używa go od teraz."
      },
      "provider": {
        "en": "Read today by the speech and text recognition of the actions transcribe and ocr; the voice input and the import of screenshots still follow the media profile.",
        "pl": "Czytane dziś przez rozpoznawanie mowy i tekstu w akcjach transkrybuj i ocr; wejście głosowe i import zrzutów nadal idą wg profilu mediów."
      },
      "recorded": {
        "en": "Recorded for this conversation; the window itself uses the setting of the job until it reads the role.",
        "pl": "Zapisane dla tej rozmowy; samo okienko używa ustawienia tej pracy, dopóki nie przeczyta roli."
      },
      "setting": {
        "en": "This is the setting {{setting}}: the window uses it from the next message.",
        "pl": "To jest ustawienie {{setting}}: okienko używa go od następnej wiadomości."
      }
    },
