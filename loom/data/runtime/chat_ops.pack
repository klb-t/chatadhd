      "expert": [
        {
          "en": "/action key=value  — run an action by its name, for example /search.find query=cats or /conversation.rename title=Plan",
          "pl": "/akcja klucz=wartość  — uruchom akcję po nazwie, np. /search.find query=koty albo /conversation.rename title=Plan"
        },
        {
          "en": "/run action on id  — run it on an element: /run summarise on c_0123456789ab (a message m_…, a conversation c_…, a node n_…)",
          "pl": "/run akcja on id  — uruchom na elemencie: /run summarise on c_0123456789ab (wiadomość m_…, rozmowa c_…, węzeł n_…)"
        },
        {
          "en": "/set key value  and  /get key  — a setting; “for this conversation set key to value” writes it for this conversation only",
          "pl": "/set klucz wartość  i  /get klucz  — ustawienie; „w tej rozmowie ustaw klucz na wartość” zapisuje je tylko dla tej rozmowy"
        },
        {
          "en": "“yes” / “no” answer a proposal; every proposal carries a receipt that the API needs to run it (POST /api/actions/confirm)",
          "pl": "„tak” / „nie” odpowiadają na propozycję; każda propozycja ma pokwitowanie, którego API wymaga do wykonania (POST /api/actions/confirm)"
        },
        {
          "en": "/help  — this list; /rules.list  — your rules; keys and tokens are never typed here: use Settings",
          "pl": "/help  — ta lista; /rules.list  — Twoje reguły; kluczy i tokenów nie wpisuje się tutaj: użyj Ustawień"
        }
      ]
    },
