{
  "schema": "loom.runtime_profile/1",
  "domain": "chat_ops",
  "revision": 1,
  "description": "The words, numbers and texts of the operations of the application as actions (include/loom/action_ops.h, src/actions/ops.cpp): search, the graph around a name, the memory, conversations and messages, export and import, storage backends, the model or provider of a job, usage, models and providers, the background work, the log, and the two answers that make the rest discoverable (what can be done here, how to do something). Every number is a preset (limits), every list of words is what the sentences of the user are matched with (letters are folded with `fold`, so words are written without diacritics or with them), every sentence the operations say is in `texts` per language ({{name}} is filled in). Nothing here is a limit: the overlay <data>/profiles/chat_ops.pack replaces any entry (arrays replace, objects merge by key).",
  "defaults": {
    "fold": {
      "ą": "a",
      "ć": "c",
      "ę": "e",
      "ł": "l",
      "ń": "n",
      "ó": "o",
      "ś": "s",
      "ź": "z",
      "ż": "z"
    },
    "limits": {
      "list": 20,
      "search": 10,
      "graph_edges": 60,
      "graph_depth_max": 3,
      "scan_nodes": 5000,
      "memory": 30,
      "models": 20,
      "tasks": 20,
      "logs": 30,
      "sources": 20,
      "snippet_chars": 160,
      "catalog": 10
    },
    "default_format": "markdown",
    "forget": {
      "keep_content": true
    },
    "receipt_graph": {
      "label_chars": 80
    },
