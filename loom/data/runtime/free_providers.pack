          "cached_input_per_million": 0.15,
          "output_per_million": 9.0,
          "to_eur": 0.92,
          "observed_at": "2026-10-29",
          "source_url": "https://cloud.google.com/vertex-ai/generative-ai/pricing",
          "source_rating": "aggregator (official page did not list 3.5 Flash in the fetched copy; third-party trackers agree on 1.50/9.00 USD)",
          "note": "thinking tokens are billed as output; to_eur is a dated approximate conversion, not a quote"
        },
        "exhaustion_markers": [
          "429",
          "RESOURCE_EXHAUSTED",
          "quota",
          "rate limit"
        ],
        "exhausted_cooldown_seconds": 60,
        "data_terms_prompt": "first_use",
        "equivalent_to": []
