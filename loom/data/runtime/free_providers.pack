          "summary": {
            "pl": "Vertex AI nie uczy na danych klientów (domyślnie, tak zostaje); dane idą do Google Cloud na koncie operatora; pamięć podręczna Vertex włączona.",
            "en": "Vertex AI does not train on customer data (by default, kept so); data goes to Google Cloud on the operator's account; Vertex caching is on."
          }
        },
        "fallback_order": 30,
        "auth": {
          "metadata_base": "http://metadata.google.internal",
