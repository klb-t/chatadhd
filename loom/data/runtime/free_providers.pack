  "value_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "providers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "base_url",
            "enabled",
            "data_terms"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "base_url": {
              "type": "string",
              "minLength": 1
            },
            "enabled": {
              "type": "boolean"
            },
            "data_terms": {
              "type": "object"
            }
          }
        },
        "x-setting": "/providers",
        "x-consumer": "server guests"
      },
      "free_model_choice": {
        "type": "object",
        "x-setting": "/free_model_choice",
        "x-consumer": "server guests"
      },
      "terms": {
        "type": "object",
        "x-setting": "/terms",
        "x-consumer": "server guests"
      }
    }
  }
