{
  "schema": "loom.runtime_profile/1",
  "domain": "archive",
  "revision": 1,
  "description": "Exact legacy archive pipeline defaults. Objects merge recursively; lists replace. Existing KB lexicons stopwords_base and item_cues remain canonical and are read with their KB overlay. Reopen runtime after changing either profile.",
  "defaults": {
    "text": {
      "abbreviations": [
        "e",
        "g",
        "i",
        "np",
        "itd",
        "itp",
        "tzn",
        "etc",
        "vs",
        "cf",
        "dr",
        "mr",
        "ms",
        "prof",
        "tj",
        "in",
        "al",
        "no",
        "nr",
        "ok",
        "ang",
        "pl"
      ],
      "glossary": {
        "pamięć": "memory",
        "pamięci": "memory",
        "graf": "graph",
        "grafu": "graph",
        "grafie": "graph",
        "zadanie": "task",
        "zadania": "task",
        "zadań": "task",
        "źródło": "source",
        "źródła": "source",
        "źródeł": "source",
        "szyfrowanie": "encryption",
        "szyfrowania": "encryption",
        "wyszukiwanie": "search",
        "wyszukiwania": "search",
        "rozmowa": "conversation",
        "rozmowy": "conversation",
        "rozmów": "conversation",
        "załączniki": "attachment",
        "załączników": "attachment",
        "głos": "voice",
        "synchronizacja": "sync",
        "synchronizacji": "sync",
        "wykonanie": "execution",
        "wykonania": "execution",
        "środowisko": "environment",
        "środowiska": "environment",
        "wtyczka": "plugin",
        "wtyczki": "plugin",
        "logi": "log",
        "logów": "log",
        "kontekst": "context",
        "kontekstu": "context",
        "dostawca": "provider",
        "providerzy": "provider",
        "providerów": "provider",
        "wersja": "version",
        "wersje": "version",
        "gałąź": "branch",
        "historia": "history",
        "historii": "history",
        "tytuł": "title",
        "tytuły": "title",
        "surowy": "raw",
        "szablon": "template",
        "szablony": "template",
        "polityka": "policy",
        "zdarzenie": "event",
        "zdarzenia": "event",
        "decyzja": "decision",
        "decyzje": "decision",
        "wymagania": "requirement",
        "panele": "panel",
        "model": "model",
        "modele": "model",
        "import": "import",
        "eksport": "export",
        "eksporty": "export",
        "sprzeczności": "contradiction",
        "braki": "gap",
        "chronologia": "timeline",
        "pliki": "file",
        "plików": "file",
        "kod": "code",
        "kodu": "code",
        "testy": "test",
        "testów": "test",
        "magazyn": "store",
        "klucz": "key",
        "klucze": "key",
        "tożsamość": "identity",
        "artefakt": "artifact",
        "artefakty": "artifact",
        "artefaktów": "artifact",
        "widok": "view",
        "widoki": "view",
        "agent": "agent",
        "agenta": "agent",
        "przeglądarka": "browser",
        "terminal": "terminal",
        "punkt": "checkpoint",
        "surowych": "raw",
        "surowe": "raw",
        "surowego": "raw",
        "eksportów": "export",
        "eksportu": "export",
        "oryginału": "source",
        "oryginał": "source",
        "chronologię": "timeline",
        "forków": "fork",
        "forki": "fork",
        "słownika": "vocabulary",
        "słownik": "vocabulary",
        "terminów": "term",
        "tematów": "theme",
        "idei": "idea",
        "decyzji": "decision",
        "scalenie": "merge",
        "materializacja": "materialize",
        "wznowienie": "resume",
        "ponowienie": "retry",
        "wycofanie": "rollback"
      },
      "stem_min_extra_bytes": 2,
      "stem_rules": [
        {
          "suffixes": [
            "ies"
          ],
          "exclude": [],
          "remove": 3,
          "replacement": "y"
        },
        {
          "suffixes": [
            "sses",
            "xes",
            "ches",
            "shes"
          ],
          "exclude": [],
          "remove": 2,
          "replacement": ""
        },
        {
          "suffixes": [
            "s"
          ],
          "exclude": [
            "ss",
            "us",
            "is"
          ],
          "remove": 1,
          "replacement": ""
        }
      ],
      "min_token_codepoints": 3,
      "min_sentence_codepoints": 8,
      "min_sentence_tokens": 2
    },
    "items": {
      "types": [
        "decision",
        "rejected_option",
        "open_question",
        "requirement",
        "invariant",
        "idea",
        "rationale",
        "implementation",
        "bug"
      ],
      "contains_headings": [
        "otwarte decyzje",
        "open question",
        "open decision",
        "nie wolno zgubić",
        "must not lose",
        "otwarte pytania"
      ],
      "requirement_penalty_phrases": [
        "must not",
        "must never"
      ],
      "requirement_penalty": 1.5,
      "question_suffix": "?",
      "question_suffix_score": 2.5,
      "question_prefix": "czy ",
      "question_prefix_cue": "czy",
      "question_prefix_score": 1.0,
      "min_score": 1.5,
      "min_sentence_score": 1.0,
      "min_list_tokens": 3,
      "min_heading_tokens": 5,
      "confidence_base": 0.35,
      "confidence_slope": 0.15,
      "ambiguity_margin": 0.5,
      "ambiguity_penalty": 0.1,
      "confidence_min": 0.3,
      "confidence_max": 0.95,
      "subject_min_token_codepoints": 3,
      "negation_lookback": 3,
      "bug_markers": [
        "FIXME",
        "XXX",
        "HACK"
      ],
      "todo_confidence": 0.6,
      "commit_bug_phrases": [
        "fix",
        "bug",
        "crash*",
        "regression"
      ],
      "commit_confidence": 0.9,
      "text_max_codepoints": 320,
      "sentence_max_bytes": 1200,
      "sentence_min_tokens": 3,
      "relation_types": [
        "decision",
        "rejected_option",
        "requirement",
        "invariant"
      ],
      "idf_offset": 0.1,
      "distinctive_df_min": 3.0,
      "distinctive_df_fraction": 0.3,
      "max_shared_token_items": 200,
      "min_shared_distinctive": 2,
      "min_longer_share": 0.2,
      "supersede_threshold": 0.3,
      "contradict_threshold": 0.5,
      "resolution_threshold": 0.35
    },
    "code": {
      "extensions": {
        ".c": "c",
        ".h": "cpp",
        ".cc": "cpp",
        ".cpp": "cpp",
        ".cxx": "cpp",
        ".hh": "cpp",
        ".hpp": "cpp",
        ".hxx": "cpp",
        ".ipp": "cpp",
        ".py": "python",
        ".pyi": "python",
        ".kt": "kotlin",
        ".kts": "kotlin",
        ".java": "java",
        ".js": "javascript",
        ".mjs": "javascript",
        ".jsx": "javascript",
        ".ts": "typescript",
        ".tsx": "typescript",
        ".go": "go",
        ".rs": "rust",
        ".swift": "swift",
        ".m": "objc",
        ".mm": "objc",
        ".cs": "csharp",
        ".rb": "ruby",
        ".php": "php",
        ".sh": "shell",
        ".bash": "shell",
        ".cmake": "cmake",
        ".gradle": "gradle",
        ".proto": "proto",
        ".sql": "sql",
        ".dart": "dart",
        ".scala": "scala",
        ".lua": "lua",
        ".r": "r",
        ".jl": "julia",
        ".zig": "zig",
        ".vue": "vue",
        ".svelte": "svelte"
      },
      "filenames": {
        "CMakeLists.txt": "cmake",
        "Makefile": "make",
        "makefile": "make",
        "Dockerfile": "docker"
      },
      "non_functions": [
        "if",
        "for",
        "while",
        "switch",
        "return",
        "catch",
        "sizeof",
        "decltype",
        "static_assert",
        "alignof",
        "defined",
        "else",
        "do",
        "new",
        "delete",
        "throw",
        "assert",
        "LOOM_TRY",
        "LOOM_TRY_ASSIGN",
        "TEST_CASE",
        "SUBCASE",
        "CHECK",
        "REQUIRE",
        "extern"
      ],
      "modifiers": [
        "export ",
        "public ",
        "private ",
        "internal ",
        "open ",
        "abstract ",
        "final ",
        "data ",
        "sealed ",
        "static ",
        "pub ",
        "async ",
        "inline ",
        "template<",
        "extern \"C\" "
      ],
      "type_words": [
        "class",
        "struct",
        "interface",
        "enum class",
        "enum struct",
        "enum",
        "object",
        "trait",
        "protocol",
        "union",
        "namespace",
        "fun",
        "func",
        "fn",
        "function",
        "typealias",
        "type"
      ],
      "todo_markers": [
        "TODO",
        "FIXME",
        "XXX",
        "HACK"
      ],
      "cmake_commands": [
        "add_library(",
        "add_executable(",
        "option(",
        "project("
      ],
      "c_like": [
        "c",
        "cpp",
        "java",
        "kotlin",
        "javascript",
        "typescript",
        "go",
        "rust",
        "swift",
        "objc",
        "csharp",
        "php",
        "gradle",
        "proto",
        "dart",
        "scala",
        "zig",
        "vue",
        "svelte"
      ],
      "hash_comments": [
        "python",
        "shell",
        "cmake",
        "ruby",
        "make",
        "docker",
        "r",
        "julia"
      ],
      "max_uses": 500,
      "min_comment_tokens": 3,
      "max_digest_symbols": 200,
      "comment_budget_bytes": 12000,
      "max_extra_symbols": 400,
      "parser_routes": {
        "python": "python",
        "cmake": "cmake",
        "shell": "shell"
      },
      "function_declaration_languages": [
        "cpp",
        "c"
      ],
      "excluded_type_words": {
        "cpp": [
          "type",
          "typealias"
        ]
      },
      "non_component_type_words": [
        "namespace"
      ],
      "excluded_symbol_names": [
        "final"
      ],
      "excluded_special_prefixes": [
        "__"
      ],
      "special_name_min_bytes_exclusive": 4,
      "allowed_special_names": [
        "__init__"
      ],
      "excluded_class_methods": [
        "__init__"
      ],
      "todo_text_max_codepoints": 200
    },
    "scan": {
      "skip_dirs": [
        ".git",
        "build",
        "node_modules",
        "third_party",
        "vendor",
        "__pycache__",
        ".venv",
        "venv",
        "env",
        "dist",
        "target",
        ".gradle",
        ".idea",
        ".vscode",
        ".cache",
        ".pytest_cache",
        ".mypy_cache",
        "Pods",
        "DerivedData",
        ".tox",
        "site-packages",
        "fixtures",
        "testdata",
        ".next",
        ".svn",
        ".hg",
        "out",
        ".claude"
      ],
      "document_extensions": [
        ".md",
        ".markdown",
        ".txt",
        ".rst",
        ".adoc",
        ".org"
      ],
      "import_extensions": [
        ".jsonl",
        ".ndjson",
        ".html",
        ".htm",
        ".mht",
        ".mhtml",
        ".db",
        ".sqlite",
        ".sqlite3",
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
      ],
      "max_unknown_text_bytes": 2000000,
      "text_user_threshold": 2,
      "text_assistant_threshold": 2,
      "title_lines": 3,
      "db_query_limit": 1000000,
      "readme_seed_limit": 6,
      "checkpoint_seconds": 10,
      "skip_dir_prefixes": [
        "cmake-build"
      ],
      "skip_dir_sentinels": [
        ".loom-archive"
      ],
      "provenance_query_limit": 10000000,
      "json_chunk_bytes": 1048576,
      "readme_name_prefixes": [
        "readme"
      ],
      "readme_kinds": [
        "doc"
      ],
      "readme_name_case_fold": true
    },
    "synthesis": {
      "external_names": [
        "ChatGPT",
        "GitHub",
        "PolyForm",
        "ThreadSanitizer",
        "UBSan",
        "AddressSanitizer",
        "CMakeLists",
        "OpenSSL",
        "CPython",
        "MiniLM",
        "CamelCase",
        "OpenRouter",
        "SQLite",
        "JavaScript",
        "TypeScript",
        "PyPI",
        "OpenAI",
        "DeepSeek",
        "MacOS",
        "iOS",
        "YouTube",
        "LinkedIn",
        "PowerPoint",
        "JSONL",
        "WebSocket",
        "OkHttp",
        "CMake",
        "LLMs",
        "APIs",
        "IDs",
        "URLs",
        "UUIDs",
        "JSONs",
        "PDFs",
        "GPUs",
        "VMs",
        "macOS",
        "iPhone",
        "WhatsApp",
        "LaTeX",
        "NumPy",
        "PyTorch",
        "GitLab"
      ],
      "source_extensions": [
        ".py",
        ".cpp",
        ".h",
        ".hpp",
        ".kt",
        ".ts",
        ".tsx",
        ".js",
        ".md",
        ".cc",
        ".java",
        ".swift",
        ".rs",
        ".go"
      ],
      "sections": [
        {
          "title": "5. Decisions",
          "type": "decision",
          "cap": 40,
          "inactive": true
        },
        {
          "title": "6. Rejected options",
          "type": "rejected_option",
          "cap": 25,
          "inactive": true
        },
        {
          "title": "7. Open questions",
          "type": "open_question",
          "cap": 40,
          "inactive": false
        },
        {
          "title": "8. Requirements",
          "type": "requirement",
          "cap": 40,
          "inactive": false
        },
        {
          "title": "9. Invariants",
          "type": "invariant",
          "cap": 30,
          "inactive": false
        },
        {
          "title": "10. Ideas",
          "type": "idea",
          "cap": 20,
          "inactive": false
        }
      ],
      "kind_labels": {
        "chat": "chat messages",
        "doc": "document sections",
        "code": "code files",
        "commit": "commits",
        "project": "project docs",
        "memory": "memories"
      },
      "spec_kinds": [
        "doc",
        "project",
        "memory"
      ],
      "prefix_match_bytes": 6,
      "evidence_files": 3,
      "partial_fraction": 0.5,
      "named_min_bytes": 4,
      "inflection_max_bytes": 2,
      "title_phrase_min_tokens": 2,
      "title_phrase_max_tokens": 3,
      "title_word_min_bytes": 3,
      "feature_max_codepoints": 70,
      "section_min_features": 2,
      "theme_gap_min_docs": 3,
      "todo_limit": 60,
      "reason_limit": 3,
      "theme_term_limit": 10,
      "theme_doc_limit": 4,
      "timeline_head": 6,
      "timeline_tail": 6,
      "edge_limit": 40,
      "phrase_gap_limit": 15,
      "component_gap_limit": 20,
      "section_gap_limit": 10,
      "missing_feature_limit": 4,
      "section_gap_min_features": 3,
      "section_gap_coverage_fraction": 0.5,
      "discovered_min_df": 2,
      "discovered_limit": 8
    },
    "vocabulary": {
      "camel_min_length": 4,
      "camel_min_uppercase": 2,
      "salient_min_df": 2,
      "salient_max_df_fraction": 0.5,
      "salient_phrase_boost": 1.15,
      "ner_max_codepoints": 4000,
      "ner_types": [
        "code_ref",
        "organisation",
        "person",
        "hashtag"
      ],
      "ner_max_tokens": 2,
      "large_hit_count": 50,
      "min_hit_df": 2,
      "large_min_hit_df": 3,
      "generic_min_corpus": 10,
      "generic_df_fraction": 0.6,
      "min_lift": 1.3,
      "phrase_boost": 1.2,
      "pool_multiplier": 6,
      "cooccurrence_base": 0.5,
      "ner_boost": 1.5,
      "evidence_limit": 5
    },
    "pipeline": {
      "corpus_cache_entries": 4,
      "stats_cache_entries": 4,
      "search_query_limit": 5000,
      "unit_min_docs": 2,
      "unit_max_docs": 300,
      "unit_relevance_fraction": 0.3,
      "prose_preference_threshold": 20,
      "analysis_max_codepoints": 20000,
      "graph_salient_terms": 10,
      "graph_max_entities": 20,
      "fallback_term_weight": 0.5,
      "global_min_docs": 10,
      "global_df_fraction": 0.35,
      "cluster_min_df": 2,
      "cluster_min_docs": 3,
      "theme_terms": 12,
      "label_terms": 3,
      "max_themes": 12,
      "global_terms": 15,
      "manifest_seed_limit": 12,
      "auto_hits_divisor": 10,
      "auto_hits_min": 25,
      "auto_hits_max": 200,
      "standalone_hits": 150,
      "synthesis_seed_weight": 0.5,
      "theme_link_weight": 0.5,
      "graph_poll_interval": 25,
      "items_poll_interval": 200,
      "status_artifact_limit": 1000,
      "prose_excluded_kinds": [
        "code",
        "commit"
      ],
      "materialize_excluded_types": [
        "implementation"
      ],
      "derived_from_weight": 1.0,
      "item_relation_weight": 1.0,
      "initial_seed_weight": 1.0,
      "standalone_max_new_terms": 10,
      "item_node_label_max_codepoints": 90,
      "run_poll_interval_ms": 20,
      "stage_attempts": 2,
      "run_attempts": 1
    },
    "refinement": {
      "model_keys": [
        "semantic_model",
        "default_model"
      ],
      "confidence_threshold": 0.6,
      "excluded_types": [
        "implementation"
      ],
      "max_items": 100,
      "batch_size": 25,
      "max_item_codepoints": 300,
      "temperature": 0,
      "max_tokens": 1500,
      "timeout_ms": 60000,
      "confidence_floor": 0.7,
      "title": "ChatADHD-Archive",
      "prompt": "Classify each numbered sentence from a project archive as one of: idea, decision, rejected_option, open_question, implementation, bug, requirement, invariant, rationale, none. Sentences may be Polish or English. Reply with only a JSON array of objects {\"i\": <number>, \"type\": <label>}.\n\n"
    },
    "clustering": {
      "max_local_passes": 100,
      "max_levels": 10,
      "gain_tolerance": 1e-12
    },
    "config_bounds": {
      "max_passes": {
        "minimum": 1,
        "maximum": 20
      },
      "max_new_terms": {
        "minimum": 0,
        "maximum": 100
      },
      "max_hits_per_term": {
        "minimum": 0,
        "maximum": 5000
      },
      "max_synthesis_rounds": {
        "minimum": 0,
        "maximum": 5
      }
    },
    "config_defaults": {
      "sources": [],
      "repo": null,
      "code": true,
      "git": true,
      "seed_terms": [],
      "out_dir": "",
      "project": "",
      "max_passes": 3,
      "max_new_terms": 8,
      "max_hits_per_term": 0,
      "max_synthesis_rounds": 1,
      "llm": "off",
      "include_db": false,
      "exclude": [],
      "max_file_bytes": 1000000,
      "force": false
    },
    "titles": {
      "doc": "[Doc] {uri}",
      "code": "[Code] {uri}",
      "chat": "[Chat] {title}",
      "project": "[Project] {name}",
      "memory": "[Memory] Claude memories",
      "git": "[Git] {repo}",
      "project_document": "Project: {name}",
      "memory_document": "Claude memory",
      "untitled_chat": "(untitled)",
      "untitled_project": "(project)",
      "project_description_label": "description",
      "project_instructions_label": "instructions",
      "project_document_fallback": "doc",
      "memory_conversations_label": "conversations memory",
      "memory_project_label": "project memory {key}",
      "import_strip_prefix": "[Import] ",
      "line_label": "L{line}",
      "chat_label": "#{ordinal} {role}",
      "section_label": "{label} › {heading}",
      "commit_label": "{hash} {subject}",
      "commit_more_files": "\n(+{count} more)",
      "db_chat_label": "#{ordinal} {role}{version}",
      "earlier_version_suffix": " (earlier version)"
    },
    "projection": {
      "doc_label_max_codepoints": 120,
      "section_label_max_codepoints": 120,
      "git_hash_prefix_bytes": 7,
      "git_subject_max_codepoints": 72,
      "git_text_files": 40,
      "git_extra_files": 200,
      "memory_project_key_prefix_bytes": 8
    },
    "git": {
      "strip_trailers": true,
      "trailer_key_min_bytes": 1,
      "trailer_key_max_bytes_exclusive": 30,
      "trailer_forbidden_key_chars": [
        " "
      ],
      "trailer_required_key_fragments": [
        "-"
      ]
    },
    "markdown": {
      "section_max_bytes": 4000
    },
    "output": {
      "mime_rules": [
        {
          "suffix": ".md",
          "mime": "text/markdown",
          "require_prefix": true
        },
        {
          "suffix": ".csv",
          "mime": "text/csv",
          "require_prefix": true
        },
        {
          "suffix": ".jsonl",
          "mime": "application/x-ndjson",
          "require_prefix": true
        }
      ],
      "default_mime": "application/json",
      "marker_file": ".loom-archive",
      "marker_text": "Generated by `loom archive`. The archive walker skips this directory.\n",
      "task_log_file": "task_log.jsonl"
    },
    "text_item_closure": {
      "phrase_orders": [
        2,
        1
      ],
      "phrase_separators": " -",
      "phrase_output_separator": " ",
      "phrase_distinct_adjacent": true,
      "bullet_max_digits": 4,
      "sentence_terminals": ".!?",
      "sentence_closers": ".!?)\"”'",
      "sentence_openers": "\"„“([*`",
      "sentence_opener_classes": [
        "uppercase",
        "decimal"
      ],
      "abbreviation_terminals": ".",
      "year_min": 1990,
      "year_max": 2100,
      "penalty_target_type": "requirement",
      "question_target_type": "open_question",
      "question_closing_suffixes": [
        ")",
        "*",
        "\""
      ],
      "confidence_multiplier": 100.0,
      "todo_source_kinds": [
        "code"
      ],
      "commit_source_kinds": [
