                    "type": "string"
                  }
                },
                "remove": {
                  "type": "integer",
                  "minimum": 0,
                  "x-setting": "/text/stem_rules/*/remove",
                  "x-consumer": "archive",
                  "maximum": 2147483647
                },
                "replacement": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "x-setting": "/text/stem_rules",
            "x-consumer": "archive",
            "title": "stem rules"
          },
