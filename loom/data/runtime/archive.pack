{
  "schema": "loom.runtime_profile/1",
  "domain": "archive",
  "revision": 1,
  "description": "Exact legacy archive pipeline defaults. Objects merge recursively; lists replace. Existing KB lexicons stopwords_base and item_cues remain canonical and are read with their KB overlay. Reopen runtime after changing either profile.",
  "defaults": {
    "text": {
      "abbreviations": [
        "e",
        "g",
        "i",
        "np",
        "itd",
        "itp",
        "tzn",
        "etc",
        "vs",
        "cf",
        "dr",
        "mr",
        "ms",
        "prof",
        "tj",
        "in",
        "al",
        "no",
        "nr",
        "ok",
        "ang",
        "pl"
      ],
      "glossary": {
        "pamięć": "memory",
        "pamięci": "memory",
        "graf": "graph",
        "grafu": "graph",
        "grafie": "graph",
        "zadanie": "task",
        "zadania": "task",
        "zadań": "task",
        "źródło": "source",
        "źródła": "source",
        "źródeł": "source",
        "szyfrowanie": "encryption",
        "szyfrowania": "encryption",
        "wyszukiwanie": "search",
        "wyszukiwania": "search",
        "rozmowa": "conversation",
        "rozmowy": "conversation",
        "rozmów": "conversation",
        "załączniki": "attachment",
        "załączników": "attachment",
        "głos": "voice",
        "synchronizacja": "sync",
        "synchronizacji": "sync",
        "wykonanie": "execution",
        "wykonania": "execution",
        "środowisko": "environment",
        "środowiska": "environment",
        "wtyczka": "plugin",
        "wtyczki": "plugin",
        "logi": "log",
        "logów": "log",
        "kontekst": "context",
        "kontekstu": "context",
        "dostawca": "provider",
        "providerzy": "provider",
        "providerów": "provider",
        "wersja": "version",
        "wersje": "version",
        "gałąź": "branch",
        "historia": "history",
        "historii": "history",
        "tytuł": "title",
        "tytuły": "title",
        "surowy": "raw",
        "szablon": "template",
        "szablony": "template",
        "polityka": "policy",
        "zdarzenie": "event",
        "zdarzenia": "event",
        "decyzja": "decision",
        "decyzje": "decision",
        "wymagania": "requirement",
        "panele": "panel",
        "model": "model",
        "modele": "model",
        "import": "import",
        "eksport": "export",
        "eksporty": "export",
        "sprzeczności": "contradiction",
        "braki": "gap",
        "chronologia": "timeline",
        "pliki": "file",
        "plików": "file",
        "kod": "code",
        "kodu": "code",
        "testy": "test",
        "testów": "test",
        "magazyn": "store",
        "klucz": "key",
        "klucze": "key",
        "tożsamość": "identity",
        "artefakt": "artifact",
        "artefakty": "artifact",
        "artefaktów": "artifact",
        "widok": "view",
        "widoki": "view",
        "agent": "agent",
        "agenta": "agent",
        "przeglądarka": "browser",
        "terminal": "terminal",
        "punkt": "checkpoint",
        "surowych": "raw",
        "surowe": "raw",
        "surowego": "raw",
        "eksportów": "export",
        "eksportu": "export",
        "oryginału": "source",
        "oryginał": "source",
        "chronologię": "timeline",
        "forków": "fork",
        "forki": "fork",
        "słownika": "vocabulary",
        "słownik": "vocabulary",
        "terminów": "term",
        "tematów": "theme",
        "idei": "idea",
        "decyzji": "decision",
        "scalenie": "merge",
        "materializacja": "materialize",
        "wznowienie": "resume",
        "ponowienie": "retry",
        "wycofanie": "rollback"
      },
      "stem_min_extra_bytes": 2,
      "stem_rules": [
        {
          "suffixes": [
            "ies"
          ],
          "exclude": [],
          "remove": 3,
          "replacement": "y"
        },
        {
          "suffixes": [
            "sses",
            "xes",
            "ches",
            "shes"
          ],
          "exclude": [],
          "remove": 2,
          "replacement": ""
        },
        {
          "suffixes": [
            "s"
          ],
          "exclude": [
            "ss",
            "us",
            "is"
          ],
          "remove": 1,
          "replacement": ""
        }
      ],
      "min_token_codepoints": 3,
      "min_sentence_codepoints": 8,
      "min_sentence_tokens": 2
    },
    "items": {
      "types": [
        "decision",
        "rejected_option",
        "open_question",
        "requirement",
        "invariant",
        "idea",
        "rationale",
        "implementation",
        "bug"
      ],
      "contains_headings": [
        "otwarte decyzje",
        "open question",
        "open decision",
        "nie wolno zgubić",
        "must not lose",
        "otwarte pytania"
      ],
      "requirement_penalty_phrases": [
        "must not",
        "must never"
      ],
      "requirement_penalty": 1.5,
      "question_suffix": "?",
      "question_suffix_score": 2.5,
      "question_prefix": "czy ",
      "question_prefix_cue": "czy",
      "question_prefix_score": 1.0,
      "min_score": 1.5,
      "min_sentence_score": 1.0,
      "min_list_tokens": 3,
      "min_heading_tokens": 5,
      "confidence_base": 0.35,
      "confidence_slope": 0.15,
      "ambiguity_margin": 0.5,
      "ambiguity_penalty": 0.1,
      "confidence_min": 0.3,
      "confidence_max": 0.95,
      "subject_min_token_codepoints": 3,
      "negation_lookback": 3,
      "bug_markers": [
        "FIXME",
        "XXX",
        "HACK"
      ],
      "todo_confidence": 0.6,
      "commit_bug_phrases": [
        "fix",
        "bug",
        "crash*",
        "regression"
      ],
      "commit_confidence": 0.9,
      "text_max_codepoints": 320,
      "sentence_max_bytes": 1200,
      "sentence_min_tokens": 3,
      "relation_types": [
        "decision",
        "rejected_option",
        "requirement",
        "invariant"
      ],
      "idf_offset": 0.1,
      "distinctive_df_min": 3.0,
      "distinctive_df_fraction": 0.3,
      "max_shared_token_items": 200,
      "min_shared_distinctive": 2,
      "min_longer_share": 0.2,
      "supersede_threshold": 0.3,
      "contradict_threshold": 0.5,
      "resolution_threshold": 0.35
    },
    "code": {
      "extensions": {
        ".c": "c",
        ".h": "cpp",
        ".cc": "cpp",
        ".cpp": "cpp",
        ".cxx": "cpp",
        ".hh": "cpp",
        ".hpp": "cpp",
        ".hxx": "cpp",
        ".ipp": "cpp",
        ".py": "python",
        ".pyi": "python",
        ".kt": "kotlin",
        ".kts": "kotlin",
        ".java": "java",
        ".js": "javascript",
        ".mjs": "javascript",
        ".jsx": "javascript",
        ".ts": "typescript",
        ".tsx": "typescript",
        ".go": "go",
        ".rs": "rust",
        ".swift": "swift",
        ".m": "objc",
        ".mm": "objc",
        ".cs": "csharp",
        ".rb": "ruby",
        ".php": "php",
        ".sh": "shell",
        ".bash": "shell",
        ".cmake": "cmake",
        ".gradle": "gradle",
        ".proto": "proto",
        ".sql": "sql",
        ".dart": "dart",
        ".scala": "scala",
        ".lua": "lua",
        ".r": "r",
        ".jl": "julia",
        ".zig": "zig",
        ".vue": "vue",
        ".svelte": "svelte"
      },
      "filenames": {
        "CMakeLists.txt": "cmake",
        "Makefile": "make",
        "makefile": "make",
        "Dockerfile": "docker"
      },
      "non_functions": [
        "if",
        "for",
        "while",
        "switch",
        "return",
        "catch",
        "sizeof",
        "decltype",
        "static_assert",
        "alignof",
        "defined",
        "else",
        "do",
        "new",
        "delete",
        "throw",
        "assert",
        "LOOM_TRY",
        "LOOM_TRY_ASSIGN",
        "TEST_CASE",
        "SUBCASE",
        "CHECK",
        "REQUIRE",
        "extern"
      ],
      "modifiers": [
        "export ",
        "public ",
        "private ",
        "internal ",
        "open ",
        "abstract ",
        "final ",
        "data ",
        "sealed ",
        "static ",
        "pub ",
        "async ",
        "inline ",
        "template<",
        "extern \"C\" "
      ],
      "type_words": [
        "class",
        "struct",
        "interface",
        "enum class",
        "enum struct",
        "enum",
        "object",
        "trait",
        "protocol",
        "union",
        "namespace",
        "fun",
        "func",
        "fn",
        "function",
        "typealias",
        "type"
      ],
      "todo_markers": [
        "TODO",
        "FIXME",
        "XXX",
        "HACK"
      ],
      "cmake_commands": [
        "add_library(",
        "add_executable(",
        "option(",
        "project("
      ],
      "c_like": [
        "c",
        "cpp",
        "java",
        "kotlin",
        "javascript",
        "typescript",
        "go",
        "rust",
        "swift",
        "objc",
        "csharp",
        "php",
        "gradle",
        "proto",
        "dart",
        "scala",
        "zig",
        "vue",
        "svelte"
      ],
      "hash_comments": [
        "python",
        "shell",
        "cmake",
        "ruby",
        "make",
        "docker",
        "r",
        "julia"
      ],
      "max_uses": 500,
      "min_comment_tokens": 3,
      "max_digest_symbols": 200,
      "comment_budget_bytes": 12000,
      "max_extra_symbols": 400
    },
    "scan": {
      "skip_dirs": [
        ".git",
        "build",
        "node_modules",
        "third_party",
        "vendor",
        "__pycache__",
        ".venv",
        "venv",
        "env",
        "dist",
        "target",
        ".gradle",
        ".idea",
        ".vscode",
        ".cache",
        ".pytest_cache",
        ".mypy_cache",
        "Pods",
        "DerivedData",
        ".tox",
        "site-packages",
        "fixtures",
        "testdata",
        ".next",
        ".svn",
        ".hg",
        "out",
        ".claude"
      ],
      "document_extensions": [
        ".md",
        ".markdown",
        ".txt",
        ".rst",
        ".adoc",
        ".org"
      ],
      "import_extensions": [
        ".jsonl",
        ".ndjson",
        ".html",
        ".htm",
        ".mht",
        ".mhtml",
        ".db",
        ".sqlite",
        ".sqlite3",
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
      ],
      "max_unknown_text_bytes": 2000000,
      "text_user_threshold": 2,
      "text_assistant_threshold": 2,
      "title_lines": 3,
      "db_query_limit": 1000000,
      "readme_seed_limit": 6,
      "checkpoint_seconds": 10
    },
    "synthesis": {
      "external_names": [
        "ChatGPT",
        "GitHub",
        "PolyForm",
        "ThreadSanitizer",
        "UBSan",
        "AddressSanitizer",
        "CMakeLists",
        "OpenSSL",
        "CPython",
        "MiniLM",
        "CamelCase",
        "OpenRouter",
        "SQLite",
        "JavaScript",
        "TypeScript",
        "PyPI",
        "OpenAI",
        "DeepSeek",
        "MacOS",
        "iOS",
        "YouTube",
        "LinkedIn",
        "PowerPoint",
        "JSONL",
        "WebSocket",
        "OkHttp",
        "CMake",
        "LLMs",
        "APIs",
        "IDs",
        "URLs",
        "UUIDs",
        "JSONs",
        "PDFs",
        "GPUs",
        "VMs",
        "macOS",
        "iPhone",
        "WhatsApp",
        "LaTeX",
        "NumPy",
        "PyTorch",
        "GitLab"
      ],
      "source_extensions": [
        ".py",
        ".cpp",
        ".h",
        ".hpp",
        ".kt",
        ".ts",
        ".tsx",
        ".js",
        ".md",
        ".cc",
        ".java",
        ".swift",
        ".rs",
        ".go"
      ],
      "sections": [
        {
          "title": "5. Decisions",
          "type": "decision",
          "cap": 40,
          "inactive": true
        },
        {
          "title": "6. Rejected options",
          "type": "rejected_option",
          "cap": 25,
          "inactive": true
        },
        {
          "title": "7. Open questions",
          "type": "open_question",
          "cap": 40,
          "inactive": false
        },
        {
          "title": "8. Requirements",
          "type": "requirement",
          "cap": 40,
          "inactive": false
        },
        {
          "title": "9. Invariants",
          "type": "invariant",
          "cap": 30,
          "inactive": false
        },
        {
          "title": "10. Ideas",
          "type": "idea",
          "cap": 20,
          "inactive": false
        }
      ],
      "kind_labels": {
        "chat": "chat messages",
        "doc": "document sections",
        "code": "code files",
        "commit": "commits",
        "project": "project docs",
        "memory": "memories"
      },
      "spec_kinds": [
        "doc",
        "project",
        "memory"
      ],
      "prefix_match_bytes": 6,
      "evidence_files": 3,
      "partial_fraction": 0.5,
      "named_min_bytes": 4,
      "inflection_max_bytes": 2,
      "title_phrase_min_tokens": 2,
      "title_phrase_max_tokens": 3,
      "title_word_min_bytes": 3,
      "feature_max_codepoints": 70,
      "section_min_features": 2,
      "theme_gap_min_docs": 3,
      "todo_limit": 60,
      "reason_limit": 3,
      "theme_term_limit": 10,
      "theme_doc_limit": 4,
      "timeline_head": 6,
      "timeline_tail": 6,
      "edge_limit": 40,
      "phrase_gap_limit": 15,
      "component_gap_limit": 20,
      "section_gap_limit": 10,
      "missing_feature_limit": 4,
      "section_gap_min_features": 3,
      "section_gap_coverage_fraction": 0.5,
      "discovered_min_df": 2,
      "discovered_limit": 8
    },
    "vocabulary": {
      "camel_min_length": 4,
      "camel_min_uppercase": 2,
      "salient_min_df": 2,
      "salient_max_df_fraction": 0.5,
      "salient_phrase_boost": 1.15,
      "ner_max_codepoints": 4000,
      "ner_types": [
        "code_ref",
        "organisation",
        "person",
        "hashtag"
      ],
      "ner_max_tokens": 2,
      "large_hit_count": 50,
      "min_hit_df": 2,
      "large_min_hit_df": 3,
      "generic_min_corpus": 10,
      "generic_df_fraction": 0.6,
      "min_lift": 1.3,
      "phrase_boost": 1.2,
      "pool_multiplier": 6,
      "cooccurrence_base": 0.5,
      "ner_boost": 1.5,
      "evidence_limit": 5
    },
    "pipeline": {
      "corpus_cache_entries": 4,
      "stats_cache_entries": 4,
      "search_query_limit": 5000,
      "unit_min_docs": 2,
      "unit_max_docs": 300,
      "unit_relevance_fraction": 0.3,
      "prose_preference_threshold": 20,
      "analysis_max_codepoints": 20000,
      "graph_salient_terms": 10,
      "graph_max_entities": 20,
      "fallback_term_weight": 0.5,
      "global_min_docs": 10,
      "global_df_fraction": 0.35,
      "cluster_min_df": 2,
      "cluster_min_docs": 3,
      "theme_terms": 12,
      "label_terms": 3,
      "max_themes": 12,
      "global_terms": 15,
      "manifest_seed_limit": 12,
      "auto_hits_divisor": 10,
      "auto_hits_min": 25,
      "auto_hits_max": 200,
      "standalone_hits": 150,
      "synthesis_seed_weight": 0.5,
      "theme_link_weight": 0.5,
      "graph_poll_interval": 25,
      "items_poll_interval": 200,
      "status_artifact_limit": 1000
    },
    "refinement": {
      "model_keys": [
        "semantic_model",
        "default_model"
      ],
      "confidence_threshold": 0.6,
      "excluded_types": [
        "implementation"
      ],
      "max_items": 100,
      "batch_size": 25,
      "max_item_codepoints": 300,
      "temperature": 0,
      "max_tokens": 1500,
      "timeout_ms": 60000,
      "confidence_floor": 0.7,
      "title": "ChatADHD-Archive",
      "prompt": "Classify each numbered sentence from a project archive as one of: idea, decision, rejected_option, open_question, implementation, bug, requirement, invariant, rationale, none. Sentences may be Polish or English. Reply with only a JSON array of objects {\"i\": <number>, \"type\": <label>}.\n\n"
    },
    "clustering": {
      "max_local_passes": 100,
      "max_levels": 10,
      "gain_tolerance": 1e-12
    }
  },
  "value_schema": {
    "type": "object",
    "required": [
      "text",
      "items",
      "code",
      "scan",
      "synthesis",
      "vocabulary",
      "pipeline",
      "refinement",
      "clustering"
    ],
    "properties": {
      "text": {
        "type": "object",
        "required": [
          "abbreviations",
          "glossary",
          "stem_min_extra_bytes",
          "stem_rules",
          "min_token_codepoints",
          "min_sentence_codepoints",
          "min_sentence_tokens"
        ],
        "properties": {
          "abbreviations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "x-setting": "/text/abbreviations",
            "x-consumer": "archive",
            "title": "abbreviations"
          },
          "glossary": {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "type": "string"
            },
            "x-setting": "/text/glossary",
            "x-consumer": "archive",
            "title": "glossary"
          },
          "stem_min_extra_bytes": {
            "type": "integer",
            "minimum": 0,
            "x-setting": "/text/stem_min_extra_bytes",
            "x-consumer": "archive",
            "maximum": 2147483647,
            "title": "stem min extra bytes",
            "x-unit": "bytes"
          },
          "stem_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "suffixes",
                "exclude",
                "remove",
                "replacement"
              ],
              "properties": {
                "suffixes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exclude": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "remove": {
                  "type": "integer",
                  "minimum": 0,
                  "x-setting": "/text/stem_rules/*/remove",
                  "x-consumer": "archive",
                  "maximum": 2147483647
                },
                "replacement": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "x-setting": "/text/stem_rules",
            "x-consumer": "archive",
            "title": "stem rules"
          },
          "min_token_codepoints": {
            "type": "integer",
            "minimum": 0,
            "x-setting": "/text/min_token_codepoints",
            "x-consumer": "archive",
            "maximum": 2147483647,
            "title": "min token codepoints",
            "x-unit": "Unicode codepoints"
          },
          "min_sentence_codepoints": {
            "type": "integer",
            "minimum": 0,
            "x-setting": "/text/min_sentence_codepoints",
            "x-consumer": "archive",
            "maximum": 2147483647,
            "title": "min sentence codepoints",
            "x-unit": "Unicode codepoints"
          },
          "min_sentence_tokens": {
            "type": "integer",
            "minimum": 0,
            "x-setting": "/text/min_sentence_tokens",
            "x-consumer": "archive",
            "maximum": 2147483647,
            "title": "min sentence tokens"
          }
        },
        "additionalProperties": false,
        "x-setting": "/text",
        "x-consumer": "archive",
        "title": "text"
      },
      "items": {
        "type": "object",
        "required": [
          "types",
          "contains_headings",
          "requirement_penalty_phrases",
          "requirement_penalty",
          "question_suffix",
          "question_suffix_score",
          "question_prefix",
          "question_prefix_cue",
          "question_prefix_score",
          "min_score",
          "min_sentence_score",
          "min_list_tokens",
          "min_heading_tokens",
          "confidence_base",
          "confidence_slope",
          "ambiguity_margin",
          "ambiguity_penalty",
          "confidence_min",
          "confidence_max",
          "subject_min_token_codepoints",
          "negation_lookback",
          "bug_markers",
          "todo_confidence",
          "commit_bug_phrases",
          "commit_confidence",
          "text_max_codepoints",
          "sentence_max_bytes",
          "sentence_min_tokens",
          "relation_types",
          "idf_offset",
          "distinctive_df_min",
          "distinctive_df_fraction",
          "max_shared_token_items",
          "min_shared_distinctive",
          "min_longer_share",
          "supersede_threshold",
          "contradict_threshold",
          "resolution_threshold"
        ],
        "properties": {
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "x-setting": "/items/types",
            "x-consumer": "archive",
            "title": "types"
          },
          "contains_headings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "x-setting": "/items/contains_headings",
            "x-consumer": "archive",
            "title": "contains headings"
          },
          "requirement_penalty_phrases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "x-setting": "/items/requirement_penalty_phrases",
            "x-consumer": "archive",
            "title": "requirement penalty phrases"
          },
          "requirement_penalty": {
            "type": "number",
            "x-setting": "/items/requirement_penalty",
            "x-consumer": "archive",
            "title": "requirement penalty"
          },
          "question_suffix": {
            "type": "string",
            "x-setting": "/items/question_suffix",
            "x-consumer": "archive",
            "title": "question suffix"
          },
          "question_suffix_score": {
            "type": "number",
            "x-setting": "/items/question_suffix_score",
            "x-consumer": "archive",
            "title": "question suffix score"
