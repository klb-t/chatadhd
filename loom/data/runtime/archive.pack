    },
    "vocab_closure": {
      "camel_min_lowercase": 1,
      "camel_require_inner_uppercase": true,
      "score_multiplier": 10000.0,
      "reason_score_precision": 3,
      "reason_lift_precision": 1
    },
    "synthesis_rendering": {
      "display": {
        "item_codepoints": 260,
        "dedup_codepoints": 120,
        "superseded_codepoints": 90,
        "section_heading_codepoints": 140,
        "feature_codepoints": 100,
        "evidence_feature_codepoints": 60,
        "todo_codepoints": 140,
        "fork_title_codepoints": 60,
        "edge_codepoints": 140,
        "missing_features_codepoints": 160,
        "manifest_item_codepoints": 240,
        "graph_item_codepoints": 100
      },
      "identifiers": {
        "require_uppercase_initial": true,
        "exclude_plural_acronyms": true,
        "plural_acronym_suffixes": [
          "s"
        ],
        "inflection_min_base_bytes": 4,
        "inflection_require_lowercase_suffix": true,
        "exclude_project_name": true
      },
      "interfaces": {
        "prefixes": [
          "I"
        ],
        "minimum_bytes": 3,
        "require_uppercase_after_prefix": true
      },
      "component_evidence": {
        "declaration_files": 3,
        "used_files": 2,
        "comment_files": 2
      },
      "feature_terms": {
        "separators": [
          " — ",
          " – ",
          " - ",
          ": "
        ],
        "minimum_tokens": 1,
        "maximum_tokens": 5
      },
      "selection": {
        "active_statuses": [
          "active",
          "contested"
        ],
        "deprioritized_doc_kinds": [
          "code",
          "commit"
        ],
        "manifest_items": 80,
