      "vocab_closure",
      "synthesis_rendering"
    ],
    "properties": {
      "text": {
        "type": "object",
        "required": [
          "abbreviations",
          "glossary",
          "stem_min_extra_bytes",
          "stem_rules",
          "min_token_codepoints",
          "min_sentence_codepoints",
          "min_sentence_tokens"
        ],
        "properties": {
          "abbreviations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "x-setting": "/text/abbreviations",
            "x-consumer": "archive",
            "title": "abbreviations"
          },
          "glossary": {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "type": "string"
            },
