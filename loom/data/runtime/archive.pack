          "requirement",
          "open_question",
          "invariant"
        ],
        "graph_excluded_item_types": [
          "implementation"
        ],
        "question_summary_types": [
          "open_question"
        ],
        "answered_statuses": [
          "resolved"
        ]
      },
      "files": {
