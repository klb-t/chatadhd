          },
          {
            "name": "include_unmatched",
            "type": "boolean",
            "required": false,
            "description": {
              "en": "Also list actions whose requirements the element does not meet (status not_applicable, with the missing traits)",
              "pl": "Wypisz także akcje, których wymagań element nie spełnia (status not_applicable, z brakującymi cechami)"
            },
            "has_default": true,
            "edit": "toggle",
            "default": false
          }
        ],
        "http": {
          "verb": "POST",
          "path": "/api/actions/for"
        }
      },
      "actions.explain": {
        "id": "actions.explain",
        "kind": "atomic",
        "status": "implemented",
        "title": "Explain one action for an element",
        "description": "Why an action does or does not fit an element: traits matched or missing (and where each came from), every rule considered and the one that decided; when traits are missing, the chain proposals that would supply them.",
        "labels": {
          "pl": "Wyjaśnij jedną akcję dla elementu"
        },
        "inputs": [
          "json"
        ],
        "outputs": [
          "json"
        ],
        "requires": [
          "application"
        ],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 0.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": false
        },
        "consumer": "loom/src/actions/action_rules.cpp",
        "port": "actions",
        "action": "explain",
        "params": [
          {
            "name": "element",
            "type": "object",
            "required": true,
            "description": {
              "en": "The element: {\"class\": class id, \"traits\": [extra traits], \"attrs\": {...}, \"id\": optional}",
              "pl": "Element: {\"class\": id klasy, \"traits\": [dodatkowe cechy], \"attrs\": {...}, \"id\": opcjonalnie}"
            },
            "has_default": false,
            "edit": "json"
          },
          {
            "name": "action",
            "type": "string",
            "required": true,
            "description": {
              "en": "Action id from the catalogue",
              "pl": "Identyfikator akcji z katalogu"
            },
            "has_default": false,
            "edit": "choice:actions"
          },
          {
            "name": "scope",
            "type": "string",
            "required": false,
            "description": {
              "en": "Scope level of the scopes chain, or an object {level: instance id}; default: the most specific level",
              "pl": "Poziom łańcucha zakresów albo obiekt {poziom: id}; domyślnie najbardziej szczegółowy"
            },
            "has_default": false,
            "edit": "free_text"
          }
        ],
        "http": {
          "verb": "POST",
          "path": "/api/actions/explain"
        }
      },
      "actions.propose_chain": {
        "id": "actions.propose_chain",
        "kind": "atomic",
        "status": "implemented",
        "title": "Propose a chain of actions",
        "description": "Candidate chains of actions that make a missing trait (or the requirements of a target action) available, ranked by declared cost and confidence and bounded by the extrapolation preset. Proposals only: nothing is executed.",
        "labels": {
          "pl": "Zaproponuj łańcuch akcji"
        },
        "inputs": [
          "json"
        ],
        "outputs": [
          "json"
        ],
        "requires": [
          "application"
        ],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 0.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": false
        },
        "consumer": "loom/src/actions/action_rules.cpp",
        "port": "actions",
        "action": "propose_chain",
        "params": [
          {
            "name": "element",
            "type": "object",
            "required": true,
            "description": {
              "en": "The element: {\"class\": class id, \"traits\": [extra traits], \"attrs\": {...}, \"id\": optional}",
              "pl": "Element: {\"class\": id klasy, \"traits\": [dodatkowe cechy], \"attrs\": {...}, \"id\": opcjonalnie}"
            },
            "has_default": false,
            "edit": "json"
          },
          {
            "name": "target_trait",
            "type": "string",
            "required": false,
            "description": {
              "en": "The trait the element should get",
              "pl": "Cecha, którą element ma zyskać"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "target_action",
            "type": "string",
            "required": false,
            "description": {
              "en": "The action the element should become fit for",
              "pl": "Akcja, do której element ma się nadać"
            },
            "has_default": false,
            "edit": "choice:actions"
          },
          {
            "name": "scope",
            "type": "string",
            "required": false,
            "description": {
              "en": "Scope level of the scopes chain, or an object {level: instance id}; default: the most specific level",
              "pl": "Poziom łańcucha zakresów albo obiekt {poziom: id}; domyślnie najbardziej szczegółowy"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "preset",
            "type": "string",
            "required": false,
            "description": {
              "en": "Extrapolation preset (off disables proposals); default: the active preset",
              "pl": "Preset ekstrapolacji (off wyłącza propozycje); domyślnie aktywny"
            },
            "has_default": false,
            "edit": "choice:extrapolation_presets"
          },
          {
            "name": "max_length",
            "type": "integer",
            "required": false,
            "description": {
              "en": "Longest chain; absent = the preset value, null = no bound",
              "pl": "Najdłuższy łańcuch; brak = wartość presetu, null = bez ograniczenia"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "max_cost",
            "type": "number",
            "required": false,
            "description": {
              "en": "Largest total declared cost; absent = the preset value, null = no bound",
              "pl": "Największy łączny koszt; brak = wartość presetu, null = bez ograniczenia"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "min_confidence",
            "type": "number",
            "required": false,
            "description": {
              "en": "Lowest total confidence; absent = the preset value, null = no bound",
              "pl": "Najniższa łączna pewność; brak = wartość presetu, null = bez ograniczenia"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "max_results",
            "type": "integer",
            "required": false,
            "description": {
              "en": "How many chains to return; absent = the preset value, null = all",
              "pl": "Ile łańcuchów zwrócić; brak = wartość presetu, null = wszystkie"
            },
            "has_default": false,
            "edit": "free_text"
          }
        ],
        "http": {
          "verb": "POST",
          "path": "/api/actions/propose_chain"
        }
      }
    }
  },
  "value_schema": {
    "type": "object",
    "required": [
      "schema",
      "actions"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "enum": [
          "loom.action_catalogue/1"
        ]
      },
      "actions": {
        "type": "object",
        "description": "Action id -> declaration.",
        "x-setting": "/actions",
        "x-consumer": "loom::llm::use_model",
        "additionalProperties": {
          "type": "object",
          "required": [
            "id",
            "kind",
            "status",
            "inputs",
            "outputs",
            "requires",
            "effects"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "atomic",
                "composite"
              ],
              "description": "atomic: implemented in code; composite: steps of other actions."
            },
            "status": {
              "type": "string",
              "enum": [
                "implemented",
                "planned"
              ],
              "description": "planned: declared, not callable yet."
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "description": "Composite only: the actions run in order.",
              "items": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "text",
                  "json",
                  "image",
                  "audio",
                  "video",
                  "embedding",
                  "file_ref"
                ]
              },
              "description": "Typed input part kinds the action takes."
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "text",
                  "json",
                  "image",
                  "audio",
                  "video",
                  "embedding",
                  "file_ref"
                ]
              },
              "description": "Typed output part kinds the action returns."
            },
            "requires": {
              "type": "array",
              "description": "Traits the input element must have (all of them). A class id is a trait of its own; classes declare further traits in graph/classes.pack.",
              "items": {
                "type": "string"
              }
            },
            "produces": {
              "type": "array",
              "description": "Traits of the output element (a produced class id stands for the traits of that class).",
              "items": {
                "type": "string"
              }
            },
            "content_op": {
              "type": "string",
              "description": "What the action does to the content: preserve, condense, expand, restyle, evaluate, combine or none (open list, see action_rules axes)."
            },
            "form_op": {
              "type": "string",
              "description": "read (form to content), express (content to form) or none (open list)."
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "description": "Declared relative cost (1 = one ordinary model call); ranks chain proposals, never a limit."
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Declared confidence that the result keeps what the caller meant (0..1); ranks chain proposals."
            },
            "effects": {
              "type": "object",
              "required": [
                "reads_only",
                "writes",
                "sends_off_device",
                "costs_money",
                "irreversible",
                "touches_private_data"
              ],
              "properties": {
                "reads_only": {
                  "type": "boolean"
                },
                "writes": {
                  "type": "boolean"
                },
                "sends_off_device": {
                  "type": "boolean"
                },
                "costs_money": {
                  "type": "boolean"
                },
                "irreversible": {
                  "type": "boolean"
                },
                "touches_private_data": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "consumer": {
              "type": "string",
              "description": "Where the action is called from today."
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": false
  }
}
