{
  "schema": "loom.runtime_profile/1",
  "domain": "actions",
  "revision": 1,
  "description": "Catalogue of actions: ONE kind of entity. An action is atomic (implemented by code or an adapter: use_model, save, share) or composite (steps of other actions, defined here as data). Both have the same shape: declared typed inputs and outputs, effect flags and a status, plus what the matching engine (loom/include/loom/action_rules.h) needs: `requires` (traits the input element must have; a class id is a trait of its own), `produces` (traits of the output element), the two axes of GRAF_HUB_KOD_SILNIK §6 (`content_op`: what the action does to the content, `form_op`: whether it reads a form into content or expresses content in a form) and the declared `cost` (relative: 1 = one ordinary model call, not money) and `confidence` (0..1) used to rank chains. A new action fits every existing class whose traits meet its `requires` without editing the class. Which of the fitting actions are default, need confirmation or are denied is decided by the rules (data/runtime/action_rules.pack). A call to use_model may name its action; an unknown, planned or non-model action is refused before any send. Entries with port/action are reachable through loom_invoke(port, action, json); their params carry field descriptions (has_default/default/edit) and http the server route. All numbers and ops are calibration, editable in the overlay. Interpreted composites (consumer empty) are run by the interpreter (include/loom/action_run.h): their steps carry the prompts, models, variants and conditions as data.",
  "defaults": {
    "schema": "loom.action_catalogue/1",
    "actions": {
      "use_model": {
        "id": "use_model",
        "kind": "atomic",
        "status": "implemented",
        "title": "Use a model",
        "description": "The one action that calls a language or media model: chosen model(s) with parameters, context and prompt; guarded by the usage policy, with provenance. Implemented by the adapters in code.",
        "why": {
          "pl": "Jedyne działanie, które woła model językowy albo medialny: wybrany model z parametrami, kontekstem i poleceniem, pod strażą zużycia i z zapisem pochodzenia."
        },
        "inputs": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "outputs": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "requires": [],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 1.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": false,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "loom/src/llm/use_model.cpp",
        "labels": {
          "pl": "Użyj modelu"
        },
        "human": {
          "title": {
            "pl": "Użyj modelu",
            "en": "Use a model"
          },
          "steps": [
            {
              "label": {
                "pl": "Wybierz model: podany w kroku, inaczej „Model dla działania” (Twój wybór albo wybór tej rozmowy dla tego działania), inaczej „Model rozmowy” (default_model) z Twoich ustawień",
                "en": "Choose the model: the one the step names, else “Model for an action” (your choice or this conversation’s for this action), else “Conversation model” (default_model) from your settings"
              }
            },
            {
              "label": {
                "pl": "Wybierz dostawcę i adres (llm_provider, base_url, provider_manifests) oraz klucz dostawcy",
                "en": "Choose the provider and the address (llm_provider, base_url, provider_manifests) and the provider key"
              }
            },
            {
              "label": {
                "pl": "Sprawdź możliwości modelu (model_capabilities), Bezpiecznik ×10 i limity wydatków",
                "en": "Check the model capabilities (model_capabilities), the ×10 fuse and the spending limits"
              }
            },
            {
              "label": {
                "pl": "Wyślij żądanie i zapisz zużycie w księdze",
                "en": "Send the request and record the usage in the ledger"
              }
            }
          ],
          "steps_are": "description"
        },
        "reads": [
          "base_url",
          "llm_provider",
          "local_model_base_url",
          "provider_manifests",
          "model_capabilities",
          "default_model",
          "api_key",
          "anthropic_batch_key",
          "groq_api_key",
          "google_speech_api_key",
          "ocr_space_api_key",
          "loom_usage_policy",
          "usage_baseline_key_templates",
          "usage_spend_limits"
        ],
        "uses_role": "chat.default",
        "implemented_in": [
          "loom/src/llm/use_model.cpp",
          "loom/src/providers/providers.cpp",
          "loom/data/runtime/action_run.pack#/defaults/use_model",
          "loom/src/core/config_usage_policy.cpp",
          "loom/src/actions/spend.cpp"
        ]
      },
