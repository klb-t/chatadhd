      "usage.set_limit": {
        "id": "usage.set_limit",
        "kind": "atomic",
        "status": "implemented",
        "title": "Set a usage limit",
        "description": "Two limits of the usage. (1) The growth factor of the usage policy: how many times above the usual consumption an operation may grow before you are asked (the setting loom_usage_policy; raising expected consumption by an order of magnitude still needs your confirmation). (2) A spending limit per period (day, week or month; the setting usage_spend_limits): before an action run that calls a model, the spend of the period plus the estimate of the run is compared with it, and what you chose happens - confirm (the run waits for your yes), deny (the run does not start) or notify (it goes on and says so). There is no limit until you set one; the limit is yours, nothing is added on top of it. The growth guard is separate and stays.",
        "why": {
          "pl": "Ustawia próg bezpiecznika wzrostu zużycia albo limit wydatków na okres."
        },
        "labels": {
          "pl": "Ustaw limit zużycia lub wydatków"
        },
        "inputs": [],
        "outputs": [
          "text"
        ],
        "requires": [
          "settings_field"
        ],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 0.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": false
        },
        "consumer": "loom/src/actions/ops.cpp",
        "stores_result": false,
        "params": [
          {
            "name": "growth_factor",
            "type": "number",
            "required": true,
            "description": {
              "en": "The growth factor (10 is the preset); leave out when setting a spending limit",
              "pl": "Współczynnik wzrostu (preset to 10); pomiń przy limicie wydatków"
            },
            "has_default": false,
            "edit": "free_text",
            "required_unless": [
              "amount",
              "period",
              "clear"
            ]
          },
          {
            "name": "amount",
            "type": "number",
            "required": false,
            "description": {
              "en": "The spending limit of a period, in `currency`",
              "pl": "Limit wydatków na okres, w `currency`"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "currency",
            "type": "string",
            "required": false,
            "description": {
              "en": "The currency of the amount (USD, PLN, EUR ...; USD when not said)",
              "pl": "Waluta kwoty (USD, PLN, EUR ...; domyślnie USD)"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "period",
            "type": "string",
            "required": false,
            "description": {
              "en": "day, week or month",
              "pl": "dzień, tydzień albo miesiąc"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "on_exceed",
            "type": "string",
            "required": false,
            "description": {
              "en": "What happens when the limit is passed: confirm (preset), deny or notify",
              "pl": "Co się dzieje po przekroczeniu: confirm (preset), deny albo notify"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "rate",
            "type": "number",
            "required": false,
            "description": {
              "en": "USD per unit of the currency, when you want your own instead of the approximate preset",
              "pl": "USD za jednostkę waluty, gdy chcesz własny kurs zamiast przybliżonego presetu"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "clear",
            "type": "boolean",
            "required": false,
            "description": {
              "en": "Remove the limit of the period instead of setting one",
              "pl": "Usuń limit okresu zamiast ustawiać"
            },
            "has_default": true,
            "edit": "toggle",
            "default": false
          }
        ],
        "examples": {
          "en": [
            "set the usage growth limit to 20",
            "set a weekly limit of $5",
            "set a monthly limit of 20 PLN, ask me first",
            "remove the weekly spending limit"
          ],
          "pl": [
            "ustaw limit wzrostu zużycia na 20",
            "ustaw limit 20 zł na miesiąc",
            "ustaw tygodniowy limit 5 dolarów, odmawiaj",
            "usuń tygodniowy limit wydatków"
          ]
        },
        "positional_arg": "growth_factor",
        "gate_as": [
          "edit"
        ],
        "element_from_arg": "setting_key",
        "element_arg_defaults": {
          "growth_factor": "loom_usage_policy",
          "amount": "usage_spend_limits",
          "clear": "usage_spend_limits",
          "period": "usage_spend_limits"
        }
      },
