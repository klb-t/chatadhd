      "analysis.run": {
        "id": "analysis.run",
        "kind": "composite",
        "status": "implemented",
        "title": "Run a reviewed analysis",
        "description": "A prepared analysis contract request (prompt contract, exact body bytes, reviewed by the owner) executed once, admitted by the usage policy, its first response retained before decoding and bound to a method version in the graph.",
        "why": {
          "pl": "Wykonuje raz przygotowaną i przejrzaną analizę (kontrakt polecenia, dokładne bajty), pod polityką zużycia, z wynikiem związanym z wersją metody."
        },
        "steps": [
          {
            "action": "use_model"
          }
        ],
        "inputs": [
          "text",
          "json"
        ],
        "outputs": [
          "text",
          "json"
        ],
        "requires": [
          "analysis_contract"
        ],
        "produces": [
          "analysis_result"
        ],
        "content_op": "evaluate",
        "form_op": "none",
        "cost": 2.0,
        "confidence": 0.8,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "loom/server/src/analysis-ui-routes.h",
        "labels": {
          "pl": "Uruchom przejrzaną analizę"
        },
        "human": {
          "title": {
            "pl": "Uruchom przejrzaną analizę",
            "en": "Run a reviewed analysis"
          },
          "steps": [
            {
              "label": {
                "pl": "Weź przygotowane żądanie analizy (kontrakt promptu, dokładne bajty), przejrzane przez właściciela",
                "en": "Take the prepared analysis request (prompt contract, exact bytes), reviewed by the owner"
              }
            },
            {
              "label": {
                "pl": "Model: podany w żądaniu albo semantic_model; adres i klucz z base_url i api_key",
                "en": "The model: the one in the request, else semantic_model; the address and key from base_url and api_key"
              }
            },
            {
              "label": {
                "pl": "Wykonaj raz pod Bezpiecznikiem ×10 i limitami wydatków i zapisz pierwszą odpowiedź przed dekodowaniem",
                "en": "Run it once under the ×10 fuse and the spending limits and keep the first response before decoding"
              }
            }
          ],
          "steps_are": "description"
        },
        "reads": [
          "semantic_model",
          "base_url",
          "api_key",
          "analysis_prompt_dir",
          "analysis_prompt_overrides"
        ],
        "uses_role": "analysis.fast",
        "implemented_in": [
          "loom/server/src/analysis-ui-routes.h"
        ]
      },
