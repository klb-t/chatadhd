      },
      "parody": {
        "id": "parody",
        "kind": "composite",
        "status": "implemented",
        "title": "Parody",
        "description": "Change the tone or style of a text content while keeping its subject and recognisable structure. The style is the argument style.",
        "labels": {
          "pl": "Sparodiuj"
        },
        "steps": [
          {
            "action": "use_model",
            "with": {
              "system": {
                "$localized": {
                  "en": "You write parodies. Keep the subject and the recognisable structure of the original, exaggerate its manner in the requested style for comic effect, and add no commentary. Answer in the language of the text.",
                  "pl": "Piszesz parodie. Zachowaj temat i rozpoznawalną strukturę oryginału, wyolbrzymiaj jego manierę w zadanym stylu dla efektu komicznego i nie dodawaj komentarzy. Odpowiadaj w języku tekstu."
                }
              },
              "prompt": {
                "$format": {
                  "$localized": {
                    "en": "Write a parody of the text above in this style: {style}.",
                    "pl": "Napisz parodię powyższego tekstu w tym stylu: {style}."
                  }
                },
                "vars": {
                  "style": {
                    "$arg": "style",
                    "default": {
                      "$localized": {
                        "en": "light, good-natured satire",
                        "pl": "lekka, życzliwa satyra"
                      }
                    }
                  }
                }
              },
              "parameters": {
                "temperature": 0.9
              }
            }
          }
        ],
        "inputs": [
          "text"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "has_text"
        ],
        "produces": [
          "has_text"
        ],
        "content_op": "restyle",
        "form_op": "none",
        "cost": 1.0,
        "confidence": 0.7,
        "effects": {
