{
  "schema": "loom.runtime_profile/1",
  "domain": "actions",
  "revision": 1,
  "description": "Catalogue of actions: ONE kind of entity. An action is atomic (implemented by code or an adapter: use_model, save, share) or composite (steps of other actions, defined here as data). Both have the same shape: declared typed inputs and outputs, required traits of the input element, effect flags and a status. A call to use_model may name its action; an unknown, planned or non-model action is refused before any send. Matching elements to actions is a later wave. Entries with port/action are reachable through loom_invoke(port, action, json); their params carry field descriptions (has_default/default/edit) and http the server route.",
  "defaults": {
    "schema": "loom.action_catalogue/1",
    "actions": {
      "use_model": {
        "id": "use_model",
        "kind": "atomic",
        "status": "implemented",
        "title": "Use a model",
        "description": "The one action that calls a language or media model: chosen model(s) with parameters, context and prompt; guarded by the usage policy, with provenance. Implemented by the adapters in code.",
        "inputs": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "outputs": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "requires": [],
        "effects": {
          "reads_only": false,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "loom/src/llm/use_model.cpp"
      },
      "save": {
        "id": "save",
        "kind": "atomic",
        "status": "planned",
        "title": "Save",
        "description": "Persist the given element in a chosen memory.",
        "inputs": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "outputs": [],
        "requires": [],
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": false
        },
        "consumer": ""
      },
      "share": {
        "id": "share",
        "kind": "atomic",
        "status": "planned",
        "title": "Share",
        "description": "Hand the given element to another person or service.",
        "inputs": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "outputs": [],
        "requires": [],
        "effects": {
          "reads_only": false,
          "writes": false,
          "sends_off_device": true,
          "costs_money": false,
          "irreversible": true,
          "touches_private_data": true
        },
        "consumer": ""
      },
      "chat.send": {
        "id": "chat.send",
        "kind": "composite",
        "status": "implemented",
        "title": "Send a chat message",
        "description": "A user message in a conversation, answered by the selected model (buffered or streamed); history, memory and graph context are the input.",
        "steps": [
          {
