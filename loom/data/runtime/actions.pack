      "chat.route": {
        "id": "chat.route",
        "kind": "atomic",
        "status": "implemented",
        "title": "Route a chat input",
        "description": "Decides whether a chat input is a message or a command to the interface (R54) and, for a command, which action on which element, with the plan, cost estimate and what needs confirmation. Nothing is stored or executed. The same decision is made for every input of the chat window before it is sent.",
        "why": {
          "pl": "Rozstrzyga, czy wpis w okienku rozmowy jest wiadomością, czy poleceniem, i dla polecenia daje plan; niczego nie zapisuje."
        },
        "labels": {
          "pl": "Rozpoznaj wejście z okienka rozmowy"
        },
        "inputs": [
          "json"
        ],
        "outputs": [
          "json"
        ],
        "requires": [
          "user_input"
        ],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 0.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": false
        },
        "consumer": "loom/src/actions/route.cpp",
        "port": "chat",
        "action": "route",
        "params": [
          {
            "name": "text",
            "type": "string",
            "required": true,
            "description": {
              "en": "The input",
              "pl": "Wejście"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "conv_id",
            "type": "string",
            "required": false,
            "description": {
              "en": "The conversation it is typed in (\"this conversation\" refers to it)",
              "pl": "Rozmowa, w której je wpisano (\"ta rozmowa\" odnosi się do niej)"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "method",
            "type": "string",
            "required": false,
            "description": {
              "en": "Override the routing method for this call: off, heuristic, hybrid or model",
              "pl": "Nadpisz metodę rozpoznawania dla tego wywołania: off, heuristic, hybrid albo model"
            },
            "has_default": false,
            "edit": "choice:intent_routing_methods"
          },
          {
            "name": "lang",
            "type": "string",
            "required": false,
            "description": {
