        "action": "backup",
        "params": [
          {
            "name": "to",
            "type": "string",
            "required": true,
            "description": {
              "en": "Target backend id",
              "pl": "Identyfikator docelowego magazynu"
            },
            "has_default": false,
            "edit": "choice:backends"
          },
          {
            "name": "what",
            "type": "string",
            "required": false,
            "description": {
              "en": "What to back up",
              "pl": "Co skopiować"
            },
            "has_default": true,
            "edit": "choice:database",
            "default": "database"
          }
        ],
        "http": {
          "verb": "POST",
          "path": "/api/storage/backup"
        }
      }
    }
  },
  "value_schema": {
    "type": "object",
    "required": [
      "schema",
      "actions"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "enum": [
          "loom.action_catalogue/1"
        ]
      },
      "actions": {
        "type": "object",
        "description": "Action id -> declaration.",
        "x-setting": "/actions",
        "x-consumer": "loom::llm::use_model",
        "additionalProperties": {
          "type": "object",
          "required": [
            "id",
            "kind",
            "status",
            "inputs",
            "outputs",
            "requires",
            "effects"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "atomic",
                "composite"
              ],
              "description": "atomic: implemented in code; composite: steps of other actions."
            },
            "status": {
              "type": "string",
              "enum": [
                "implemented",
                "planned"
              ],
              "description": "planned: declared, not callable yet."
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "description": "Composite only: the actions run in order.",
              "items": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "text",
                  "json",
                  "image",
                  "audio",
                  "video",
                  "embedding",
                  "file_ref"
                ]
              },
              "description": "Typed input part kinds the action takes."
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "text",
                  "json",
                  "image",
                  "audio",
                  "video",
                  "embedding",
                  "file_ref"
                ]
              },
              "description": "Typed output part kinds the action returns."
            },
            "requires": {
              "type": "array",
              "description": "Free-form traits the input element must have.",
              "items": {
                "type": "string"
              }
            },
            "effects": {
              "type": "object",
              "required": [
                "reads_only",
                "writes",
                "sends_off_device",
                "costs_money",
                "irreversible",
                "touches_private_data"
              ],
              "properties": {
                "reads_only": {
                  "type": "boolean"
                },
                "writes": {
                  "type": "boolean"
                },
                "sends_off_device": {
                  "type": "boolean"
                },
                "costs_money": {
                  "type": "boolean"
                },
                "irreversible": {
                  "type": "boolean"
                },
                "touches_private_data": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "consumer": {
              "type": "string",
              "description": "Where the action is called from today."
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": false
  }
}
