      "settings.set": {
        "id": "settings.set",
        "kind": "atomic",
        "status": "implemented",
        "title": "Change a setting",
        "description": "Sets one setting (config.json, or secrets.json for a credential). The value is read as the setting's type. The edit rules of the field apply as for any edit (a deny rule refuses, a confirmation rule asks) and so does the rule that keeps credentials out of the conversation; the x10 usage policy keeps its own confirmation.",
        "why": {
          "pl": "Zmienia jedno ustawienie; obowiązują reguły edycji pola."
        },
        "labels": {
          "pl": "Zmień ustawienie"
        },
        "phrases": {
          "en": [
            "set",
            "change",
            "update",
            "switch"
          ],
          "pl": [
