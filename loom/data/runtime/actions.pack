      "device.record_audio": {
        "id": "device.record_audio",
        "kind": "atomic",
        "status": "planned",
        "planned_reason": {
          "en": "The device belongs to the client that owns it (the browser or the Android app); this runtime has no driver for it and no client is attached to it. The action is declared so that chains and rules can speak about it.",
          "pl": "Urządzenie należy do klienta, który je ma (przeglądarki albo aplikacji na Androida); ten runtime nie ma do niego sterownika i nie jest do niego podłączony żaden klient. Akcja jest zadeklarowana, żeby łańcuchy i reguły mogły o niej mówić."
        },
        "title": "Record audio",
        "description": "Record sound with a device that captures audio (a microphone). The recording becomes an audio form; transcribe turns it into text.",
        "labels": {
          "pl": "Nagraj dźwięk"
        },
        "inputs": [],
        "outputs": [
          "audio"
        ],
        "requires": [
          "captures_audio"
        ],
        "produces": [
          "has_audio"
        ],
        "content_op": "none",
        "form_op": "none",
        "cost": 1.0,
        "confidence": 0.9,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "client",
        "client": {
          "capability": "captures_audio",
          "permission": "microphone",
          "prompt": {
            "en": "Record with the microphone of this device; stop when you are done.",
            "pl": "Nagraj mikrofonem tego urządzenia; zatrzymaj, gdy skończysz."
          },
          "expects": [
            "audio"
          ]
        },
        "default_element": "device:microphone",
        "keeps_output": true,
        "phrases": {
          "en": [
            "record audio",
            "record sound",
            "record my voice",
            "start recording",
            "record a voice note",
            "record a note",
            "voice note"
          ],
          "pl": [
            "nagraj dźwięk",
            "nagraj dzwiek",
            "nagraj głos",
            "nagraj glos",
            "nagraj audio",
            "nagraj notatkę głosową",
            "nagraj notatkę",
            "notatkę głosową",
            "nagraj notatke glosowa"
          ]
        },
        "params": [
          {
            "name": "seconds",
            "type": "integer",
            "required": false,
            "description": {
              "en": "How long to record (default: until stopped).",
              "pl": "Jak długo nagrywać (domyślnie: do zatrzymania)."
