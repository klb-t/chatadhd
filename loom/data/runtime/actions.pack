        "cost": 0.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": false
        },
        "consumer": "loom/src/actions/runner.cpp",
        "gate_as": [
          "edit"
        ],
        "element_from_arg": "key",
        "params": [
          {
            "name": "key",
            "type": "string",
            "required": true,
            "description": {
              "en": "The setting (see settings fields)",
              "pl": "Ustawienie (zob. pola ustawień)"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "value",
            "type": "string",
            "required": true,
            "description": {
              "en": "The new value (JSON for objects, arrays, numbers and booleans)",
              "pl": "Nowa wartość (JSON dla obiektów, tablic, liczb i wartości logicznych)"
            },
            "has_default": false,
            "edit": "free_text"
          }
        ],
        "examples": {
