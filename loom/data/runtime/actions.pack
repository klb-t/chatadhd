      "transcribe": {
        "id": "transcribe",
        "kind": "composite",
        "status": "implemented",
        "title": "Transcribe a recording",
        "description": "Read a sound recording into text (speech recognition) with the speech-recognition provider that has a key; the text is a rendering of the same content. The call goes through use_model (adapter of the provider's family), under the usage guard.",
        "why": {
          "pl": "Zamienia nagranie dźwięku na tekst u dostawcy rozpoznawania mowy, który ma klucz; pod strażą zużycia."
        },
        "labels": {
          "pl": "Zapisz nagranie jako tekst"
        },
        "steps": [
          {
            "action": "use_model",
            "with": {
              "media": "asr",
              "provider": {
                "$arg": "provider",
                "default": ""
              },
              "language": {
                "$arg": "language",
                "default": ""
              }
            }
          }
        ],
        "inputs": [
          "audio"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "has_audio"
        ],
        "produces": [
          "has_text"
        ],
        "content_op": "preserve",
        "form_op": "read",
        "cost": 1.0,
        "confidence": 0.85,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "",
        "phrases": {
          "en": [
            "transcribe",
            "transcript"
          ],
          "pl": [
            "transkrybuj*",
            "transkrypcj*",
            "przepisz nagranie"
          ]
        },
        "params": [
          {
            "name": "provider",
            "type": "string",
            "required": false,
            "default": "the first provider with a key, in the order of the media profile",
            "description": {
              "en": "Which speech-recognition provider to use (\"groq\", \"google\"); the first one that has a key when not given.",
              "pl": "Którego dostawcy rozpoznawania mowy użyć („groq”, „google”); gdy nie podano — pierwszego, który ma klucz."
            }
          },
          {
            "name": "language",
            "type": "string",
            "required": false,
            "default": "the provider's own default",
            "description": {
              "en": "Language of the speech or text, as the provider names it (\"pl\", \"en-US\").",
              "pl": "Język mowy albo tekstu, tak jak nazywa go dostawca („pl”, „en-US”)."
            }
          }
        ],
        "examples": {
          "en": [
            "transcribe this recording"
          ],
          "pl": [
            "transkrybuj to nagranie"
          ]
        },
        "human": {
          "title": {
            "pl": "Zapisz nagranie jako tekst",
            "en": "Transcribe a recording"
          },
          "steps": [
            {
              "label": {
                "pl": "Wybierz dostawcę: podany w poleceniu, inaczej Twój wybór dla roli Mowa→tekst albo wybór tej rozmowy (pierwszy z listy), inaczej pierwszy dostawca z kluczem w kolejności profilu mediów",
                "en": "Choose the provider: the one the command names, else your choice for the role Speech→text or this conversation’s (the first of the list), else the first provider with a key in the order of the media profile"
              },
              "uses_role": "asr"
            },
            {
              "label": {
                "pl": "Nagranie idzie do dostawcy pod Bezpiecznikiem ×10; wynikiem jest tekst nagrania",
                "en": "The recording goes to the provider under the ×10 fuse; the result is the text of the recording"
              }
            }
          ],
          "steps_are": "description"
        },
        "reads": [],
        "uses_role": "asr",
        "implemented_in": [
          "loom/data/runtime/actions.pack#/defaults/actions/transcribe"
        ]
      },
