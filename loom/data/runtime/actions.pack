        "id": "use_model",
        "kind": "atomic",
        "status": "implemented",
        "title": "Use a model",
        "description": "The one action that calls a language or media model: chosen model(s) with parameters, context and prompt; guarded by the usage policy, with provenance. Implemented by the adapters in code.",
        "inputs": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "outputs": [
          "text",
          "json",
          "image",
          "audio",
          "video",
          "embedding",
          "file_ref"
        ],
        "requires": [],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 1.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": false,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
