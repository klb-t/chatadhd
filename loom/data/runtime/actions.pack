      "import.file": {
        "id": "import.file",
        "kind": "composite",
        "status": "implemented",
        "title": "Import a file",
        "labels": {
          "pl": "Zaimportuj plik"
        },
        "description": "Imports a file of conversations: the path given, or - without one - the file the device lets the user pick, then the import runs on it.",
        "why": {
          "pl": "Importuje plik z rozmowami: podaną ścieżkę albo plik wybrany na urządzeniu."
        },
        "steps": [
          {
            "id": "pick",
            "action": "device.pick_file",
            "when": {
              "not": {
                "arg": "path"
              }
