      "graph.navigate": {
        "id": "graph.navigate",
        "kind": "atomic",
        "status": "implemented",
        "title": "Navigate the graph",
        "description": "One level of the one navigable graph (the projection of runtime/graph_sources.pack: the ROM, settings, You, conversations, flows, roles, perspectives, devices, environments ...): the focus, its children with their counts, provenance and evidence, the edges between them, the breadcrumbs, how many were collapsed by the budget (navigator_children_limit) and how many you hid. With perspectives, the nodes the perspectives' edges reach from the focus. Read only; nothing is written to the graph.",
        "why": {
          "pl": "Jeden poziom jednego grafu: ognisko, jego dzieci z licznikami, pochodzeniem i dowodem, oraz to, co zwinął budżet."
        },
        "labels": {
          "pl": "Pokaż w grafie"
        },
        "inputs": [
          "json"
        ],
        "outputs": [
          "json"
        ],
        "requires": [
          "application"
        ],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 0.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": false
        },
        "consumer": "loom/src/graph/projection.cpp",
        "port": "actions",
        "action": "graph.navigate",
        "params": [
          {
            "name": "focus",
            "type": "string",
            "required": false,
            "description": {
              "en": "The node to stand on: an address (area:rom, group:modele, conv:..., c_..., m_...) or the name of an area; empty = the root.",
              "pl": "Węzeł, na którym stajemy: adres (area:rom, group:modele, conv:..., c_..., m_...) albo nazwa obszaru; puste = korzeń."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "perspectives",
            "type": "array",
            "required": false,
            "description": {
              "en": "Perspectives whose edges choose the neighbours instead of the containment.",
              "pl": "Perspektywy, których krawędzie wybierają sąsiadów zamiast zawierania."
            },
            "has_default": false,
            "edit": "json"
          },
          {
            "name": "hops",
            "type": "integer",
            "required": false,
            "description": {
              "en": "How many levels (default 1).",
              "pl": "Ile poziomów (domyślnie 1)."
            },
            "has_default": false,
            "edit": "number"
          },
          {
            "name": "limit",
            "type": "integer",
            "required": false,
            "description": {
              "en": "Children per level (default: the setting navigator_children_limit; 0 = no limit).",
              "pl": "Dzieci na poziom (domyślnie: ustawienie navigator_children_limit; 0 = bez limitu)."
            },
            "has_default": false,
            "edit": "number"
          },
          {
            "name": "query",
            "type": "string",
            "required": false,
            "description": {
              "en": "Only children whose name or address contains this.",
              "pl": "Tylko dzieci, których nazwa lub adres to zawiera."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "offset",
            "type": "integer",
            "required": false,
            "description": {
              "en": "Next page of a paged source (conversations).",
              "pl": "Następna strona źródła stronicowanego (rozmowy)."
            },
            "has_default": false,
            "edit": "number"
          },
          {
            "name": "lang",
            "type": "string",
            "required": false,
            "description": {
              "en": "Language of the labels (pl or en).",
              "pl": "Język etykiet (pl lub en)."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "conv_id",
            "type": "string",
            "required": false,
            "description": {
              "en": "The conversation the values are resolved for (default: none).",
              "pl": "Rozmowa, dla której rozwiązujemy wartości (domyślnie żadna)."
            },
            "has_default": false,
            "edit": "free_text"
          }
        ],
        "http": {
          "verb": "POST",
          "path": "/api/graph/navigate"
        },
        "phrases": {
          "en": [
            "show in the graph",
            "go into"
          ],
          "pl": [
            "pokaż w grafie",
            "wejdź w"
          ]
        },
        "examples": {
          "en": [
            "show the ROM in the graph"
          ],
          "pl": [
            "pokaż ROM w grafie"
          ]
        },
        "stores_result": false,
        "positional_arg": "focus",
        "result_text": {
          "en": "In the graph:",
          "pl": "W grafie:"
        },
        "reads": [
          "navigator_children_limit",
          "loom_graph_data_limit"
        ],
        "implemented_in": [
          "loom/src/graph/projection.cpp",
          "loom/data/runtime/graph_sources.pack#/defaults/sources"
        ]
      },
