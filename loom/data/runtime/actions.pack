        "content_op": "evaluate",
        "form_op": "none",
        "cost": 0.2,
        "confidence": 0.85,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "loom/src/context/context_engine.cpp",
        "labels": {
          "pl": "Określ cel promptu"
        },
        "human": {
          "title": {
            "pl": "Określ cel promptu",
            "en": "Type the goal of a prompt"
          },
          "steps": [
            {
              "label": {
                "pl": "Najpierw lokalne wskazówki celu (context_goal_cues)",
                "en": "Local goal cues first (context_goal_cues)"
              }
            },
            {
              "label": {
