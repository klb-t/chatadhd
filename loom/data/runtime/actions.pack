      "chat.send": {
        "id": "chat.send",
        "kind": "composite",
        "status": "implemented",
        "title": "Send a message",
        "description": "A user message in a conversation, answered by the selected model (buffered or streamed); history, memory and graph context are the input.",
        "why": {
          "pl": "Twoja wiadomość w rozmowie, na którą odpowiada wybrany model; wejściem są historia, pamięć i kontekst z grafu."
        },
        "steps": [
          {
            "action": "use_model"
          }
        ],
        "inputs": [
          "text",
          "json"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "conversation"
        ],
        "produces": [
          "message"
        ],
        "content_op": "expand",
        "form_op": "none",
        "cost": 1.0,
        "confidence": 0.9,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "loom/src/chat/chat_engine.cpp",
        "labels": {
          "pl": "Wyślij wiadomość"
        },
        "human": {
          "title": {
            "pl": "Wyślij wiadomość",
            "en": "Send a message"
          },
          "steps": [
            {
              "label": {
                "pl": "Zbierz kontekst: polecenie systemowe, pamięć, graf, historię (porządek z chat_context_order) i reprezentację Sekretarza",
                "en": "Gather the context: the system prompt, memory, graph, history (order from chat_context_order) and the Secretary’s representation"
              }
            },
            {
              "label": {
                "pl": "Wybierz model rozmowy (default_model przez łańcuch zakresów) i sposób rozumowania (chat_reasoning)",
                "en": "Choose the conversation model (default_model through the scope chain) and the reasoning recipe (chat_reasoning)"
              }
            },
            {
              "label": {
                "pl": "Wybierz przepływ odpowiedzi (chat_flow): zwykły tekst albo odpowiedź w grafie",
                "en": "Choose the reply flow (chat_flow): plain text or a graph-native reply"
              }
            },
            {
              "label": {
                "pl": "Wywołaj model (strumieniowo, gdy stream) pod Bezpiecznikiem ×10 i limitami wydatków",
                "en": "Call the model (streamed when stream is on) under the ×10 fuse and the spending limits"
              }
            },
            {
              "label": {
                "pl": "Zapisz odpowiedź; w nowej rozmowie nadaj tytuł (auto_title)",
                "en": "Store the reply; in a new conversation give it a title (auto_title)"
              }
            }
          ],
          "steps_are": "description"
        },
