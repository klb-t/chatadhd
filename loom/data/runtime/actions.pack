            "wygeneruj obraz*",
            "stwórz obraz*",
            "przedstaw*"
          ]
        },
        "params": [
          {
            "name": "model",
            "type": "string",
            "required": true,
            "setting": "image_model",
            "description": {
              "en": "The image model.",
              "pl": "Model obrazów."
            }
          },
          {
            "name": "provider",
            "type": "string",
            "required": true,
            "setting": "image_provider",
