      "client.declare": {
        "id": "client.declare",
        "kind": "atomic",
        "status": "implemented",
        "title": "Declare what this client can do",
        "description": "A client (the web page, the Android shell, the command line) declares which device capabilities it can carry out right now - captures_audio, captures_image, plays_audio, shows_notifications, clipboard, picks_files ... - each with its permission state (granted | prompt | denied). The kernel keeps the declaration for this client only (in memory, never in shipped data) and uses it so that the device actions of the catalogue are runnable FOR THIS CLIENT: the step is then carried out by the client itself (a client_step the client answers with actions.client_result). A client that declares nothing sees the device actions as planned, as before. Declaring again replaces the previous declaration; the answer carries client_id for the later calls (actions.run, preview, for, explain, propose_chain, chat.route and the chat request take client_id).",
        "labels": {
          "pl": "Zadeklaruj, co potrafi ten klient"
        },
        "inputs": [
          "json"
        ],
        "outputs": [
          "json"
        ],
        "requires": [
          "application"
        ],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 0.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": true,
          "writes": true,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": false
        },
        "consumer": "loom/src/actions/client_devices.cpp",
        "port": "actions",
        "action": "client.declare",
        "params": [
          {
            "name": "client_id",
            "type": "string",
            "required": false,
            "description": {
              "en": "The id the client chose for itself (kept for this client); the kernel makes one when it is left out.",
              "pl": "Identyfikator, który klient wybrał dla siebie (zapamiętany dla tego klienta); jądro tworzy go, gdy go brak."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "client",
            "type": "object",
            "required": false,
            "description": {
              "en": "Who the client is: {kind: web | android | cli, platform?, label?}.",
              "pl": "Kim jest klient: {kind: web | android | cli, platform?, label?}."
            },
            "has_default": false,
            "edit": "json"
          },
          {
            "name": "capabilities",
            "type": "object",
            "required": true,
            "description": {
              "en": "What the client can do: {capability: \"granted\" | \"prompt\" | \"denied\" | {permission, via?, detail?}} (a list of names means granted).",
              "pl": "Co klient potrafi: {zdolność: \"granted\" | \"prompt\" | \"denied\" | {permission, via?, detail?}} (lista nazw oznacza: przyznane)."
            },
            "has_default": false,
            "edit": "json"
          }
        ],
        "http": {
          "verb": "POST",
          "path": "/api/client/declare"
        }
      },
