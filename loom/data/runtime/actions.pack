      "knowledge.propose_semantics": {
        "id": "knowledge.propose_semantics",
        "kind": "composite",
        "status": "implemented",
        "title": "Propose knowledge structure",
        "description": "The knowledge pipeline's model step: located, grounded proposals (relations, generalizations, candidate graph bundles) for chunks of source observations, from a prompt contract; nothing is accepted without validation.",
        "why": {
          "pl": "Krok modelu budowania wiedzy: proponuje relacje, uogólnienia i wiązki grafu z fragmentów źródeł; nic nie jest przyjmowane bez sprawdzenia."
        },
        "steps": [
          {
            "action": "use_model"
          }
        ],
        "inputs": [
          "text",
          "json"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "observation"
        ],
        "produces": [
          "knowledge_proposal"
        ],
        "content_op": "none",
        "form_op": "read",
        "cost": 1.0,
        "confidence": 0.7,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "loom/src/extract/semantic.cpp",
        "labels": {
          "pl": "Zaproponuj strukturę wiedzy"
        },
        "human": {
          "title": {
            "pl": "Zaproponuj strukturę wiedzy",
            "en": "Propose knowledge structure"
          },
          "steps": [
            {
              "label": {
                "pl": "Weź fragmenty obserwacji ze źródła",
                "en": "Take the chunks of observations from the source"
              }
            },
            {
              "label": {
                "pl": "Złóż prompt z kontraktu (analysis_prompt_dir, analysis_prompt_overrides) i wywołaj model semantic_model",
                "en": "Build the prompt from the contract (analysis_prompt_dir, analysis_prompt_overrides) and call the model semantic_model"
              }
            },
            {
              "label": {
                "pl": "Sprawdź propozycje (relacje, uogólnienia, pakiety grafu); nic nie jest przyjęte bez walidacji",
                "en": "Validate the proposals (relations, generalizations, graph bundles); nothing is accepted without validation"
              }
            }
          ],
          "steps_are": "description"
        },
        "reads": [
          "semantic_model",
          "semantic_analysis",
          "analysis_prompt_dir",
          "analysis_prompt_overrides",
          "base_url",
          "loom_semantic_usage_policy_required"
        ],
        "uses_role": "analysis.fast",
        "implemented_in": [
          "loom/src/extract/semantic.cpp",
          "loom/src/extract/semantic_usage.h"
        ]
      },
