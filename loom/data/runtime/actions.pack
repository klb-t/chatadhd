      "translate": {
        "id": "translate",
        "kind": "composite",
        "status": "implemented",
        "title": "Translate",
        "description": "Carry a text content into another language, keeping its meaning, tone and formatting. The target language is the argument target_language (default: the language the command was written in).",
        "labels": {
          "pl": "Przetłumacz"
        },
        "steps": [
          {
            "action": "use_model",
            "with": {
              "system": {
                "$localized": {
                  "en": "You are a precise translator. Translate faithfully: keep the meaning, tone, formatting, names and numbers. Output only the translation, with no commentary.",
                  "pl": "Jesteś precyzyjnym tłumaczem. Tłumacz wiernie: zachowaj sens, ton, formatowanie, nazwy własne i liczby. Podaj samo tłumaczenie, bez komentarzy."
                }
              },
              "prompt": {
                "$format": {
                  "$localized": {
                    "en": "Translate the text above into {language}.",
                    "pl": "Przetłumacz powyższy tekst na język: {language}."
                  }
                },
                "vars": {
                  "language": {
                    "$arg": "target_language",
                    "default": {
                      "$localized": {
                        "en": "English",
                        "pl": "polski"
                      }
                    }
                  }
                }
              },
              "parameters": {
                "temperature": 0.2
              }
            }
          }
        ],
        "inputs": [
          "text"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "has_text"
        ],
        "produces": [
          "has_text"
        ],
        "content_op": "preserve",
        "form_op": "none",
        "cost": 1.0,
        "confidence": 0.9,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "",
        "phrases": {
          "en": [
            "translate"
