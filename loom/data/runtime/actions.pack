      },
      "elaborate": {
        "id": "elaborate",
        "kind": "composite",
        "status": "implemented",
        "title": "Elaborate",
        "description": "Develop a text content: add detail, examples, the missing steps. What to dwell on is the argument focus.",
        "labels": {
          "pl": "Rozwiń"
        },
        "steps": [
          {
            "action": "use_model",
            "with": {
              "system": {
                "$localized": {
                  "en": "You develop texts. Keep the author's voice and claims; add detail, concrete examples and the steps that are missing; do not contradict the text and do not present invented facts as the author's. Answer in the language of the text.",
                  "pl": "Rozwijasz teksty. Zachowaj głos i tezy autora; dodaj szczegóły, konkretne przykłady i brakujące kroki; nie przeczą tekstowi i nie podawaj zmyślonych faktów jako słów autora. Odpowiadaj w języku tekstu."
                }
              },
              "prompt": {
                "$format": {
                  "$localized": {
                    "en": "Elaborate on the text above. Dwell on: {focus}.",
                    "pl": "Rozwiń powyższy tekst. Skup się na: {focus}."
                  }
                },
                "vars": {
                  "focus": {
                    "$arg": "focus",
                    "default": {
                      "$localized": {
                        "en": "whatever needs the most detail",
                        "pl": "tym, co najbardziej wymaga rozwinięcia"
                      }
                    }
                  }
                }
              },
              "parameters": {
                "temperature": 0.6
              }
            }
          }
        ],
        "inputs": [
          "text"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "has_text"
        ],
        "produces": [
          "has_text"
        ],
        "content_op": "expand",
        "form_op": "none",
        "cost": 1.0,
        "confidence": 0.8,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
