          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "",
        "phrases": {
          "en": [
            "parody",
            "parodise",
            "parodize"
          ],
          "pl": [
            "sparoduj*",
