      "rules.set": {
        "id": "rules.set",
        "kind": "atomic",
        "status": "implemented",
        "title": "Set a rule",
        "description": "Writes a scoped rule or value into the user overlay profiles/action_rules.pack: set_value (a setting's value in a scope), confirm / require_confirmation, deny (with a reason), allow, at conversation, person, installation or any other level of the scope chain. A new rule for the same scope and subject replaces the old one. A rule pinned by a higher scope (locked) refuses with its reason. Writing is an action like any other: the rules of the scope apply and the preset asks you to confirm each write. Undo: rules.disable.",
        "labels": {
          "pl": "Zapisz regułę"
        },
        "inputs": [
          "json"
        ],
        "outputs": [
          "json"
        ],
        "requires": [
          "application"
        ],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 0.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": false
        },
        "consumer": "loom/src/actions/overlay.cpp",
        "port": "actions",
        "action": "rules.set",
        "params": [
          {
            "name": "scope",
            "type": "string",
            "required": false,
            "description": {
              "en": "Level of the scope chain: conversation, person (alias user), installation, project ... Default: person.",
              "pl": "Poziom łańcucha zakresów: conversation, person (alias user), installation, project ... Domyślnie: person."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "scope_id",
            "type": "string",
            "required": false,
            "description": {
              "en": "The instance of the level (a conversation id for conversation). Defaults to the conversation the call comes from.",
              "pl": "Instancja poziomu (id rozmowy dla conversation). Domyślnie rozmowa, z której idzie wywołanie."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "effect",
            "type": "string",
            "required": false,
            "description": {
              "en": "set_value | confirm | require_confirmation | deny | allow (or any effect of the rules table). With key and value: set_value.",
              "pl": "set_value | confirm | require_confirmation | deny | allow (albo dowolny efekt z tabeli reguł). Z key i value: set_value."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "key",
            "type": "string",
            "required": false,
            "description": {
              "en": "set_value: the setting whose value the rule sets (e.g. action_result_target).",
              "pl": "set_value: ustawienie, którego wartość ustawia reguła (np. action_result_target)."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "value",
            "type": "string",
            "required": false,
            "description": {
              "en": "set_value: the value (JSON for numbers, booleans and objects).",
              "pl": "set_value: wartość (JSON dla liczb, wartości logicznych i obiektów)."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "action",
            "type": "string",
            "required": false,
            "description": {
              "en": "confirm / deny / allow: the action id the rule is about (default: every action).",
              "pl": "confirm / deny / allow: id akcji, której dotyczy reguła (domyślnie każda)."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "target",
            "type": "object",
            "required": false,
            "description": {
              "en": "Which elements: {\"kind\":\"class\",\"id\":...}, {\"kind\":\"trait\",...}, {\"kind\":\"any\"} (default).",
              "pl": "Które elementy: {\"kind\":\"class\",\"id\":...}, {\"kind\":\"trait\",...}, {\"kind\":\"any\"} (domyślnie)."
            },
            "has_default": false,
            "edit": "json"
          },
          {
            "name": "reason",
            "type": "string",
            "required": false,
            "description": {
              "en": "Why (deny needs one; default: \"Set by you.\").",
              "pl": "Dlaczego (deny wymaga; domyślnie: „Ustawione przez Ciebie.”)."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "initiator",
            "type": "string",
            "required": false,
            "description": {
              "en": "Who stands behind the rule (default: user).",
              "pl": "Kto stoi za regułą (domyślnie: user)."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "locked",
            "type": "boolean",
            "required": false,
            "description": {
              "en": "Pin the rule: a lower scope cannot override it.",
              "pl": "Przypnij regułę: niższy zakres jej nie nadpisze."
            },
            "has_default": true,
            "edit": "toggle",
            "default": false
          },
          {
            "name": "id",
            "type": "string",
            "required": false,
            "description": {
              "en": "Id of the rule (default: made from scope, dimension and subject).",
              "pl": "Id reguły (domyślnie z zakresu, wymiaru i przedmiotu)."
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "dry_run",
            "type": "boolean",
            "required": false,
            "description": {
              "en": "Check and say whether it would be refused; write nothing.",
              "pl": "Sprawdź i powiedz, czy zostałaby odrzucona; nic nie zapisuj."
            },
            "has_default": true,
            "edit": "toggle",
            "default": false
          },
          {
            "name": "confirmed",
            "type": "boolean",
            "required": false,
            "description": {
              "en": "The caller's yes to the confirmations the rules ask for in this plan - honoured only with receipt_id (the plan_receipt of a preview or a proposal of exactly this plan); a bare true returns the proposal instead of running. Denials and the x10 usage confirmation are never covered.",
              "pl": "Tak wywołującego na potwierdzenia, o które proszą reguły w tym planie - uwzględniane tylko z receipt_id (plan_receipt podglądu lub propozycji dokładnie tego planu); samo true zwraca propozycję zamiast wykonać. Odmowy i potwierdzenie ×10 nigdy nie są objęte."
            },
            "has_default": true,
            "edit": "toggle",
            "default": false
          },
          {
            "name": "receipt_id",
            "type": "string",
            "required": false,
            "description": {
              "en": "With confirmed: the plan_receipt that actions.preview (or a proposal, propose:true) gave for exactly this plan (action, element, args, scope).",
              "pl": "Razem z confirmed: plan_receipt, który actions.preview (albo propozycja, propose:true) zwróciło dla dokładnie tego planu (akcja, element, argumenty, zakres)."
            },
            "has_default": false,
            "edit": "free_text"
          }
        ],
        "http": {
          "verb": "POST",
          "path": "/api/rules/set"
        },
        "examples": {
          "en": [
            "for this conversation set action_result_target to conversation_message"
          ],
          "pl": [
            "w tej rozmowie ustaw action_result_target=conversation_message"
          ]
        }
      },
