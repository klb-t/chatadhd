      "rephrase": {
        "id": "rephrase",
        "kind": "composite",
        "status": "implemented",
        "title": "Rephrase",
        "description": "Say the same thing in another tone or at another level of language, keeping the meaning, facts, names and numbers. The tone is the argument tone, the level the argument level.",
        "labels": {
          "pl": "Przeredaguj"
        },
        "steps": [
          {
            "action": "use_model",
            "with": {
              "system": {
                "$localized": {
                  "en": "You rewrite texts. Keep the meaning, the facts, the names and the numbers; change only the way it is said: the tone, the register, the level of language. Output only the rewritten text, with no commentary. Answer in the language of the text.",
                  "pl": "Przepisujesz teksty. Zachowaj sens, fakty, nazwy własne i liczby; zmień tylko sposób powiedzenia: ton, rejestr, poziom języka. Podaj samo przepisanie, bez komentarzy. Odpowiadaj w języku tekstu."
                }
              },
              "prompt": {
                "$format": {
                  "$localized": {
                    "en": "Rewrite the text above. Tone: {tone}. Level: {level}.",
                    "pl": "Przeredaguj powyższy tekst. Ton: {tone}. Poziom: {level}."
                  }
                },
                "vars": {
                  "tone": {
                    "$arg": "tone",
                    "default": {
                      "$localized": {
                        "en": "plain and neutral",
                        "pl": "prosty i neutralny"
                      }
                    }
                  },
                  "level": {
                    "$arg": "level",
                    "default": {
                      "$localized": {
                        "en": "everyday language",
                        "pl": "język codzienny"
                      }
                    }
                  }
                }
              },
              "parameters": {
                "temperature": 0.5
              }
            }
          }
        ],
        "inputs": [
          "text"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "has_text"
        ],
        "produces": [
          "has_text"
        ],
        "content_op": "restyle",
        "form_op": "none",
        "cost": 1.0,
        "confidence": 0.85,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "",
        "params": [
          {
            "name": "tone",
            "type": "string",
            "required": false,
            "default": "plain and neutral",
            "description": {
              "en": "The tone to say it in (\"formal\", \"warm\", \"blunt\").",
              "pl": "Ton, w jakim to powiedzieć („formalny”, „ciepły”, „dosadny”)."
            }
          },
          {
            "name": "level",
            "type": "string",
            "required": false,
            "default": "everyday language",
            "description": {
              "en": "The level of language (\"academic\", \"for teenagers\").",
              "pl": "Poziom języka („akademicki”, „dla nastolatków”)."
            }
          }
        ]
      },
      "explain_simply": {
        "id": "explain_simply",
        "kind": "composite",
        "status": "implemented",
        "title": "Explain simply",
        "description": "Explain a text content for a stated level of competence: short sentences, everyday words, a concrete example, nothing false. Any level, down to a beginner and up to an expert: the audience is the argument audience.",
        "labels": {
          "pl": "Wytłumacz prościej"
        },
        "steps": [
          {
            "action": "use_model",
            "with": {
              "system": {
                "$localized": {
                  "en": "You explain things simply and correctly. Explain the text above for the stated audience: short sentences, everyday words, a concrete example or comparison, no jargon unless you explain it. Never talk down and never change what is true. Answer in the language of the text.",
                  "pl": "Tłumaczysz rzeczy prosto i poprawnie. Wyjaśnij powyższy tekst wskazanemu odbiorcy: krótkie zdania, codzienne słowa, konkretny przykład lub porównanie, żadnego żargonu bez wyjaśnienia. Nie traktuj odbiorcy protekcjonalnie i nie zmieniaj tego, co prawdziwe. Odpowiadaj w języku tekstu."
                }
              },
              "prompt": {
                "$format": {
                  "$localized": {
                    "en": "Explain the text above simply, for this audience: {audience}.",
                    "pl": "Wyjaśnij prosto powyższy tekst dla tego odbiorcy: {audience}."
                  }
                },
                "vars": {
                  "audience": {
                    "$arg": "audience",
                    "default": {
                      "$localized": {
                        "en": "someone who is new to the subject",
                        "pl": "ktoś, kto dopiero poznaje temat"
                      }
                    }
                  }
                }
              },
              "parameters": {
                "temperature": 0.4
              }
            }
          }
        ],
        "inputs": [
          "text"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "has_text"
        ],
        "produces": [
          "has_text"
        ],
        "content_op": "restyle",
        "form_op": "none",
        "cost": 1.0,
        "confidence": 0.8,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "",
        "params": [
          {
            "name": "audience",
            "type": "string",
            "required": false,
            "default": "someone who is new to the subject",
            "description": {
              "en": "Who it is for, at any level (\"a beginner\", \"a ten-year-old\", \"an expert in another field\").",
              "pl": "Dla kogo, na dowolnym poziomie („początkujący”, „dziesięciolatek”, „ekspert z innej dziedziny”)."
            }
          }
        ]
      }
    }
  },
  "value_schema": {
    "type": "object",
    "required": [
      "schema",
      "actions"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "enum": [
          "loom.action_catalogue/1"
        ]
      },
      "actions": {
        "type": "object",
        "description": "Action id -> declaration.",
        "x-setting": "/actions",
        "x-consumer": "loom::llm::use_model",
        "additionalProperties": {
          "type": "object",
          "required": [
            "id",
            "kind",
            "status",
            "inputs",
            "outputs",
            "requires",
            "effects"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "atomic",
                "composite"
              ],
              "description": "atomic: implemented in code; composite: steps of other actions."
            },
            "status": {
              "type": "string",
              "enum": [
                "implemented",
                "planned"
              ],
              "description": "planned: declared, not callable yet."
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "description": "Composite only: the steps, run in order. Step: {id?, action, with?, when?, variants?, variant_mode?, on_failure?}; see runtime/action_run.pack for the placeholders and conditions.",
              "items": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "with": {
                    "type": "object"
                  },
                  "when": {
                    "type": "object"
                  },
                  "variants": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "variant_mode": {
                    "type": "string",
                    "enum": [
                      "all",
                      "first_success"
                    ]
                  },
                  "on_failure": {
                    "type": "string",
                    "enum": [
                      "stop",
                      "continue"
                    ]
                  }
                },
                "additionalProperties": true
              }
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "text",
                  "json",
                  "image",
                  "audio",
                  "video",
                  "embedding",
                  "file_ref"
                ]
              },
              "description": "Typed input part kinds the action takes."
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "text",
                  "json",
                  "image",
                  "audio",
                  "video",
                  "embedding",
                  "file_ref"
                ]
              },
              "description": "Typed output part kinds the action returns."
            },
            "requires": {
              "type": "array",
              "description": "Traits the input element must have (all of them). A class id is a trait of its own; classes declare further traits in graph/classes.pack.",
              "items": {
                "type": "string"
              }
            },
            "produces": {
              "type": "array",
              "description": "Traits of the output element (a produced class id stands for the traits of that class).",
              "items": {
                "type": "string"
              }
            },
            "content_op": {
              "type": "string",
              "description": "What the action does to the content: preserve, condense, expand, restyle, evaluate, combine or none (open list, see action_rules axes)."
            },
            "form_op": {
              "type": "string",
              "description": "read (form to content), express (content to form) or none (open list)."
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "description": "Declared relative cost (1 = one ordinary model call); ranks chain proposals, never a limit."
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Declared confidence that the result keeps what the caller meant (0..1); ranks chain proposals."
            },
            "effects": {
              "type": "object",
              "required": [
                "reads_only",
                "writes",
                "sends_off_device",
                "costs_money",
                "irreversible",
                "touches_private_data"
              ],
              "properties": {
                "reads_only": {
                  "type": "boolean"
                },
                "writes": {
                  "type": "boolean"
                },
                "sends_off_device": {
                  "type": "boolean"
                },
                "costs_money": {
                  "type": "boolean"
                },
                "irreversible": {
                  "type": "boolean"
                },
                "touches_private_data": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "consumer": {
              "type": "string",
              "description": "Where the action is called from today."
            },
            "gate_as": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Further action names whose rules also apply to this action (the most restrictive decision wins): settings.set is gated as `edit`, so the edit rules of a settings field apply to it."
            },
            "element_from_arg": {
              "type": "string",
              "description": "The argument that is the element when the caller names none (settings.set: `key` is the settings field)."
            },
            "result_from": {
              "type": "string",
              "description": "Composite only: the id of the step whose output is the result (default: the last step)."
            },
            "phrases": {
              "type": "object",
              "description": "Words that name this action in a chat input, per language: {en: [...], pl: [...]}. A phrase is space-separated words, all of which must occur near the start of the input (any order); a word ending in * matches any continuation. Used by input.route_intent; a new action brings its own phrases."
            },
            "planned_reason": {
              "type": "object",
              "description": "Planned only: why it is not callable yet, per language {en, pl}; shown instead of a bare \"planned\".",
              "additionalProperties": {
                "type": "string"
              }
            },
            "params": {
              "type": "array",
              "description": "The arguments of the action: {name, type, required?, default?, setting?, description {en, pl}}. An argument the caller leaves out is filled from the config key `setting` (when it is set), and a required one that is still missing makes the plan unfeasible, saying which; `default` here documents the default that the steps carry.",
              "items": {
                "type": "object"
              }
            },
            "element_many": {
              "type": "boolean",
              "description": "The action takes several elements as one input (combine): the router reads every id in the words, and a request may give element as a list of ids; the contents reach the steps one after another."
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": false
  }
}
