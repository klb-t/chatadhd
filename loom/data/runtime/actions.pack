      "actions.client_result": {
        "id": "actions.client_result",
        "kind": "atomic",
        "status": "implemented",
        "title": "Answer a step the client carries out",
        "description": "Answers the client_step a run is paused on (a device action the client declared: record, take a picture, pick a file, read the clipboard ...): the receipt must be the pending one. state ok brings the produced parts - media as the blob_hash of bytes uploaded before (POST /api/client/blob/upload; checked against the blob store of this user, with a graph node and an artifact, like any produced media), text as text - and the run continues with the next step (record_audio -> transcribe -> summarise); failed and unavailable fail the step with the reason; declined (the person did not allow it) ends the run as rejected. A client that never answers leaves the run paused, not failed; actions.cancel stops it.",
        "why": {
          "pl": "Odpowiada na krok, który przebieg zlecił urządzeniu klienta (nagranie, zdjęcie, plik…)."
        },
        "labels": {
          "pl": "Odpowiedz na krok wykonywany przez klienta"
        },
        "inputs": [
          "json"
        ],
        "outputs": [
          "json"
        ],
        "requires": [
          "application"
        ],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 0.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": true,
          "writes": true,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "loom/src/actions/runner.cpp",
        "port": "actions",
        "action": "client_result",
        "params": [
          {
            "name": "run_id",
            "type": "string",
            "required": true,
            "description": {
              "en": "Id of the run (ar_...)",
              "pl": "Identyfikator przebiegu (ar_...)"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "receipt_id",
            "type": "string",
            "required": true,
            "description": {
              "en": "The pending receipt of the run (pending.receipt_id)",
              "pl": "Oczekujące pokwitowanie przebiegu (pending.receipt_id)"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "state",
            "type": "string",
            "required": true,
            "description": {
              "en": "ok | failed | declined | unavailable",
              "pl": "ok | failed | declined | unavailable"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "parts",
            "type": "array",
            "required": false,
            "description": {
              "en": "What the step produced: [{kind: audio | image | video | file_ref | text, mime?, blob_hash? | text?, name?}]. Media name a blob uploaded before; bytes are never carried in this JSON (data_base64 is refused).",
              "pl": "Co krok wytworzył: [{kind: audio | image | video | file_ref | text, mime?, blob_hash? | text?, name?}]. Media wskazują blob wgrany wcześniej; bajty nigdy nie idą w tym JSON-ie (data_base64 jest odrzucane)."
            },
            "has_default": false,
            "edit": "json"
          },
          {
            "name": "data",
            "type": "object",
            "required": false,
            "description": {
              "en": "Structured result of the step, when it has one.",
              "pl": "Wynik strukturalny kroku, jeśli go ma."
            },
            "has_default": false,
            "edit": "json"
          },
          {
            "name": "error",
            "type": "object",
            "required": false,
            "description": {
              "en": "With failed or unavailable: {code?, message}.",
              "pl": "Z failed lub unavailable: {code?, message}."
