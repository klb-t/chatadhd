      "archive.run": {
        "id": "archive.run",
        "kind": "composite",
        "status": "implemented",
        "title": "Analyse an archive",
        "labels": {
          "pl": "Przeanalizuj archiwum"
        },
        "description": "Analyses a folder, an archive or a repository: the path said, or the file the device lets you pick. It runs in the background (ask \"how is the archive analysis going\"), local and free unless you allow the model (llm auto).",
        "why": {
          "pl": "Analizuje folder, archiwum albo repozytorium w tle; lokalnie i za darmo, chyba że pozwolisz na model."
        },
        "steps": [
          {
            "id": "pick",
            "action": "device.pick_folder",
            "when": {
              "all": [
                {
                  "not": {
                    "arg": "path"
                  }
                },
                {
                  "not": {
                    "arg": "pick",
                    "equals": "file"
                  }
                }
              ]
            }
          },
          {
            "id": "pick_file",
            "action": "device.pick_file",
            "when": {
              "all": [
                {
                  "not": {
                    "arg": "path"
                  }
                },
                {
                  "arg": "pick",
                  "equals": "file"
                }
              ]
            }
          },
          {
            "id": "start",
            "action": "archive.start",
            "with": {
              "path": {
                "$arg": "path",
                "default": ""
              },
              "project": {
                "$arg": "project",
                "default": ""
              },
              "seeds": {
                "$arg": "seeds",
                "default": ""
              },
              "llm": {
                "$arg": "llm",
                "default": ""
              },
              "inputs": [
                {
                  "from": "pick"
                },
                {
                  "from": "pick_file"
                }
              ]
            }
          }
        ],
        "inputs": [],
        "outputs": [
          "text"
        ],
        "requires": [
          "application"
        ],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 0.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": false,
          "costs_money": false,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "",
        "stores_result": false,
        "params": [
          {
            "name": "path",
            "type": "string",
            "required": false,
            "description": {
              "en": "A folder, an archive or a file, written out (without it, the folder the device lets you pick)",
              "pl": "Folder, archiwum albo plik, wypisane wprost (bez tego: folder wybrany na urządzeniu)"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "pick",
            "type": "string",
            "required": false,
            "description": {
              "en": "What the device lets you pick when no path is given: folder (preset) or file (an archive file)",
              "pl": "Co pozwala wybrać urządzenie, gdy nie podano ścieżki: folder (preset) albo file (plik archiwum)"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "project",
            "type": "string",
            "required": false,
            "description": {
              "en": "A name for the result",
              "pl": "Nazwa wyniku"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "seeds",
            "type": "string",
            "required": false,
            "description": {
              "en": "Terms to start from, separated by commas",
