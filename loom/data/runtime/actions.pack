      "semantic.analyse": {
        "id": "semantic.analyse",
        "kind": "composite",
        "status": "implemented",
        "title": "Analyse a message in the background",
        "description": "Entities, topics and relations of one message from the semantic model; regex analysis stays the fallback.",
        "why": {
          "pl": "Wyciąga z jednej wiadomości encje, tematy i relacje modelem analizy; gdy go nie ma, zostają lokalne reguły."
        },
        "steps": [
          {
            "action": "use_model"
          }
        ],
        "inputs": [
          "text"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "message"
        ],
        "produces": [
          "semantic_analysis"
        ],
        "content_op": "none",
        "form_op": "read",
        "cost": 0.2,
        "confidence": 0.8,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "loom/src/semantic/semantic_llm.cpp",
        "labels": {
          "pl": "Przeanalizuj wiadomość w tle"
        },
        "human": {
          "title": {
            "pl": "Przeanalizuj wiadomość w tle",
            "en": "Analyse a message in the background"
          },
          "steps": [
            {
              "label": {
                "pl": "Wybierz model analizy: polityka analyzer (semantic_model → rola Analiza w tle → brak)",
                "en": "Choose the analysis model: policy analyzer (semantic_model → role Background analysis → none)"
              }
            },
            {
              "label": {
                "pl": "Brak modelu albo analiza wyłączona (semantic_analysis): tylko lokalne wyrażenia regularne",
                "en": "No model or analysis switched off (semantic_analysis): local regular expressions only"
              }
            },
            {
              "label": {
                "pl": "Klasa modelu wybiera przepływ (gdy ktoś czyta segmenty: semantic_segments, Sekretarz albo filtr wątków): frontier — jedno wywołanie; tani, średni i nieznany — klasyczne wywołanie i wąskie pytanie o segmenty; bez segmentów — samo klasyczne wywołanie",
                "en": "The class of the model picks the flow (when something reads segments: semantic_segments, the Secretary or the thread filter): frontier — one call; cheap, mid and unknown — the classic call and a narrow question about segments; without segments — the classic call only"
              }
            },
            {
              "label": {
                "pl": "Zapisz encje, tematy i relacje w grafie",
                "en": "Store the entities, topics and relations in the graph"
              }
            }
          ],
          "steps_are": "description"
        },
        "reads": [
          "semantic_model",
          "semantic_analysis",
          "semantic_segments",
          "semantic_retry_mode",
          "guardian_method",
          "chat_representation",
          "chat_thread_filter"
        ],
        "uses_role": "analysis.fast",
        "implemented_in": [
          "loom/src/semantic/semantic_llm.cpp",
          "loom/src/annotations/analyzer.cpp",
          "loom/src/worker/semantic_worker.cpp",
          "loom/data/runtime/guardian.pack#/defaults/models/policies/analyzer",
          "loom/data/runtime/ports.pack#/defaults/roles/analysis.fast",
          "loom/data/runtime/guardian.pack#/defaults/annotations/analyzer"
        ]
      },
      "semantic.batch": {
        "id": "semantic.batch",
        "kind": "composite",
        "status": "implemented",
        "title": "Background batch analysis",
        "description": "The worker submits queued messages to the provider's Message Batches, polls the batch and ingests the results.",
        "why": {
          "pl": "Analiza w tle wysyła oczekujące wiadomości partią do dostawcy, czeka na wynik i zapisuje go."
        },
        "steps": [
          {
            "action": "use_model"
          }
        ],
        "inputs": [
          "text"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "message"
        ],
        "produces": [
          "semantic_analysis"
        ],
        "content_op": "none",
        "form_op": "read",
        "cost": 0.1,
        "confidence": 0.8,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "loom/src/worker/semantic_worker.cpp",
        "labels": {
          "pl": "Analiza zbiorcza w tle"
        },
        "human": {
          "title": {
            "pl": "Analiza zbiorcza w tle",
            "en": "Background batch analysis"
          },
          "steps": [
            {
              "label": {
                "pl": "Gdy oczekujących wiadomości jest dużo (worker.batch_threshold) i jest klucz analizy zbiorczej: zbierz je w jedną paczkę",
                "en": "When many messages wait (worker.batch_threshold) and the batch analysis key is set: gather them into one batch"
              }
            },
            {
              "label": {
                "pl": "Wyślij paczkę modelem z pola „Model analizy w tle” (semantic_model), wprost — wybór dla roli Analiza w tle jej nie dotyczy — przez Anthropic Message Batches (taniej, wynik później)",
                "en": "Send the batch with the model of the field “Background analysis model” (semantic_model), directly — a choice for the role Background analysis does not reach it — through Anthropic Message Batches (cheaper, the result comes later)"
              }
            },
            {
              "label": {
                "pl": "Odbierz wyniki i zapisz analizę każdej wiadomości; nieudane ponów według semantic_retry_mode",
                "en": "Collect the results and store the analysis of each message; retry the failed ones per semantic_retry_mode"
              }
            }
          ],
          "steps_are": "description"
        },
        "reads": [
          "semantic_model",
          "semantic_analysis",
          "semantic_retry_mode",
          "anthropic_batch_key",
          "semantic_segments",
          "guardian_method",
          "chat_representation",
          "chat_thread_filter"
        ],
        "uses_role": "analysis.fast",
        "implemented_in": [
          "loom/src/worker/semantic_worker.cpp",
          "loom/data/runtime/worker.pack#/defaults/batch_secret_key",
          "loom/data/runtime/guardian.pack#/defaults/annotations/analyzer"
        ]
      },
