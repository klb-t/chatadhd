  "value_schema": {
    "type": "object",
    "required": [
      "schema",
      "actions"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "enum": [
          "loom.action_catalogue/1"
        ]
      },
      "actions": {
        "type": "object",
        "description": "Action id -> declaration.",
        "x-setting": "/actions",
        "x-consumer": "loom::llm::use_model",
        "additionalProperties": {
          "type": "object",
          "required": [
            "id",
            "kind",
            "status",
            "inputs",
            "outputs",
            "requires",
            "effects"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "atomic",
                "composite"
              ],
              "description": "atomic: implemented in code; composite: steps of other actions."
            },
            "status": {
              "type": "string",
              "enum": [
                "implemented",
                "planned"
              ],
              "description": "planned: declared, not callable yet."
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "description": "Composite only: the steps, run in order. Step: {id?, action, with?, when?, variants?, variant_mode?, on_failure?}; see runtime/action_run.pack for the placeholders and conditions.",
              "items": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "with": {
                    "type": "object"
                  },
                  "when": {
                    "type": "object"
                  },
                  "variants": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "variant_mode": {
                    "type": "string",
                    "enum": [
                      "all",
                      "first_success"
                    ]
                  },
                  "on_failure": {
                    "type": "string",
                    "enum": [
                      "stop",
                      "continue"
                    ]
                  }
                },
                "additionalProperties": true
              }
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "text",
                  "json",
                  "image",
                  "audio",
                  "video",
                  "embedding",
                  "file_ref"
                ]
              },
              "description": "Typed input part kinds the action takes."
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "text",
                  "json",
                  "image",
                  "audio",
                  "video",
                  "embedding",
                  "file_ref"
                ]
              },
              "description": "Typed output part kinds the action returns."
            },
            "requires": {
              "type": "array",
              "description": "Traits the input element must have (all of them). A class id is a trait of its own; classes declare further traits in graph/classes.pack.",
              "items": {
                "type": "string"
              }
            },
            "produces": {
              "type": "array",
              "description": "Traits of the output element (a produced class id stands for the traits of that class).",
              "items": {
                "type": "string"
              }
            },
            "content_op": {
              "type": "string",
              "description": "What the action does to the content: preserve, condense, expand, restyle, evaluate, combine or none (open list, see action_rules axes)."
            },
            "form_op": {
              "type": "string",
              "description": "read (form to content), express (content to form) or none (open list)."
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "description": "Declared relative cost (1 = one ordinary model call); ranks chain proposals, never a limit."
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Declared confidence that the result keeps what the caller meant (0..1); ranks chain proposals."
            },
            "effects": {
              "type": "object",
              "required": [
                "reads_only",
                "writes",
                "sends_off_device",
                "costs_money",
                "irreversible",
                "touches_private_data"
              ],
              "properties": {
                "reads_only": {
                  "type": "boolean"
                },
                "writes": {
                  "type": "boolean"
                },
                "sends_off_device": {
                  "type": "boolean"
                },
                "costs_money": {
                  "type": "boolean"
                },
                "irreversible": {
                  "type": "boolean"
                },
                "touches_private_data": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "consumer": {
              "type": "string",
              "description": "Where the action is called from today."
            },
            "gate_as": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Further action names whose rules also apply to this action (the most restrictive decision wins): settings.set is gated as `edit`, so the edit rules of a settings field apply to it."
            },
            "element_from_arg": {
              "type": "string",
              "description": "The argument that is the element when the caller names none (settings.set: `key` is the settings field)."
            },
            "result_from": {
              "type": "string",
              "description": "Composite only: the id of the step whose output is the result (default: the last step)."
            },
            "phrases": {
              "type": "object",
              "description": "Words that name this action in a chat input, per language: {en: [...], pl: [...]}. A phrase is space-separated words, all of which must occur near the start of the input (any order); a word ending in * matches any continuation. Used by input.route_intent; a new action brings its own phrases."
            },
            "planned_reason": {
              "type": "object",
              "description": "Planned only: why it is not callable yet, per language {en, pl}; shown instead of a bare \"planned\".",
              "additionalProperties": {
                "type": "string"
              }
            },
            "params": {
              "type": "array",
              "description": "The arguments of the action: {name, type, required?, required_unless?, default?, setting?, description {en, pl}}. `required_unless` lists arguments any of which, once given, makes this one optional (usage.set_limit: the growth factor, unless a spending limit is being set). An argument the caller leaves out is filled from the config key `setting` (when it is set), and a required one that is still missing makes the plan unfeasible, saying which; `default` here documents the default that the steps carry.",
              "items": {
                "type": "object"
              }
            },
            "element_many": {
              "type": "boolean",
              "description": "The action takes several elements as one input (combine): the router reads every id in the words, and a request may give element as a list of ids; the contents reach the steps one after another."
            },
            "default_element": {
              "type": "string",
              "minLength": 1,
              "description": "The element the action acts on when the sentence names none: a name the router resolves (last_message, current_conversation), or an element id (device:microphone). A sentence that brings its own text to work on (a colon, a quote, more content words than heuristic.payload.max_words) stays an ordinary message."
            },
            "result_text": {
              "type": "object",
              "description": "The sentence that says what a result is when the result is data and not words (an action whose outputs have no text): per language, {{name}} is an argument of the run. Shown above the data itself, in the language of the proposal. Required by a test for every action whose outputs have no text; an action that outputs text says it in the language of the text it works on.",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1
                },
                "pl": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "element_arg_defaults": {
              "type": "object",
              "description": "For an action whose element is one of its arguments (element_from_arg): when the caller names no element, the first argument of this object that the caller did give selects it - {argument: element value}. usage.set_limit: an `amount` is about the setting usage_spend_limits, a `growth_factor` about loom_usage_policy.",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "model_use": {
              "type": "object",
              "description": "For an action that starts a pipeline: when the model is used, so the estimate of the proposal can say so instead of counting a plan with no model step as free. `arg` is the argument that decides (llm), `values` the values that mean the model is used (auto), `default` the value when the argument is not said (off), `reason` the code of the text in the profile action_run (estimate.reasons) that says why the cost is not known.",
              "additionalProperties": true
            },
            "human": {
              "type": "object",
              "required": [
                "title",
                "steps",
                "steps_are"
              ],
              "description": "M1-D1: the flow in the owner's words: title {pl, en} and steps [{label {pl, en}, uses_role?}]. title.pl equals labels.pl and title.en equals title (one name per flow, checked by tools/check_action_reads.py). A step that calls a model names the ports role of that model (uses_role), so a flow that calls two models (depict: the action model, then the image model) says which step uses which. steps_are is always \"description\": the steps describe what the flow does, they are not the steps the interpreter runs (P37).",
              "properties": {
                "title": {
                  "type": "object"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "type": "object"
                      },
                      "uses_role": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "steps_are": {
                  "type": "string",
                  "enum": [
                    "description"
                  ]
                }
              }
            },
            "reads": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "M1-D1: the settings keys (settings_fields.pack) the executor of this flow reads itself; the reads of its steps and subflows count too. Checked against implemented_in by tools/check_action_reads.py (ctest data.check_action_reads), and against settings_fields.pack human.flows."
            },
            "implemented_in": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "M1-D1: the files (repo-relative) that execute the flow; a data file may be narrowed by a JSON pointer after #. Empty for a planned action."
            },
            "uses_role": {
              "type": "string",
              "minLength": 1,
              "description": "M1-D1: the model role of ports.pack whose job this flow does (for a flow that calls two models, the one that sets it apart: depict -> image.generate; human.steps[].uses_role names the role of each step); guardian.pack models.policies has a policy for it whose explicit setting the flow reads."
            },
            "subflows": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "M1-D1: flows this one runs inside it that are not interpreter steps (chat.send runs graph_native.reply when the flow says so); their reads count as reads of this flow."
            },
            "why": {
              "type": "object",
              "description": "M1-K0: what the flow is for, in the words of each language other than English (the graph navigator's „po co”); English is the description. A language without its words shows the description and says so (no_translation).",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": false
  }
}
