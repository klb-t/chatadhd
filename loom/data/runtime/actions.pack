      "actions.confirm": {
        "id": "actions.confirm",
        "kind": "atomic",
        "status": "implemented",
        "title": "Answer a pending question of a run",
        "description": "Answers the question a run is paused on (a proposal, a confirmation the rules ask for, or the usage guard's x10 hold). The receipt must be the pending one (pending.receipt_id); a stale or invented receipt is refused. approved: true continues the run, false drops it (and records the refusal with the usage guard).",
        "labels": {
          "pl": "Odpowiedz na pytanie wstrzymanego przebiegu"
        },
        "inputs": [
          "json"
        ],
        "outputs": [
          "json"
        ],
        "requires": [
          "application"
        ],
        "produces": [],
        "content_op": "none",
        "form_op": "none",
        "cost": 0.0,
        "confidence": 1.0,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "loom/src/actions/runner.cpp",
        "port": "actions",
        "action": "confirm",
        "params": [
          {
            "name": "run_id",
            "type": "string",
            "required": true,
            "description": {
              "en": "Id of the run (ar_...)",
              "pl": "Identyfikator przebiegu (ar_...)"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "approved",
            "type": "boolean",
            "required": true,
            "description": {
              "en": "Yes or no",
              "pl": "Tak albo nie"
            },
            "has_default": false,
            "edit": "toggle"
          },
          {
            "name": "receipt_id",
            "type": "string",
            "required": true,
            "description": {
              "en": "The pending receipt of the run",
              "pl": "Oczekujące pokwitowanie przebiegu"
            },
            "has_default": false,
            "edit": "free_text"
          },
          {
            "name": "ref",
            "type": "string",
            "required": false,
            "description": {
              "en": "Who answered (recorded)",
              "pl": "Kto odpowiedział (zapisywane)"
            },
            "has_default": false,
            "edit": "free_text"
          }
        ],
        "http": {
          "verb": "POST",
          "path": "/api/actions/confirm"
        }
      },
