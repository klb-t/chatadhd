      "critique": {
        "id": "critique",
        "kind": "composite",
        "status": "implemented",
        "title": "Critique",
        "description": "Evaluate a text content: strengths, weaknesses, credibility, clarity. What to judge it by is the argument criteria.",
        "labels": {
          "pl": "Skrytykuj"
        },
        "steps": [
          {
            "action": "use_model",
            "with": {
              "system": {
                "$localized": {
                  "en": "You are a fair, rigorous critic. Judge the text on its merits: strengths, weaknesses, gaps in the reasoning, credibility of the claims, clarity. Be specific, quote briefly where it helps, and end with the one improvement that matters most. Do not rewrite the text. Answer in the language of the text.",
                  "pl": "Jesteś rzetelnym, wymagającym krytykiem. Oceń tekst po jego wartości: mocne strony, słabe strony, luki w rozumowaniu, wiarygodność twierdzeń, jasność. Bądź konkretny, cytuj krótko, gdy to pomaga, i zakończ jedną poprawką, która liczy się najbardziej. Nie przepisuj tekstu. Odpowiadaj w języku tekstu."
                }
              },
              "prompt": {
                "$format": {
                  "$localized": {
                    "en": "Critique the text above. Judge it by: {criteria}.",
                    "pl": "Oceń krytycznie powyższy tekst. Kryteria: {criteria}."
                  }
                },
                "vars": {
                  "criteria": {
                    "$arg": "criteria",
                    "default": {
                      "$localized": {
                        "en": "strengths, weaknesses, credibility and clarity",
                        "pl": "mocne strony, słabe strony, wiarygodność i jasność"
                      }
                    }
                  }
                }
              },
              "parameters": {
                "temperature": 0.3
              }
            }
          }
        ],
        "inputs": [
          "text"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "has_text"
        ],
        "produces": [
          "has_text",
          "critique"
        ],
        "content_op": "evaluate",
        "form_op": "none",
        "cost": 1.0,
        "confidence": 0.8,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "",
        "phrases": {
          "en": [
            "critique",
            "criticise",
            "criticize"
          ],
          "pl": [
            "skrytykuj*",
            "krytyk*",
            "oceń",
            "ocen*"
          ]
        },
        "params": [
          {
            "name": "criteria",
            "type": "string",
            "required": false,
            "default": "strengths, weaknesses, credibility and clarity",
            "description": {
              "en": "What to judge the text by (\"the argument\", \"the tone\").",
              "pl": "Czym oceniać tekst („argumentacja”, „ton”)."
            }
          }
        ]
      },
      "combine": {
        "id": "combine",
        "kind": "composite",
        "status": "implemented",
        "title": "Combine",
        "description": "Put several contents side by side and join them into one text: every important point of each kept, repetition removed, disagreements named. Name the elements (ids) to combine; the argument shape says what to make of them.",
        "labels": {
          "pl": "Połącz"
        },
        "steps": [
          {
            "action": "use_model",
            "with": {
              "system": {
                "$localized": {
                  "en": "You combine several texts into one coherent text. Keep every important point of each source, remove repetition, resolve overlaps and add nothing of your own. If the sources disagree, say so plainly instead of choosing silently. Answer in the language of the sources.",
                  "pl": "Łączysz kilka tekstów w jeden spójny. Zachowaj każdą ważną myśl z każdego źródła, usuń powtórzenia, uporządkuj nakładanie się treści i nie dodawaj nic od siebie. Gdy źródła się różnią, powiedz to wprost zamiast wybierać po cichu. Odpowiadaj w języku źródeł."
                }
              },
              "prompt": {
                "$format": {
                  "$localized": {
                    "en": "Combine the texts above into one: {shape}.",
                    "pl": "Połącz powyższe teksty w jeden: {shape}."
                  }
                },
                "vars": {
                  "shape": {
                    "$arg": "shape",
                    "default": {
                      "$localized": {
                        "en": "a coherent text",
                        "pl": "spójny tekst"
                      }
                    }
                  }
                }
              },
              "parameters": {
                "temperature": 0.3
              }
            }
          }
        ],
        "inputs": [
          "text",
          "json"
        ],
        "outputs": [
          "text"
        ],
        "requires": [
          "has_text"
        ],
        "produces": [
          "has_text"
        ],
        "content_op": "combine",
        "form_op": "none",
        "cost": 1.0,
        "confidence": 0.8,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "",
        "phrases": {
          "en": [
            "combine",
            "merge",
            "put together"
          ],
          "pl": [
            "połącz*",
            "polacz*",
            "zestaw*"
          ]
        },
        "params": [
          {
            "name": "shape",
            "type": "string",
            "required": false,
            "default": "a coherent text",
            "description": {
              "en": "What to make of them (\"a summary\", \"a list\", \"an email\").",
              "pl": "Co z nich zrobić („streszczenie”, „lista”, „e-mail”)."
            }
          }
        ],
        "element_many": true
      },
      "depict": {
        "id": "depict",
        "kind": "composite",
        "status": "implemented",
        "title": "Depict as an image",
        "description": "Express a text content as an image: a chat model first writes an image prompt that depicts the text (in the style given), then the image model paints it (the openai_images adapter). Needs an image model and the provider that serves it: arguments model and provider, or the settings image_model and image_provider.",
        "labels": {
          "pl": "Namaluj"
        },
        "steps": [
          {
            "id": "scene",
            "action": "use_model",
            "with": {
              "system": {
                "$localized": {
                  "en": "You write prompts for an image generator. Describe ONE concrete scene that depicts the text: subject, setting, composition, lighting, mood and the requested style. At most 120 words. Output only the prompt, in English.",
                  "pl": "Piszesz prompty dla generatora obrazów. Opisz JEDNĄ konkretną scenę przedstawiającą tekst: temat, miejsce, kompozycję, światło, nastrój i zadany styl. Najwyżej 120 słów. Podaj sam prompt, po angielsku."
                }
              },
              "prompt": {
                "$format": {
                  "$localized": {
                    "en": "Write an image prompt that depicts the text above. Style: {style}.",
                    "pl": "Napisz prompt obrazu przedstawiający powyższy tekst. Styl: {style}."
                  }
                },
                "vars": {
                  "style": {
                    "$arg": "style",
                    "default": "a clear, detailed illustration"
                  }
                }
              },
              "parameters": {
                "temperature": 0.7
              }
            },
            "estimate": {
              "output_tokens": {
                "low": 40,
                "high": 300
              }
            }
          },
          {
            "id": "paint",
            "action": "use_model",
            "with": {
              "model": {
                "$arg": "model"
              },
              "provider": {
                "$arg": "provider"
              },
              "wants": [
                "image"
              ],
              "parameters": {
                "n": 1,
                "size": {
                  "$arg": "size",
                  "default": "1024x1024"
                },
                "response_format": "b64_json"
              }
            }
          }
        ],
        "inputs": [
          "text"
        ],
        "outputs": [
          "text",
          "image"
        ],
        "requires": [
          "has_text"
        ],
        "produces": [
          "image_form"
        ],
        "content_op": "preserve",
        "form_op": "express",
        "cost": 3.0,
        "confidence": 0.6,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "",
        "phrases": {
          "en": [
            "draw",
            "paint",
            "depict",
            "make image",
            "make picture",
            "create image",
            "generate image",
            "turn image"
          ],
          "pl": [
            "narysuj*",
            "namaluj*",
            "zrób obraz*",
            "zrób rysunek",
            "wygeneruj obraz*",
            "stwórz obraz*",
            "przedstaw*"
          ]
        },
        "params": [
          {
            "name": "model",
            "type": "string",
            "required": true,
            "setting": "image_model",
            "description": {
              "en": "The image model.",
              "pl": "Model obrazów."
            }
          },
          {
            "name": "provider",
            "type": "string",
            "required": true,
            "setting": "image_provider",
            "description": {
              "en": "The provider (manifest id, adapter openai_images) that serves the image model.",
              "pl": "Dostawca (id manifestu, adapter openai_images) obsługujący model obrazów."
            }
          },
          {
            "name": "style",
            "type": "string",
            "required": false,
            "default": "a clear, detailed illustration",
            "description": {
              "en": "The style of the image (\"watercolour\", \"pixel art\").",
              "pl": "Styl obrazu („akwarela”, „pixel art”)."
            }
          },
          {
            "name": "size",
            "type": "string",
            "required": false,
            "default": "1024x1024",
            "description": {
              "en": "Image size as the provider names it.",
              "pl": "Rozmiar obrazu w nazwach dostawcy."
            }
          }
        ]
      },
      "narrate": {
        "id": "narrate",
        "kind": "composite",
        "status": "implemented",
        "title": "Read aloud",
        "description": "Express a text content as speech: first the text is rewritten as a narration for reading aloud (text), then, when a speech model is set (argument or setting speech_model, with speech_provider), that narration is spoken (audio). Without a speech model the result is the narration text; no speech adapter is registered by default.",
        "labels": {
          "pl": "Przeczytaj na głos"
        },
        "steps": [
          {
            "id": "script",
            "action": "use_model",
            "with": {
              "system": {
                "$localized": {
                  "en": "You prepare texts for reading aloud. Rewrite the text as a spoken narration: short sentences, no markup or lists, numbers and abbreviations written out in words, a clear rhythm. Keep the meaning and the language. Output only the narration.",
                  "pl": "Przygotowujesz teksty do czytania na głos. Przepisz tekst jako narrację mówioną: krótkie zdania, bez znaczników i list, liczby i skróty zapisane słowami, wyraźny rytm. Zachowaj sens i język. Podaj samą narrację."
                }
              },
              "prompt": {
                "$format": {
                  "$localized": {
                    "en": "Prepare the text above for narration. Tone: {tone}.",
                    "pl": "Przygotuj powyższy tekst do narracji. Ton: {tone}."
                  }
                },
                "vars": {
                  "tone": {
                    "$arg": "tone",
                    "default": {
                      "$localized": {
                        "en": "calm and clear",
                        "pl": "spokojny i wyraźny"
                      }
                    }
                  }
                }
              },
              "parameters": {
                "temperature": 0.5
              }
            }
          },
          {
            "id": "speak",
            "action": "use_model",
            "when": {
              "arg": "speech_model"
            },
            "with": {
              "model": {
                "$arg": "speech_model"
              },
              "provider": {
                "$arg": "speech_provider",
                "default": ""
              },
              "wants": [
                "audio"
              ],
              "parameters": {
                "$arg": "speech_parameters",
                "default": {}
              }
            }
          }
        ],
        "inputs": [
          "text"
        ],
        "outputs": [
          "text",
          "audio"
        ],
        "requires": [
          "has_text"
        ],
        "produces": [
          "audio_form"
        ],
        "content_op": "preserve",
        "form_op": "express",
        "cost": 1.0,
        "confidence": 0.8,
        "effects": {
          "reads_only": false,
          "writes": true,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "",
        "phrases": {
          "en": [
            "read aloud",
            "read out",
            "narrate"
          ],
          "pl": [
            "przeczytaj na głos",
            "przeczytaj naglos",
            "opowiedz*",
            "narracj*"
          ]
        },
        "params": [
          {
            "name": "tone",
            "type": "string",
            "required": false,
            "default": "calm and clear",
            "description": {
              "en": "Tone of the narration.",
              "pl": "Ton narracji."
            }
          },
          {
            "name": "speech_model",
            "type": "string",
            "required": false,
            "setting": "speech_model",
            "description": {
              "en": "A model that speaks (needs an adapter that produces audio). Without it the result is the narration text.",
              "pl": "Model, który mówi (wymaga adaptera dającego dźwięk). Bez niego wynikiem jest tekst narracji."
            }
          },
          {
            "name": "speech_provider",
            "type": "string",
            "required": false,
            "setting": "speech_provider",
            "description": {
              "en": "The provider (manifest id) of the speech model.",
              "pl": "Dostawca (id manifestu) modelu mowy."
            }
          },
          {
            "name": "speech_parameters",
            "type": "object",
            "required": false,
            "description": {
              "en": "Extra parameters of the speech request (voice, format ...), as the provider names them.",
              "pl": "Dodatkowe parametry żądania mowy (głos, format ...) w nazwach dostawcy."
            }
          }
        ]
      },
      "actions.for": {
