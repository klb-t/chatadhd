      "goal.typing": {
        "id": "goal.typing",
        "kind": "composite",
        "status": "implemented",
        "title": "Type the goal of a prompt",
        "description": "Classifies a prompt into a goal type when the cue classifier is unsure; explicitly budgeted.",
        "why": {
          "pl": "Określa rodzaj celu polecenia, gdy lokalny klasyfikator nie jest pewien; z jawnym budżetem."
