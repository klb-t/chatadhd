      "input.route_intent": {
        "id": "input.route_intent",
        "kind": "composite",
        "status": "implemented",
        "title": "Recognise a command",
        "description": "Decides whether user input is a message or an interface command; for a command, finds the action and the element and analyses feasibility, cost and what needs confirmation. Method is a setting (intent_routing_method): heuristic (local and free: explicit command syntax and a phrase lexicon from data, no model call), model (one use_model call with the configured model, guarded like any other) or off. Data: runtime/intent_routing.pack; the phrases of an action are on the action (`phrases`).",
        "why": {
          "pl": "Rozstrzyga, czy wpis jest wiadomością, czy poleceniem dla aplikacji; dla polecenia znajduje działanie i element oraz mówi, co kosztuje i o co trzeba zapytać."
        },
        "steps": [
          {
            "action": "use_model"
          }
        ],
        "inputs": [
          "text",
          "json"
        ],
        "outputs": [
          "json"
        ],
        "requires": [
          "user_input"
        ],
        "produces": [
          "classification"
        ],
        "content_op": "none",
        "form_op": "none",
        "cost": 0.2,
        "confidence": 0.85,
        "effects": {
          "reads_only": true,
          "writes": false,
          "sends_off_device": true,
          "costs_money": true,
          "irreversible": false,
          "touches_private_data": true
        },
        "consumer": "loom/src/actions/route.cpp",
        "labels": {
          "pl": "Rozpoznaj polecenie"
        },
        "result_text": {
          "en": "The input was read as a message or a command.",
          "pl": "Wejście zostało odczytane jako wiadomość albo polecenie."
        },
        "human": {
          "title": {
            "pl": "Rozpoznaj polecenie",
            "en": "Recognise a command"
          },
          "steps": [
            {
              "label": {
                "pl": "Najpierw lokalnie: reguły poleceń i frazy z danych (bez kosztu)",
                "en": "Locally first: command rules and phrases from data (at no cost)"
              }
            },
            {
              "label": {
                "pl": "Gdy metoda (intent_routing_method) każe i odczyt lokalny jest niepewny: zapytaj model rozpoznawania (intent_routing_model, a gdy pusty — default_model)",
                "en": "When the method (intent_routing_method) says so and the local reading is unsure: ask the recognition model (intent_routing_model, else default_model)"
              }
            },
            {
              "label": {
                "pl": "Polecenie: zaproponuj działanie albo wykonaj je od razu według intent_routing_run; odrzucenie według intent_routing_on_reject",
                "en": "A command: propose the action or run it at once per intent_routing_run; a rejection per intent_routing_on_reject"
              }
            },
            {
              "label": {
                "pl": "Nieznany kształt polecenia: zaproponuj zdefiniowanie działania (emergent_actions)",
                "en": "An unknown command shape: offer to define an action (emergent_actions)"
              }
            }
          ],
          "steps_are": "description"
        },
        "reads": [
          "intent_routing_method",
          "intent_routing_model",
          "default_model",
          "intent_routing_run",
          "intent_routing_on_reject",
          "emergent_actions",
          "auto_title"
        ],
        "uses_role": "intent.routing",
        "implemented_in": [
          "loom/src/actions/route.cpp",
          "loom/data/runtime/intent_routing.pack#/defaults/method",
          "loom/data/runtime/intent_routing.pack#/defaults/execution",
          "loom/data/runtime/intent_routing.pack#/defaults/on_reject",
          "loom/data/runtime/intent_routing.pack#/defaults/emergent",
          "loom/src/actions/emergent.cpp"
        ]
      },
