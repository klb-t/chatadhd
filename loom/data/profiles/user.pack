{
  "schema": "loom.default_layers_pack/1",
  "pack_id": "loom.onboarding.defaults",
  "revision": 7,
  "policy": {
    "excluded_area_new_defaults": "proposal"
  },
  "entry_packs": [
    {
      "$include": "profiles/graph_perspective.pack"
    },
    {
      "$include": "profiles/conversation_view.pack"
    }
  ],
  "entries": [
    {
      "id": "onboarding.settings/v1",
      "key": "onboarding.settings",
      "area": "onboarding/settings",
      "revision": 1,
      "value": {
        "preference_mode": "ask"
      }
    },
    {
      "id": "onboarding.privacy/v1",
      "key": "onboarding.privacy",
      "area": "privacy",
      "revision": 1,
      "value": {
        "rules": [
          {
            "id": "local-explicit-preset",
            "category": "*",
            "store": true,
            "infer": false,
            "explicit_only": true,
            "providers": [],
            "max_detail": null,
            "max_sensitivity": null,
            "retention": {
              "history": "full",
              "max_events": null,
              "metadata_keys": [
                "id",
                "op",
                "field",
                "category",
                "time",
                "provenance",
                "review",
                "review_time",
                "presentation",
                "detail",
                "sensitivity",
                "candidate",
                "decision",
                "status",
                "source_refs",
                "method_version_id",
                "method_run_id"
              ]
            },
            "provenance": "builtin_preset",
            "consent_event": null
          }
        ]
      },
      "requires_explicit_consent": true
    },
    {
      "id": "preference.style/v1",
      "key": "preference.style",
      "area": "preferences/communication",
      "revision": 1,
      "value": "neutral"
    },
    {
      "id": "preference.length/v1",
      "key": "preference.length",
      "area": "preferences/communication",
      "revision": 1,
      "value": "concise"
    },
    {
      "id": "preference.language/v1",
      "key": "preference.language",
      "area": "preferences/communication",
      "revision": 1,
      "value": "auto"
    },
    {
      "id": "preference.adhd_needs/v1",
      "key": "preference.adhd_needs",
      "area": "preferences/communication",
      "revision": 1,
      "value": []
    },
    {
      "id": "profile.self/v1",
      "key": "profile.self",
      "area": "profiles/application",
      "revision": 1,
      "value": {
        "pack_path": "profiles/self.json",
        "role": "application_probe",
        "user_personal_fact": false
      }
    },
    {
      "id": "method.onboarding/v1",
      "key": "method.onboarding",
      "area": "methods/onboarding",
      "revision": 1,
      "value": {
        "schema": "loom.default_reference/1",
        "source": "scenario",
        "pointer": "/graph_method"
      }
    },
    {
      "id": "prompt.onboarding/v1",
      "key": "prompt.onboarding",
      "area": "prompts/onboarding",
      "revision": 1,
      "value": {
        "schema": "loom.default_reference/1",
        "source": "scenario",
        "pointer": "/prompt"
      }
    },
    {
      "id": "onboarding.presentation/v1",
      "key": "presentation.onboarding",
      "area": "onboarding/presentation",
      "revision": 3,
      "value": {
        "$include": "onboarding/ui.pack"
      }
    },
    {
      "id": "profile.subgraphs/v1",
      "key": "profile.subgraphs",
      "area": "profiles/subgraphs",
      "revision": 2,
      "value": {
        "schema": "loom.profile_subgraphs/1",
        "description": "The parts of the node You (party:self): the order in which the stable ones are rendered into the profile prefix of a request (order_for_prefix, null = not part of the prefix; stability_rank, 1 = changes least) and what the graph shows under each (members: the projection sources whose nodes hang under that part, where = the node fields they must have, also = shown here too and still at their home; the first part in this table that claims a node keeps it; actions = the catalogue actions offered on each member, args = the node field each takes or a constant; actions_here = offered on the part itself; hidden: true = you hid the part). The projection of party:self (M1-K2c-2) reads this table; your table in the onboarding layers replaces the shipped one.",
        "subgraphs": [
          {
            "id": "identity",
            "label": {
              "pl": "Tożsamość",
              "en": "Identity"
            },
            "why": {
              "pl": "Kim jesteś: imię, rola, strefa czasu. Zmienia się najrzadziej, więc idzie na początek.",
              "en": "Who you are: name, role, time zone. It changes least, so it goes first."
            },
            "order_for_prefix": 1,
            "stability_rank": 1,
            "members": [
              {
                "source": "party",
                "where": {
                  "kind": "profile_slot",
                  "attrs.section": [
                    "identity"
                  ]
                }
              }
            ],
            "actions": [
              {
                "action": "profile.set",
                "args": {
                  "slot": "attrs.slot"
                }
              }
            ],
            "actions_here": [
              {
                "action": "profile.interview",
                "args": {
                  "op": {
                    "const": "start"
                  }
                }
              },
              {
                "action": "profile.show"
              }
            ]
          },
          {
            "id": "preferences",
            "label": {
              "pl": "Preferencje",
              "en": "Preferences"
            },
            "why": {
              "pl": "Styl, długość odpowiedzi, język. Mogą być inne dla każdego przepływu.",
              "en": "Style, answer length, language. They can differ for every flow."
            },
            "order_for_prefix": 2,
            "stability_rank": 2,
            "per_flow": true,
            "members": [
              {
                "source": "preference"
              }
            ],
            "actions": [
              {
                "action": "profile.set",
                "args": {
                  "slot": "attrs.slot"
                }
              }
            ],
            "actions_here": [
              {
                "action": "profile.interview",
                "args": {
                  "op": {
                    "const": "start"
                  }
                }
              }
            ]
          },
          {
            "id": "policies",
            "label": {
              "pl": "Zasady",
              "en": "Policies"
            },
            "why": {
              "pl": "Co wolno robić z Twoimi danymi i o co pytać: prywatność i to, co strażnik ma zapamiętane.",
              "en": "What may be done with your data and what to ask about: privacy and what the guardian remembers."
            },
            "order_for_prefix": 3,
            "stability_rank": 3,
            "members": [
              {
                "source": "policy"
              }
            ],
            "actions": [
              {
                "action": "profile.set",
                "args": {
                  "slot": {
                    "const": "privacy.preferences"
                  }
                }
              }
            ],
            "actions_here": [
              {
                "action": "profile.show"
              }
            ]
          },
          {
            "id": "units",
            "label": {
              "pl": "Jednostki",
              "en": "Units"
            },
            "why": {
              "pl": "Projekty, zespoły i organizacje, do których należysz.",
              "en": "The projects, teams and organisations you belong to."
            },
            "order_for_prefix": 4,
            "stability_rank": 4,
            "members": [
              {
                "source": "unit",
                "also": true
              }
            ],
            "actions": [
              {
                "action": "units.forget",
                "args": {
                  "kind": "attrs.unit_kind",
                  "id": "attrs.unit_id"
                }
              },
              {
                "action": "conversation.set_unit",
                "args": {
                  "kind": "attrs.unit_kind",
                  "id": "attrs.unit_id"
                }
              }
            ],
            "actions_here": [
              {
                "action": "units.define",
                "ask": [
                  "label"
                ]
              },
              {
                "action": "units.list"
              }
            ]
          },
          {
            "id": "interests",
            "label": {
              "pl": "Zainteresowania",
              "en": "Interests"
            },
            "why": {
              "pl": "Tematy, o których piszesz; to wnioski z analizy, nie Twoje słowa.",
              "en": "Topics you write about; these are conclusions of the analysis, not your words."
            },
            "order_for_prefix": 5,
            "stability_rank": 5,
            "members": [
              {
                "source": "interest"
              }
            ],
            "actions": [
              {
                "action": "inference.confirm",
                "args": {
                  "entry": "attrs.node_id"
                },
                "where": {
                  "evidence.class": "inferred"
                }
              },
              {
                "action": "inference.reject",
                "args": {
                  "entry": "attrs.node_id"
                },
                "where": {
                  "evidence.class": "inferred"
                }
              },
              {
                "action": "inference.confirm",
                "args": {
                  "entry": "attrs.node_id"
                },
                "where": {
                  "state": "rejected"
                }
              },
              {
                "action": "inference.reject",
                "args": {
                  "entry": "attrs.node_id"
                },
                "where": {
                  "evidence.provenance.method": "user_confirmed"
                }
              }
            ],
            "actions_here": []
          },
          {
            "id": "network",
            "label": {
              "pl": "Sieć",
              "en": "Network"
            },
            "why": {
              "pl": "Osoby i organizacje, które znasz.",
              "en": "The people and organisations you know."
            },
            "order_for_prefix": 6,
            "stability_rank": 6,
            "members": [
              {
                "source": "party",
                "where": {
                  "kind": [
                    "person",
                    "organization"
                  ],
                  "attrs.contact": true
                }
              }
            ],
            "actions": [
              {
                "action": "inference.confirm",
                "args": {
                  "entry": "attrs.node_id"
                },
                "where": {
                  "evidence.class": "inferred"
                }
              },
              {
                "action": "inference.reject",
                "args": {
                  "entry": "attrs.node_id"
                },
                "where": {
                  "evidence.class": "inferred"
                }
              },
              {
                "action": "inference.confirm",
                "args": {
                  "entry": "attrs.node_id"
                },
                "where": {
                  "state": "rejected"
                }
              },
              {
                "action": "inference.reject",
                "args": {
                  "entry": "attrs.node_id"
                },
                "where": {
                  "evidence.provenance.method": "user_confirmed"
                }
              }
            ],
            "actions_here": []
          },
          {
            "id": "memory",
            "label": {
              "pl": "Co pamiętam",
              "en": "What I remember"
            },
            "why": {
              "pl": "Wpisy drzewa pamięci. Idą do żądania jako część „Pamięć”, nie jako profil.",
              "en": "The entries of the memory tree. They go into the request as the part “Memory”, not as the profile."
            },
            "order_for_prefix": null,
            "stability_rank": 7,
            "members": [
              {
                "source": "memory",
                "where": {
                  "status": [
                    "active",
                    "inactive"
                  ]
                }
              }
            ],
            "actions": [
              {
                "action": "memory.forget",
                "args": {
                  "query": "attrs.note_id"
                }
              }
            ],
            "actions_here": [
              {
                "action": "memory.remember"
              },
              {
                "action": "memory.recall"
              }
            ]
          },
          {
            "id": "forgotten",
            "label": {
              "pl": "Zapomniane",
              "en": "Forgotten"
            },
            "why": {
              "pl": "Wpisy pamięci, które kazałeś zapomnieć. Nie trafiają do żadnej rozmowy; zapis (kiedy, przez kogo, czy z treścią) zostaje tutaj, żeby nic nie znikało po cichu.",
              "en": "Memory entries you told me to forget. They go into no conversation; the record (when, by whom, with or without its words) stays here so that nothing disappears silently."
            },
            "order_for_prefix": null,
            "stability_rank": 9,
            "members": [
              {
                "source": "memory",
                "where": {
                  "status": "forgotten"
                }
              }
            ],
            "actions": [
              {
                "action": "memory.restore",
                "args": {
                  "id": "attrs.note_id"
                },
                "where": {
                  "attrs.forgotten.kept": true
                }
              }
            ],
            "actions_here": []
          },
          {
            "id": "slots",
            "label": {
              "pl": "Pola wywiadu",
              "en": "Interview fields"
            },
            "why": {
              "pl": "Wszystko, o co pyta wywiad poza tożsamością: każde pole ze stanem (wiem, nieznane, pominięte, nigdy nie pytaj) i z powodem, jeśli o nie nie zapytam.",
              "en": "Everything else the interview asks about: every field with its state (known, unknown, declined, never ask) and the reason when I will not ask."
            },
            "order_for_prefix": null,
            "stability_rank": 8,
            "members": [
              {
                "source": "party",
                "where": {
                  "kind": "profile_slot"
                }
              }
            ],
            "actions": [
              {
                "action": "profile.set",
                "args": {
                  "slot": "attrs.slot"
                }
              }
            ],
            "actions_here": [
              {
                "action": "profile.interview",
                "args": {
                  "op": {
                    "const": "start"
                  }
                }
              },
              {
                "action": "profile.show"
              }
            ]
          }
        ]
      }
    }
  ],
  "vocabulary": {
    "kinds": {
      "profile": "profile",
      "field": "field",
      "privacy_rule": "privacy_rule",
      "default": "default",
      "layer": "layer",
      "exclusion": "exclusion",
      "pack_document": "pack_document",
      "type": "type",
      "method": "method",
      "method_version": "method_version",
      "prompt_version": "prompt_version",
      "recipe_version": "recipe_version",
      "parameter_set_version": "parameter_set_version",
      "preset_version": "preset_version",
      "run": "run"
    },
    "predicates": {
      "has_field": "has_field",
      "has_rule": "has_rule",
      "has_default": "has_default",
      "excluded": "excluded",
      "version_of": "version_of",
      "uses_prompt": "uses_prompt",
      "uses_recipe": "uses_recipe",
      "uses_parameter_set": "uses_parameter_set",
      "uses_preset": "uses_preset",
      "declares_type": "declares_type",
      "has_state": "has_state",
      "has_value": "has_value",
      "from_layer": "from_layer",
      "part_of": "part_of",
      "has_profile": "has_profile",
      "has_method": "has_method",
      "uses_method_version": "uses_method_version",
      "requests_method_version": "requests_method_version",
      "produced_in_run": "produced_in_run",
      "produced_by_method_version": "produced_by_method_version"
    }
  },
  "runtime_definition": {
    "schema": "loom.runtime_profile/1",
    "domain": "onboarding",
    "revision": 1,
    "defaults": {
      "$layer_bindings": "runtime_bindings"
    },
    "value_schema": {
      "type": "object",
      "required": [
        "settings",
        "privacy"
      ],
      "properties": {
        "settings": {
          "type": "object",
          "required": [
            "preference_mode"
          ],
          "properties": {
            "preference_mode": {
              "type": "string",
              "enum": [
                "ask",
                "candidate",
                "automatic"
              ],
              "x-setting": "/settings/preference_mode"
            }
          },
          "additionalProperties": true
        },
        "privacy": {
          "type": "object",
          "required": [
            "rules"
          ],
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              },
              "x-setting": "/privacy/rules"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "runtime_bindings": {
    "/settings": "onboarding.settings",
    "/privacy": "onboarding.privacy"
  },
  "scenario_bindings": {
    "/prompt": "prompt.onboarding",
    "/graph_method/prompt/text": "prompt.onboarding"
  },
  "method_selection": {
    "parameter_layers": [
      "preset",
      "recipe",
      "method",
      "parameter_set",
      "selection",
      "user"
    ],
    "parameters": {},
    "user_overrides": {}
  },
  "scenario_copy_bindings": {
    "/graph_method/recipe/sections": "/sections",
    "/graph_method/recipe/reply_schema": "/reply_schema",
    "/graph_method/recipe/fields": "/fields"
  },
  "presentation_key": "presentation.onboarding"
}
