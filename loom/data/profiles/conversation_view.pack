            "resource": "{{name}}: expected {{projected}}, baseline {{baseline}}, growth {{ratio}}",
            "unknown": "unknown",
            "confirm": "Confirm and send",
            "reject": "Reject",
            "restored": "Your text is back in the composer.",
            "rejected": "Rejected. Nothing was sent.",
            "limit_title": "Spending limit",
