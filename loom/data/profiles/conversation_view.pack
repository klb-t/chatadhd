  "entries": [
    {
      "id": "presentation.conversation_view/v1",
      "key": "presentation.conversation_view",
      "area": "presentation/conversation_view",
      "revision": 1,
      "label": "Local source view labels; local reading does not authorize model disclosure",
      "value": {
        "schema": "loom.presentation_feature/1",
        "feature": "conversation_view",
        "locales": {
          "en": {
            "title": "Referenced conversation sources",
            "local_read": "Read linked sources locally",
            "reading": "Reading linked sources…",
            "read_scope": "This action reads the attached source for this local view. It does not authorize sending source content to a model or another service. The adapter may read the whole container.",
            "readonly": "This source message is a version-pinned, read-only view. Editing, restoring a stored version and source-history sending are unavailable.",
            "egress_unavailable": "Source-history sending is unavailable: local read has no model-disclosure binding.",
            "details": "Source versions, access results and read evidence",
            "unavailable": "The source view is unavailable. Stored messages and explicit source statuses remain visible.",
            "complete": "Source view complete",
            "partial": "Source view partial",
            "configuration": "Local read configuration",
            "projection_storage": "Derived projection retention",
            "content_index": "Source content index",
            "snapshot": "Retain a derived snapshot",
            "transient": "Keep this read in memory",
            "sketch": "Retain a content sketch",
            "none": "Do not create a content index",
            "retention": "These are the currently resolved resource-read settings. A transient read does not remove earlier snapshots or certify absence of historical payload.",
            "configuration_unavailable": "Read configuration is unavailable; inspect diagnostics before reading.",
            "source_message": "Reference and capabilities",
            "reload": "Reload source metadata (without reading content)",
            "empty": "The recognized source has no messages.",
            "install": "Install local-source view labels in this profile",
            "feature_missing": "This profile has no accepted local-source view catalog. Installing its declaration preserves existing settings and exclusions.",
            "source_status": "Source status: {{status}}; mapping: {{mapping}}; current: {{current}}",
            "status_unavailable": "unavailable",
            "status_unknown": "unknown",
            "status_partial": "partial",
            "status_complete": "complete",
            "host_unavailable": "This host exposes stored messages only. Reading linked source history is unavailable.",
            "exact_wire": "Exact native view JSON",
            "decoded_projection": "Text and summaries are decoded display projections. Numeric tokens in unknown fields may be rounded here. Inspect the exact native response in source evidence.",
            "wire_unavailable": "Exact native response evidence is unavailable for this host response."
          },
          "pl": {
            "title": "Źródła rozmowy referencyjnej",
            "local_read": "Odczytaj źródła lokalnie",
            "reading": "Odczytywanie źródeł…",
            "read_scope": "Ta czynność odczytuje dołączone źródło na potrzeby lokalnego widoku. Nie udziela zgody na wysłanie treści do modelu ani innej usługi. Adapter może odczytać cały kontener.",
            "readonly": "Ta wiadomość jest widokiem źródła przypiętym do wersji, tylko do odczytu. Edycja, odtwarzanie zapisanej wersji i wysyłanie historii źródła są niedostępne.",
            "egress_unavailable": "Wysyłanie historii źródła jest niedostępne: lokalny odczyt nie ustanawia zgody na ujawnienie modelowi.",
            "details": "Wersje źródeł, wyniki dostępu i dowody odczytu",
            "unavailable": "Widok źródła jest niedostępny. Zapisane wiadomości i jawne statusy źródeł pozostają widoczne.",
            "complete": "Widok źródła kompletny",
            "partial": "Widok źródła częściowy",
            "configuration": "Konfiguracja lokalnego odczytu",
            "projection_storage": "Przechowywanie projekcji pochodnej",
            "content_index": "Indeks treści źródła",
            "snapshot": "Zachowaj migawkę pochodną",
            "transient": "Przechowuj ten odczyt w pamięci",
            "sketch": "Zachowaj szkic treści",
            "none": "Nie twórz indeksu treści",
            "retention": "To aktualnie rozwiązane ustawienia odczytu zasobu. Odczyt przejściowy nie usuwa wcześniejszych migawek ani nie potwierdza braku historycznej treści.",
            "configuration_unavailable": "Konfiguracja odczytu jest niedostępna; sprawdź diagnostykę przed odczytem.",
            "source_message": "Referencja i możliwości",
            "reload": "Odśwież metadane źródła (bez odczytu treści)",
            "empty": "Rozpoznane źródło nie zawiera wiadomości.",
            "install": "Zainstaluj opisy lokalnego widoku źródła w tym profilu",
            "feature_missing": "Ten profil nie ma zaakceptowanego katalogu lokalnego widoku źródła. Instalacja deklaracji zachowuje istniejące ustawienia i wykluczenia.",
            "source_status": "Status źródła: {{status}}; mapowanie: {{mapping}}; aktualne: {{current}}",
            "status_unavailable": "niedostępne",
            "status_unknown": "nieznane",
            "status_partial": "częściowe",
            "status_complete": "kompletne",
            "host_unavailable": "Ten host udostępnia tylko zapisane wiadomości. Odczyt historii źródła referencyjnego jest niedostępny.",
            "exact_wire": "Dokładny JSON natywnego widoku",
            "decoded_projection": "Tekst i podsumowania są zdekodowaną projekcją widoku. Liczby w nieznanych polach mogą być tu zaokrąglone. Dokładna odpowiedź natywna jest dostępna w dowodach źródła.",
            "wire_unavailable": "Dokładna odpowiedź natywna jest niedostępna dla tej odpowiedzi hosta."
          }
        }
      }
    },
    {
      "id": "presentation.chat_send/v1",
      "key": "presentation.chat_send",
      "area": "presentation/chat_send",
      "revision": 1,
      "label": "Send notices and explanations for conversations with linked sources; texts only, they do not change what is sent",
      "value": {
        "schema": "loom.presentation_feature/1",
        "feature": "chat_send",
        "locales": {
          "en": {
            "source_history_omitted": "Linked source history will not be included in this message. Only the messages stored in this conversation are sent.",
            "reason": "Reason: {{explanation}} (code: {{reason}})",
            "reason.source_egress_not_bound": "there is no binding yet that allows source content to be sent to a model",
            "reason.unrecognized": "the conversation view reports that this history cannot be included",
            "view_unavailable": "The conversation view could not be loaded ({{reason}}). Sending still works: the message is sent with the messages stored in this conversation; linked source history, if any, is not included.",
            "view_loading": "Sending waits until this conversation's view has loaded.",
            "source_read_in_flight": "Sending waits while linked sources are read locally, so that a message is not sent while the view is changing. It resumes when the read finishes.",
            "setting_label": "Block sending when linked source history cannot be included",
            "setting_help": "Off: the message is sent with the stored messages only and a notice says what is missing. On: sending stays disabled in such conversations until you turn this off.",
            "blocked_by_setting": "Sending is blocked by your setting “{{setting}}”. Turn it off to send with the stored messages only.",
            "unblock": "Turn off this block",
            "queued_waiting": "Waiting for the conversation to load… your message will be sent as soon as it is there.",
            "queued_failed": "The conversation did not load, so nothing was sent. Your text is still in the field.",
            "stream_ended": "The answer stream ended before a result arrived. Nothing more will come for this message; send it again if you need an answer.",
            "empty_answer": "The model answered with no text."
          },
          "pl": {
            "source_history_omitted": "Historia połączonych źródeł nie zostanie dołączona do tej wiadomości. Wysyłane są tylko wiadomości zapisane w tej rozmowie.",
            "reason": "Powód: {{explanation}} (kod: {{reason}})",
            "reason.source_egress_not_bound": "nie ma jeszcze powiązania, które pozwala wysłać treść źródła do modelu",
            "reason.unrecognized": "widok rozmowy zgłasza, że tej historii nie można dołączyć",
            "view_unavailable": "Nie udało się wczytać widoku rozmowy ({{reason}}). Wysyłanie nadal działa: wiadomość zostanie wysłana z wiadomościami zapisanymi w tej rozmowie; historia połączonych źródeł, jeśli istnieje, nie zostanie dołączona.",
            "view_loading": "Wysyłanie czeka na wczytanie widoku tej rozmowy.",
            "source_read_in_flight": "Wysyłanie czeka na zakończenie lokalnego odczytu połączonych źródeł, aby wiadomość nie została wysłana przy zmieniającym się widoku. Wznowi się po zakończeniu odczytu.",
            "setting_label": "Blokuj wysyłanie, gdy nie można dołączyć historii połączonych źródeł",
            "setting_help": "Wyłączone: wiadomość jest wysyłana tylko z zapisanymi wiadomościami, a komunikat mówi, czego brakuje. Włączone: wysyłanie pozostaje zablokowane w takich rozmowach, dopóki tego nie wyłączysz.",
            "blocked_by_setting": "Wysyłanie blokuje Twoje ustawienie „{{setting}}”. Wyłącz je, aby wysłać wiadomość tylko z zapisanymi wiadomościami.",
            "unblock": "Wyłącz tę blokadę",
            "queued_waiting": "Czekam na wczytanie rozmowy… wiadomość zostanie wysłana, gdy tylko będzie gotowa.",
            "queued_failed": "Rozmowa nie wczytała się, więc nic nie wysłano. Twój tekst został w polu.",
            "stream_ended": "Strumień odpowiedzi skończył się, zanim doszedł wynik. Dla tej wiadomości nic więcej nie przyjdzie; wyślij ją jeszcze raz, jeśli potrzebujesz odpowiedzi.",
            "empty_answer": "Model odpowiedział bez tekstu."
          }
        }
      }
    },
    {
      "id": "presentation.chat_usage/v1",
      "key": "presentation.chat_usage",
      "area": "presentation/chat_usage",
      "revision": 1,
      "label": "Texts for a send or semantic batch paused by the usage guard; texts only, they do not change what is sent",
      "value": {
        "schema": "loom.presentation_feature/1",
        "feature": "chat_usage",
        "locales": {
          "en": {
            "title": "Requires confirmation",
