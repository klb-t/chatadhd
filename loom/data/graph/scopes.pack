{
  "schema": "loom.graph_scopes/1",
  "revision": 1,
  "calibration": true,
  "description": "Calibration example (R53, DUCH_GRAFU 0): a starting point the owner may reorder, hide, extend or replace through the graph_entry runtime-profile overlay; it is not a closed list. Chain runs from most general to most specific; not every setting uses every scope.",
  "chain": [
    {
      "id": "engine",
      "label": {
        "en": "Engine invariants",
        "pl": "Silnik (niezmienniki)"
      },
      "meaning": {
        "en": "what the app never lets anyone change",
        "pl": "to, czego aplikacja nikomu nie pozwala zmienić"
      }
    },
    {
      "id": "app_preset",
      "label": {
        "en": "Application preset",
        "pl": "Preset aplikacji"
      },
      "meaning": {
        "en": "the values the app ships with",
        "pl": "wartości, z którymi aplikacja przychodzi"
      }
    },
    {
      "id": "installation",
      "label": {
        "en": "Installation",
        "pl": "Instalacja"
      },
      "meaning": {
        "en": "this phone or this copy of the app",
        "pl": "ten telefon albo ta kopia aplikacji"
      }
    },
    {
      "id": "organization",
      "label": {
        "en": "Organization",
        "pl": "Organizacja"
      },
      "meaning": {
        "en": "the company or institution you belong to",
        "pl": "firma albo instytucja, do której należysz"
      }
    },
    {
      "id": "group_of_groups",
      "label": {
        "en": "Group of groups",
        "pl": "Grupa grup"
      },
      "meaning": {
        "en": "a parent unit that gathers several teams",
        "pl": "jednostka nadrzędna, która zbiera kilka zespołów"
      }
    },
    {
      "id": "team",
      "label": {
        "en": "Team",
        "pl": "Zespół"
      },
      "meaning": {
        "en": "the team you work in",
        "pl": "zespół, w którym pracujesz"
      }
    },
    {
      "id": "person",
      "label": {
        "en": "Person",
        "pl": "Osoba"
      },
      "meaning": {
        "en": "you: your own settings",
        "pl": "Ty: Twoje własne ustawienia"
      }
    },
    {
      "id": "role_in_context",
      "label": {
        "en": "Role in context",
        "pl": "Rola w kontekście"
      },
      "meaning": {
        "en": "the role you act in right now (author, reviewer…)",
        "pl": "rola, w jakiej teraz występujesz (autor, recenzent…)"
      }
    },
    {
      "id": "project",
      "label": {
        "en": "Project (branch)",
        "pl": "Projekt (gałąź)"
      },
      "meaning": {
        "en": "one project or one branch of work",
        "pl": "jeden projekt albo jedna gałąź pracy"
      }
    },
    {
      "id": "conversation",
      "label": {
        "en": "Conversation",
        "pl": "Rozmowa"
      },
      "meaning": {
        "en": "this conversation only",
        "pl": "tylko ta rozmowa"
      }
    },
    {
      "id": "turn",
      "label": {
        "en": "Turn / single call",
        "pl": "Tura / wywołanie"
      },
      "meaning": {
        "en": "one single call to the model",
        "pl": "jedno pojedyncze wywołanie modelu"
      }
    }
  ],
  "default_rule": "most_specific_wins",
  "conflict_rules": [
    {
      "id": "most_specific_wins",
      "label": {
        "en": "Most specific scope wins",
        "pl": "Wygrywa najbardziej szczegółowy zakres"
      }
    },
    {
      "id": "locked_by",
      "label": {
        "en": "Pinned by a higher scope",
        "pl": "Przypięte przez wyższy zakres"
      }
    },
    {
      "id": "merge",
      "label": {
        "en": "Deep merge",
        "pl": "Scalanie"
      }
    },
    {
      "id": "intersection",
      "label": {
        "en": "Intersection",
        "pl": "Część wspólna"
      }
    },
    {
      "id": "min",
      "label": {
        "en": "Minimum",
        "pl": "Minimum"
      }
    },
    {
      "id": "max",
      "label": {
        "en": "Maximum",
        "pl": "Maksimum"
      }
    },
    {
      "id": "weighted_vote",
      "label": {
        "en": "Weighted vote",
        "pl": "Głosowanie z wagami"
      }
    },
    {
      "id": "ask",
      "label": {
        "en": "Ask the user",
        "pl": "Zapytaj użytkownika"
      }
    },
    {
      "id": "by_context",
      "label": {
        "en": "By context predicate",
        "pl": "Według kontekstu"
      }
    },
    {
      "id": "first_defined",
      "label": {
        "en": "First defined",
        "pl": "Pierwsza zdefiniowana"
      }
    }
  ]
}
