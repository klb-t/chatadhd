      "note": {
        "en": "Chat (base_url + api_key), batch (anthropic_batch_key), speech (Groq, Google), OCR (ocr.space). Reachable only with a key and network.",
        "pl": "Czat (base_url + api_key), batch (anthropic_batch_key), mowa (Groq, Google), OCR (ocr.space). Dostępne tylko z kluczem i siecią."
      }
    },
    "server_endpoint": {
