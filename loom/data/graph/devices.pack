    },
    "storage_backend": {
      "class": "storage_backend",
      "label": {
        "en": "Configured storage backends",
        "pl": "Skonfigurowane magazyny"
      },
      "availability": {
        "web": "available",
        "android": "available",
        "server": "available",
        "cli": "available"
      },
      "instances": {
        "from": {
          "domain": "storage_security",
          "pointer": "/storages"
