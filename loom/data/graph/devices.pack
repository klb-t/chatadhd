        "server": "unavailable",
        "cli": "unavailable"
      }
    },
    "file_access": {
      "class": "file_access",
      "label": {
        "en": "Files",
        "pl": "Pliki"
      },
      "availability": {
        "web": "permission",
        "android": "permission",
        "server": "available",
        "cli": "available"
      },
      "note": {
        "en": "Web: file picker; Android: storage access; server/CLI: the process file system.",
        "pl": "Web: wybierak plików; Android: dostęp do pamięci; serwer/CLI: system plików procesu."
      }
    },
    "clipboard": {
      "class": "clipboard",
