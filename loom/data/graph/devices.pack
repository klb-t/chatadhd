          "cli": [
            "linux",
            "macos",
            "windows",
            "all"
          ]
        }
      },
      "note": {
        "en": "One node per storage in the storage_security profile; their availability is that profile's available_on (OS names), mapped to platforms here.",
        "pl": "Jeden węzeł na magazyn z profilu storage_security; dostępność z jego pola available_on (nazwy systemów), tu mapowana na platformy."
      }
    },
    "model_provider": {
      "class": "model_provider",
