{
  "schema": "loom.graph_devices/1",
  "revision": 1,
  "calibration": true,
  "description": "Input/output devices as graph nodes (GRAF_HUB_KOD_SILNIK §4.3, S2/R9). Each entry has a class (data/graph/classes.pack: class and traits come from there, never from code) and availability per platform: available | permission (usable after a user grant) | unavailable. Descriptions only: no hardware is accessed. Device ids equal their class id (also for the kinds that expand into instances), so `actions.for {element: \"microphone\"}` resolves them through the class traits. Entries with `instances` expand into one node per configured item (storages, ...). Calibration: the owner may add, hide or change entries through the graph_entry overlay.",
  "platforms": {
    "web": {
      "en": "Web (browser)",
      "pl": "Web (przeglądarka)"
    },
    "android": {
      "en": "Android",
      "pl": "Android"
    },
    "server": {
      "en": "Server",
      "pl": "Serwer"
    },
    "cli": {
      "en": "Command line",
      "pl": "Wiersz poleceń"
    }
  },
  "availability_values": {
    "available": {
      "en": "Usable",
      "pl": "Dostępne"
    },
    "permission": {
      "en": "Usable after the user grants permission",
      "pl": "Dostępne po zgodzie użytkownika"
    },
    "unavailable": {
      "en": "Not available on this platform",
      "pl": "Niedostępne na tej platformie"
    }
  },
  "devices": {
    "microphone": {
      "class": "microphone",
      "label": {
        "en": "Microphone",
        "pl": "Mikrofon"
      },
      "availability": {
        "web": "permission",
        "android": "permission",
        "server": "unavailable",
        "cli": "unavailable"
      },
      "note": {
        "en": "Browser getUserMedia / Android RECORD_AUDIO; a server or CLI has no capture device unless a host provides one.",
        "pl": "Przeglądarka getUserMedia / Android RECORD_AUDIO; serwer i CLI nie mają urządzenia, chyba że udostępni je host."
      }
    },
    "camera": {
      "class": "camera",
      "label": {
        "en": "Camera",
        "pl": "Aparat"
      },
      "availability": {
        "web": "permission",
        "android": "permission",
        "server": "unavailable",
        "cli": "unavailable"
      }
    },
    "screen": {
      "class": "screen",
      "label": {
        "en": "Screen",
        "pl": "Ekran"
