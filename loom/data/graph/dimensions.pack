{
  "schema": "loom.dimensions/1",
  "revision": 1,
  "calibration": true,
  "description": "Dimension registry of the graph (K3-1; R74, R76, R77, R84). A dimension is an entry of this pack, there is no enum in the code; the list is open, the entries below are examples to follow. A dimension says what kind of coordinate it carries (codec), how its nodes are ordered, how its neighbours are reached, what a point between two nodes means and which words an address may use on it. Today the registry works on a mock graph in tests: no entry is bound to the database yet.",
  "status_note": {
    "pl": "Dziś adres da się zapisać, wydrukować i rozwiązać na atrapie grafu w testach; żaden wymiar nie jest jeszcze podpięty do bazy (to robi dalszy pakiet).",
    "en": "Today an address can be written, printed and resolved on a mock graph in tests; no dimension is bound to the database yet (a later package does that)."
  },
  "default_dimension": "message",
  "closed_lists": [
    {
      "id": "codec_native_compare",
      "what": { "pl": "Kodeki, które jądro umie porównywać natywnie (integer, double, name, datetime, range, levels, predicate).", "en": "Codecs the kernel compares natively (integer, double, name, datetime, range, levels, predicate)." },
      "reason": { "pl": "Porównanie współrzędnych to funkcja w C++; nowy kodek wymaga wpisu w kodzie i testu. Rejestr w danych jest otwarty: kodek nieznany działa jak nazwa i daje podpowiedź.", "en": "Comparing coordinates is a C++ function; a new codec needs an entry in code and a test. The registry in data is open: an unknown codec behaves like a name and raises an advisory." },
      "observed_on": "2026-10-23",
      "reverse": { "pl": "Porównanie jako predykat z danych otworzy także tę warstwę.", "en": "Comparison as a predicate from data would open this layer too." }
    },
    {
      "id": "word_ops",
      "what": { "pl": "Operacje, które może oznaczać słowo adresu (offset, end, extremum, all).", "en": "Operations a word of an address may mean (offset, end, extremum, all)." },
      "reason": { "pl": "Operację wykonuje kod rozwiązujący adres; słowa i ich przypisania do operacji są danymi (każdy wymiar może mieć własne). Słowo z nieznaną operacją daje podpowiedź.", "en": "The code that resolves an address performs the operation; the words and their assignment to operations are data (each dimension may have its own). A word with an unknown operation raises an advisory." },
      "observed_on": "2026-10-23",
      "reverse": { "pl": "Nowa operacja to nowa gałąź w rozwiązywaniu adresu i wpis tutaj.", "en": "A new operation is a new branch in address resolution and an entry here." }
    },
    {
      "id": "coordinate_kinds_in_text",
      "what": { "pl": "Rodzaje współrzędnych, które zapis tekstowy umie wypisać bez prefiksu (int, double, name, word, datetime, range, levels, pred).", "en": "Coordinate kinds the text notation writes without a prefix (int, double, name, word, datetime, range, levels, pred)." },
      "reason": { "pl": "Parser rozpoznaje je po kształcie tekstu. Każdy inny rodzaj (kodek spoza listy) ma zapis z prefiksem: nazwa\"tekst\"; adres w JSON nie ma tego ograniczenia.", "en": "The parser recognises them by the shape of the text. Any other kind (a codec outside the list) is written with a prefix: name\"text\"; an address in JSON has no such limit." },
      "observed_on": "2026-10-23",
      "reverse": { "pl": "Dodać rozpoznawanie kształtu w parserze albo zostawić prefiks.", "en": "Add shape recognition to the parser or keep the prefix." }
    }
  ],
  "codecs": [
    { "id": "integer",  "label": { "pl": "Liczba całkowita", "en": "Integer" }, "why": { "pl": "Pozycja liczona w węzłach od bieżącego: 0 bieżący, -1 poprzedni, +1 następny.", "en": "Position counted in nodes from the current one: 0 current, -1 previous, +1 next." } },
    { "id": "double",   "label": { "pl": "Liczba rzeczywista", "en": "Real number" }, "why": { "pl": "Wartość ciągła: węzeł najbliższy podanej wartości; punkt między węzłami zależy od trybu wymiaru.", "en": "A continuous value: the node nearest to it; a point between nodes depends on the dimension's mode." } },
    { "id": "name",     "label": { "pl": "Nazwa", "en": "Name" }, "why": { "pl": "Napis porównywany po kolei (albo według listy podanej w wymiarze).", "en": "A string compared in order (or by the list given in the dimension)." } },
    { "id": "datetime", "label": { "pl": "Data i czas", "en": "Date and time" }, "why": { "pl": "Moment w czasie: węzeł najbliższy podanemu momentowi.", "en": "A moment in time: the node nearest to it." } },
    { "id": "range",    "label": { "pl": "Zakres", "en": "Range" }, "why": { "pl": "Od-do (np. -3..0): wszystkie węzły między dwoma końcami włącznie.", "en": "From-to (e.g. -3..0): every node between the two ends, inclusive." } },
    { "id": "levels",   "label": { "pl": "Poziomy", "en": "Levels" }, "why": { "pl": "Hierarchia (np. duża.mała.poprawka): każdy poziom wybiera węzły wewnątrz poprzedniego.", "en": "A hierarchy (e.g. major.minor.patch): each level picks nodes inside the previous one." } },
    { "id": "predicate", "label": { "pl": "Warunek", "en": "Condition" }, "why": { "pl": "Dziś tylko zapisany w adresie; wyliczanie warunku robi dalszy pakiet, adres daje podpowiedź i pusty wynik.", "en": "Today only stored in the address; evaluating a condition is done by a later package, the address gives an advisory and an empty result." } }
  ],
  "between_modes": {
    "nearest":     { "available": true,  "label": { "pl": "Najbliższy węzeł", "en": "Nearest node" }, "why": { "pl": "Punkt między węzłami wskazuje najbliższy z nich (przy remisie wcześniejszy).", "en": "A point between nodes picks the nearest one (the earlier on a tie)." } },
    "interpolate": { "available": false, "advisory": "between_unavailable", "label": { "pl": "Interpolacja", "en": "Interpolation" }, "why": { "pl": "Wyliczy węzeł pochodny między dwoma; jeszcze niedostępne, dziś adres daje podpowiedź i wynik najbliższy.", "en": "Will derive a node between two; not available yet, today the address gives an advisory and the nearest result." } },
    "derive":      { "available": false, "advisory": "between_unavailable", "label": { "pl": "Wyprowadzenie", "en": "Derivation" }, "why": { "pl": "Węzeł powstaje metodą z rejestru metod; jeszcze niedostępne, dziś podpowiedź i wynik najbliższy.", "en": "The node is produced by a method of the method registry; not available yet, today an advisory and the nearest result." } }
  },
  "default_words": {
    "last":    { "end": "last" },
    "first":   { "end": "first" },
    "max":     { "extremum": "max" },
    "min":     { "extremum": "min" },
    "prev":    { "offset": -1 },
    "next":    { "offset": 1 },
    "current": { "offset": 0 },
    "all":     { "all": true }
  },
  "dimensions": [
    {
      "id": "message", "kind": "example", "codec": "integer", "origin": "current",
      "order": { "by": ["created", "rowid"] },
      "walk": { "kind": "db_order", "query": "conversation_active" },
      "between": { "mode": "nearest" },
      "step_from_fov": { "axis": "history.window", "rule": "max(1, floor(extent/10))" },
      "label": { "pl": "Kolejne wiadomości", "en": "Consecutive messages" },
      "why": { "pl": "Pozycja w rozmowie: 0 to wiadomość, dla której budujemy kontekst, -1 poprzednia, +1 następna.", "en": "Position in the conversation: 0 is the message the context is built for, -1 the previous one, +1 the next." }
    },
    {
      "id": "version", "kind": "example", "codec": "levels", "levels": ["line", "revision"], "origin": "current",
      "order": { "by": ["version_group_id", "version_num"] },
      "walk": { "kind": "db_order", "query": "message_versions" },
      "between": { "mode": "nearest" },
      "label": { "pl": "Wersje wiadomości", "en": "Message versions" },
      "why": { "pl": "Wiadomość po edycji ma kilka wersji. Pierwszy poziom to linia wersji, drugi kolejne wersje w linii; max.last to najwyższa linia i jej ostatnia wersja.", "en": "A message has several versions after editing. The first level is the version line, the second the successive versions in the line; max.last is the highest line and its last version." }
    },
    {
      "id": "program_version", "kind": "example", "codec": "levels", "levels": ["major", "minor", "patch"], "origin": "current",
      "order": { "by": ["version_number"] },
      "walk": { "kind": "link", "link_type": "version_of" },
      "between": { "mode": "nearest" },
      "label": { "pl": "Wersja programu", "en": "Program version" },
      "why": { "pl": "Duża.mała.poprawka. Adres -1.last.last to poprzednia duża wersja, w niej ostatnia mała, w niej ostatnia poprawka (przykład z słów właściciela).", "en": "Major.minor.patch. The address -1.last.last is the previous major version, its last minor, its last patch (an example from the owner's words)." }
    },
    {
      "id": "branch", "kind": "example", "codec": "name", "origin": "current",
      "order": { "by": ["created"] },
      "walk": { "kind": "db_order", "query": "conversation_branches" },
      "between": { "mode": "nearest" },
      "label": { "pl": "Gałęzie rozmowy", "en": "Conversation branches" },
      "why": { "pl": "Gałąź to nazwa: poprzednia, następna albo wskazana w cudzysłowie.", "en": "A branch is a name: the previous, the next or one given in quotes." }
    },
    {
      "id": "time", "kind": "example", "codec": "datetime", "origin": "current",
      "order": { "by": ["created", "rowid"] },
      "walk": { "kind": "db_order", "query": "created" },
      "between": { "mode": "interpolate" },
      "label": { "pl": "Czas", "en": "Time" },
      "why": { "pl": "Moment w czasie wskazuje najbliższy węzeł. Węzeł pochodny między dwoma (interpolacja) jest jeszcze niedostępny: adres da podpowiedź i wynik najbliższy.", "en": "A moment in time picks the nearest node. A derived node between two (interpolation) is not available yet: the address gives an advisory and the nearest result." }
    },
    {
      "id": "weight", "kind": "example", "codec": "double", "origin": "current",
      "order": { "by": ["weight", "rowid"] },
      "walk": { "kind": "db_order", "query": "weight" },
      "between": { "mode": "nearest" },
      "label": { "pl": "Waga", "en": "Weight" },
      "why": { "pl": "Wartość ciągła: węzeł o wadze najbliższej podanej.", "en": "A continuous value: the node whose weight is nearest to the given one." }
    },
    {
      "id": "perspective", "kind": "example", "codec": "name", "origin": "current",
      "order": { "by": ["id"] },
      "walk": { "kind": "registry", "registry": "perspectives" },
      "between": { "mode": "nearest" },
      "label": { "pl": "Perspektywy", "en": "Perspectives" },
      "why": { "pl": "Perspektywa grafu wskazana nazwą.", "en": "A graph perspective given by name." }
    },
    {
      "id": "scope", "kind": "example", "codec": "name", "origin": "current",
      "order": { "by": ["chain_position"] },
      "walk": { "kind": "registry", "registry": "graph/scopes.pack#/chain" },
      "between": { "mode": "nearest" },
      "label": { "pl": "Zakres", "en": "Scope" },
      "why": { "pl": "Poziom łańcucha zakresów (od ogólnego do rozmowy i tury) wskazany nazwą.", "en": "A level of the scope chain (from general down to the conversation and the turn) given by name." }
    },
    {
      "id": "representation_level", "kind": "example", "codec": "name", "origin": "current",
      "order": { "by": "list", "list": ["L0", "L1", "L2"] },
      "walk": { "kind": "registry", "registry": "guardian.representation_levels" },
      "between": { "mode": "nearest" },
      "label": { "pl": "Poziom opisu", "en": "Representation level" },
      "why": { "pl": "Jak szczegółowo węzeł jest opisany; kolejność bierze z listy w danych (L0, L1, L2).", "en": "How detailed the description of a node is; the order comes from the list in the data (L0, L1, L2)." }
    },
    {
      "id": "scale", "kind": "example", "codec": "double", "origin": "current", "node_coordinate": false,
      "order": { "by": ["scale"] },
      "walk": { "kind": "view", "note": "scale is a feature of the view, not of a node (R79)" },
      "between": { "mode": "derive" },
      "label": { "pl": "Skala widoku", "en": "View scale" },
      "why": { "pl": "To cecha widoku, nie węzła: wpis istnieje, żeby pole widzenia mogło ją nieść. Węzeł pochodny jest jeszcze niedostępny.", "en": "A feature of the view, not of a node: the entry exists so that the field of view can carry it. A derived node is not available yet." }
    }
  ],
  "advisories": {
    "address_outside":  { "level": "warning", "text": { "pl": "Adres {address} wskazuje poza zakres ({detail}); zwracam pusty zbiór.", "en": "The address {address} points outside the range ({detail}); returning an empty set." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "address_degenerate": { "level": "info", "text": { "pl": "Adres {address} jest poprawny, ale mało użyteczny: {detail}.", "en": "The address {address} is valid but of little use: {detail}." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "address_empty":    { "level": "info", "text": { "pl": "Adres jest pusty; oznacza węzeł bieżący.", "en": "The address is empty; it means the current node." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "codec_unknown":    { "level": "warning", "text": { "pl": "Wymiar {dimension} ma kodek {codec}, którego jądro nie zna; traktuję go jak nazwę.", "en": "The dimension {dimension} has the codec {codec}, which the kernel does not know; treating it like a name." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "dimension_unknown": { "level": "warning", "text": { "pl": "Wymiaru {dimension} nie ma w rejestrze; adres jest zapisany, ale nic nie wskazuje.", "en": "The dimension {dimension} is not in the registry; the address is stored but points to nothing." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "word_unknown":     { "level": "warning", "text": { "pl": "Słowo {word} nie jest znane w wymiarze {dimension}; pusty wynik.", "en": "The word {word} is not known in the dimension {dimension}; empty result." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "coord_kind_mismatch": { "level": "warning", "text": { "pl": "Współrzędna rodzaju {kind} nie pasuje do wymiaru {dimension} (kodek {codec}); pusty wynik.", "en": "A coordinate of kind {kind} does not suit the dimension {dimension} (codec {codec}); empty result." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "between_unavailable": { "level": "warning", "text": { "pl": "Tryb {mode} wymiaru {dimension} jest jeszcze niedostępny; podaję najbliższy węzeł.", "en": "The mode {mode} of the dimension {dimension} is not available yet; giving the nearest node." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "predicate_not_evaluated": { "level": "warning", "text": { "pl": "Warunek [{pred}] w wymiarze {dimension} jest zapisany, ale jeszcze nieliczony; pusty wynik.", "en": "The condition [{pred}] in the dimension {dimension} is stored but not evaluated yet; empty result." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "alias_applied":    { "level": "info", "text": { "pl": "Skrót {from} przeczytany jako {to}.", "en": "The shorthand {from} was read as {to}." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "anchor_off_dimension": { "level": "warning", "text": { "pl": "Węzeł {node} nie leży w wymiarze {dimension}; pusty wynik.", "en": "The node {node} does not lie in the dimension {dimension}; empty result." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "levels_deeper_than_dimension": { "level": "info", "text": { "pl": "Adres ma {depth} poziomów, a wymiar {dimension} deklaruje {declared}; schodzę tak głęboko, jak sięga graf.", "en": "The address has {depth} levels while the dimension {dimension} declares {declared}; going as deep as the graph reaches." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "origin_unknown":   { "level": "warning", "text": { "pl": "Początek {origin} wymiaru {dimension} jest nieznany; liczę od węzła bieżącego.", "en": "The origin {origin} of the dimension {dimension} is unknown; counting from the current node." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "key_missing":      { "level": "warning", "text": { "pl": "Graf nie podaje klucza porządku dla wymiaru {dimension}; używam kolejności przejścia.", "en": "The graph gives no ordering key for the dimension {dimension}; using the walk order." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "coord_printed_as_name": { "level": "warning", "text": { "pl": "Współrzędnej rodzaju {kind} ({text}) nie da się wypisać w tym zapisie; wypisana jako nazwa.", "en": "A coordinate of kind {kind} ({text}) cannot be written in this notation; written as a name." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "alias_collision":  { "level": "warning", "text": { "pl": "Zapis {address} przeczytałby się z powrotem przez skrót; nie udało się go zapisać inaczej.", "en": "The text {address} would be read back through an alias; it could not be written another way." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } },
    "syntax_unknown":   { "level": "warning", "text": { "pl": "Zapisu {syntax} nie ma w paczce; używam zapisu domyślnego.", "en": "The notation {syntax} is not in the pack; using the default notation." }, "question": { "pl": "Czy to celowe?", "en": "Is this intended?" } }
  }
}
