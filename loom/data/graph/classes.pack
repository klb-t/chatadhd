      }
    },
    "archive_item": {
      "label": {
        "en": "Archive item",
        "pl": "Element archiwum"
      },
      "traits": [
        "has_text",
        "has_file"
      ]
    },
    "file": {
      "label": {
        "en": "File",
        "pl": "Plik"
      },
      "traits": [
        "has_file",
        "has_hash"
      ]
    },
    "storage": {
      "label": {
        "en": "Memory / storage",
        "pl": "Pamięć / magazyn"
      }
    },
    "settings_field": {
      "label": {
        "en": "Settings field",
        "pl": "Pole ustawień"
      },
      "traits": [
        "editable"
      ]
    },
    "usage_ledger": {
      "label": {
        "en": "Usage ledger",
        "pl": "Rejestr zużycia"
      }
    },
    "application": {
      "label": {
        "en": "Application (self-model)",
        "pl": "Aplikacja (samomodel)"
