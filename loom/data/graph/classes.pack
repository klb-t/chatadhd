      "traits": [
        "has_text"
      ]
    },
    "image_form": {
      "label": {
        "en": "Image",
        "pl": "Obraz"
      },
      "parent": "form",
      "traits": [
        "has_image"
      ]
    },
    "audio_form": {
      "label": {
        "en": "Audio recording",
        "pl": "Nagranie dźwiękowe"
      },
      "parent": "form",
      "traits": [
        "has_audio"
      ]
    },
    "video_form": {
      "label": {
        "en": "Video",
        "pl": "Wideo"
      },
      "parent": "form",
      "traits": [
