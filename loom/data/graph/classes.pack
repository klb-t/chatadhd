        "pl": "Ma lokalizator"
      },
      "description": "Says where its bytes are inside the source (member, index, JSON pointer)."
    },
    "has_provenance": {
      "label": {
        "en": "Has provenance",
        "pl": "Ma pochodzenie"
      },
      "description": "Records where it came from (file, hash, source id)."
    },
    "export": {
      "label": {
        "en": "Export",
        "pl": "Eksport"
      },
      "description": "An export of data from an application or a provider."
    },
    "vendor:openai": {
      "label": {
        "en": "From OpenAI",
        "pl": "Od OpenAI"
      },
