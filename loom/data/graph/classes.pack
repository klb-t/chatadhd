        "pl": "Ruch / taniec"
      },
      "parent": "form",
      "traits": [
        "has_motion"
      ]
    },
    "code_form": {
      "label": {
        "en": "Code",
        "pl": "Kod"
      },
      "parent": "text_form",
      "traits": [
        "has_code"
      ]
    },
    "table_form": {
      "label": {
        "en": "Table",
        "pl": "Tabela"
      },
      "parent": "form",
      "traits": [
        "has_table"
      ]
    },
    "conversation": {
