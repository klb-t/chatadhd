      "label": {
        "en": "Goal",
        "pl": "Cel"
      }
    },
    "decision": {
      "label": {
        "en": "Decision",
        "pl": "Decyzja"
      }
    },
    "method": {
      "label": {
        "en": "Method",
        "pl": "Metoda"
      },
      "traits": [
        "executable"
      ]
    },
    "document": {
      "label": {
