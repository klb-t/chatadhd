{
  "schema": "loom.graph_entry_areas/1",
  "revision": 1,
  "calibration": true,
  "description": "Calibration example (R53, DUCH_GRAFU 0): a starting point the owner may reorder, hide, extend or replace through the graph_entry runtime-profile overlay; it is not a closed list. Area ids are stable keys: an overlay may set hidden:true, change order/label/axes, or add new areas by id. A binding names a code provider (mechanism) and optionally cells it fills even when no area occupies the cell. M1: You (party_self) is a root row of its own; flows, devices and input/output, tools and the agent, providers and connectors, environments, automations and experiments are areas too, each counted by a provider or saying unknown with a reason; an area whose expand names graph.navigate opens in the graph navigator (the focus it names).",
  "areas": {
    "self_model": {
      "order": 1,
      "label": {
        "en": "Self-model",
        "pl": "Samomodel"
      },
      "why": {
        "en": "What the app says about itself: its principles, operators and inference rules.",
        "pl": "Co aplikacja mówi o sobie: jej zasady, operatory i reguły wnioskowania."
      },
      "axes": {
        "about": "application",
        "kind": "knowledge",
        "time": "state"
      },
      "bindings": [
        "pack.principles",
        "pack.operators",
        "pack.rules",
        "profile.authority_ranks"
      ],
      "expand": {
        "view": "kb.policy",
        "params": {
          "name": "philosophy/principles.json"
        }
      }
    },
    "technologies": {
      "order": 2,
      "label": {
        "en": "Technologies and adapters",
        "pl": "Technologie i adaptery"
      },
      "why": {
        "en": "The formats and adapters the app can read and talk to.",
        "pl": "Formaty i adaptery, które aplikacja umie czytać i z którymi rozmawia."
      },
      "axes": {
        "about": "application",
        "kind": "resource",
        "time": "state"
      },
      "bindings": [
        "profile.import_formats"
      ]
    },
    "rom": {
      "order": 0,
      "label": {
        "en": "ROM (read-only memory)",
        "pl": "ROM (pamięć tylko do odczytu)"
      },
      "why": {
        "en": "What is mounted first and read-only: the presets everything else starts from.",
        "pl": "To, co montuje się pierwsze i tylko do odczytu: presety, od których zaczyna się wszystko inne."
      },
      "axes": {
        "about": "application",
        "kind": "knowledge",
        "time": "state"
      },
      "bindings": [
        "rom.catalogue"
      ],
      "expand": {
        "view": "graph.navigate",
        "params": {
          "focus": "area:rom"
        }
      }
    },
    "interfaces": {
      "order": 3,
      "label": {
        "en": "Interfaces",
        "pl": "Interfejsy"
      },
      "why": {
        "en": "The ways in: the C interface, the HTTP server, the command line, the web screen.",
        "pl": "Drogi wejścia: interfejs C, serwer HTTP, wiersz poleceń, ekran w przeglądarce."
      },
      "axes": {
        "about": "application",
        "kind": "resource",
        "time": "plan"
      },
      "bindings": [
        "interfaces.abi"
      ]
    },
    "profiles_settings": {
      "order": 4,
      "label": {
        "en": "Profiles and settings",
        "pl": "Profile i ustawienia"
      },
      "why": {
        "en": "Every setting in human groups, and the levels a value can come from.",
        "pl": "Każde ustawienie w ludzkich grupach i poziomy, z których może pochodzić wartość."
      },
      "axes": {
        "about": "application",
        "kind": "setting",
        "time": "state"
      },
      "bindings": [
        "profile.domains",
        "data.scopes",
        "data.conflict_rules"
      ],
      "expand": {
        "view": "graph.navigate",
        "params": {
          "focus": "area:profiles_settings"
        }
      }
    },
    "parties": {
      "order": 5,
      "label": {
        "en": "Parties",
        "pl": "Podmioty"
      },
      "why": {
        "en": "People and organisations: the templates of parties and the entities the analysis found.",
        "pl": "Ludzie i organizacje: szablony podmiotów i encje, które znalazła analiza."
      },
      "axes": {
        "about": "party",
        "kind": "data",
        "time": "state"
      },
      "bindings": [
        "data.parties",
        "kb.entities"
      ],
      "expand": {
        "view": "kb.query",
        "params": {
          "what": "entities"
        }
      }
    },
    "context_projects": {
      "order": 6,
      "label": {
        "en": "Context and projects",
        "pl": "Kontekst i projekty"
      },
      "why": {
        "en": "Your conversations, their messages and the projects (units) they belong to.",
        "pl": "Twoje rozmowy, ich wiadomości i projekty (jednostki), do których należą."
      },
      "axes": {
        "about": "world",
        "kind": "data",
        "time": "plan"
      },
      "bindings": [
        "db.conversations"
      ],
      "expand": {
        "view": "conversations.list",
        "params": {}
      }
    },
    "methods": {
      "order": 7,
      "label": {
        "en": "Methods",
        "pl": "Metody"
      },
      "why": {
        "en": "The methods the app knows for doing a kind of work.",
        "pl": "Metody, które aplikacja zna do danego rodzaju pracy."
      },
      "axes": {
        "about": "application",
        "kind": "method",
        "time": "state"
      },
      "bindings": [
        "methods.registry"
      ]
    },
    "data_corpora": {
      "order": 8,
      "label": {
        "en": "Data and corpora",
        "pl": "Dane i korpusy"
      },
      "why": {
        "en": "What was imported: messages, sources, recognised formats and duplicates.",
        "pl": "To, co zaimportowano: wiadomości, źródła, rozpoznane formaty i duplikaty."
      },
      "axes": {
        "about": "world",
        "kind": "data",
        "time": "state"
      },
      "bindings": [
        "db.conversations",
        "db.messages",
        "db.sources",
        "db.recognition",
        "db.duplicates"
      ],
      "expand": {
        "view": "graph.nodes",
        "params": {
          "kind": "import:unrecognized"
        }
      }
    },
    "knowledge": {
      "order": 9,
      "label": {
        "en": "Knowledge",
        "pl": "Wiedza"
      },
      "why": {
        "en": "Claims from the analysis (the evidence layer) and the entities they are about.",
        "pl": "Twierdzenia z analizy (warstwa dowodów) i encje, których dotyczą."
      },
      "axes": {
        "about": "world",
        "kind": "knowledge",
        "time": "state"
      },
      "bindings": [
        "kb.entities",
        "kb.claims"
      ],
      "expand": {
        "view": "kb.query",
        "params": {
          "what": "claims"
        }
      }
    },
    "ontology": {
      "order": 10,
      "label": {
        "en": "Ontology",
        "pl": "Ontologia"
      },
      "why": {
        "en": "The classes of things in the graph and the packages of their properties.",
        "pl": "Klasy rzeczy w grafie i pakiety ich właściwości."
      },
      "axes": {
        "about": "application",
        "kind": "knowledge",
        "time": "plan"
      },
      "bindings": [
        "data.classes",
        "data.properties"
      ]
    },
    "provenance_history": {
      "order": 11,
      "label": {
        "en": "Provenance and history",
        "pl": "Pochodzenie i historia"
      },
      "why": {
        "en": "Where things came from and when: the records of provenance.",
        "pl": "Skąd się co wzięło i kiedy: zapisy pochodzenia."
      },
      "axes": {
        "about": "world",
        "kind": "data",
        "time": "history"
      },
      "bindings": [
        "db.provenance"
      ]
    },
    "resource_economy": {
      "order": 12,
      "label": {
        "en": "Resource economy",
        "pl": "Ekonomia zasobów"
      },
      "why": {
        "en": "What the work costs: the usage ledger and the bytes kept twice.",
        "pl": "Ile kosztuje praca: księga zużycia i bajty trzymane podwójnie."
      },
      "axes": {
        "about": "application",
        "kind": "resource",
        "time": "history"
      },
      "bindings": [
        "usage.ledger",
        "economy.redundant_bytes"
      ]
    },
    "privacy_consent": {
      "order": 13,
      "label": {
        "en": "Privacy and consent",
        "pl": "Prywatność i zgody"
      },
      "why": {
        "en": "What may be stored, inferred and sent, and to whom.",
        "pl": "Co wolno zapisać, wywnioskować i wysłać, i komu."
      },
      "axes": {
        "about": "party",
        "kind": "setting",
        "time": "state"
      },
      "bindings": [
        "layers.privacy"
      ]
    },
    "perspectives": {
      "order": 14,
      "label": {
        "en": "Perspectives and views",
        "pl": "Perspektywy i widoki"
      },
      "why": {
        "en": "Ways of looking at the graph: perspectives, kinds of edges and views.",
        "pl": "Sposoby patrzenia na graf: perspektywy, rodzaje krawędzi i widoki."
      },
      "axes": {
        "about": "application",
        "kind": "setting",
        "time": "plan"
      },
      "bindings": [
        "perspectives.store",
        "db.nodes"
      ],
      "expand": {
        "view": "graph.nodes",
        "params": {}
      }
    },
    "storage_security": {
      "order": 15,
      "label": {
        "en": "Storage and security",
        "pl": "Magazyn i bezpieczeństwo"
      },
      "why": {
        "en": "Where the data is kept and how it is protected.",
        "pl": "Gdzie są dane i jak są chronione."
      },
      "axes": {
        "about": "application",
        "kind": "data",
        "time": "state"
      },
      "bindings": [
        "security.categories",
        "security.storages",
        "security.backends",
        "security.suites",
        "security.crypto_status",
        "security.threats"
      ]
    },
    "party_self": {
      "order": 1,
      "label": {
        "en": "You",
        "pl": "Ty"
      },
      "why": {
        "en": "You: the answers of the interview, your preferences, privacy rules, what the app remembers and your interests.",
        "pl": "Ty: odpowiedzi z wywiadu, Twoje preferencje, zasady prywatności, to, co aplikacja pamięta, i Twoje zainteresowania."
      },
      "axes": {
        "about": "party",
        "kind": "knowledge",
        "time": "state"
      },
      "bindings": [
        "party.slots"
      ],
      "expand": {
        "view": "graph.navigate",
        "params": {
          "focus": "party:self"
        }
      }
    },
    "flows": {
      "order": 16,
      "label": {
        "en": "Flows",
        "pl": "Przepływy"
      },
      "why": {
        "en": "Everything the app can do, as flows of steps.",
        "pl": "Wszystko, co aplikacja umie zrobić, jako przepływy kroków."
      },
      "axes": {
        "about": "application",
        "kind": "method",
        "time": "plan"
      },
      "bindings": [
        "actions.flows"
      ],
      "expand": {
        "view": "graph.navigate",
        "params": {
          "focus": "area:flows"
        }
      }
    },
    "devices_io": {
      "order": 17,
      "label": {
        "en": "Devices and input/output",
        "pl": "Urządzenia i wejście/wyjście"
      },
      "why": {
        "en": "The devices the app can use and the gestures and keys of the navigator.",
        "pl": "Urządzenia, których aplikacja może używać, oraz gesty i klawisze nawigatora."
      },
      "axes": {
        "about": "world",
        "kind": "resource",
        "time": "state"
      },
      "bindings": [
        "data.devices",
        "data.input_bindings"
      ],
      "expand": {
        "view": "graph.navigate",
        "params": {
          "focus": "area:devices_io"
        }
      }
    },
    "tools_agent": {
      "order": 18,
      "label": {
        "en": "Tools and the agent",
        "pl": "Narzędzia i agent"
      },
      "why": {
        "en": "The agent and the tools it may call: tool sources, their kinds, the agent's flows and settings.",
        "pl": "Agent i narzędzia, które może wołać: źródła narzędzi, ich rodzaje, przepływy i ustawienia agenta."
      },
      "axes": {
        "about": "world",
        "kind": "method",
        "time": "state"
      },
      "bindings": [
        "tools.sources"
      ],
      "expand": {
        "view": "graph.navigate",
        "params": {
          "focus": "area:tools_agent"
        }
      }
    },
    "providers_connectors": {
      "order": 19,
      "label": {
        "en": "Providers and connectors",
        "pl": "Dostawcy i konektory"
      },
      "why": {
        "en": "Who does which job: the model roles, the models they resolve to, and the connectors.",
        "pl": "Kto wykonuje którą pracę: role modeli, modele, które wskazują, i konektory."
      },
      "axes": {
        "about": "world",
        "kind": "resource",
        "time": "plan"
      },
      "bindings": [
        "ports.roles",
        "data.connectors"
      ],
      "expand": {
        "view": "graph.navigate",
        "params": {
          "focus": "area:providers_connectors"
        }
      }
    },
    "environments": {
      "order": 20,
      "label": {
        "en": "Environments",
        "pl": "Środowiska"
      },
      "why": {
        "en": "Where the app runs and what it can reach there.",
        "pl": "Gdzie działa aplikacja i do czego tam sięga."
      },
      "axes": {
        "about": "world",
        "kind": "resource",
        "time": "history"
      },
      "bindings": [
        "data.environments"
      ],
      "expand": {
        "view": "graph.navigate",
        "params": {
          "focus": "area:environments"
        }
      }
    },
    "automations": {
      "order": 21,
      "label": {
        "en": "Automations and tasks",
        "pl": "Automatyzacje i zadania"
      },
      "why": {
        "en": "What runs without being asked, and the background tasks.",
        "pl": "Co działa samo, bez proszenia, i zadania w tle."
      },
      "axes": {
        "about": "application",
        "kind": "method",
        "time": "history"
      },
      "bindings": [
        "worker.status"
      ],
      "expand": {
        "view": "graph.navigate",
        "params": {
          "focus": "area:automations"
        }
      }
    },
    "experiments": {
      "order": 22,
      "label": {
        "en": "Experiments and calibration",
        "pl": "Eksperymenty i kalibracja"
      },
      "why": {
        "en": "Research in progress: everything still in calibration.",
        "pl": "Badania w toku: wszystko, co jest jeszcze w kalibracji."
      },
      "axes": {
        "about": "application",
        "kind": "knowledge",
        "time": "history"
      },
      "bindings": [
        "calibration.items"
      ],
      "expand": {
        "view": "graph.navigate",
        "params": {
          "focus": "area:experiments"
        }
      }
    },
    "imports": {
      "order": 23,
      "label": {
        "en": "Imports",
        "pl": "Importy"
      },
      "why": {
        "en": "Every imported file as a node: the export, its entries, conversations and attachments, with what was read from where.",
        "pl": "Każdy zaimportowany plik jako węzeł: eksport, jego wpisy, rozmowy i załączniki, z tym, co skąd przeczytano."
      },
      "axes": {
        "about": "world",
        "kind": "data",
        "time": "history"
      },
      "bindings": [
        "db.imports"
      ],
      "expand": {
        "view": "graph.navigate",
        "params": {
          "focus": "area:imports"
        }
      }
    }
  },
  "bindings": {
    "pack.principles": {
      "provider": "pack.file",
      "as": "principles",
      "params": {
        "path": "philosophy/principles.json"
      }
    },
    "pack.operators": {
      "provider": "pack.file",
      "as": "operators",
      "params": {
        "path": "philosophy/operators.json"
      }
    },
    "pack.rules": {
      "provider": "pack.file",
      "as": "rules",
      "params": {
        "path": "rules/inference_rules.json"
      }
    },
    "profile.domains": {
      "provider": "profile.domains",
      "as": "profile_domains"
    },
    "profile.import_formats": {
      "provider": "profile.items",
      "as": "import_formats",
      "params": {
        "domain": "import_formats",
        "pointer": "/mime_by_format"
      }
    },
    "profile.authority_ranks": {
      "provider": "profile.items",
      "as": "authority_ranks",
      "params": {
        "domain": "model",
        "pointer": "/authority_ranks"
      }
    },
    "rom.catalogue": {
      "provider": "rom.catalogue",
      "as": "rom_items",
      "params": {
        "pointer": "/rom/items"
      }
    },
    "interfaces.abi": {
      "provider": "interfaces.enumerate",
      "as": "interfaces",
      "params": {
        "pointer": "/interfaces"
      }
    },
    "data.scopes": {
      "provider": "data.items",
      "as": "scopes",
      "params": {
        "pointer": "/scopes/chain"
      }
    },
    "data.conflict_rules": {
      "provider": "data.items",
      "as": "conflict_rules",
      "params": {
        "pointer": "/scopes/conflict_rules"
      }
    },
    "data.parties": {
      "provider": "data.items",
      "as": "party_templates",
      "params": {
        "pointer": "/parties/templates"
      }
    },
    "data.classes": {
      "provider": "data.items",
      "as": "classes",
      "params": {
        "pointer": "/ontology/classes"
      }
    },
    "data.properties": {
      "provider": "data.items",
      "as": "property_packages",
      "params": {
        "pointer": "/ontology/packages"
      }
    },
    "data.areas": {
      "provider": "data.items",
      "as": "entry_areas",
      "params": {
        "pointer": "/areas"
      }
    },
    "db.conversations": {
      "provider": "db.conversations"
    },
    "db.messages": {
      "provider": "db.messages_by_status"
    },
    "db.sources": {
      "provider": "db.sources"
    },
    "db.recognition": {
      "provider": "db.recognition"
    },
    "db.duplicates": {
      "provider": "db.duplicates"
    },
    "db.nodes": {
      "provider": "db.nodes_by_kind"
    },
    "db.provenance": {
      "provider": "db.provenance"
    },
    "kb.entities": {
      "provider": "kb.entities"
    },
    "kb.claims": {
      "provider": "kb.claims"
    },
    "kb.runs": {
      "provider": "kb.runs",
      "cells": [
        {
          "about": "world",
          "kind": "knowledge",
          "time": "history"
        }
      ]
    },
    "usage.ledger": {
      "provider": "usage.ledger"
    },
    "economy.redundant_bytes": {
      "provider": "economy.report"
    },
    "methods.registry": {
      "provider": "methods.registry",
      "params": {
        "entity_kind": "method:method"
      }
    },
    "perspectives.store": {
      "provider": "perspectives.store",
      "params": {
        "area": "graph/perspectives"
      }
    },
    "layers.privacy": {
      "provider": "layers.entries"
    },
    "security.categories": {
      "provider": "profile.items",
      "as": "storage_categories",
      "params": {
        "domain": "storage_security",
        "pointer": "/categories"
      }
    },
    "security.storages": {
      "provider": "profile.items",
      "as": "storages",
      "params": {
        "domain": "storage_security",
        "pointer": "/storages"
      }
    },
    "security.suites": {
      "provider": "profile.items",
      "as": "crypto_suites",
      "params": {
        "domain": "storage_security",
        "pointer": "/crypto/suite_presets"
      }
    },
    "security.crypto_status": {
      "provider": "crypto.status",
      "as": "crypto_primitives"
    },
    "security.threats": {
      "provider": "profile.items",
      "as": "threats",
      "params": {
        "domain": "storage_security",
        "pointer": "/threat_model"
      }
    },
    "security.backends": {
      "provider": "storage.probe",
      "as": "storage_backends_reachable"
    },
    "data.devices": {
      "provider": "devices.enumerate",
      "as": "devices",
      "params": {
        "pointer": "/devices",
        "platforms_pointer": "/device_platforms"
      }
    },
    "party.slots": {
      "provider": "party.slots",
      "as": "profile_slots"
    },
    "actions.flows": {
      "provider": "actions.composite",
      "as": "flows"
    },
    "data.input_bindings": {
      "provider": "profile.items",
      "as": "input_bindings",
      "params": {
        "domain": "graph_views",
        "pointer": "/interaction_bindings"
      }
    },
    "tools.sources": {
      "provider": "tools.sources",
      "as": "tool_sources"
    },
    "ports.roles": {
      "provider": "ports.roles",
      "as": "roles"
    },
    "data.connectors": {
      "provider": "data.items",
      "as": "connectors",
      "params": {
        "pointer": "/environments/services"
      }
    },
    "data.environments": {
      "provider": "data.items",
      "as": "environments",
      "params": {
        "pointer": "/environments/runtimes"
      }
    },
    "worker.status": {
      "provider": "worker.status",
      "as": "messages_waiting"
    },
    "calibration.items": {
      "provider": "calibration.items",
      "as": "calibration_items"
    },
    "db.imports": {
      "provider": "db.imports"
    }
  },
  "seed": {
    "description": "Zero seed (R52): computed from packs with no DB access; each element can be hidden by setting.",
    "elements": {
      "self_model": {
        "order": 1,
        "kind": "self_model",
        "label": {
          "en": "Self-model",
          "pl": "Samomodel"
        },
        "bindings": [
          "pack.principles",
