{
  "schema": "loom.resource_adapter/1",
  "id": "json-lines-local",
  "version": "1",
  "operator": "resource_graph.line_adapter.JsonLinesAdapter",
  "media_types": ["application/x-ndjson", "application/jsonl"],
  "extensions": [".jsonl", ".ndjson"],
  "capabilities": {
    "reference": true,
    "on_demand": true,
    "bounded_pages": true,
    "renderer_required": false,
    "native_store_required": false,
    "write_back": false,
    "domain_recognition": false
  },
  "policy": {
    "max_line_bytes": 1048576,
    "max_scan_bytes": 8388608,
    "max_page_items": 256,
    "offset_cache": false,
    "index_stride": 128,
    "max_index_entries": 4096,
    "read_buffer_bytes": 8192,
    "freshness": "snapshot"
  },
  "recognition": {
    "syntax": "JSON text per physical line, UTF-8, RFC 6901 fragments",
    "semantics": "unrecognized",
    "duplicate_object_keys": "corrupt",
    "blank_lines": "corrupt",
    "whole_source_validation": "not_required"
  }
}
