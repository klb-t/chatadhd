  },
  "categories": {
    "contract": "Names/keys/schema versions and pack filenames of the code-data contract; changing them requires the matching implementation change.",
    "external_standard": "Constants and parsing grammars fixed by an external standard, not domain recognition policy.",
    "mechanism": "Lifecycle states, machine error/event codes and universal engine operation vocabulary.",
    "serialization": "Date/number/serialization formats whose exact bytes are an existing compatibility contract.",
    "bootstrap": "Minimal locators needed to discover the data before a pack can be loaded.",
    "developer_diagnostic": "Developer diagnostics or assertions, never user-facing presentation, domain defaults or policy."
  },
  "scopes": [
    "loom/src",
    "loom/server",
    "loom/cli",
    "loom/web/src",
    "android",
    "rootandroid",
    "loom/android",
    "loom/include"
  ],
  "exclusions": [
    {
      "path_segment": "tests",
      "reason": "Explicit R42 exclusion: tests are not product code; discovered files remain listed with no content scan."
    },
    {
      "path_segment": "fixtures",
      "reason": "Explicit R42 exclusion: fixtures are not product code; discovered files remain listed with no content scan."
    }
  ],
  "scanners": [
    {
      "suffixes": [
        ".cpp",
        ".cc",
        ".c",
        ".h",
        ".hpp",
        ".inc"
      ],
      "backend": "cxx",
      "keyword_literals": {
        "true": "boolean",
        "false": "boolean",
        "nullptr": "null"
