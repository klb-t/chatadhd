{
  "schema": "loom.kb.relation_patterns/1",
  "description": "Typed phrase templates for fact extraction (extractor kind 'pattern'). A template is a token sequence: literals (lowercase, '*' = prefix), slots {name:type} where type is an entity kind, a gazetteer class (platform+ = one or more joined by and/i/,/+) or 'text' (rest of the clause), and '|' alternatives inside (...). Matching runs on match keys, so inflections are covered. Each hit produces the fact (subj rel obj) with the template's confidence; 'lang' only documents the source language.",
  "patterns": [
    {"id": "rp.runs_on.en", "lang": "en", "rel": "targets_platform", "template": "{subj:project} (runs|works|runs natively) on {obj:platform+}", "confidence": 0.8},
    {"id": "rp.runs_on.pl", "lang": "pl", "rel": "targets_platform", "template": "{subj:project} (działa|chodzi|ma działać) na {obj:platform+}", "confidence": 0.8},
    {"id": "rp.for_platform.pl", "lang": "pl", "rel": "targets_platform", "template": "{subj:project} (na|dla) {obj:platform+}", "confidence": 0.5},
    {"id": "rp.written_in.en", "lang": "en", "rel": "written_in", "template": "{subj:project|component} (is written|written|implemented|rewritten) in {obj:language}", "confidence": 0.8},
    {"id": "rp.written_in.pl", "lang": "pl", "rel": "written_in", "template": "{subj:project|component} (napisany|napisana|napisane|pisany|przepisany) w {obj:language}", "confidence": 0.8},
    {"id": "rp.core_lang.pl", "lang": "pl", "rel": "written_in", "template": "rdzeń (w|na) {obj:language}", "confidence": 0.6, "subject": "$context_project"},
    {"id": "rp.ui.en", "lang": "en", "rel": "uses_ui_framework", "template": "{subj:project} (uses|built with|with a) {obj:ui_framework}", "confidence": 0.7},
    {"id": "rp.ui.pl", "lang": "pl", "rel": "uses_ui_framework", "template": "{subj:project} (używa|na|w) {obj:ui_framework}", "confidence": 0.6},
    {"id": "rp.stores.en", "lang": "en", "rel": "stores_in", "template": "{subj:project|component} (stores|keeps|persists) * (in|to) {obj:storage}", "confidence": 0.75},
    {"id": "rp.stores.pl", "lang": "pl", "rel": "stores_in", "template": "{subj:project|component} (trzyma|zapisuje|przechowuje) * w {obj:storage}", "confidence": 0.75},
    {"id": "rp.sync.en", "lang": "en", "rel": "syncs_via", "template": "{subj:project} (syncs|synchronises|synchronizes) (with|via|to) {obj:sync}", "confidence": 0.7},
    {"id": "rp.part_of.en", "lang": "en", "rel": "part_of", "template": "{subj:component} (is part of|belongs to|lives in) {obj:project|component}", "confidence": 0.75},
    {"id": "rp.part_of.pl", "lang": "pl", "rel": "part_of", "template": "(moduł|komponent|warstwa) {subj:component} (w|we) {obj:project|component}", "confidence": 0.7},
    {"id": "rp.has_stage.chain", "lang": "any", "rel": "next_stage", "template": "{subj:stage} (→|->|=>|then|potem|następnie) {obj:stage}", "confidence": 0.7},
    {"id": "rp.uses_tool.en", "lang": "en", "rel": "uses_tool", "template": "{subj:project|component} (uses|calls|runs|via) {obj:tool}", "confidence": 0.6},
    {"id": "rp.uses_tool.pl", "lang": "pl", "rel": "uses_tool", "template": "{subj:project|component} (używa|wywołuje|przez) {obj:tool}", "confidence": 0.6},
    {"id": "rp.instead.pl", "lang": "pl", "rel": "chosen_over", "template": "{subj:any} zamiast {obj:any}", "confidence": 0.65},
    {"id": "rp.instead.en", "lang": "en", "rel": "chosen_over", "template": "{subj:any} instead of {obj:any}", "confidence": 0.65},
    {"id": "rp.rather.en", "lang": "en", "rel": "chosen_over", "template": "{subj:any} rather than {obj:any}", "confidence": 0.6},
    {"id": "rp.vs", "lang": "any", "rel": "alternative_of", "template": "{subj:any} (vs|vs.|versus|czy|or|albo) {obj:any}", "confidence": 0.4},
    {"id": "rp.merged_into.en", "lang": "en", "rel": "merged_into", "template": "{subj:project} (becomes part of|is merged into|merged into|folds into) {obj:project}", "confidence": 0.8},
    {"id": "rp.merged_into.pl", "lang": "pl", "rel": "merged_into", "template": "{subj:project} (staje się częścią|wchodzi do|wpada do) {obj:project}", "confidence": 0.8},
    {"id": "rp.becomes.pl", "lang": "pl", "rel": "evolved_into", "template": "{subj:project} (staje się|to|jest teraz) {obj:project|component}", "confidence": 0.5},
    {"id": "rp.based_on.en", "lang": "en", "rel": "based_on", "template": "{subj:version} (is based on|based on|forked from|on top of) {obj:version}", "confidence": 0.85},
    {"id": "rp.based_on.pl", "lang": "pl", "rel": "based_on", "template": "{subj:version} (na bazie|bazuje na|oparta na|oparty na) {obj:version}", "confidence": 0.85},
    {"id": "rp.introduced_in.en", "lang": "en", "rel": "introduced_in", "template": "{subj:component} (added|introduced|new) in {obj:version}", "confidence": 0.8},
    {"id": "rp.introduced_in.pl", "lang": "pl", "rel": "introduced_in", "template": "(w|we) {obj:version} (dodałem|dodaliśmy|doszedł|doszła|doszło|nowy|nowa|nowe) {subj:component}", "confidence": 0.8},
    {"id": "rp.introduced_in.pl2", "lang": "pl", "rel": "introduced_in", "template": "{subj:component} (od|w) (wersji|wersja) {obj:version}", "confidence": 0.7},
    {"id": "rp.purpose.en", "lang": "en", "rel": "has_purpose", "template": "{subj:project} is (a|an) {obj:text}", "confidence": 0.5},
    {"id": "rp.purpose.pl", "lang": "pl", "rel": "has_purpose", "template": "{subj:project} (to|jest|służy do) {obj:text}", "confidence": 0.5}
  ]
}
