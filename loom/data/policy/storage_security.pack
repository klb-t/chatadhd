{
  "schema": "loom.storage_security/1",
  "revision": 1,
  "calibration": true,
  "description": "Storage, encryption and security (R51), generated from the T5a inventory. Everything here is a preset or an example, not a rule (owner rule: nothing is decided for the user). Default placement equals today's reality, so loading this pack changes no behaviour; crypto.selected_preset is pq_hybrid for NEW writes when the backend has every required primitive, otherwise the effective suite is legacy with a visible reason (owner decision: docs/reports/THREADS_2026-10-11.md section 6); existing ciphertexts are never touched; set crypto.selected_preset to legacy to turn it off. Keys are objects keyed by stable id so that profiles/storage_security.pack overlays can merge, hide (hidden:true) or add entries. Locators use {dir} for the data directory. Documents: docs/architecture/STORAGE_SECURITY_{INVENTORY,DESIGN}_2026-10-12.md.",
  "categories": {
    "conversations": {
      "label": {
        "en": "Conversations and graph",
        "pl": "Rozmowy i graf"
      },
      "sensitivity": "content",
      "locators": [
        "{dir}/chatadhd.db",
        "{dir}/chatadhd.db-wal",
        "{dir}/chatadhd.db-shm"
      ]
    },
    "search_index": {
      "label": {
        "en": "Full-text index (copy of message text)",
        "pl": "Indeks pe\u0142notekstowy (kopia tekstu wiadomo\u015bci)"
      },
      "sensitivity": "content",
      "locators": [
        "{dir}/chatadhd.fts.db"
      ]
    },
    "blobs": {
      "label": {
        "en": "Raw sources and artifacts (BlobStore)",
        "pl": "Surowe \u017ar\u00f3d\u0142a i artefakty (BlobStore)"
      },
      "sensitivity": "content",
      "locators": [
        "{dir}/blobs/"
      ]
    },
    "usage_ledger": {
      "label": {
        "en": "Usage ledger",
        "pl": "Rejestr zu\u017cycia"
      },
      "sensitivity": "metadata",
      "locators": [
        "{dir}/usage-policy.sqlite"
      ]
    },
    "embedding_cache": {
      "label": {
        "en": "Embedding cache (derived from content)",
        "pl": "Cache embedding\u00f3w (pochodny od tre\u015bci)"
      },
      "sensitivity": "derived",
      "locators": [
        "{dir}/context_embedding_cache/"
      ]
    },
    "secrets": {
      "label": {
        "en": "API keys and tokens",
        "pl": "Klucze API i tokeny"
      },
      "sensitivity": "secret",
      "locators": [
        "{dir}/secrets.json"
      ]
    },
    "config": {
      "label": {
        "en": "Configuration",
        "pl": "Konfiguracja"
      },
      "sensitivity": "settings",
      "locators": [
        "{dir}/config.json"
      ]
    },
    "memory_tree": {
      "label": {
        "en": "Memory tree (goes into prompts)",
        "pl": "Drzewo pami\u0119ci (trafia do prompt\u00f3w)"
      },
      "sensitivity": "content",
      "locators": [
        "{dir}/memory.json"
      ]
    },
    "models_cache": {
      "label": {
        "en": "Model list cache",
        "pl": "Cache listy modeli"
      },
      "sensitivity": "public",
      "locators": [
        "{dir}/models.json"
      ]
    },
    "sync_state": {
      "label": {
        "en": "GitHub sync state",
        "pl": "Stan synchronizacji GitHub"
      },
      "sensitivity": "settings",
      "locators": [
        "{dir}/github_sync.json"
      ]
    },
    "crypto_vault": {
      "label": {
        "en": "Encryption vault verifier",
        "pl": "Weryfikator sejfu szyfrowania"
      },
      "sensitivity": "secret",
      "locators": [
        "{dir}/crypto.json"
      ]
    },
    "exports": {
      "label": {
        "en": "Exports",
        "pl": "Eksporty"
      },
      "sensitivity": "content",
      "locators": [
        "{dir}/exports/"
      ]
    },
    "attachments": {
      "label": {
        "en": "Attachments",
        "pl": "Za\u0142\u0105czniki"
      },
      "sensitivity": "content",
      "locators": [
        "{dir}/attachments/"
      ],
      "note": "Python keeps paths to originals; directory is created, copying not verified"
    },
    "logs": {
      "label": {
        "en": "Logs",
        "pl": "Logi"
      },
      "sensitivity": "diagnostic",
      "locators": [
        "stdout/stderr",
        "LOGBUF (RAM, 500 entries)",
        "{dir}/logs/ (unused)"
      ],
      "note": "may contain message fragments and provider error bodies"
    },
    "research_evidence": {
      "label": {
        "en": "Research evidence in the repository",
        "pl": "Dowody bada\u0144 w repozytorium"
      },
      "sensitivity": "repo",
      "locators": [
        "loom/src/catalog/tests/profile_policy/results/2026-10-05/evidence.zip",
        "loom/tools/structure/retrieval_exploration_v1/actor_projection_v1/first_evidence.zip",
        "loom/tools/structure/retrieval_exploration_v1/native_source_free_v1/first_evidence.zip"
      ]
    },
    "browser_state": {
      "label": {
        "en": "Browser-side UI state (loom/web)",
        "pl": "Stan interfejsu w przegl\u0105darce (loom/web)"
      },
      "sensitivity": "ui",
      "locators": [
        "localStorage:loom.application.views.v1",
        "localStorage:loom.application.workflow.v1:*",
        "localStorage:saved perspectives / knowledge workspace",
        "sessionStorage:server token"
      ]
    },
    "credential_handoff": {
      "label": {
        "en": "Credential handoff sessions",
        "pl": "Sesje przekazania po\u015bwiadcze\u0144"
      },
      "sensitivity": "secret",
      "locators": [
        "<session_dir>/private.pem",
        "<session_dir>/session.json",
        "<session_dir>/openrouter-new.key"
      ]
    },
    "user_defined_example": {
      "label": {
        "en": "Example of a user-defined category (health)",
        "pl": "Przyk\u0142ad kategorii u\u017cytkownika (zdrowie)"
      },
      "sensitivity": "user",
      "locators": [],
      "note": "calibration example: user adds categories as data; inference of category with low confidence takes the most restrictive rule"
    }
  },
  "storages": {
    "local_dir": {
      "class": "local",
      "label": {
        "en": "Local data directory",
        "pl": "Lokalny katalog danych"
      },
      "path": "{dir}",
      "access": "OS user owner; others per file mode (db 644, secrets 600, blobs 444)",
      "encryption": {
        "algorithm": "none",
        "key_custody": "none",
        "rotation": "none"
      },
      "sync": {
        "rule": "none",
        "conflict": "n/a"
      },
      "capabilities": [
        "read",
        "write",
        "list",
        "watch"
      ],
      "available_on": [
        "linux",
        "macos",
        "windows",
        "android"
      ],
      "jurisdiction": {
        "known": false
      }
    },
    "android_shared": {
      "class": "device",
      "label": {
        "en": "Android shared storage (Documents/ChatADHD)",
        "pl": "Wsp\u00f3\u0142dzielony storage Androida (Documents/ChatADHD)"
      },
      "path": "/storage/emulated/0/Documents/ChatADHD/",
      "access": "apps with All files access, file managers, sync clients; chmod effect not verified",
      "encryption": {
        "algorithm": "none",
        "key_custody": "none",
        "rotation": "none",
        "note": "LOOM_WITH_OPENSSL=OFF on Android"
      },
      "sync": {
        "rule": "external client",
        "conflict": "n/a"
      },
      "capabilities": [
        "read",
        "write",
        "list"
      ],
      "available_on": [
        "android"
      ],
      "jurisdiction": {
        "known": false
      }
    },
    "app_server": {
      "class": "app_server",
      "label": {
        "en": "Server running the web app",
        "pl": "Serwer, na kt\u00f3rym dzia\u0142a aplikacja webowa"
      },
      "path": "loom-server --data-dir",
      "access": "server operator; HTTP clients per bearer token (off by default, bind 127.0.0.1)",
      "encryption": {
        "algorithm": "none",
        "key_custody": "none",
        "rotation": "none"
      },
      "sync": {
        "rule": "none",
        "conflict": "n/a"
      },
      "capabilities": [
        "read",
        "write",
        "list"
      ],
      "available_on": [
        "server"
      ],
      "jurisdiction": {
        "known": false
      },
      "configured": false
    },
    "github_repo": {
      "class": "repo",
      "label": {
        "en": "GitHub repository (user cloud)",
        "pl": "Repozytorium GitHub (chmura u\u017cytkownika)"
      },
      "path": "repos/<repo>/contents@<branch>",
      "access": "anyone with repo access; GitHub",
      "encryption": {
        "algorithm": "none",
        "key_custody": "secrets.json:github_token",
        "rotation": "none"
      },
      "sync": {
        "rule": "bidirectional (engine default), auto_sync off",
        "conflict": "in code (github_sync)"
      },
      "capabilities": [
        "read",
        "write",
        "list"
      ],
      "available_on": [
        "linux",
        "macos",
        "windows",
        "android",
        "server"
      ],
      "jurisdiction": {
        "known": false
      },
      "configured": false
    },
    "user_cloud_other": {
      "class": "user_cloud",
      "label": {
        "en": "Other user cloud (template)",
        "pl": "Inna chmura u\u017cytkownika (szablon)"
      },
      "path": "",
      "access": "provider-defined",
      "encryption": {
        "algorithm": "none",
        "key_custody": "none",
        "rotation": "none"
      },
      "sync": {
        "rule": "none",
        "conflict": "ask"
      },
      "capabilities": [],
      "available_on": [],
      "jurisdiction": {
        "known": false
      },
      "configured": false,
      "note": "any other provider: register a backend kind (BackendRegistry) and describe it here as data; s3 and webdav kinds cover most services"
    },
    "browser": {
      "class": "device",
      "label": {
        "en": "Browser storage",
        "pl": "Pami\u0119\u0107 przegl\u0105darki"
      },
      "path": "localStorage / sessionStorage",
      "access": "scripts of the same origin; browser profile",
      "encryption": {
        "algorithm": "none",
        "key_custody": "none",
        "rotation": "none"
      },
      "sync": {
        "rule": "none",
        "conflict": "n/a"
      },
      "capabilities": [
        "read",
        "write"
      ],
      "available_on": [
        "web"
      ],
      "jurisdiction": {
        "known": false
      }
    },
    "process_memory": {
      "class": "volatile",
      "label": {
        "en": "Process memory",
        "pl": "Pami\u0119\u0107 procesu"
      },
      "path": "RAM",
      "access": "the process; OS-level attacker",
      "encryption": {
        "algorithm": "none",
        "key_custody": "none",
        "rotation": "n/a"
      },
      "sync": {
        "rule": "none",
        "conflict": "n/a"
      },
      "capabilities": [
        "read",
        "write"
      ],
      "available_on": [
        "all"
      ],
      "jurisdiction": {
        "known": false
      }
    },
    "provider_llm": {
      "class": "provider_side",
      "label": {
        "en": "LLM / ASR / OCR / embedding provider",
        "pl": "Dostawca LLM / ASR / OCR / embedding\u00f3w"
      },
      "path": "per provider manifest",
      "access": "provider; transport TLS",
      "encryption": {
        "algorithm": "TLS in transit; plaintext at provider",
        "key_custody": "secrets.json:api_key",
        "rotation": "manual"
      },
      "sync": {
        "rule": "egress only",
        "conflict": "n/a"
      },
      "capabilities": [
        "write"
      ],
      "available_on": [
        "all"
      ],
      "jurisdiction": {
        "known": false
      }
    },
    "s3_example": {
      "class": "user_cloud",
      "label": {
        "en": "S3-compatible bucket (AWS, MinIO, R2, B2) - template",
        "pl": "Bucket zgodny z S3 (AWS, MinIO, R2, B2) - szablon"
      },
      "path": "",
      "access": "bucket credentials from secrets storage_s3_example_access_key / _secret_key",
      "encryption": {
        "algorithm": "none",
        "key_custody": "none",
        "rotation": "none"
      },
      "sync": {
        "rule": "none",
        "conflict": "ask"
      },
      "capabilities": [
        "read",
        "write",
        "list"
      ],
      "available_on": [
        "linux",
        "macos",
        "windows",
        "android"
      ],
      "jurisdiction": {
        "known": false
      },
      "backend": {
        "kind": "s3",
        "endpoint": "https://s3.example.com",
        "bucket": "chatadhd",
        "region": "us-east-1",
        "prefix": "",
        "secret_ref": "storage_s3_example"
      },
      "configured": false,
      "note": "template: copy into profiles/storage_security.pack with real endpoint values and set the credentials as secrets <secret_ref>_*; never put credentials here"
    },
    "webdav_example": {
      "class": "user_cloud",
      "label": {
        "en": "WebDAV (Nextcloud and others) - template",
        "pl": "WebDAV (Nextcloud i inne) - szablon"
      },
      "path": "",
      "access": "credentials from secrets storage_webdav_example_user / _password, or _token",
      "encryption": {
        "algorithm": "none",
        "key_custody": "none",
        "rotation": "none"
      },
      "sync": {
        "rule": "none",
        "conflict": "ask"
      },
      "capabilities": [
        "read",
        "write",
        "list"
      ],
      "available_on": [
        "linux",
        "macos",
        "windows",
        "android"
      ],
      "jurisdiction": {
        "known": false
      },
      "backend": {
        "kind": "webdav",
        "url": "https://cloud.example.com/remote.php/dav/files/user",
        "prefix": "chatadhd",
        "secret_ref": "storage_webdav_example"
      },
      "configured": false,
      "note": "template: copy into profiles/storage_security.pack with real endpoint values and set the credentials as secrets <secret_ref>_*; never put credentials here"
    },
    "gdrive_example": {
      "class": "user_cloud",
      "label": {
        "en": "Google Drive - template (adapter planned)",
        "pl": "Google Drive - szablon (adapter planowany)"
      },
      "path": "",
      "access": "OAuth tokens as secrets (adapter not implemented yet)",
      "encryption": {
        "algorithm": "none",
        "key_custody": "none",
        "rotation": "none"
      },
      "sync": {
        "rule": "none",
        "conflict": "ask"
      },
      "capabilities": [],
      "available_on": [
        "linux",
        "macos",
        "windows",
        "android"
      ],
      "jurisdiction": {
        "known": false
      },
      "backend": {
        "kind": "gdrive",
        "secret_ref": "storage_gdrive_example"
      },
      "configured": false,
      "note": "template: copy into profiles/storage_security.pack with real endpoint values and set the credentials as secrets <secret_ref>_*; never put credentials here"
    }
  },
