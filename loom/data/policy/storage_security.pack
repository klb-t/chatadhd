    "conflict_presets": {
      "ask": {
        "en": "Ask the user, store the decision as an override",
        "pl": "Zapytaj u\u017cytkownika, zapisz decyzj\u0119 jako nadpisanie"
      },
      "keep_both": {
        "en": "Keep both versions",
        "pl": "Zachowaj obie wersje"
      },
      "last_writer_wins": {
        "en": "Last writer wins",
        "pl": "Wygrywa ostatni zapis"
      },
      "vector_clock": {
        "en": "Vector clock, ask on concurrent edits",
        "pl": "Zegar wektorowy, pytaj przy r\u00f3wnoleg\u0142ych edycjach"
      },
      "merge_by_kind": {
        "en": "Merge by data kind",
        "pl": "Scalaj wed\u0142ug rodzaju danych"
      }
    },
    "write_quorum": {
      "preset": 1,
      "note": "a write succeeds when at least this many storages accepted it; an unreachable storage degrades, never blocks (EC-E07)"
    },
    "move": {
      "order": [
        "copy",
        "verify_hash",
        "delete_source"
      ],
      "invariant": "at least one complete copy at every moment (EC-E04)"
    }
  },
  "settings_conflict_rules": {
    "/placement/*": "most_specific_wins",
    "/allowed_storages/*": "intersection",
    "/egress/*": "intersection",
    "/crypto/selected_preset": "most_specific_wins",
    "/crypto/params/*": "max",
    "/sync/*/direction": "most_specific_wins",
    "/sync/*/conflict": "ask",
    "/key_custody/*": "ask",
    "/rotation/*": "min",
    "/migration/*": "most_specific_wins",
    "/guard/*": "most_specific_wins"
  },
  "crypto": {
    "selected_preset": "pq_hybrid",
    "suite_presets": {
      "legacy": {
        "label": {
          "en": "Legacy (today)",
          "pl": "Dotychczasowy (stan dzisiejszy)"
        },
        "status": "implemented",
        "data": "aes-256-gcm",
        "password_kdf": "pbkdf2-hmac-sha256",
        "kem": "rsa-oaep-3072-sha256",
        "signature": null,
        "handoff_envelope": "credential_envelope/2",
        "object_key": "password_derived_direct",
        "aad": "none"
      },
      "pq_hybrid": {
        "label": {
          "en": "Post-quantum hybrid",
          "pl": "Hybryda odporna kwantowo"
        },
        "status": "implemented",
        "data": "aes-256-gcm",
        "password_kdf": "argon2id",
        "argon2id_preset": "rfc9106_second",
        "kem": "xwing-x25519-mlkem768",
        "signature": "hybrid-ed25519-mldsa65",
        "handoff_envelope": "credential_envelope/3",
        "requires": [
          "aes-256-gcm",
          "argon2id",
          "hkdf-sha256",
          "sha3-256",
          "shake256",
          "x25519",
          "ml-kem-768",
          "ed25519",
          "ml-dsa-65"
        ],
        "object_key": "hkdf-sha256(category_dek, object_id)",
        "aad": "category|object_id|version|suite"
      }
    },
    "algorithms": {
      "aes-256-gcm": {
        "kind": "aead",
        "standard": "NIST SP 800-38D",
        "params": {
          "key_bits": 256,
          "nonce_bits": 96,
          "tag_bits": 128
        },
        "status": "implemented",
        "library": "OpenSSL (desktop); injected on Android",
        "enabled": true
      },
      "pbkdf2-hmac-sha256": {
        "kind": "kdf_password",
        "standard": "RFC 8018",
        "params": {
          "iterations": 600000,
          "salt_bytes": 32
        },
        "status": "legacy_readable",
        "library": "OpenSSL",
        "enabled": true,
        "note": "format v:1 {v,ct,n,s,i}; always readable"
      },
      "argon2id": {
        "kind": "kdf_password",
        "standard": "RFC 9106",
        "params_preset": "rfc9106_second",
        "status": "implemented",
        "library": "phc-winner-argon2 20190702 (vendored, reference backend)",
        "enabled": true
      },
      "hkdf-sha256": {
        "kind": "kdf",
        "standard": "RFC 5869",
        "params": {},
        "status": "implemented",
        "library": "portable C++ HMAC-SHA256 (RFC 5869)",
        "enabled": true
      },
      "sha3-256": {
        "kind": "hash",
        "standard": "FIPS 202",
        "params": {},
        "status": "implemented",
        "library": "portable C++ Keccak (FIPS 202)",
        "enabled": true
      },
      "rsa-oaep-3072-sha256": {
        "kind": "kem_classical",
        "standard": "RFC 8017",
        "params": {
          "modulus_bits": 3072
        },
        "status": "legacy_readable",
        "library": "cryptography (Python), WebCrypto (HTML)",
        "enabled": true,
        "note": "credential_envelope/2; always readable"
      },
      "x25519": {
        "kind": "kem_classical",
        "standard": "RFC 7748",
        "params": {},
        "status": "implemented",
        "library": "OpenSSL when present, else Monocypher 4.0.3 (vendored)",
        "enabled": true
      },
      "ml-kem-768": {
        "kind": "kem_pq",
        "standard": "FIPS 203",
        "params": {
          "pk_bytes": 1184,
          "ct_bytes": 1088,
          "ss_bytes": 32
        },
        "status": "implemented",
        "library": "mlkem-native v2.0.0 (vendored, portable C)",
        "enabled": true
      },
      "xwing-x25519-mlkem768": {
        "kind": "kem_hybrid",
        "standard": "draft-connolly-cfrg-xwing-kem",
        "params": {
          "ct_bytes": 1120
        },
        "status": "implemented",
        "library": "composition of the two above",
        "enabled": true
      },
      "ed25519": {
        "kind": "signature_classical",
        "standard": "RFC 8032",
        "params": {},
        "status": "implemented",
        "library": "OpenSSL when present, else Monocypher 4.0.3 (vendored)",
        "enabled": true
      },
      "ml-dsa-65": {
        "kind": "signature_pq",
        "standard": "FIPS 204",
        "params": {},
        "status": "implemented",
        "library": "mldsa-native v2.0.0 (vendored, portable C)",
        "enabled": true
      },
      "hybrid-ed25519-mldsa65": {
        "kind": "signature_hybrid",
        "standard": "loom.sig_hybrid/1 (compare draft-ietf-lamps-pq-composite-sigs)",
        "params": {
          "verify": "both"
        },
        "status": "implemented",
        "library": "composition of the two above",
        "enabled": true
      }
    },
    "params": {
      "argon2id_presets": {
        "rfc9106_second": {
          "t": 3,
          "m_kib": 65536,
          "p": 4,
          "source": "RFC 9106 section 4, second recommended option"
        },
        "rfc9106_first": {
          "t": 1,
          "m_kib": 2097152,
          "p": 4,
          "source": "RFC 9106 section 4, first recommended option"
        },
        "owasp_min": {
          "t": 2,
          "m_kib": 19456,
          "p": 1,
          "source": "OWASP Password Storage Cheat Sheet"
        },
        "calibrated": {
          "t": null,
          "m_kib": null,
          "p": null,
          "source": "measured on the device to a target time chosen by the user"
        }
      }
    },
    "readable_formats": {
      "blob": [
        "v:1 pbkdf2-hmac-sha256 + aes-256-gcm"
      ],
      "envelope": [
        "loom.credential_envelope/2 rsa-oaep-3072-sha256 + aes-256-gcm"
      ]
    }
  },
  "key_custody": {
    "options": {
      "passphrase_in_memory": {
        "label": {
          "en": "Passphrase, held in RAM while unlocked",
          "pl": "Has\u0142o, trzymane w RAM po odblokowaniu"
        },
        "status": "implemented"
      },
      "os_keystore": {
        "label": {
          "en": "Operating system keystore",
          "pl": "Magazyn kluczy systemu"
        },
        "status": "planned"
      },
      "hardware": {
        "label": {
          "en": "Hardware token",
          "pl": "Klucz sprz\u0119towy"
        },
        "status": "planned"
      },
      "escrow": {
        "label": {
          "en": "Escrow with a chosen party",
          "pl": "Depozyt u wskazanego podmiotu"
        },
        "status": "planned"
      },
      "none": {
        "label": {
          "en": "No recovery (explicit choice with recorded warning)",
          "pl": "Bez odzyskiwania (\u015bwiadomy wyb\u00f3r z zapisanym ostrze\u017ceniem)"
        },
        "status": "planned"
      }
    },
    "selected": "passphrase_in_memory",
    "key_bytes_in_nodes": false
  },
  "rotation": {
    "preset": {
      "period_days": null,
      "mode": "manual"
    },
    "note": "no automatic rotation by default; period is a setting and the shortest of the scopes wins (min)"
  },
  "recovery": "hint",
  "handoff": {
    "envelope": "v2",
    "allow_v2": true
  },
  "migration": {
    "reencrypt": "never",
    "modes": [
      "never",
      "on_touch",
      "background",
      "now"
    ]
  },
  "guard": {
    "x10": {
      "mode": "ask_once",
      "note": "only gate: expected growth of resource use by an order of magnitude is confirmed once by the user (owner rule 2026-09-30)"
    }
  },
  "threat_model": {
    "lost_device": {
      "label": {
        "en": "Lost or stolen device",
        "pl": "Utrata lub kradzie\u017c urz\u0105dzenia"
      },
      "attacker": "physical access, offline",
      "assets": [
        "conversations",
        "search_index",
        "blobs",
        "secrets",
        "memory_tree"
      ],
      "paths": [
        "local_dir",
        "android_shared"
      ],
      "controls": [
        "OS disk encryption (outside the app)"
      ],
      "status_today": "unknown",
      "note": "the application adds no at-rest encryption today"
    },
    "other_app_shared_storage": {
      "label": {
        "en": "Other app on shared storage",
        "pl": "Inna aplikacja na wsp\u00f3\u0142dzielonym storage"
