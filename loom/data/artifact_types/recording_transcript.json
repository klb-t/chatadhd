   },
   {
    "op": "mime",
    "value": "audio/*"
   }
  ],
  "min_score": 0.5
 },
 "parse": {
  "segment": [
   "timestamped_utterances"
  ],
  "observation_kinds": [
   "utterance"
  ]
 },
 "extract": [
  {
   "op": "speakers"
  },
  {
   "op": "dates"
  },
  {
   "op": "items"
  },
  {
   "op": "entities_lexicon"
  }
 ],
 "structure": [
  {
   "name": "recording",
   "type": "string",
   "card": "one",
   "required": true,
   "description": "content hash of the original recording"
  },
  {
   "name": "utterances",
   "type": "record[]",
   "card": "list",
   "fields": {
    "speaker": {
     "type": "string"
    },
    "start": {
     "type": "string"
    },
    "end": {
     "type": "string"
    },
    "text": {
     "type": "text"
    }
   }
  },
  {
   "name": "speakers",
   "type": "string",
   "card": "many"
  }
 ]
}
