{
  "schema": "loom.application_profile/1",
  "id": "chatgpt-inspired",
  "profile_revision": 1,
  "label": "ChatGPT-inspired",
  "target": {
    "application_id": "chatgpt",
    "version": null,
    "platform": "web"
  },
  "evidence": {
    "status": "inspired",
    "sources": [
      {
        "url": "https://github.com/LibreChat-AI/LibreChat",
        "revision": "e8f3be08623663d4ad7f7241e693c94469b63bb0",
        "note": "LibreChat v0.8.8 is a reference implementation, not a ChatGPT build."
      }
    ],
    "gaps": [
      "No verified original application version/build: this is an inspired example, not an exact historical replica.",
      "Original service backend, hidden prompts and request compilation are not reproduced.",
      "Artifact editing, original project workflows, web browsing, voice and descendant-branch navigation need additional adapters."
    ]
  },
  "presentation": {
    "renderer": "chat",
    "tokens": {
      "background": "#171717",
      "surface": "#212121",
      "text": "#ececec",
      "muted": "#b4b4b4",
      "accent": "#8bd6b3",
      "border": "#383838"
    },
    "sidebar": {
      "side": "left",
      "width": 260
    },
    "content_width": 800,
    "message_style": "plain"
  },
  "composer": {
    "submit": "enter",
    "placeholder": "Message in ChatGPT-inspired view\u2026"
  },
  "actions": [
    {
      "id": "create",
      "label": "New conversation",
      "operation": "chat.create",
      "capability": "chat.create",
      "required": true
    },
    {
      "id": "select",
      "label": "Return to conversation",
      "operation": "chat.select",
      "capability": "chat.select",
      "required": true
    },
    {
      "id": "send",
      "label": "Send",
      "operation": "chat.send",
      "capability": "chat.send",
      "required": true
    },
    {
      "id": "cancel",
      "label": "Stop",
      "operation": "chat.cancel",
      "capability": "chat.cancel",
      "required": true
    },
    {
      "id": "edit",
      "label": "Edit message",
      "operation": "message.edit",
      "capability": "message.edit",
      "required": true
    },
    {
      "id": "restore",
      "label": "Restore version",
      "operation": "message.restore",
      "capability": "message.restore",
      "required": true
    },
    {
      "id": "exclude",
      "label": "Exclude message",
      "operation": "message.exclude",
      "capability": "message.exclude",
      "required": true
    },
    {
      "id": "knowledge",
      "label": "Inspect knowledge",
      "operation": "knowledge.open",
      "capability": "knowledge.open",
      "required": false
    },
    {
      "id": "memory",
      "label": "Memory",
      "operation": "memory.open",
      "capability": "memory.open",
      "required": false
    },
    {
      "id": "import",
      "label": "Import",
      "operation": "import.open",
      "capability": "import.open",
      "required": false
    },
    {
      "id": "settings",
      "label": "Settings",
      "operation": "settings.open",
      "capability": "settings.open",
      "required": false
    }
  ],
  "workflows": [
    {
      "id": "conversation-review",
      "initial": "ready",
      "states": [
        "ready",
        "chat",
        "review"
      ],
      "transitions": [
        {
          "from": "ready",
          "event": "create",
          "action": "create",
          "to": "chat"
        },
        {
          "from": "chat",
          "event": "inspect",
          "action": "knowledge",
          "to": "review"
        },
        {
          "from": "review",
          "event": "return",
          "action": "select",
          "to": "chat"
        }
      ]
    }
  ]
}
