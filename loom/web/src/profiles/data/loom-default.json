{
  "schema": "loom.application_profile/1",
  "id": "loom-default",
  "profile_revision": 1,
  "label": "Loom",
  "target": {
    "application_id": "chatadhd",
    "version": "development-2026-10-04",
    "platform": "web"
  },
  "evidence": {
    "status": "partial",
    "sources": [
      {
        "url": "https://github.com/klb-t/chatadhd",
        "revision": "421415f8b9a5c29e25fc4c5fda5b87ba8f5fb9cd",
        "note": "Base of this implementation; local profile increment is separate."
      }
    ],
    "gaps": [
      "Original service backend, hidden prompts and request compilation are not reproduced.",
      "Artifact editing, original project workflows, web browsing, voice and descendant-branch navigation need additional adapters."
    ]
  },
  "presentation": {
    "renderer": "chat",
    "tokens": {
      "background": "#0f0f14",
      "surface": "#24242e",
      "text": "#f2f2f2",
      "muted": "#8c8c99",
      "accent": "#4d8cf2",
      "border": "#33333e"
    },
    "sidebar": {
      "side": "left",
      "width": 280
    },
    "content_width": 900,
    "message_style": "bubble"
  },
  "composer": {
    "submit": "enter",
    "placeholder": "Message in Loom view\u2026"
  },
  "actions": [
    {
      "id": "create",
      "label": "New conversation",
      "operation": "chat.create",
      "capability": "chat.create",
      "required": true
    },
    {
      "id": "select",
      "label": "Return to conversation",
      "operation": "chat.select",
      "capability": "chat.select",
      "required": true
    },
    {
      "id": "send",
      "label": "Send",
      "operation": "chat.send",
      "capability": "chat.send",
      "required": true
    },
    {
      "id": "cancel",
      "label": "Stop",
      "operation": "chat.cancel",
      "capability": "chat.cancel",
      "required": true
    },
    {
      "id": "edit",
      "label": "Edit message",
      "operation": "message.edit",
      "capability": "message.edit",
      "required": true
    },
    {
      "id": "restore",
      "label": "Restore version",
      "operation": "message.restore",
      "capability": "message.restore",
      "required": true
    },
    {
      "id": "exclude",
      "label": "Exclude message",
      "operation": "message.exclude",
      "capability": "message.exclude",
      "required": true
    },
    {
      "id": "knowledge",
      "label": "Inspect knowledge",
      "operation": "knowledge.open",
      "capability": "knowledge.open",
      "required": false
    },
    {
      "id": "memory",
      "label": "Memory",
      "operation": "memory.open",
      "capability": "memory.open",
      "required": false
    },
    {
      "id": "import",
      "label": "Import",
      "operation": "import.open",
      "capability": "import.open",
      "required": false
    },
    {
      "id": "settings",
      "label": "Settings",
      "operation": "settings.open",
      "capability": "settings.open",
      "required": false
    }
  ],
  "workflows": [
    {
      "id": "conversation-review",
      "initial": "ready",
      "states": [
        "ready",
        "chat",
        "review"
      ],
      "transitions": [
        {
          "from": "ready",
          "event": "create",
          "action": "create",
          "to": "chat"
        },
        {
          "from": "chat",
          "event": "inspect",
          "action": "knowledge",
          "to": "review"
        },
        {
          "from": "review",
          "event": "return",
          "action": "select",
          "to": "chat"
        }
      ]
    }
  ]
}
