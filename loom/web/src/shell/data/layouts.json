{
  "schema": "loom.shell_layouts/2",
  "default": "czat",
  "layouts": {
    "czat": {
      "label": "Czat",
      "layout_mode": "full_screen_chat",
      "topbar": [
        "drawer",
        "title",
        "model",
        "status",
        "menu"
      ],
      "menu": [
        {
          "id": "graph",
          "label": "menu_graph",
          "action": "navigator:"
        },
        {
          "id": "settings",
          "label": "menu_settings",
          "action": "panel:settings"
        },
        {
          "id": "me",
          "label": "menu_me",
          "action": "navigator:party:self"
        },
        {
          "id": "this_conversation",
          "label": "menu_this_conversation",
          "action": "navigator:conv:current"
        },
        {
          "id": "windows",
          "label": "menu_windows",
          "action": "sheet:windows"
        },
        {
          "id": "layouts",
          "label": "menu_layouts",
          "action": "sheet:layouts"
        },
        {
          "id": "views",
          "label": "menu_views",
          "action": "sheet:views"
        },
        {
          "id": "semantic",
          "label": "menu_semantic",
          "action": "sheet:semantic"
        },
        {
          "id": "diagnostics",
          "label": "menu_diagnostics",
          "action": "sheet:diagnostics"
        },
        {
          "id": "connection",
          "label": "menu_connection",
          "action": "connection",
          "when": "android_shell"
        },
        {
          "id": "workshop",
          "label": "menu_workshop",
          "action": "layout:workshop"
        }
      ],
      "message_actions": [
        "copy",
        "edit",
        "regenerate",
        "versions",
        "exclude"
      ],
      "composer": [
        "attach",
        "text",
        "mic",
        "send"
      ],
      "starters": 4,
      "origin": "preset",
      "device_class": "any",
      "tree": {
        "split": "h",
        "ratio": 0.28,
        "a": {
          "leaf": "L0"
        },
        "b": {
          "leaf": "L1"
        }
      },
      "leaves": {
        "L0": {
          "windows": [
            "w_list"
          ],
          "active": "w_list"
        },
        "L1": {
          "windows": [
            "w_chat"
          ],
          "active": "w_chat"
        }
      },
      "windows": [
        {
          "id": "w_list",
          "kind": "conversation_list",
          "node": "conversations:",
          "mode": "docked",
          "z": 0,
          "params": {},
          "profile": null,
          "title_override": null,
          "collapsed": true,
          "pinned": false,
          "dock": {
            "leaf": "L0"
          }
        },
        {
          "id": "w_chat",
          "kind": "chat",
          "node": "conv:current",
          "mode": "maximized",
          "z": 0,
          "params": {},
          "profile": null,
          "title_override": null,
          "collapsed": false,
          "pinned": false,
          "dock": {
            "leaf": "L1"
          }
        }
      ],
      "focus": "w_chat",
      "channels": {
        "conversation": null
      },
      "shelf": {
        "handles": [
          "w_list"
        ]
      },
      "switcher": {
        "style": "sheet",
        "position": "menu"
      }
    },
    "siatka": {
      "label": "Siatka",
      "origin": "preset",
      "device_class": "any",
      "layout_mode": "views_grid",
      "aliases": [
        "warsztat",
        "workshop"
      ],
      "note": "The workbench: the application views grid with every panel, as before P20. Dawny „Warsztat” (kod: layout workshop). W3: drawn from this dock tree (list | chat over knowledge, 0.32 as the former 32 % chat strip); the former header is the switcher bar; the panels are its tabs and open as windows over the layout.",
      "tree": {
        "split": "h",
        "ratio": 0.22,
        "a": {
          "leaf": "L0"
        },
        "b": {
          "split": "v",
          "ratio": 0.32,
          "a": {
            "leaf": "L1"
          },
          "b": {
            "leaf": "L2"
          }
        }
      },
      "leaves": {
        "L0": {
          "windows": [
            "w_list"
          ],
          "active": "w_list"
        },
        "L1": {
          "windows": [
            "w_chat"
          ],
          "active": "w_chat"
        },
        "L2": {
          "windows": [
            "w_knowledge"
          ],
          "active": "w_knowledge"
        }
      },
      "windows": [
        {
          "id": "w_list",
          "kind": "conversation_list",
          "node": "conversations:",
          "mode": "docked",
          "z": 0,
          "params": {},
          "profile": null,
          "title_override": null,
          "collapsed": false,
          "pinned": false,
          "dock": {
            "leaf": "L0"
          }
        },
        {
          "id": "w_chat",
          "kind": "chat",
          "node": "conv:current",
          "mode": "docked",
          "z": 0,
          "params": {},
          "profile": null,
          "title_override": null,
          "collapsed": false,
          "pinned": false,
          "dock": {
            "leaf": "L1"
          }
        },
        {
          "id": "w_knowledge",
          "kind": "knowledge",
          "node": "knowledge:",
          "mode": "docked",
          "z": 0,
          "params": {},
          "profile": null,
          "title_override": null,
          "collapsed": false,
          "pinned": false,
          "dock": {
            "leaf": "L2"
          }
        }
      ],
      "focus": "w_chat",
      "channels": {
        "conversation": null
      },
      "shelf": {
        "handles": []
      },
      "leaf_sizing": {
        "L0": "content"
      },
      "leaf_sizing_note": "W3: a leaf whose window keeps its own size (the conversation list: its CSS width and collapse, as in the former Workshop); other leaves take the split ratio. A preset: 'ratio' gives the list 22 %.",
      "switcher": {
        "style": "bar",
        "position": "top",
        "entries": "panels_as_tabs"
      }
    }
  },
  "journal_limit": 50,
  "aliases": {
    "warsztat": "siatka",
    "workshop": "siatka",
    "chat": "czat",
    "full_screen_chat": "czat",
    "views_grid": "siatka"
  },
  "layout_modes": {
    "full_screen_chat": "czat",
    "views_grid": "siatka",
    "windows": "last"
  },
  "fallbacks": {
    "last": "siatka"
  },
  "fallbacks_note": "W5: layout_mode=windows means 'the last own layout' (OKNA §3.1): the layout active on this device class (window_layout_active) when it is an own one, else the most recently saved (window_layouts); only when the person has saved none does it open this fallback, the grid. A preset, not a rule.",
  "panel_kinds": {
    "graph": "graph_view",
    "graph-entry": "graph_entry",
    "navigator": "navigator",
    "perspectives": "perspectives",
    "view-engine": "view_engine",
    "memory": "memory",
    "import": "import",
    "context": "context",
    "settings": "settings",
    "logs": "logs",
    "methods": "methods",
    "analysis": "analysis",
    "onboarding": "onboarding",
    "user-knowledge": "user_knowledge",
    "operations": "operations"
  },
  "panel_kinds_by_layout": {
    "siatka": {
      "settings": "settings_fields"
    }
  },
  "panel_kinds_note": "W1: which window kind a panel of the app opens as (maximized over the layout, OKNA §3.3). Open map: a panel missing here opens as the kind of its own id.",
  "panel_placement": "maximize",
  "window_words": {
    "czat": "chat",
    "rozmow": "chat",
    "chat": "chat",
    "conversation": "chat",
    "graf": "navigator",
    "graph": "navigator",
    "nawigator": "navigator",
    "navigator": "navigator",
    "ustawien": "settings",
    "ustawieni": "settings",
    "settings": "settings",
    "pamiec": "memory",
    "pamie": "memory",
    "memory": "memory",
    "import": "import",
    "dziennik": "logs",
    "log": "logs",
    "kontekst": "context",
    "context": "context",
    "metod": "methods",
    "method": "methods",
    "analiz": "analysis",
    "analysis": "analysis",
    "operacj": "operations",
    "operation": "operations",
    "perspektyw": "perspectives",
    "perspective": "perspectives",
    "silnik widok": "view-engine",
    "view engine": "view-engine"
  },
  "window_words_note": "W2: a word of a sentence (folded, no diacritics) to a window: the longest stem a word starts with wins; the value is `chat` (the own chat window) or a panel id. Open map, an example set; an id of a panel is accepted as is.",
  "window_placements": {
    "any": {
      "beside": "maximize",
      "below": "maximize",
      "float": "maximize",
      "tab": "maximize",
      "shelf": "maximize"
    }
  },
  "window_placements_note": "W2: the placement a screen uses for an asked one, per device class (`any` = every class). Preset: every placement is the next maximized window of the stack (OKNA §4.1) until docking and floating are drawn (W3/W4); the receipt says so when it differs from the asked one. A preset, not a rule. W5: the settings field of the same name (settings_fields.pack) overrides this preset when it is set.",
  "window_back": "visits",
  "window_back_note": "W2 (OKNA §4.2): what Back does with windows: visits (back to the previous window of the journal of visits), to_chat (back to the chat window), close_window (closes the window in front), none (Back never changes the window). Preset of the phone. W5: the settings field of the same name (settings_fields.pack) overrides this preset when it is set.",
  "window_restore_last": true,
  "window_restore_last_note": "W2: the start view `last_saved` restores the windows of the last session (window_layout_last in localStorage loom.shell.last.v2), not only the layout id. false = only the layout id, as in W1. W5: the settings field of the same name (settings_fields.pack) overrides this preset when it is set.",
  "window_restore_front": "layout",
  "window_restore_front_note": "W2: which window is in front after a start that restored window_layout_last: layout (preset: the window the layout's preset maximizes, the chat; the restored others wait in the switcher - a start looks as before W2) | saved (the window that was in front when the page was left). W5: the settings field of the same name (settings_fields.pack) overrides this preset when it is set.",
  "window_arrange": {
    "min_useful_width": 240,
    "offscreen_fraction": 0.5,
    "keyboard_min_px": 80,
    "drop_edge": 0.25,
    "float_drop_edge": 0.08,
    "drag_threshold_px": 8,
    "split_grip_px": 24,
    "float_rect": {
      "x": 0.06,
      "y": 0.12,
      "w": 0.88,
      "h": 0.6,
      "unit": "fraction"
    },
    "advisory_button_order": [
      "keep",
      "dont_ask",
      "fix"
    ],
    "advisories": {
      "dock_narrow": {
        "text": {
          "pl": "Zadokowane okna mają tu mniej niż {min} px szerokości ({widths}).",
          "en": "Docked windows are narrower than {min} px here ({widths})."
        },
        "fix": {
          "id": "maximize",
          "label": {
            "pl": "Zmaksymalizuj",
            "en": "Maximize"
          }
        }
      },
      "float_offscreen": {
        "text": {
          "pl": "Okno «{title}» jest w większości poza ekranem.",
          "en": "The window «{title}» is mostly off the screen."
        },
        "fix": {
          "id": "snap",
          "label": {
            "pl": "Przyciągnij",
            "en": "Snap back"
          }
        }
      },
      "float_under_keyboard": {
        "text": {
          "pl": "Klawiatura zakrywa okno «{title}».",
          "en": "The keyboard covers the window «{title}»."
        },
        "fix": {
          "id": "above_keyboard",
          "label": {
            "pl": "Przesuń nad",
            "en": "Move above"
          }
        }
      }
    },
    "question": {
      "pl": "Czy to celowe?",
      "en": "Is this intended?"
    },
    "choices": [
      {
        "id": "keep",
        "label": {
          "pl": "Zostaw",
          "en": "Keep it"
        }
      },
      {
        "id": "dont_ask",
        "label": {
          "pl": "Zostaw, nie pytaj więcej",
          "en": "Keep it, don't ask again"
        }
      }
    ],
    "menu": [
      {
        "id": "left",
        "label": {
          "pl": "Dokuj z lewej",
          "en": "Dock left"
        },
        "icon": "⇤"
      },
      {
        "id": "right",
        "label": {
          "pl": "Dokuj z prawej",
          "en": "Dock right"
        },
        "icon": "⇥"
      },
      {
        "id": "top",
        "label": {
          "pl": "Dokuj u góry",
          "en": "Dock top"
        },
        "icon": "⤒"
      },
      {
        "id": "bottom",
        "label": {
          "pl": "Dokuj na dole",
          "en": "Dock bottom"
        },
        "icon": "⤓"
      },
      {
        "id": "tab",
        "label": {
          "pl": "Jako zakładka",
          "en": "As a tab"
        },
        "icon": "▭"
      },
      {
        "id": "float",
        "label": {
          "pl": "Pływające",
          "en": "Floating"
        },
        "icon": "⧉"
      },
      {
        "id": "maximize",
        "label": {
          "pl": "Zmaksymalizuj",
          "en": "Maximize"
        },
        "icon": "⤢"
      }
    ],
    "keymap": {
      "ctrl+shift+arrowleft": "left",
      "ctrl+shift+arrowright": "right",
      "ctrl+shift+arrowup": "top",
      "ctrl+shift+arrowdown": "bottom",
      "ctrl+shift+f": "float",
      "ctrl+shift+m": "maximize",
      "ctrl+shift+t": "tab",
      "ctrl+shift+z": "undo",
      "ctrl+shift+y": "redo"
    }
  },
  "window_arrange_note": "W4 (OKNA §4.4, §6.3): presets of docking and floating - thresholds of the advisories dock_narrow (min_useful_width px of a drawn leaf), float_offscreen (fraction of a floating rect outside the area), float_under_keyboard (on-screen keyboard at least keyboard_min_px tall); drop_edge = the fraction of a leaf near its edge that docks to that side (the middle makes a tab); the menu entries and keys reach every arrangement without dragging. All examples; any value works, also degenerate ones (0 = never narrow).",
  "device_classes": [
    {
      "id": "phone",
      "max_width": 599
    },
    {
      "id": "desktop"
    }
  ],
  "device_classes_note": "W5: the device class of a screen (the key of window_layout_active and of window_layout_journal): the first rule whose width range (CSS px, max_width / min_width) holds the screen wins. An open list of examples - add tablet, tv, watch… as rules; a screen no rule holds is the class `any`.",
  "layout_reset": {
    "any": "same"
  },
  "layout_reset_note": "W5: what „Jak w aplikacji” (layout.reset) brings back, per device class (`any` = every class): `same` = the shipped form of the layout drawn now (czat stays czat, siatka stays siatka), or the id of a shipped layout. One journal entry, undo returns the layout that was there.",
  "journal_limit_note": "W5: the bound of the persisted journal (window_layout_journal, per device class); the field's own `limit` overrides it. Any number ≥ 0 (0 = no undo)."
}
