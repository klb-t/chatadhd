{
  "schema": "loom.shell_layouts/1",
  "default": "czat",
  "layouts": {
    "czat": {
      "label": "Czat",
      "layout_mode": "full_screen_chat",
      "topbar": ["drawer", "title", "model", "status", "menu"],
      "menu": [
        { "id": "graph", "label": "menu_graph", "action": "navigator:" },
        { "id": "settings", "label": "menu_settings", "action": "panel:settings" },
        { "id": "me", "label": "menu_me", "action": "navigator:party:self" },
        { "id": "this_conversation", "label": "menu_this_conversation", "action": "navigator:conv:current" },
        { "id": "views", "label": "menu_views", "action": "sheet:views" },
        { "id": "semantic", "label": "menu_semantic", "action": "sheet:semantic" },
        { "id": "connection", "label": "menu_connection", "action": "connection", "when": "android_shell" },
        { "id": "workshop", "label": "menu_workshop", "action": "layout:workshop" }
      ],
      "message_actions": ["copy", "edit", "regenerate", "versions", "exclude"],
      "composer": ["attach", "text", "mic", "send"],
      "starters": 4
    },
    "warsztat": {
      "label": "Warsztat",
      "layout_mode": "views_grid",
      "note": "The workbench: the application views grid with every panel, as before P20."
    }
  }
}
