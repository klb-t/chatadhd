{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom.seeding.recipe/1",
  "title": "Offline seeding dimension and projection profile",
  "type": "object",
  "required": [
    "schema",
    "version",
    "dimensions"
  ],
  "properties": {
    "schema": {
      "const": "loom.seeding.recipe/1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "extensions": {}
  },
  "additionalProperties": false,
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "^\\$"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          }
        },
        {
          "type": "object",
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$literal"
          ],
          "properties": {
            "$literal": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$op",
            "value"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/expression"
            },
            "$op": {
              "const": "items"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$op",
            "key",
            "value"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/expression"
            },
            "key": {
              "$ref": "#/$defs/expression"
            },
            "default": {
              "$ref": "#/$defs/expression"
            },
            "$op": {
              "const": "get"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$op",
            "items",
            "value"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/expression"
            },
            "items": {
              "$ref": "#/$defs/expression"
            },
            "$op": {
              "const": "collect"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$op",
            "items"
          ],
          "properties": {
            "items": {
              "$ref": "#/$defs/expression"
            },
            "$op": {
              "const": "flatten"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$op",
            "items"
          ],
          "properties": {
            "items": {
              "$ref": "#/$defs/expression"
            },
            "$op": {
              "const": "union"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$op",
            "value"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/expression"
            },
            "$op": {
              "const": "nonempty"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$op",
            "items"
          ],
          "properties": {
            "default": {
              "$ref": "#/$defs/expression"
            },
            "items": {
              "$ref": "#/$defs/expression"
            },
            "$op": {
              "const": "max"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$op",
            "template",
            "values"
          ],
          "properties": {
            "values": {
              "$ref": "#/$defs/expression"
            },
            "template": {
              "$ref": "#/$defs/expression"
            },
            "$op": {
              "const": "format"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$op",
            "item",
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/expression"
            },
            "item": {
              "$ref": "#/$defs/expression"
            },
            "$op": {
              "const": "source_record"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$op",
            "items"
          ],
          "properties": {
            "items": {
              "$ref": "#/$defs/expression"
            },
            "$op": {
              "const": "merge"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "dimension": {
      "type": "object",
      "required": [
        "id",
        "predict",
        "rows",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "predict": {
          "type": "boolean"
        },
        "rows": {
          "$ref": "#/$defs/expression"
        },
        "select": {
          "$ref": "#/$defs/expression"
        },
        "label": {
          "$ref": "#/$defs/expression"
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "not": {
              "enum": [
                "project",
                "operators",
                "item",
                "key",
                "label",
                "members"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          }
        },
        "properties": {
          "$ref": "#/$defs/expression"
        },
        "eligibility": {
          "type": "object",
          "required": [
            "policy_key",
            "support_dimension",
            "union_property",
            "alternatives_property",
            "member_property",
            "application_id_property",
            "application_source_property",
            "mapping_relation",
            "mapping_label_key",
            "mapping_witness_id_key"
          ],
          "properties": {
            "policy_key": {
              "type": "string",
              "minLength": 1
            },
            "support_dimension": {
              "type": "string",
              "minLength": 1
            },
            "union_property": {
              "type": "string",
              "minLength": 1
            },
            "alternatives_property": {
              "type": "string",
              "minLength": 1
            },
            "member_property": {
              "type": "string",
              "minLength": 1
            },
            "application_id_property": {
              "type": "string",
              "minLength": 1
            },
            "application_source_property": {
              "type": "string",
              "minLength": 1
            },
            "mapping_relation": {
              "type": "string",
              "minLength": 1
            },
            "mapping_label_key": {
              "type": "string",
              "minLength": 1
            },
            "mapping_witness_id_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "extensions": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "predict": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "properties"
            ]
          }
        }
      ]
    }
  }
}
