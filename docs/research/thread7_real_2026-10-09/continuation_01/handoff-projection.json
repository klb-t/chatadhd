{
  "export": {
    "confirmation_ratio": 10,
    "format": "json.gz",
    "mode": "records",
    "source_encoding": "base64"
  },
  "hash_bindings": {
    "code": "program",
    "policy": "policy",
    "protocol": "protocol"
  },
  "inputs": {
    "policy": {
      "paths": [
        "policy_frozen.json"
      ],
      "required": true
    },
    "predictions": {
      "paths": [
        "predictions.json.gz",
        "predictions.json"
      ],
      "required": true
    },
    "program": {
      "paths": [
        "prototype_frozen.py"
      ],
      "required": true
    },
    "protocol": {
      "paths": [
        "protocol_frozen.md"
      ],
      "required": true
    },
    "results": {
      "paths": [
        "results.json.gz",
        "results.json"
      ],
      "required": true
    }
  },
  "manifest": {
    "input": "predictions",
    "input_hash_pointer": "/hashes/fixture",
    "pointer": "/manifest",
    "timestamp_pointer": "/predicted_at"
  },
  "method": {
    "identity": "thread7-source-bound-offline-analysis",
    "label": "Offline source-bound research analysis and missingness"
  },
  "namespace": "thread7-continuation-analysis-public",
  "output_manifests": [
    {
      "input": "results",
      "pointer": "/manifest"
    }
  ],
  "parameters": {
    "input": "policy",
    "pointer": ""
  },
  "profiles": {
    "descriptor_pointer": "/profile",
    "effective_role": "effective_profile",
    "modules_pointer": "/modules"
  },
  "projections": {
    "records": [
      {
        "id": "source_bound_evidence_receipt",
        "input": "predictions",
        "path": [
          "records",
          "*"
        ]
      },
      {
        "id": "unmeasured_real_results",
        "input": "results",
        "path": [
          "records",
          "*"
        ],
        "evaluation": true
      }
    ]
  },
  "schema": "loom.seeding.method_graph_projection/1",
  "source_roles": {
    "outputs": [
      "predictions",
      "results"
    ],
    "recipe_exclude": [
      "predictions",
      "results",
      "fixture"
    ]
  },
  "support": {
    "quote_chars": 64
  },
  "vocabulary": {
    "kinds": {
      "method": "Method",
      "method_version": "MethodVersion",
      "parameter_set_version": "ParameterSetVersion",
      "profile_version": "ProfileVersion",
      "projection_version": "ProjectionVersion",
      "recipe_version": "RecipeVersion",
      "result": "CapturedResult",
      "run": "MethodRun",
      "source_version": "SourceVersion"
    },
    "predicates": {
      "captured_record": "captured_record",
      "evaluation_record": "has_evaluation_record",
      "produced_by_method_version": "produced_by_method_version",
      "produced_in_run": "produced_in_run",
      "requests_method_version": "requests_method_version",
      "uses_parameter_set": "uses_parameter_set",
      "uses_profile": "uses_profile",
      "uses_projection": "uses_projection",
      "uses_recipe": "uses_recipe",
      "uses_source_version": "uses_source_version",
      "version_of": "version_of"
    }
  }
}
