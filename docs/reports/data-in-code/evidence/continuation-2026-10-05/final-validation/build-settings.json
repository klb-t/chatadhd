{
  "CMAKE_BUILD_TYPE": "Debug",
  "CMAKE_CXX_COMPILER": "/usr/bin/c++",
  "CMAKE_CXX_FLAGS_DEBUG": "-g0",
  "CMAKE_MAKE_PROGRAM": "/root/.local/bin/ninja",
  "LOOM_BUILD_CLI": "ON",
  "LOOM_BUILD_SERVER": "ON",
  "LOOM_BUILD_TESTS": "ON",
  "LOOM_CCACHE": "LOOM_CCACHE-NOTFOUND",
  "LOOM_SHARED": "ON",
  "LOOM_USE_SYSTEM_SQLITE": "OFF",
  "LOOM_WERROR": "ON",
  "LOOM_WITH_OPENSSL": "AUTO",
  "LOOM_WITH_OPENSSL-STRINGS": "ON;OFF;AUTO"
}
