  "definition": {
    "schema": "loom.runtime_profile/1",
    "domain": "model",
    "revision": 1,
    "description": "Model policy defaults for origin authority ranks, status-history classification and anchoring rationale formatting. Ranks and class membership do not rewrite recorded Origin, EvidenceClass or StatusValue. Evidence/premise protections remain engine invariants. Anchoring identity and exact role-binding confidence are unchanged. If status classes overlap, loss classification takes precedence, matching the history state machine's branch order. Creation defaults apply only through the new normalize_creation API; historic DTO defaults and from_json interpretation remain unchanged. Producer origin, identity/type and evidence/provenance cannot be supplied by profile templates.",
    "defaults": {
      "authority_ranks": {
        "archive": 4,
        "repo": 4,
        "user": 5,
        "external_authority": 3,
        "model_knowledge": 1,
        "system": 2
      },
