  "definition": {
    "schema": "loom.runtime_profile/1",
    "domain": "util",
    "revision": 1,
    "title": "Utility operation presets",
    "description": "Presets for temporary directory allocation and log presentation. Empty base_root uses the system temp directory; fallback_root is consulted only when discovery fails. TempDir::create and Record::formatted_checked accept per-call profiles. Existing explicit ring capacity/level/stderr setters remain authoritative; no mutable global profile is installed.",
    "defaults": {
      "temp": {
        "prefix": "loom_",
        "base_root": "",
        "fallback_root": "/tmp",
        "attempts": 16,
        "id_chars": 12
      },
      "log": {
        "ring_capacity": 500,
        "recent_lines": 500,
        "default_level": 20,
        "stderr_enabled": true,
        "level_environment": "LOOM_LOG_LEVEL",
        "stderr_environment": "LOOM_LOG_STDERR",
        "stderr_disabled_value": "0",
        "level_names": {
          "10": "DEBUG",
          "20": "INFO",
          "30": "WARN",
          "40": "ERROR"
        },
        "default_level_name": "INFO",
        "level_aliases": {
          "debug": 10,
          "warning": 30,
          "warn": 30,
          "error": 40
        },
        "level_width": 5,
        "record_template": "{{time}} [{{level}}] {{logger}}: {{message}}"
      }
    },
