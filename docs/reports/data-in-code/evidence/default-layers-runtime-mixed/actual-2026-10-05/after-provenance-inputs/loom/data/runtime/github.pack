{
  "schema": "loom.runtime_profile/1",
  "domain": "github",
  "revision": 1,
  "description": "Defaults match SyncConfig/GitHubSync. Credential values are external; only credential reference names and inert templates are data.",
  "defaults": {
    "branch": "main",
    "sync_direction": "bidirectional",
    "auto_sync": false,
    "include_patterns": [
      "*.py",
      "*.md",
      "*.json",
      "*.txt"
    ],
    "exclude_patterns": [
      "__pycache__/*",
      ".git/*",
      "*.pyc",
      "secrets.json",
      "*/secrets.json"
    ],
    "base_url": "https://api.github.com",
    "headers": {
      "Accept": "application/vnd.github.v3+json",
      "User-Agent": "ChatADHD-Sync"
    },
    "authorization_template": "token {{token}}",
    "connection_timeout_ms": 10000,
    "request_timeout_ms": 30000,
    "commit_message_template": "Update {{path}} via ChatADHD",
    "secret_key": "github_token",
    "sync_policy": {
      "directions": {
        "bidirectional": {
          "pull": true,
          "push": true
        },
        "push_only": {
          "pull": false,
          "push": true
        },
        "pull_only": {
          "pull": true,
          "push": false
        }
      },
      "unknown_direction": {
        "pull": true,
        "push": true
      },
      "disabled_message_templates": {
        "pull": "pull disabled in {{mode}} mode",
        "push": "push disabled in {{mode}} mode"
      },
      "pull_statuses": [
        "new_remote",
        "modified"
      ],
      "push_statuses": [
        "new_local",
        "modified"
      ],
      "sync_actions": {
        "new_remote": "pull",
        "new_local": "push",
        "modified": "conflict"
      },
      "unknown_sync_action": "ignore"
    }
  },
  "value_schema": {
    "x-setting": "",
    "x-consumer": "worker/media/github",
    "type": "object",
    "required": [
      "branch",
      "sync_direction",
      "auto_sync",
      "include_patterns",
      "exclude_patterns",
      "base_url",
      "headers",
      "authorization_template",
      "connection_timeout_ms",
      "request_timeout_ms",
      "commit_message_template",
      "secret_key",
      "sync_policy"
    ],
    "properties": {
      "branch": {
        "x-setting": "/branch",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "sync_direction": {
        "x-setting": "/sync_direction",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "auto_sync": {
        "x-setting": "/auto_sync",
        "x-consumer": "worker/media/github",
        "type": "boolean"
      },
      "include_patterns": {
        "x-setting": "/include_patterns",
        "x-consumer": "worker/media/github",
        "type": "array",
        "items": {
          "x-setting": "/include_patterns/<index>",
          "x-consumer": "worker/media/github",
          "type": "string"
        }
      },
      "exclude_patterns": {
        "x-setting": "/exclude_patterns",
        "x-consumer": "worker/media/github",
        "type": "array",
        "items": {
          "x-setting": "/exclude_patterns/<index>",
          "x-consumer": "worker/media/github",
          "type": "string"
        }
      },
      "base_url": {
        "x-setting": "/base_url",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "headers": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "authorization_template": {
        "x-setting": "/authorization_template",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "connection_timeout_ms": {
        "x-setting": "/connection_timeout_ms",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "request_timeout_ms": {
        "x-setting": "/request_timeout_ms",
        "x-consumer": "worker/media/github",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "commit_message_template": {
        "x-setting": "/commit_message_template",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "secret_key": {
        "x-setting": "/secret_key",
        "x-consumer": "worker/media/github",
        "type": "string"
      },
      "sync_policy": {
        "type": "object",
        "required": [
          "directions",
          "unknown_direction",
          "disabled_message_templates",
          "pull_statuses",
          "push_statuses",
          "sync_actions",
          "unknown_sync_action"
        ],
        "additionalProperties": false,
        "properties": {
          "directions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "pull",
                "push"
              ],
              "properties": {
                "pull": {
                  "type": "boolean"
                },
                "push": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "unknown_direction": {
            "type": "object",
            "required": [
              "pull",
              "push"
            ],
            "properties": {
              "pull": {
                "type": "boolean"
              },
              "push": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "disabled_message_templates": {
            "type": "object",
            "required": [
              "pull",
              "push"
            ],
            "properties": {
              "pull": {
                "type": "string"
              },
              "push": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "pull_statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "push_statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sync_actions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "pull",
                "push",
                "conflict",
                "ignore"
              ]
            }
          },
          "unknown_sync_action": {
            "type": "string",
            "enum": [
              "pull",
              "push",
              "conflict",
              "ignore"
            ]
          }
        },
        "x-setting": "/sync_policy",
        "x-consumer": "github"
      }
    },
    "additionalProperties": false
  }
}
