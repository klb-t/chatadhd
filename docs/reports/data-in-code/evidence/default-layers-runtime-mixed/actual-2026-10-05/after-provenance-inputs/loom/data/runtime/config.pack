{
  "schema": "loom.runtime_profile/1",
  "domain": "config",
  "revision": 1,
  "description": "Exact 161cc22 fresh Config recipe: seed legacy_defaults in legacy_key_order, append remaining declared keys, and serve loom_defaults only as absent-key fallbacks. Usage fallback belongs to usage_policy. Stored config merges shallowly at top level; existing files are not automatically rewritten.",
  "defaults": {
    "legacy_defaults": {
      "base_url": "https://openrouter.ai/api/v1",
      "default_model": "anthropic/claude-sonnet-4-20250514",
      "semantic_model": "",
      "temperature": 0.7,
      "max_tokens": 4096,
      "theme": "dark",
      "system_prompt": "You are a helpful assistant with access to the user's hierarchical memory.",
      "auto_title": true,
      "stream": true,
      "semantic_analysis": true,
      "graph_memory_depth": 2,
      "graph_memory_max_nodes": 20
    },
    "legacy_key_order": [
      "base_url",
      "default_model",
      "semantic_model",
      "temperature",
      "max_tokens",
      "theme",
      "system_prompt",
      "auto_title",
      "stream",
      "semantic_analysis",
      "graph_memory_depth",
      "graph_memory_max_nodes"
    ],
    "loom_defaults": {
      "loom_event_log_types": [
        "conv:created",
        "import:done",
        "graph:changed"
      ],
      "loom_task_workers": 1
    }
  },
  "value_schema": {
    "type": "object",
    "required": [
      "legacy_defaults",
      "legacy_key_order",
      "loom_defaults"
    ],
    "additionalProperties": false,
    "properties": {
      "legacy_defaults": {
        "type": "object",
        "required": [
          "base_url",
          "default_model",
          "semantic_model",
          "temperature",
