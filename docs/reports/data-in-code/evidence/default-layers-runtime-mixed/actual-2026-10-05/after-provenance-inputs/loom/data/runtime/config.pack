          "graph_memory_depth",
          "graph_memory_max_nodes"
        ],
        "additionalProperties": true,
        "properties": {
          "base_url": {
            "type": "string",
            "x-setting": "/legacy_defaults/base_url",
            "x-consumer": "Config preset"
          },
          "default_model": {
