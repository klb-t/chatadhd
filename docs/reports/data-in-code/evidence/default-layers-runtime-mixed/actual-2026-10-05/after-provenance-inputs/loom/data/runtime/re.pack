{
  "schema": "loom.runtime_profile/1",
  "domain": "re",
  "revision": 1,
  "defaults": {
    "step_limit": 10000000
  },
  "value_schema": {
    "type": "object",
    "required": [
      "step_limit"
    ],
    "properties": {
      "step_limit": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615,
        "description": "Per-search VM instruction budget. Zero exhausts before executing an instruction; the maximum is only the uint64 representation boundary. Legacy set_step_limit has the same semantics.",
        "x-setting": "/step_limit",
        "x-unit": "VM instructions",
        "x-consumer": "loom::re::Regex"
      }
    },
    "additionalProperties": false
  }
}
