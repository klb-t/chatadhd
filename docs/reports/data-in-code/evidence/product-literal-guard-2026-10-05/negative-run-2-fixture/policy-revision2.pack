{
  "schema": "loom.product_literals/1",
  "revision": 2,
  "requirement": {
    "id": "R42",
    "source_commit": "3cd5848e7484d50d00f19f0855bc2cd228ad7f3b",
    "path": "docs/architecture/OWNER_REQUIREMENTS_2026-09-26.md",
    "section_sha256": "ae082e3275f57ad7f0ded968af4b92eb8387d280e1e6b6c69e4c40029bcf0aa6"
  },
  "categories": {
    "contract": "Names/keys/schema versions and pack filenames of the code-data contract; changing them requires the matching implementation change.",
    "external_standard": "Constants and parsing grammars fixed by an external standard, not domain recognition policy.",
    "mechanism": "Lifecycle states, machine error/event codes and universal engine operation vocabulary.",
    "serialization": "Date/number/serialization formats whose exact bytes are an existing compatibility contract.",
    "bootstrap": "Minimal locators needed to discover the data before a pack can be loaded.",
    "developer_diagnostic": "Developer diagnostics or assertions, never user-facing presentation, domain defaults or policy."
  },
  "scopes": [
    "loom/src"
  ],
  "exclusions": [
    {
      "path_segment": "tests",
      "reason": "Explicit synthetic fixture exclusion."
    },
    {
      "path_segment": "fixtures",
      "reason": "Explicit synthetic fixture exclusion."
    }
  ],
  "scanners": [
    {
      "suffixes": [
        ".cpp",
        ".cc",
        ".c",
        ".h",
        ".hpp",
        ".inc"
      ],
      "backend": "cxx",
      "keyword_literals": {
        "true": "boolean",
        "false": "boolean",
        "nullptr": "null"
      }
    },
    {
      "suffixes": [
        ".py"
      ],
      "backend": "python",
      "keyword_literals": {
        "True": "boolean",
        "False": "boolean",
        "None": "null"
      }
    },
    {
      "suffixes": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ],
      "backend": "javascript",
      "keyword_literals": {
        "true": "boolean",
        "false": "boolean",
        "null": "null"
      }
    },
    {
      "suffixes": [
        ".java"
      ],
      "backend": "java",
      "keyword_literals": {
        "true": "boolean",
        "false": "boolean",
        "null": "null"
      }
    },
    {
      "suffixes": [
        ".kt",
        ".kts"
      ],
      "backend": "kotlin",
      "keyword_literals": {
        "true": "boolean",
        "false": "boolean",
        "null": "null"
      }
    },
    {
      "suffixes": [
        ".css",
        ".html",
        ".xml",
        ".json",
        ".md",
        ".txt",
        ".properties",
        ".pro",
        ".bat",
        ".jar",
        ".pyc",
        ""
      ],
      "backend": "unsupported",
      "keyword_literals": {}
    }
  ],
