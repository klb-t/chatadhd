{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom.product_literals/1",
  "title": "Source-bound R42 product literal review and lexical scanner registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "requirement",
    "categories",
    "scopes",
    "exclusions",
    "scanners",
    "owner_rules",
    "fallback_owner",
    "allowlist",
    "generated_outputs",
    "diagnostics",
    "outside_scope",
    "optional_scopes"
  ],
  "properties": {
    "schema": {
      "const": "loom.product_literals/1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_commit",
        "path",
        "section_sha256"
      ],
      "properties": {
        "id": {
          "const": "R42"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "section_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "external_standard",
        "mechanism",
        "serialization",
        "bootstrap",
        "developer_diagnostic"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/reason"
        },
        "external_standard": {
          "$ref": "#/$defs/reason"
        },
        "mechanism": {
          "$ref": "#/$defs/reason"
        },
        "serialization": {
          "$ref": "#/$defs/reason"
        },
        "bootstrap": {
          "$ref": "#/$defs/reason"
        },
        "developer_diagnostic": {
          "$ref": "#/$defs/reason"
        }
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_segment",
          "reason"
        ],
        "properties": {
          "path_segment": {
            "enum": [
              "tests",
              "fixtures"
            ]
          },
          "reason": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    "scanners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suffixes",
          "backend",
          "keyword_literals"
        ],
        "properties": {
          "suffixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "backend": {
            "enum": [
              "cxx",
              "python",
              "javascript",
              "java",
              "kotlin",
              "unsupported"
            ]
          },
          "keyword_literals": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "enum": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "backend": {
                  "const": "cxx"
                }
              },
              "required": [
                "backend"
              ]
            },
            "then": {
              "properties": {
                "keyword_literals": {
                  "const": {
                    "true": "boolean",
                    "false": "boolean",
                    "nullptr": "null"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "backend": {
                  "const": "python"
                }
              },
              "required": [
                "backend"
              ]
            },
            "then": {
              "properties": {
                "keyword_literals": {
                  "const": {
                    "True": "boolean",
                    "False": "boolean",
                    "None": "null"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "backend": {
                  "const": "javascript"
                }
              },
              "required": [
                "backend"
              ]
            },
            "then": {
              "properties": {
                "keyword_literals": {
                  "const": {
                    "true": "boolean",
                    "false": "boolean",
                    "null": "null"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "backend": {
                  "const": "java"
                }
              },
              "required": [
                "backend"
              ]
            },
            "then": {
              "properties": {
                "keyword_literals": {
                  "const": {
                    "true": "boolean",
                    "false": "boolean",
                    "null": "null"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "backend": {
                  "const": "kotlin"
                }
              },
              "required": [
                "backend"
              ]
            },
            "then": {
              "properties": {
                "keyword_literals": {
                  "const": {
                    "true": "boolean",
                    "false": "boolean",
                    "null": "null"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "backend": {
                  "const": "unsupported"
                }
              },
              "required": [
                "backend"
              ]
            },
            "then": {
              "properties": {
                "keyword_literals": {
                  "const": {}
                }
              }
            }
          }
        ]
      }
    },
    "owner_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prefix",
          "thread"
        ],
        "properties": {
          "prefix": {
            "$ref": "#/$defs/path"
          },
          "thread": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "fallback_owner": {
      "type": "integer",
      "minimum": 1
    },
    "allowlist": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allow"
      }
    },
    "generated_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/generated"
      }
    },
    "diagnostics": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/reason"
      }
    },
    "outside_scope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    "optional_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\]+$",
      "description": "Root-relative POSIX path; traversal and filesystem escapes are additionally rejected by the tool."
    },
    "reason": {
      "type": "string",
      "pattern": "\\S",
      "description": "An explicit, nonblank reviewed reason; a category without a reason grants nothing."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "allow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_sha256",
        "byte_start",
        "byte_end",
        "literal_sha256",
        "category",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_start": {
          "type": "integer",
          "minimum": 0
        },
        "byte_end": {
          "type": "integer",
          "minimum": 1
        },
        "literal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "category": {
          "enum": [
            "contract",
            "external_standard",
            "mechanism",
            "serialization",
            "bootstrap",
            "developer_diagnostic"
          ]
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "operation",
        "generator",
        "inputs",
        "output_sha256",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "operation": {
          "const": "runtime_profiles_v1"
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "loom/src/model/gen_runtime_profiles.py"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      }
    }
  }
}
