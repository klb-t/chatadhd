{
  "schema": "loom.runtime_profile_fragment/1",
  "domain": "archive",
  "defaults": {
    "config_defaults": {
      "sources": [],
      "repo": null,
      "code": true,
      "git": true,
      "seed_terms": [],
      "out_dir": "",
      "project": "",
      "max_passes": 3,
      "max_new_terms": 8,
      "max_hits_per_term": 0,
      "max_synthesis_rounds": 1,
      "llm": "off",
      "include_db": false,
      "exclude": [],
      "max_file_bytes": 1000000,
      "force": false
    },
    "scan": {
      "skip_dir_prefixes": [
        "cmake-build"
      ],
      "skip_dir_sentinels": [
        ".loom-archive"
      ],
      "provenance_query_limit": 10000000,
      "json_chunk_bytes": 1048576,
      "readme_name_prefixes": [
        "readme"
      ],
      "readme_kinds": [
        "doc"
      ],
      "readme_name_case_fold": true
    },
    "titles": {
      "doc": "[Doc] {uri}",
      "code": "[Code] {uri}",
      "chat": "[Chat] {title}",
      "project": "[Project] {name}",
      "memory": "[Memory] Claude memories",
      "git": "[Git] {repo}",
      "project_document": "Project: {name}",
      "memory_document": "Claude memory",
      "untitled_chat": "(untitled)",
      "untitled_project": "(project)",
      "project_description_label": "description",
      "project_instructions_label": "instructions",
      "project_document_fallback": "doc",
      "memory_conversations_label": "conversations memory",
      "memory_project_label": "project memory {key}",
      "import_strip_prefix": "[Import] ",
      "line_label": "L{line}",
      "chat_label": "#{ordinal} {role}",
      "section_label": "{label} › {heading}",
      "commit_label": "{hash} {subject}",
      "commit_more_files": "\n(+{count} more)",
      "db_chat_label": "#{ordinal} {role}{version}",
      "earlier_version_suffix": " (earlier version)"
    },
    "projection": {
      "doc_label_max_codepoints": 120,
      "section_label_max_codepoints": 120,
      "git_hash_prefix_bytes": 7,
      "git_subject_max_codepoints": 72,
      "git_text_files": 40,
      "git_extra_files": 200,
      "memory_project_key_prefix_bytes": 8
    },
    "git": {
      "strip_trailers": true,
      "trailer_key_min_bytes": 1,
      "trailer_key_max_bytes_exclusive": 30,
      "trailer_forbidden_key_chars": [
        " "
      ],
      "trailer_required_key_fragments": [
        "-"
      ]
    },
    "code": {
      "parser_routes": {
        "python": "python",
        "cmake": "cmake",
        "shell": "shell"
      },
      "function_declaration_languages": [
        "cpp",
        "c"
      ],
      "excluded_type_words": {
        "cpp": [
          "type",
          "typealias"
        ]
      },
      "non_component_type_words": [
        "namespace"
      ],
      "excluded_symbol_names": [
        "final"
      ],
      "excluded_special_prefixes": [
        "__"
      ],
      "special_name_min_bytes_exclusive": 4,
      "allowed_special_names": [
        "__init__"
      ],
      "excluded_class_methods": [
        "__init__"
      ],
      "todo_text_max_codepoints": 200
    },
    "markdown": {
      "section_max_bytes": 4000
    },
    "output": {
      "mime_rules": [
        {
          "suffix": ".md",
          "mime": "text/markdown",
          "require_prefix": true
        },
        {
          "suffix": ".csv",
          "mime": "text/csv",
          "require_prefix": true
        },
        {
          "suffix": ".jsonl",
          "mime": "application/x-ndjson",
          "require_prefix": true
        }
      ],
      "default_mime": "application/json",
      "marker_file": ".loom-archive",
      "marker_text": "Generated by `loom archive`. The archive walker skips this directory.\n",
      "task_log_file": "task_log.jsonl"
    },
    "pipeline": {
      "prose_excluded_kinds": [
        "code",
        "commit"
      ],
      "materialize_excluded_types": [
        "implementation"
      ],
      "derived_from_weight": 1.0,
      "item_relation_weight": 1.0,
      "initial_seed_weight": 1.0,
      "standalone_max_new_terms": 10,
      "item_node_label_max_codepoints": 90,
      "run_poll_interval_ms": 20,
      "stage_attempts": 2,
      "run_attempts": 1
    }
  },
