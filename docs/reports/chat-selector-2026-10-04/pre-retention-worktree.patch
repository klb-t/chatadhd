+  CHECK(result["selected"][0]["duplicate_paths"][0]["provenance"]["source_ref"] == "other_recorded_source");
+  CHECK(result["selected"][1]["ref"] == "observation_ref");
+  CHECK(dropped_reason(result, "duplicate_identity"));
